/* ==========================================================================
   ENTERPRISE MOBILE ENGINEERING PORTAL - MASTER STYLESHEET
   Compatible with Astro Starlight (.sl-markdown-content scoped components)
   ========================================================================== */

/* 1. FULL-WIDTH CANVAS OVERRIDE */
:root {
  --sl-content-width: 100% !important;
  --sl-content-pad-x: 1.25rem !important;
}

main, .main-pane, .content-panel, .sl-container, .sl-markdown-content {
  max-width: 100% !important;
  width: 100% !important;
}

/* 2. DUAL THEME TOKENS */
:root, :root[data-theme='dark'] {
  --sl-color-bg: #0d1912;
  --sl-color-bg-nav: #09130e;
  --sl-color-bg-sidebar: #09130e;
  --sl-color-bg-inline-code: #13251c;
  --sl-color-border: #1f3b2c;
  --sl-color-text: #e2e8f0;
  --sl-color-text-accent: #22c55e;
  --portal-gold: #f3d17b;
  --portal-card-bg: #13251c;
  --portal-card-border: #1f3b2c;
  --portal-text-body: #cbd5e1;
  --portal-text-muted: #9ca3af;
  --portal-pill-bg: #1a2e23;
  --portal-pill-border: rgba(255, 255, 255, 0.12);
  --portal-pill-text: #e2e8f0;
  --portal-pill-hover: #233e2f;
  --portal-accent: #22c55e;
  --portal-accent-hover: #4ade80;
}

:root[data-theme='light'] {
  --sl-color-bg: #f8faf8;
  --sl-color-bg-nav: #ffffff;
  --sl-color-bg-sidebar: #f2f6f3;
  --sl-color-bg-inline-code: #edf4ee;
  --sl-color-border: #d4e2d8;
  --sl-color-text: #111827;
  --sl-color-text-accent: #007a3d;
  --portal-gold: #143823;
  --portal-card-bg: #ffffff;
  --portal-card-border: #d8e5dc;
  --portal-text-body: #1f2937;
  --portal-text-muted: #4b5563;
  --portal-pill-bg: #f0f7f2;
  --portal-pill-border: #cfe0d4;
  --portal-pill-text: #133824;
  --portal-pill-hover: #e1efe5;
  --portal-accent: #007a3d;
  --portal-accent-hover: #005a2b;
}

/* 3. TYPOGRAPHY & TOC HEADINGS */
:root[data-theme='dark'] #_top, :root[data-theme='dark'] h1 { color: #f3d17b !important; }
:root[data-theme='light'] #_top, :root[data-theme='light'] h1 { color: #143823 !important; }

.sl-markdown-content h2:not(.portal-card-title):not(.portal-route-title),
h2:not(.portal-card-title):not(.portal-route-title) {
  font-size: 1.35rem !important;
  font-weight: 800 !important;
  margin: 36px 0 8px 0 !important;
  border-bottom: none !important;
}
:root[data-theme='dark'] h2:not(.portal-card-title):not(.portal-route-title) { color: #f3d17b !important; }
:root[data-theme='light'] h2:not(.portal-card-title):not(.portal-route-title) { color: #143823 !important; }

.sl-markdown-content h3:not(.portal-card-title):not(.portal-route-title),
h3:not(.portal-card-title):not(.portal-route-title) {
  font-size: 1.08rem !important;
  font-weight: 700 !important;
  margin: 24px 0 6px 0 !important;
}
:root[data-theme='dark'] h3:not(.portal-card-title):not(.portal-route-title) { color: #e2e8f0 !important; }
:root[data-theme='light'] h3:not(.portal-card-title):not(.portal-route-title) { color: #143823 !important; }

.portal-section-sub {
  font-size: 0.92rem;
  color: var(--portal-text-muted);
  margin: 0 0 18px 0;
  line-height: 1.5;
}

/* 4. HERO ORIENTATION & TOPOLOGY CARDS */
.portal-hero-card {
  background: var(--portal-card-bg) !important;
  border: 1px solid var(--portal-card-border) !important;
  border-radius: 12px !important;
  padding: 18px 22px !important;
  margin: 16px 0 28px 0 !important;
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.05) !important;
  width: 100% !important;
  box-sizing: border-box !important;
}

.portal-hero-card.portal-hero-row,
.portal-hero-row,
.portal-hero-card:has(.portal-hero-icon) {
  display: flex !important;
  flex-direction: row !important;
  align-items: flex-start !important;
  gap: 16px !important;
}

.portal-hero-topbar {
  display: flex !important;
  justify-content: space-between !important;
  align-items: center !important;
  flex-wrap: wrap !important;
  gap: 12px !important;
  margin-bottom: 4px !important;
}

.portal-badge-hub {
  background: rgba(34, 197, 94, 0.15) !important;
  color: var(--portal-accent) !important;
  border: 1px solid rgba(34, 197, 94, 0.35) !important;
  font-size: 0.75rem !important;
  font-weight: 700 !important;
  padding: 3px 10px !important;
  border-radius: 4px !important;
  letter-spacing: 0.06em !important;
}

.portal-hub-tag {
  font-size: 0.78rem !important;
  font-weight: 700 !important;
  color: var(--portal-accent) !important;
  letter-spacing: 0.05em !important;
}

.portal-hero-title {
  font-size: 1.35rem !important;
  font-weight: 800 !important;
  color: var(--portal-gold) !important;
  margin: 0 0 4px 0 !important;
  line-height: 1.3 !important;
}

.portal-hero-desc {
  font-size: 0.94rem !important;
  color: var(--portal-text-body) !important;
  line-height: 1.55 !important;
  margin: 0 0 12px 0 !important;
}

.portal-hero-icon {
  width: 32px !important;
  height: 32px !important;
  flex-shrink: 0 !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  color: var(--portal-accent) !important;
  margin-top: 3px !important;
}
.portal-hero-icon svg { width: 26px !important; height: 26px !important; }

.portal-hero-sub {
  font-size: 0.88rem !important;
  color: var(--portal-text-muted) !important;
  margin: 0 !important;
}

.portal-caps-bar {
  display: grid !important;
  grid-template-columns: repeat(4, 1fr) !important;
  gap: 12px !important;
  padding-top: 14px !important;
  border-top: 1px solid var(--portal-card-border) !important;
  width: 100% !important;
  box-sizing: border-box !important;
}
@media (max-width: 900px) { .portal-caps-bar { grid-template-columns: repeat(2, 1fr) !important; } }
@media (max-width: 520px) { .portal-caps-bar { grid-template-columns: 1fr !important; } }

.portal-cap-item {
  background: var(--portal-pill-bg) !important;
  border: 1px solid var(--portal-card-border) !important;
  border-radius: 8px !important;
  padding: 10px 12px !important;
  box-sizing: border-box !important;
}

.portal-cap-title {
  font-size: 0.85rem !important;
  font-weight: 700 !important;
  color: var(--portal-gold) !important;
  margin-bottom: 3px !important;
}

.portal-cap-desc {
  font-size: 0.78rem !important;
  color: var(--portal-text-body) !important;
  line-height: 1.4 !important;
}

/* 5. MERMAID DIAGRAM RESPONSIVE CLAMPING */
.starlight-mermaid, pre.mermaid, .mermaid, div.mermaid {
  display: flex !important;
  justify-content: center !important;
  align-items: center !important;
  width: 100% !important;
  margin: 16px 0 28px 0 !important;
  padding: 16px 10px !important;
  overflow-x: auto !important;
  background: transparent !important;
  box-sizing: border-box !important;
}

.starlight-mermaid svg, pre.mermaid svg, .mermaid svg, svg[id^="mermaid"] {
  display: block !important;
  margin: 0 auto !important;
  max-width: 680px !important;
  width: 100% !important;
  height: auto !important;
}

/* 6. RESPONSIVE CARDS GRIDS */
.portal-grid {
  display: grid !important;
  grid-template-columns: repeat(3, 1fr) !important;
  gap: 16px !important;
  margin: 16px 0 36px 0 !important;
  width: 100% !important;
  box-sizing: border-box !important;
}
@media (max-width: 1160px) { .portal-grid { grid-template-columns: repeat(2, 1fr) !important; } }
@media (max-width: 680px)  { .portal-grid { grid-template-columns: 1fr !important; } }

.portal-cards-grid,
.portal-routes-grid {
  display: grid !important;
  grid-template-columns: repeat(2, 1fr) !important;
  gap: 16px !important;
  margin: 16px 0 28px 0 !important;
  width: 100% !important;
  box-sizing: border-box !important;
}
@media (max-width: 768px) {
  .portal-cards-grid,
  .portal-routes-grid { grid-template-columns: 1fr !important; }
}

.portal-card,
.portal-route-card {
  background: var(--portal-card-bg) !important;
  border: 1px solid var(--portal-card-border) !important;
  border-radius: 12px !important;
  padding: 18px 20px !important;
  display: flex !important;
  flex-direction: column !important;
  justify-content: space-between !important;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05) !important;
  transition: transform 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease !important;
  box-sizing: border-box !important;
  height: 100% !important;
}

.portal-card:hover,
.portal-route-card:hover {
  transform: translateY(-2px) !important;
  border-color: var(--portal-accent) !important;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25) !important;
}

.portal-card-full,
.portal-route-card-full {
  grid-column: span 2 !important;
}
@media (max-width: 768px) {
  .portal-card-full,
  .portal-route-card-full { grid-column: span 1 !important; }
}

/* 7. SAME-LINE ICON, TITLE, TAG & ALIGNED DESCRIPTION FOR ALL CARDS */
.portal-grid .portal-card > div,
.portal-route-card > div,
.portal-cards-grid .portal-card > div {
  display: grid !important;
  grid-template-columns: auto 1fr auto !important;
  column-gap: 14px !important;
  row-gap: 4px !important;
  width: 100% !important;
}

.portal-route-topbar,
.portal-card-topbar {
  display: contents !important;
}

.portal-icon-badge,
.portal-card-icon,
.portal-route-icon {
  grid-column: 1 !important;
  grid-row: 1 / span 2 !important;
  margin: 2px 0 0 0 !important;
  align-self: flex-start !important;
  width: 34px !important;
  height: 34px !important;
  border-radius: 6px !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  color: #ffffff !important;
}

.portal-icon-badge svg,
.portal-card-icon svg,
.portal-route-icon svg {
  width: 18px !important;
  height: 18px !important;
}

/* Badge Colors */
.badge-green  { background: #22c55e !important; }
.badge-purple { background: #8b5cf6 !important; }
.badge-coral  { background: #f87171 !important; }
.badge-rose   { background: #f43f5e !important; }
.badge-amber  { background: #f59e0b !important; }
.badge-teal   { background: #06b6d4 !important; }
.badge-blue   { background: #3b82f6 !important; }

.portal-tag-pill {
  grid-column: 3 !important;
  grid-row: 1 !important;
  align-self: center !important;
  justify-self: end !important;
  font-size: 0.72rem !important;
  font-weight: 700 !important;
  color: var(--portal-accent) !important;
  background: rgba(34, 197, 94, 0.12) !important;
  border: 1px solid rgba(34, 197, 94, 0.3) !important;
  padding: 2px 8px !important;
  border-radius: 4px !important;
  letter-spacing: 0.05em !important;
}

/* Card Titles */
.sl-markdown-content .portal-card-title,
.sl-markdown-content .portal-route-title,
.portal-card-title,
.portal-route-title,
h2.portal-card-title,
h3.portal-route-title,
h3.portal-card-title {
  grid-column: 2 !important;
  grid-row: 1 !important;
  font-size: 1.08rem !important;
  font-weight: 700 !important;
  color: var(--portal-gold) !important;
  margin: 0 !important;
  padding: 0 !important;
  align-self: center !important;
  line-height: 1.3 !important;
}

/* Card Descriptions */
.sl-markdown-content .portal-card-desc,
.sl-markdown-content .portal-route-desc,
.portal-card-desc,
.portal-route-desc,
p.portal-card-desc,
p.portal-route-desc {
  grid-column: 2 / -1 !important;
  grid-row: 2 !important;
  font-size: 0.88rem !important;
  color: var(--portal-text-body) !important;
  line-height: 1.45 !important;
  margin: 4px 0 14px 0 !important;
  padding: 0 !important;
}

/* 8. CARD PILLS & BUTTONS */
.portal-grid .portal-pills {
  grid-column: 1 / -1 !important;
  display: grid !important;
  grid-template-columns: 1fr 1fr !important;
  gap: 8px 10px !important;
  margin-bottom: 16px !important;
}

.portal-card-pills,
.portal-route-pills {
  grid-column: 2 / -1 !important;
  display: flex !important;
  flex-wrap: wrap !important;
  gap: 8px !important;
  margin: 0 0 14px 0 !important;
  padding: 0 !important;
}

.portal-card-pills span,
.portal-route-pills span {
  font-size: 0.74rem !important;
  background: var(--portal-pill-bg) !important;
  border: 1px solid var(--portal-pill-border) !important;
  padding: 3px 8px !important;
  border-radius: 6px !important;
  color: var(--portal-pill-text) !important;
  font-weight: 600 !important;
  display: inline-block !important;
  line-height: 1.4 !important;
  white-space: nowrap !important;
}

.portal-pill-link,
.sl-markdown-content .portal-pill-link {
  background: var(--portal-pill-bg) !important;
  border: 1px solid var(--portal-pill-border) !important;
  border-radius: 6px !important;
  padding: 8px 10px !important;
  color: var(--portal-pill-text) !important;
  text-decoration: none !important;
  font-size: 0.76rem !important;
  font-weight: 600 !important;
  text-align: center !important;
  white-space: nowrap !important;
  overflow: hidden !important;
  text-overflow: ellipsis !important;
  display: block !important;
  transition: all 0.15s ease !important;
}

.portal-pill-link:hover,
.sl-markdown-content .portal-pill-link:hover {
  background: var(--portal-pill-hover) !important;
  border-color: var(--portal-accent) !important;
  color: #ffffff !important;
}

/* 9. CARD FOOTER ACTIONS */
.portal-card-foot,
.portal-card-action,
.portal-route-action {
  padding-top: 10px !important;
  border-top: 1px solid var(--portal-card-border) !important;
  display: flex !important;
  justify-content: flex-end !important;
  align-items: center !important;
  margin-top: auto !important;
}

.portal-view-link,
.portal-card-link,
.portal-route-link,
.sl-markdown-content .portal-view-link,
.sl-markdown-content .portal-card-link,
.sl-markdown-content .portal-route-link {
  color: var(--portal-accent) !important;
  font-size: 0.84rem !important;
  font-weight: 700 !important;
  text-decoration: none !important;
  display: inline-flex !important;
  align-items: center !important;
  gap: 4px !important;
  transition: transform 0.15s ease, color 0.15s ease !important;
}

.portal-view-link:hover,
.portal-card-link:hover,
.portal-route-link:hover,
.sl-markdown-content .portal-view-link:hover,
.sl-markdown-content .portal-card-link:hover,
.sl-markdown-content .portal-route-link:hover {
  color: var(--portal-accent-hover) !important;
  transform: translateX(2px) !important;
}

/* 10. RELEASE GATES SEQUENTIAL BAR */
.portal-gates-container {
  background: var(--portal-card-bg) !important;
  border: 1px solid var(--portal-card-border) !important;
  border-radius: 12px !important;
  padding: 18px 20px !important;
  margin: 16px 0 28px 0 !important;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05) !important;
  width: 100% !important;
  box-sizing: border-box !important;
}

.portal-gates-flow {
  display: flex !important;
  align-items: center !important;
  justify-content: space-between !important;
  flex-wrap: wrap !important;
  gap: 8px !important;
  margin: 12px 0 !important;
}

.portal-gate-node {
  background: var(--portal-pill-bg) !important;
  border: 1px solid var(--portal-card-border) !important;
  border-radius: 8px !important;
  padding: 8px 12px !important;
  text-align: center !important;
  flex: 1 !important;
  min-width: 120px !important;
}

.portal-gate-title {
  font-size: 0.82rem !important;
  font-weight: 700 !important;
  color: var(--portal-gold) !important;
}

.portal-gate-sub {
  font-size: 0.72rem !important;
  color: var(--portal-text-muted) !important;
  margin-top: 2px !important;
}

.portal-gate-arrow {
  color: var(--portal-accent) !important;
  font-weight: 800 !important;
  font-size: 1rem !important;
}

/* 11. TABLE STYLING */
.portal-table-wrap {
  overflow-x: auto !important;
  border: 1px solid var(--portal-card-border) !important;
  border-radius: 8px !important;
  margin: 20px 0 28px 0 !important;
  width: 100% !important;
  background: var(--portal-card-bg) !important;
  box-sizing: border-box !important;
}

.portal-table,
.sl-markdown-content table.portal-table {
  width: 100% !important;
  border-collapse: collapse !important;
  font-size: 0.85rem !important;
  text-align: left !important;
  margin: 0 !important;
  display: table !important;
}

.portal-table th,
.sl-markdown-content table.portal-table th {
  background: var(--portal-pill-bg) !important;
  color: var(--portal-gold) !important;
  font-weight: 700 !important;
  padding: 10px 14px !important;
  border-bottom: 1px solid var(--portal-card-border) !important;
  border-top: none !important;
  border-left: none !important;
  border-right: none !important;
  text-transform: uppercase !important;
  letter-spacing: 0.04em !important;
  font-size: 0.75rem !important;
}

.portal-table td,
.sl-markdown-content table.portal-table td {
  padding: 11px 14px !important;
  border-bottom: 1px solid var(--portal-card-border) !important;
  border-top: none !important;
  border-left: none !important;
  border-right: none !important;
  color: var(--portal-text-body) !important;
  font-size: 0.85rem !important;
}

.portal-table tr:last-child td,
.sl-markdown-content table.portal-table tr:last-child td {
  border-bottom: none !important;
}

.portal-table td code,
.sl-markdown-content table.portal-table td code {
  background: var(--portal-pill-bg) !important;
  border: 1px solid var(--portal-card-border) !important;
  padding: 2px 6px !important;
  border-radius: 4px !important;
  color: var(--portal-accent) !important;
  font-size: 0.78rem !important;
}

/* 12. CHECKLIST & ALERT BOXES */
.portal-checklist-box,
.portal-alert-box {
  background: var(--portal-pill-bg) !important;
  border: 1px solid var(--portal-card-border) !important;
  border-left: 4px solid var(--portal-accent) !important;
  border-radius: 8px !important;
  padding: 18px 20px !important;
  margin: 28px 0 20px 0 !important;
  width: 100% !important;
  box-sizing: border-box !important;
}

.portal-checklist-title,
.portal-alert-title {
  font-size: 0.88rem !important;
  font-weight: 800 !important;
  color: var(--portal-gold) !important;
  letter-spacing: 0.04em !important;
  margin-bottom: 8px !important;
}

.portal-checklist-box p,
.portal-alert-box p {
  font-size: 0.86rem !important;
  color: var(--portal-text-body) !important;
  margin: 0 0 10px 0 !important;
}

.portal-checklist-box ul,
.portal-alert-box ul {
  margin: 0 !important;
  padding-left: 20px !important;
}

.portal-checklist-box li,
.portal-alert-box li {
  font-size: 0.85rem !important;
  color: var(--portal-text-body) !important;
  margin-bottom: 6px !important;
  line-height: 1.5 !important;
}

.portal-checklist-box li strong,
.portal-alert-box li strong {
  color: var(--portal-accent) !important;
}
