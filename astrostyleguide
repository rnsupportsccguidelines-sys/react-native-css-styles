## 5. Implement the same contract on each platform

For readability, each example is grouped into one code block. Split the declarations into the corresponding files above. `BalanceApi` is an example-owned port, not an internal SDK or a complete HTTP implementation.

<Tabs>
<TabItem label="Android">

### Domain, data adapter, and explicit composition

```kotlin
import kotlinx.coroutines.CancellationException

// domain/Balance.kt
 data class Balance(
    val accountId: String,
    val amountMinor: Long,
    val currency: String,
)

// domain/BalanceResult.kt
sealed interface BalanceResult {
    data class Found(val balance: Balance) : BalanceResult
    data object Empty : BalanceResult
    data class Failed(val reason: BalanceFailure) : BalanceResult
}

enum class BalanceFailure { INVALID_ACCOUNT, INVALID_RESPONSE, UNAVAILABLE }

// domain/BalanceRepository.kt
interface BalanceRepository {
    suspend fun read(accountId: String): BalanceResult
}

// domain/LoadBalance.kt
class LoadBalance(private val repository: BalanceRepository) {
    suspend operator fun invoke(accountId: String): BalanceResult {
        if (accountId.isBlank()) {
            return BalanceResult.Failed(BalanceFailure.INVALID_ACCOUNT)
        }
        return repository.read(accountId)
    }
}

// data/BalanceApi.kt
// Contract: null means an explicit no-record result, not a failed request.
data class BalanceDto(
    val accountId: String,
    val amountMinor: Long,
    val currency: String,
)

interface BalanceApi {
    suspend fun fetch(accountId: String): BalanceDto?
}

// data/RemoteBalanceRepository.kt
class RemoteBalanceRepository(
    private val api: BalanceApi,
) : BalanceRepository {
    override suspend fun read(accountId: String): BalanceResult {
        return try {
            val dto = api.fetch(accountId) ?: return BalanceResult.Empty
            if (dto.accountId != accountId ||
                !Regex("[A-Z]{3}").matches(dto.currency)
            ) {
                BalanceResult.Failed(BalanceFailure.INVALID_RESPONSE)
            } else {
                BalanceResult.Found(
                    Balance(dto.accountId, dto.amountMinor, dto.currency)
                )
            }
        } catch (cancelled: CancellationException) {
            throw cancelled
        } catch (_: Exception) {
            // Simplified teaching policy. Production adapters must distinguish
            // expected transport failures from defects and report safely.
            BalanceResult.Failed(BalanceFailure.UNAVAILABLE)
        }
    }
}

// app/composition/BalanceDependencies.kt
fun buildLoadBalance(api: BalanceApi): LoadBalance =
    LoadBalance(RemoteBalanceRepository(api))
```

**Hint:** a `suspend` function does not guarantee that its implementation avoids blocking. The actual API and storage adapters must use appropriate non-blocking APIs or injected dispatchers. Do not wrap every layer in a new coroutine scope.

</TabItem>
<TabItem label="iOS">

### Domain, data adapter, and explicit composition

```swift
import Foundation

// Domain/Balance.swift
struct Balance: Equatable, Sendable {
    let accountID: String
    let amountMinor: Int64
    let currency: String
}

enum BalanceFailure: Equatable, Sendable {
    case invalidAccount
    case invalidResponse
    case unavailable
}

enum BalanceResult: Equatable, Sendable {
    case found(Balance)
    case empty
    case failed(BalanceFailure)
}

// Domain/BalanceRepository.swift
protocol BalanceRepository: Sendable {
    func read(accountID: String) async throws -> BalanceResult
}

// Domain/LoadBalance.swift
struct LoadBalance: Sendable {
    let repository: any BalanceRepository

    func callAsFunction(accountID: String) async throws -> BalanceResult {
        try Task.checkCancellation()
        guard !accountID.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty else {
            return .failed(.invalidAccount)
        }
        return try await repository.read(accountID: accountID)
    }
}

// Data/BalanceAPI.swift
struct BalanceDTO: Sendable {
    let accountID: String
    let amountMinor: Int64
    let currency: String
}

protocol BalanceAPI: Sendable {
    // nil represents an explicit no-record response.
    func fetch(accountID: String) async throws -> BalanceDTO?
}

// Data/RemoteBalanceRepository.swift
struct RemoteBalanceRepository: BalanceRepository {
    let api: any BalanceAPI

    func read(accountID: String) async throws -> BalanceResult {
        do {
            try Task.checkCancellation()
            let response = try await api.fetch(accountID: accountID)
            try Task.checkCancellation()
            guard let dto = response else { return .empty }
            let isCurrencyShapeValid = dto.currency.utf8.count == 3 &&
                dto.currency.utf8.allSatisfy { (65...90).contains($0) }
            guard dto.accountID == accountID, isCurrencyShapeValid else {
                return .failed(.invalidResponse)
            }
            return .found(Balance(
                accountID: dto.accountID,
                amountMinor: dto.amountMinor,
                currency: dto.currency
            ))
        } catch {
            if error is CancellationError || Task.isCancelled {
                throw CancellationError()
            }
            // Simplified policy. Classify actual transport errors in production.
            return .failed(.unavailable)
        }
    }
}

// App/Composition/BalanceDependencies.swift
func buildLoadBalance(api: any BalanceAPI) -> LoadBalance {
    LoadBalance(repository: RemoteBalanceRepository(api: api))
}
```

**Hint:** `Sendable` defines a concurrency boundary; it does not move work to a background thread. Keep concrete dependencies safe under that boundary rather than adding unchecked conformance to silence diagnostics. Presentation owns its UI actor isolation.

</TabItem>
<TabItem label="React Native">

### Domain, data adapter, and explicit composition

```typescript
// domain/balance.ts
export type Balance = Readonly<{
  accountId: string;
  amountMinor: number;
  currency: string;
}>;

export type BalanceFailure =
  | 'invalidAccount'
  | 'invalidResponse'
  | 'unavailable';

export type BalanceResult =
  | { kind: 'found'; balance: Balance }
  | { kind: 'empty' }
  | { kind: 'failed'; reason: BalanceFailure };

// domain/balanceRepository.ts
export interface BalanceRepository {
  read(accountId: string, signal: AbortSignal): Promise<BalanceResult>;
}

function checkCancellation(signal: AbortSignal): void {
  if (signal.aborted) {
    const error = new Error('Operation cancelled');
    error.name = 'AbortError';
    throw error;
  }
}

// domain/loadBalance.ts
export type LoadBalance = (
  accountId: string,
  signal: AbortSignal,
) => Promise<BalanceResult>;

export function buildLoadBalance(repository: BalanceRepository): LoadBalance {
  return async (accountId, signal) => {
    checkCancellation(signal);
    if (accountId.trim().length === 0) {
      return { kind: 'failed', reason: 'invalidAccount' };
    }
    return repository.read(accountId, signal);
  };
}

// data/balanceApi.ts
export type BalanceDto = Readonly<{
  accountId: string;
  amountMinor: number;
  currency: string;
}>;

export interface BalanceApi {
  // null represents an explicit no-record response.
  // The transport adapter must validate untrusted JSON before returning a DTO.
  fetch(accountId: string, signal: AbortSignal): Promise<BalanceDto | null>;
}

// data/remoteBalanceRepository.ts
export function makeBalanceRepository(api: BalanceApi): BalanceRepository {
  return {
    async read(accountId, signal) {
      checkCancellation(signal);
      try {
        const dto = await api.fetch(accountId, signal);
        checkCancellation(signal);
        if (dto === null) return { kind: 'empty' };
        if (
          dto.accountId !== accountId ||
          !Number.isSafeInteger(dto.amountMinor) ||
          !/^[A-Z]{3}$/.test(dto.currency)
        ) {
          return { kind: 'failed', reason: 'invalidResponse' };
        }
        return { kind: 'found', balance: { ...dto } };
      } catch (error: unknown) {
        checkCancellation(signal);
        if (error instanceof Error && error.name === 'AbortError') throw error;
        // Simplified policy. Classify actual transport errors in production.
        return { kind: 'failed', reason: 'unavailable' };
      }
    },
  };
}

// app/composition/dependencies.ts
export function makeBalanceDependencies(api: BalanceApi) {
  return { loadBalance: buildLoadBalance(makeBalanceRepository(api)) };
}
```

**Hint:** JavaScript numbers cannot represent every 64-bit integer exactly. This example accepts only safe integers. If the API supports larger amounts, agree a string/decimal representation and conversion policy; do not silently coerce them to `number`.

Inject `loadBalance` into the established Redux Toolkit async coordination, for example through typed thunk extra arguments. Keep service instances outside serializable Redux state. A thunk's cancellation signal must reach the operation, and reducers must guard request identity and account scope before accepting results. The full store, slice, thunk, hooks, and screen belong together in the React Native implementation guide.

</TabItem>
</Tabs>

### Understand the example's limits

The three examples share outcome semantics but use platform-appropriate numeric and cancellation types. A three-uppercase-letter currency check validates shape, not membership in an approved currency list. Negative amounts may be legitimate depending on product rules; the example does not invent a non-negative requirement.

The broad error mapping is deliberately simplified. Production adapters should classify expected failures, preserve cancellation, and report unexpected defects through privacy-safe diagnostics. Do not label every defect a network outage.

## 6. Define the presentation contract

The state owner translates the result into UI state. It should not expose a DTO, database row, or exception directly to the screen.

| Outcome | Presentation responsibility |
| :--- | :--- |
| **Found** | Format the amount with the correct currency rules and locale. |
| **Empty** | Show the agreed no-record state. Do not display a failed request as a zero balance. |
| **Failed** | Map the typed reason to a safe localized message and an appropriate action. |
| **Cancelled** | End obsolete work without displaying a spurious error. |
| **Obsolete result** | Ignore it when its request or session is no longer current. |

A feature that keeps cached content during refresh needs a state model that represents both content and refresh status. Avoid replacing a valid balance with a full-screen loader on every refresh unless that is the intended experience.

## 7. Keep cache and session behavior explicit

Before adding persistence, define:

1. Whether reads return a snapshot or observe a stream.
2. Which source is authoritative and what freshness means.
3. Whether offline display is permitted for this data classification.
4. How records are keyed by account and invalidated.
5. What logout does to subscriptions, requests, cache writers, and stored data.
6. How a response arriving after logout is prevented from repopulating cleared storage.

The balance adapters above do not provide these behaviors. Add them as a reviewed data policy, not as hidden side effects in a screen or mapper.

## 8. Test the contract at meaningful boundaries

Use this common test matrix on all platforms:

| Case | Expected assertion |
| :--- | :--- |
| Blank account ID | Invalid-account result and repository not called. |
| Valid record | Exact account, amount, and currency mapped correctly. |
| Explicit no record | Empty outcome, distinct from failure and zero balance. |
| Account mismatch | Invalid-response outcome. |
| Invalid currency shape | Invalid-response outcome. |
| Transport failure | Defined failure classification without sensitive message leakage. |
| Cancellation | Cancellation propagates rather than becoming unavailable. |
| Obsolete response | State owner rejects it after a newer request or session change. |
| Large amount | Platform representation policy is enforced, including TypeScript safe-integer checks. |

Use fakes at contracts for domain tests and controlled transport/storage doubles for adapter tests. Do not require live APIs or real credentials for these assertions. Verify concrete integration separately.

Coverage must meet the defined 100% scope and metrics, with production files accounted for. The full Testing & Quality example supplies platform-specific test harnesses, commands, and report enforcement. This page's matrix is not a claim that those tests have been executed.

## 9. Avoid unnecessary architectural machinery

| Temptation | Prefer |
| :--- | :--- |
| One pass-through use case for every getter. | A use case when it names an application operation or owns meaningful coordination/policy. |
| A generic repository exposing arbitrary CRUD for every entity. | Contracts expressing the feature's actual needs. |
| A global service locator inside domain functions. | Explicit constructor or function dependencies. |
| DTOs shared through every layer. | Domain models and deliberate boundary mapping. |
| Separate modules for every small class. | Module boundaries that enforce useful ownership and dependency rules. |
| Identical folders on every platform. | Equivalent responsibilities implemented with supported platform conventions. |

## 10. Review before integration

- [ ] Domain code depends on contracts rather than concrete UI, network, or storage frameworks.
- [ ] Composition supplies concrete implementations outside feature business rules.
- [ ] Transport data is validated and mapped before presentation.
- [ ] Empty, zero, failure, and cancellation have distinct meanings.
- [ ] Numeric and currency policies match the actual service contract.
- [ ] State and session guards reject obsolete results.
- [ ] Cache, offline, and cleanup behavior are explicit when present.
- [ ] Tests cover contract outcomes and integration boundaries.
- [ ] Actual SDK APIs and toolchain compatibility are confirmed in the platform guide.

