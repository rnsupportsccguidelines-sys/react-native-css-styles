import React, { createContext, useContext, type ReactNode } from 'react';
import { View, Text, ActivityIndicator, StyleSheet } from 'react-native';
import { useFoundationsReady } from './useFoundationsReady';

const FoundationsContext = createContext<boolean>(false);

export function FoundationsProvider({ children }: { readonly children: ReactNode }) {
  const { isReady, error } = useFoundationsReady();

  if (error) {
    return (
      <View style={styles.errorContainer}>
        <Text style={styles.errorTitle}>Foundation Initialization Failure</Text>
        <Text style={styles.errorMessage}>{error.message}</Text>
      </View>
    );
  }

  if (!isReady) {
    return (
      <View style={styles.splashContainer}>
        <ActivityIndicator size="large" color="#22c55e" />
      </View>
    );
  }

  return (
    <FoundationsContext.Provider value={isReady}>
      {children}
    </FoundationsContext.Provider>
  );
}

export function useFoundations(): boolean {
  return useContext(FoundationsContext);
}

