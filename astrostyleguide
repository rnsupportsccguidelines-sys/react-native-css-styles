    end

    subgraph GatewayLayer ["TRUEFOUNDRY MCP GATEWAY (mcp-gateway.enterprise.internal)"]
        SSEListener["Server-Sent Events (SSE) Listener<br/>/sse/bitrise"]
        AuthModule["Enterprise Access &amp; Governance<br/>access.enterprise.internal Entitlement"]
        AuthOverride["User Auth Override Vault<br/>Bitrise Personal Access Token (PAT) / CIMD"]
        
