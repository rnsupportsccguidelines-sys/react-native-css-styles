### BUSINESS USE CASE: `feature/user/domain/usecase/GetUserProfileUseCase.kt`

```kotlin
package com.enterprise.mobile.feature.user.domain.usecase

import com.enterprise.mobile.feature.user.domain.model.UserDomainModel
import com.enterprise.mobile.feature.user.domain.repository.UserRepository
import javax.inject.Inject

/**
 * Profile use case exposing observation and refresh with identifier validation.
 * Isolated from Android framework and presentation dependencies.
 */
class GetUserProfileUseCase @Inject constructor(
    private val userRepository: UserRepository
) {
    fun observe(userId: String): kotlinx.coroutines.flow.Flow<UserDomainModel?> {
        require(userId.isNotBlank()) { "User ID must not be blank." }
        return userRepository.observeUserProfile(userId.trim())
    }

    suspend fun refresh(userId: String): Result<Unit> {
        if (userId.isBlank()) {
            return Result.failure(IllegalArgumentException("User ID must not be blank."))
        }
        return userRepository.refreshUserProfile(userId.trim())
    }
}
