/**
 * Stateful Route Composable: Coordinates ViewModel, lifecycle-aware state collection,
 * and high-level navigation callbacks.
 */
@Composable
fun UserProfileRoute(
    userId: String,
    onNavigateBack: () -> Unit,
    modifier: Modifier = Modifier,
    viewModel: UserProfileViewModel = hiltViewModel()
) {
    val uiState by viewModel.uiState.collectAsStateWithLifecycle()

