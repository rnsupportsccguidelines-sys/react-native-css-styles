```kotlin
package com.enterprise.mobile.core.branding

import android.content.ComponentName
import android.content.Context
import android.content.pm.PackageManager
import kotlinx.coroutines.CoroutineDispatcher
import kotlinx.coroutines.sync.Mutex
import kotlinx.coroutines.sync.withLock
import kotlinx.coroutines.withContext

enum class AppBrand(val aliasClass: String) {
    CORE("com.enterprise.mobile.LauncherCore"),
    PARTNER("com.enterprise.mobile.LauncherPartner"),
}

class DynamicIconManager(
    context: Context,
    private val ioDispatcher: CoroutineDispatcher,
) {
    private val appContext = context.applicationContext
    private val mutex = Mutex()

    suspend fun apply(brand: AppBrand) = withContext(ioDispatcher) {
        mutex.withLock {
            val manager = appContext.packageManager
            // Enable the target first. A later failure must not remove every entry point.
            manager.setComponentEnabledSetting(
                ComponentName(appContext.packageName, brand.aliasClass),
                PackageManager.COMPONENT_ENABLED_STATE_ENABLED,
                PackageManager.DONT_KILL_APP,
            )
            AppBrand.values().filter { it != brand }.forEach { other ->
                manager.setComponentEnabledSetting(
                    ComponentName(appContext.packageName, other.aliasClass),
                    PackageManager.COMPONENT_ENABLED_STATE_DISABLED,
                    PackageManager.DONT_KILL_APP,
                )
            }
        }
    }
}
```

