### Unleash Service Implementation (`src/core/flags/UnleashService.ts`)

```typescript
import { UnleashClient } from 'unleash-proxy-client';
import AsyncStorage from '@react-native-async-storage/async-storage';
import { AppState, AppStateStatus } from 'react-native';

export class UnleashService {
  private static instance: UnleashClient | null = null;

  static initialize(userId: string, appVersion: string): UnleashClient {
    if (!this.instance) {
      this.instance = new UnleashClient({
        url: 'https://flags.enterprise.com/proxy',
        clientKey: process.env.EXPO_PUBLIC_UNLEASH_CLIENT_KEY ?? '',
        appName: 'enterprise-mobile-app',
        refreshInterval: 15,
        storageProvider: {
          save: (name: string, data: any) => AsyncStorage.setItem(name, JSON.stringify(data)),
          get: async (name: string) => {
            const data = await AsyncStorage.getItem(name);
            return data ? JSON.parse(data) : undefined;
          },
        },
        context: {
          userId,
          appName: 'enterprise-mobile-app',
          environment: __DEV__ ? 'development' : 'production',
          properties: {
            appVersion,
            platform: 'react-native',
          },
        },
      });

      this.instance.start();

      AppState.addEventListener('change', (nextState: AppStateStatus) => {
        if (nextState === 'active' && this.instance) {
          this.instance.updateContext({ userId });
        }
      });
    }

    return this.instance;
  }

  static isEnabled(flagName: string, fallback = false): boolean {
    if (!this.instance) return fallback;
    return this.instance.isEnabled(flagName);
  }
}
```

