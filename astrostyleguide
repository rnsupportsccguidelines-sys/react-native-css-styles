### Initializing Core SDKs in Your App Entry Point

Bootstrap Identity, Telemetry, and Resilience at application startup:

#### React Native Entry Point (`App.tsx`)

```typescript
import React, { useEffect } from 'react';
import { SafeAreaView, StatusBar, Text } from 'react-native';
import { initializeEnterpriseAuth } from '@enterprise/identity-sso';
import { initializeDatadogRUM } from '@enterprise/telemetry';

export default function App() {
  useEffect(() => {
    // 1. Initialize Datadog Real User Monitoring
    initializeDatadogRUM({
      clientToken: 'pub_rum_prod_token_sample',
      applicationId: 'app_id_guid_enterprise',
      env: 'production',
      trackUserInteractions: true,
      trackFrustrations: true,
    });

    // 2. Initialize Single Sign-On (SSO) OAuth2 Configuration
    initializeEnterpriseAuth({
      clientId: 'mobile-client-01',
      issuer: 'https://sso.enterprise.internal/oauth2/v1',
      redirectUrl: 'com.enterprise.app://oauthredirect',
      scopes: ['openid', 'profile', 'email', 'offline_access'],
    });
  }, []);

  return (
    <SafeAreaView style={{ flex: 1, backgroundColor: '#0d1912' }}>
      <StatusBar barStyle="light-content" />
      <Text style={{ color: '#e2e8f0', padding: 20 }}>Enterprise Mobile Application Initialized</Text>
    </SafeAreaView>
  );
}
```

#### Android Native Entry Point (`MainApplication.kt`)

```kotlin
package com.enterprise.mobile

import android.app.Application
import com.enterprise.identity.EnterpriseAuth
import com.enterprise.telemetry.EnterpriseDatadogConfig
import com.enterprise.telemetry.EnterpriseTelemetry

class MainApplication : Application() {

    override fun onCreate() {
        super.onCreate()

        // 1. Initialize Enterprise Telemetry & RUM
        EnterpriseTelemetry.initialize(
            this,
            EnterpriseDatadogConfig(
                clientToken = "pub_rum_prod_token_sample",
                applicationId = "app_id_guid_enterprise",
                environment = "production",
                trackErrors = true
            )
        )

        // 2. Initialize Enterprise SSO Auth Session
        EnterpriseAuth.initialize(
            context = this,
            clientId = "mobile-android-client-01",
            discoveryUri = "https://sso.enterprise.internal/.well-known/openid-configuration"
        )
    }
}
```

