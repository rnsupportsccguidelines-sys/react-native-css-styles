// Ordinary application coordinator, NOT a UNNotificationServiceExtension.
@MainActor
final class NotificationService: NSObject, UNUserNotificationCenterDelegate {
    static let shared = NotificationService()
    private var pendingOpen = false
    // Configure from approved foreground preference. false prevents banners/sounds.
    var presentInForeground = false
    private override init() { super.init() }

    func installDelegate() {
        UNUserNotificationCenter.current().delegate = self
    }

    func requestPresentationPermission() async throws -> Bool {
        let center = UNUserNotificationCenter.current()
        let settings = await center.notificationSettings()
        if settings.authorizationStatus == .notDetermined {
            return try await center.requestAuthorization(options: [.alert, .sound, .badge])
        }
        return settings.authorizationStatus == .authorized ||
            settings.authorizationStatus == .provisional ||
            settings.authorizationStatus == .ephemeral
    }

    // Registration and presentation permission are distinct. Call through the
    // app's approved opt-in flow; OS registration may succeed without visible alerts.
    func registerForRemoteNotifications() {
        UIApplication.shared.registerForRemoteNotifications()
    }

    nonisolated func userNotificationCenter(
        _ center: UNUserNotificationCenter,
        willPresent notification: UNNotification
    ) async -> UNNotificationPresentationOptions {
        await MainActor.run {
            self.presentInForeground ? [.banner, .list, .sound] : []
        }
    }

    nonisolated func userNotificationCenter(
        _ center: UNUserNotificationCenter,
        didReceive response: UNNotificationResponse
    ) async {
        guard response.actionIdentifier == UNNotificationDefaultActionIdentifier else { return }
        // No URL/identifier from the payload is executed or passed to navigation.
        await MainActor.run { self.pendingOpen = true }
    }

    func consumeOpenIfReady(openAuthorizedUpdates: () -> Bool) {
        if pendingOpen && openAuthorizedUpdates() { pendingOpen = false }
    }

    func clearPendingOpen() { pendingOpen = false }
}
