import type { OrderOutcome, OrderRepository, OrderRequest } from './orderDomain';

export interface OrderApi {
  submit(request: OrderRequest): Promise<unknown>;
}
export function makeRemoteOrderRepository(api: OrderApi): OrderRepository {
  return {
    async place(request): Promise<OrderOutcome> {
      try {
        const response = await api.submit(request);
        if (typeof response !== 'object' || response === null
          || !('orderId' in response) || typeof response.orderId !== 'string'
          || !response.orderId.trim()) return { kind: 'unknown' };
        return { kind: 'confirmed', orderId: response.orderId };
      } catch {
        return { kind: 'unknown' };
      }
    },
  };
}
