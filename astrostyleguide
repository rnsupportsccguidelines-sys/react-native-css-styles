```kotlin
// File: feature/user/presentation/UserProfileViewModel.kt
package com.enterprise.mobile.feature.user.presentation

import androidx.lifecycle.ViewModel
import androidx.lifecycle.viewModelScope
import com.enterprise.mobile.feature.user.domain.usecase.GetUserProfileUseCase
import com.enterprise.mobile.feature.user.presentation.state.UserProfileUiEvent
import com.enterprise.mobile.feature.user.presentation.state.UserProfileUiState
import dagger.hilt.android.lifecycle.HiltViewModel
import kotlinx.coroutines.flow.MutableStateFlow
import kotlinx.coroutines.flow.StateFlow
import kotlinx.coroutines.flow.asStateFlow
import kotlinx.coroutines.launch
import javax.inject.Inject

@HiltViewModel
class UserProfileViewModel @Inject constructor(
    private val getUserProfileUseCase: GetUserProfileUseCase
) : ViewModel() {

    private val _uiState = MutableStateFlow<UserProfileUiState>(UserProfileUiState.Loading)
    val uiState: StateFlow<UserProfileUiState> = _uiState.asStateFlow()

    fun onEvent(event: UserProfileUiEvent) {
        when (event) {
            is UserProfileUiEvent.RefreshProfile -> fetchProfile(event.userId)
        }
    }

    private fun fetchProfile(userId: String) {
        viewModelScope.launch {
            _uiState.value = UserProfileUiState.Loading
            getUserProfileUseCase(userId)
                .onSuccess { domainUser ->
                    _uiState.value = UserProfileUiState.Success(user = domainUser)
                }
                .onFailure { error ->
                    _uiState.value = UserProfileUiState.Error(
                        errorMessage = error.localizedMessage ?: "Failed to retrieve user profile."
                    )
                }
        }
    }
}
