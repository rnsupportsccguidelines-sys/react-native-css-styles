### `PlaceChickenOrder.swift` — sample production boundary

```swift
import Foundation

struct ChickenItem: Sendable {
    let id: String
    let unitPriceMinor: Int64
    let available: Bool
}
struct OrderRequest: Sendable, Equatable {
    let requestId: String
    let itemId: String
    let quantity: Int
}
struct OrderReceipt: Sendable, Equatable { let orderId: String }
protocol OrderGateway: Sendable {
    func place(_ request: OrderRequest) async throws -> OrderReceipt
}
enum OrderFailure: Error, Equatable {
    case invalidItem, unavailable, invalidQuantity, invalidPrice, invalidTotal
    case invalidRequestId, alreadySubmitting, invalidReceipt
}

func quote(_ item: ChickenItem, quantity: Int) throws -> Int64 {
    if item.id.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty {
        throw OrderFailure.invalidItem
    }
    guard item.available else { throw OrderFailure.unavailable }
    guard (1...20).contains(quantity) else { throw OrderFailure.invalidQuantity }
    guard item.unitPriceMinor > 0 else { throw OrderFailure.invalidPrice }
    let (total, overflow) = item.unitPriceMinor.multipliedReportingOverflow(by: Int64(quantity))
    guard !overflow else { throw OrderFailure.invalidTotal }
    return total
}

// Retain one instance for the active order flow, not one per tap.
actor PlaceChickenOrder {
    private let gateway: any OrderGateway
    private var submitting = false
    init(gateway: any OrderGateway) { self.gateway = gateway }

    func place(_ item: ChickenItem, quantity: Int,
               requestId: String) async throws -> OrderReceipt {
        _ = try quote(item, quantity: quantity)
        guard !requestId.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty else {
            throw OrderFailure.invalidRequestId
        }
        guard !submitting else { throw OrderFailure.alreadySubmitting }
        submitting = true
        defer { submitting = false }
        let receipt = try await gateway.place(OrderRequest(
            requestId: requestId, itemId: item.id, quantity: quantity))
        guard !receipt.orderId.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty else {
            throw OrderFailure.invalidReceipt
        }
        return receipt
    }
}
```

