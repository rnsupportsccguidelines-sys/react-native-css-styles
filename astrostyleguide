### `feature/user/data/UserRepositoryImpl.kt`

```kotlin
package com.enterprise.mobile.feature.user.data

import com.enterprise.mobile.core.profile.EpochClock
import com.enterprise.mobile.core.profile.IoDispatcher
import com.enterprise.mobile.core.profile.ProfileSessionGuard
import com.enterprise.mobile.feature.user.data.local.UserDao
import com.enterprise.mobile.feature.user.data.mapper.toDomain
import com.enterprise.mobile.feature.user.data.mapper.toEntity
import com.enterprise.mobile.feature.user.data.remote.UserApiService
import com.enterprise.mobile.feature.user.domain.ProfileException
import com.enterprise.mobile.feature.user.domain.ProfileFailure
import com.enterprise.mobile.feature.user.domain.ProfileKey
import com.enterprise.mobile.feature.user.domain.UserDomainModel
import com.enterprise.mobile.feature.user.domain.UserRepository
import javax.inject.Inject
import kotlinx.coroutines.CancellationException
import kotlinx.coroutines.CoroutineDispatcher
import kotlinx.coroutines.currentCoroutineContext
import kotlinx.coroutines.ensureActive
import kotlinx.coroutines.withContext

class UserRepositoryImpl @Inject constructor(
    private val api: UserApiService,
    private val dao: UserDao,
    private val session: ProfileSessionGuard,
    private val clock: EpochClock,
    @IoDispatcher private val ioDispatcher: CoroutineDispatcher,
) : UserRepository {
    override suspend fun cachedProfile(key: ProfileKey): UserDomainModel? =
        withContext(ioDispatcher) {
            session.requireActiveAccount(key.accountId)
            val cached = try {
                dao.find(key.accountId, key.userId)
            } catch (cancelled: CancellationException) {
                throw cancelled
            } catch (_: Exception) {
                throw ProfileException(ProfileFailure.CACHE_ERROR)
            }
            currentCoroutineContext().ensureActive()
            session.requireActiveAccount(key.accountId)
            cached?.toDomain()
        }

    override suspend fun refreshProfile(key: ProfileKey): UserDomainModel =
        withContext(ioDispatcher) {
            try {
                currentCoroutineContext().ensureActive()
                session.requireActiveAccount(key.accountId)
                val response = api.fetchProfile(key.userId)
                currentCoroutineContext().ensureActive()
                when (response.code()) {
                    200 -> Unit
                    401 -> throw ProfileException(ProfileFailure.SESSION_EXPIRED)
                    403 -> throw ProfileException(ProfileFailure.ACCESS_DENIED)
                    404 -> throw ProfileException(ProfileFailure.NOT_FOUND)
                    else -> throw ProfileException(ProfileFailure.HTTP_ERROR)
                }
                val dto = response.body()
                    ?: throw ProfileException(ProfileFailure.INVALID_PAYLOAD)
                if (dto.id != key.userId || dto.fullName.isBlank()) {
                    throw ProfileException(ProfileFailure.INVALID_PAYLOAD)
                }
                session.requireActiveAccount(key.accountId)
                currentCoroutineContext().ensureActive()
                val entity = dto.toEntity(key, clock.nowMillis())
                try {
                    dao.upsert(entity)
                } catch (cancelled: CancellationException) {
                    throw cancelled
                } catch (_: Exception) {
                    throw ProfileException(ProfileFailure.CACHE_ERROR)
                }
                currentCoroutineContext().ensureActive()
                session.requireActiveAccount(key.accountId)
                entity.toDomain()
            } catch (cancelled: CancellationException) {
                throw cancelled
            } catch (failure: ProfileException) {
                if (failure.failure in ACCESS_FAILURES) {
                    try {
                        dao.delete(key.accountId, key.userId)
                    } catch (cancelled: CancellationException) {
                        throw cancelled
                    } catch (_: Exception) {
                        throw ProfileException(ProfileFailure.CACHE_INVALIDATION)
                    }
                }
                throw failure
            }
        }

    private companion object {
        val ACCESS_FAILURES = setOf(
            ProfileFailure.SESSION_EXPIRED,
            ProfileFailure.ACCESS_DENIED,
            ProfileFailure.NOT_FOUND,
        )
    }
}
```

<Aside type="tip" title="Hint · a failed refresh is still a failure">
Transport, serialization, and database failures propagate to presentation. The ViewModel can retain previously read content without claiming the refresh succeeded. HTTP 401, 403, and 404 are not automatically treated as network outages. Cancellation is rethrown; it never becomes a fallback success or error banner.
</Aside>

Successful refresh requires the upsert to complete. The returned value reflects the entity written by this operation; the example assumes no database trigger rewrites those fields. If database-derived values are required, read them back within an appropriate transaction.

The coroutine context is checked around suspension and persistence boundaries. Cancellation is cooperative: it does not undo a committed write. Account checks and account-scoped keys reduce cross-session mistakes, while the host remains responsible for session teardown and cache cleanup.

Concurrent callers can still write the same account/profile. Screen generation guards protect rendered state, not global freshness ordering. Use a server version, synchronization policy, or shared repository coordination if multiple writers must agree which response wins.

