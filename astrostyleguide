### React Native · initialized engine and Redux listener

`src/core/localization/languageCoordinator.ts`

```typescript
import { createInstance, type i18n } from 'i18next';
import { initReactI18next } from 'react-i18next';
import { resolveLanguage, type LanguagePreference } from './resolveLanguage';

export async function createLanguageEngine() {
  const engine = createInstance();
  await engine.use(initReactI18next).init({
    lng: 'en', fallbackLng: 'en', supportedLngs: ['en', 'ar'],
    interpolation: { escapeValue: false },
    resources: {
      en: { translation: { welcome: 'Welcome back, {{name}}' } },
      ar: { translation: { welcome: 'مرحبًا بك، {{name}}' } },
    },
  });
  return engine;
}

export class LanguageCoordinator {
  private queue: Promise<void> = Promise.resolve();
  constructor(readonly engine: i18n) {}

  apply(preference: LanguagePreference, systemTags: readonly string[]): Promise<void> {
    const language = resolveLanguage(preference, systemTags);
    const operation = this.queue.then(async () => { await this.engine.changeLanguage(language); });
    // Recover the internal queue, while the returned operation still rejects for callers.
    this.queue = operation.catch(() => undefined);
    return operation;
  }
}
```

Place the existing `resolveLanguage` function and its exported types in `src/core/localization/resolveLanguage.ts`.

`src/core/localization/localizationListener.ts`

```typescript
import { createListenerMiddleware } from '@reduxjs/toolkit';
import { languageChanged, localeStatusChanged, type FoundationState } from '../foundations/foundationSlice';
import type { LanguageCoordinator } from './languageCoordinator';

export function createLocalizationListener(
  coordinator: LanguageCoordinator,
  systemTags: () => readonly string[],
  reportFailure: (category: 'language-change') => void,
) {
  const listener = createListenerMiddleware<{ foundation: FoundationState }>();
  let generation = 0;
  listener.startListening({
    actionCreator: languageChanged,
    effect: async (action, api) => {
      const request = ++generation;
      try {
        await coordinator.apply(action.payload, systemTags());
        if (request === generation) api.dispatch(localeStatusChanged('ready'));
      } catch {
        if (request === generation) {
          api.dispatch(localeStatusChanged('error'));
          reportFailure('language-change');
        }
      }
    },
  });
  return listener;
}
```

**Hint:** Initialize the engine before mounting translated content, use `I18nextProvider` with that engine, and prepend the returned listener middleware to the existing Redux middleware chain. Dispatch `languageChanged` with the validated stored preference after startup; redispatch “system” when relevant OS-language settings change. Serialize engine changes, and use a generation guard for readiness so a late completion does not publish a stale status. `localeStatus` is transient and must not be persisted as a user preference. Native layout-direction changes still follow the documented platform restart/recreation policy.


