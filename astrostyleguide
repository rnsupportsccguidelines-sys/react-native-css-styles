/* ==========================================================================
   ENTERPRISE MOBILE ENGINEERING PLATFORM - COMMON STARLIGHT STYLESHEET
   Recommended Path: src/styles/mobile-portal.css
   Register in astro.config.mjs under starlight({ customCss: ['./src/styles/mobile-portal.css'] })
   ========================================================================== */

/* --------------------------------------------------------------------------
   1. FULL-WIDTH SCREEN EXPANSION (Eliminates artificial empty side gutters)
   -------------------------------------------------------------------------- */
:root {
  --sl-content-width: 100% !important;
  --sl-content-pad-x: 1.25rem !important;
}

main,
.main-pane,
.content-panel,
.sl-container,
.sl-markdown-content {
  max-width: 100% !important;
  width: 100% !important;
}

/* --------------------------------------------------------------------------
   2. HIGH-CONTRAST DUAL THEME TOKENS (Enterprise Dark Green & Crisp Light)
   -------------------------------------------------------------------------- */
:root[data-theme='dark'] {
  --sl-color-bg: #0d1912;
  --sl-color-bg-nav: #09130e;
  --sl-color-bg-sidebar: #09130e;
  --sl-color-bg-inline-code: #13251c;
  --sl-color-border: #1f3b2c;
  --sl-color-text: #e2e8f0;
  --sl-color-text-accent: #22c55e;
  
  --portal-gold: #f3d17b;
  --portal-card-bg: #13251c;
  --portal-card-border: #1f3b2c;
  --portal-text-body: #cbd5e1;
  --portal-text-muted: #9ca3af;
  --portal-pill-bg: #1a2e23;
  --portal-pill-border: rgba(255, 255, 255, 0.1);
  --portal-pill-text: #e2e8f0;
  --portal-accent: #22c55e;
  --portal-accent-hover: #4ade80;
}

:root, :root[data-theme='light'] {
  --sl-color-bg: #f8faf8;
  --sl-color-bg-nav: #ffffff;
  --sl-color-bg-sidebar: #f2f6f3;
  --sl-color-bg-inline-code: #edf4ee;
  --sl-color-border: #d4e2d8;
  --sl-color-text: #111827;
  --sl-color-text-accent: #007a3d;
  
  --portal-gold: #143823;
  --portal-card-bg: #ffffff;
  --portal-card-border: #d8e5dc;
  --portal-text-body: #1f2937;
  --portal-text-muted: #4b5563;
  --portal-pill-bg: #f0f7f2;
  --portal-pill-border: #cfe0d4;
  --portal-pill-text: #133824;
  --portal-accent: #007a3d;
  --portal-accent-hover: #005a2b;
}

/* --------------------------------------------------------------------------
   3. TYPOGRAPHY & TOC-COMPATIBLE HEADINGS
   -------------------------------------------------------------------------- */
:root[data-theme='dark'] #_top,
:root[data-theme='dark'] h1 {
  color: #f3d17b !important;
}

:root[data-theme='light'] #_top,
:root[data-theme='light'] h1 {
  color: #143823 !important;
}

.portal-section-heading,
.sl-markdown-content h2,
h2 {
  font-size: 1.35rem !important;
  font-weight: 800 !important;
  margin: 36px 0 8px 0 !important;
  border-bottom: none !important;
}
:root[data-theme='dark'] h2 { color: #f3d17b !important; }
:root[data-theme='light'] h2 { color: #143823 !important; }

.sl-markdown-content h3,
h3 {
  font-size: 1.08rem !important;
  font-weight: 700 !important;
  margin: 24px 0 6px 0 !important;
}
:root[data-theme='dark'] h3 { color: #e2e8f0 !important; }
:root[data-theme='light'] h3 { color: #143823 !important; }

.portal-section-sub {
  font-size: 0.92rem;
  color: var(--portal-text-muted);
  margin: 0 0 18px 0;
  line-height: 1.5;
}

/* --------------------------------------------------------------------------
   4. HERO ORIENTATION & TOPOLOGY CARD
   -------------------------------------------------------------------------- */
.portal-hero-card {
  background: var(--portal-card-bg);
  border: 1px solid var(--portal-card-border);
  border-radius: 12px;
  padding: 20px 24px;
  margin: 16px 0 28px 0;
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.05);
  width: 100%;
  box-sizing: border-box;
}

.portal-hero-topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 12px;
  margin-bottom: 10px;
}

.portal-badge-hub {
  background: rgba(34, 197, 94, 0.15);
  color: var(--portal-accent);
  border: 1px solid rgba(34, 197, 94, 0.35);
  font-size: 0.75rem;
  font-weight: 700;
  padding: 3px 10px;
  border-radius: 4px;
  letter-spacing: 0.06em;
}

.portal-hub-tag {
  font-size: 0.78rem;
  font-weight: 700;
  color: var(--portal-accent);
  letter-spacing: 0.05em;
}

.portal-hero-title {
  font-size: 1.35rem;
  font-weight: 800;
  color: var(--portal-gold);
  margin: 0 0 8px 0;
  line-height: 1.3;
}

.portal-hero-desc {
  font-size: 0.94rem;
  color: var(--portal-text-body);
  line-height: 1.55;
  margin: 0 0 16px 0;
}

.portal-caps-bar {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12px;
  padding-top: 16px;
  border-top: 1px solid var(--portal-card-border);
  width: 100%;
}
@media (max-width: 900px) { .portal-caps-bar { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 520px) { .portal-caps-bar { grid-template-columns: 1fr; } }

.portal-cap-item {
  background: var(--portal-pill-bg);
  border: 1px solid var(--portal-card-border);
  border-radius: 8px;
  padding: 10px 12px;
}

.portal-cap-title {
  font-size: 0.85rem;
  font-weight: 700;
  color: var(--portal-gold);
  margin-bottom: 3px;
}

.portal-cap-desc {
  font-size: 0.78rem;
  color: var(--portal-text-body);
  line-height: 1.4;
}

/* --------------------------------------------------------------------------
   5. MERMAID DIAGRAM CENTERING & RESPONSIVE CLAMPING
   -------------------------------------------------------------------------- */
.starlight-mermaid,
pre.mermaid,
.mermaid,
div.mermaid {
  display: flex !important;
  justify-content: center !important;
  align-items: center !important;
  width: 100% !important;
  margin: 16px 0 28px 0 !important;
  padding: 16px 10px !important;
  overflow-x: auto !important;
  background: transparent !important;
  box-sizing: border-box !important;
}

.starlight-mermaid svg,
pre.mermaid svg,
.mermaid svg,
svg[id^="mermaid"] {
  display: block !important;
  margin: 0 auto !important;
  max-width: 680px !important;
  width: 100% !important;
  height: auto !important;
}

/* --------------------------------------------------------------------------
   6. 2-COLUMN WIDE CARDS GRID (Supports both portal-cards and portal-routes)
   -------------------------------------------------------------------------- */
.portal-cards-grid,
.portal-routes-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16px;
  margin: 16px 0 28px 0;
  width: 100%;
  box-sizing: border-box;
}
@media (max-width: 768px) {
  .portal-cards-grid,
  .portal-routes-grid {
    grid-template-columns: 1fr;
  }
}

.portal-card,
.portal-route-card {
  background: var(--portal-card-bg);
  border: 1px solid var(--portal-card-border);
  border-radius: 12px;
  padding: 16px 20px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
  transition: transform 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
  box-sizing: border-box;
}

.portal-card:hover,
.portal-route-card:hover {
  transform: translateY(-2px);
  border-color: var(--portal-accent);
  box-shadow: 0 6px 20px rgba(0, 0, 0, 0.1);
}

.portal-card-full,
.portal-route-card-full {
  grid-column: span 2;
}
@media (max-width: 768px) {
  .portal-card-full,
  .portal-route-card-full {
    grid-column: span 1;
  }
}

.portal-card-topbar,
.portal-route-topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10px;
}

.portal-card-icon,
.portal-route-icon {
  width: 32px;
  height: 32px;
  border-radius: 6px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
}

/* Badge Accent Colors */
.badge-green  { background: #22c55e; }
.badge-purple { background: #8b5cf6; }
.badge-coral  { background: #f87171; }
.badge-amber  { background: #f59e0b; }
.badge-teal   { background: #06b6d4; }
.badge-blue   { background: #3b82f6; }

.portal-tag-pill {
  font-size: 0.72rem;
  font-weight: 700;
  color: var(--portal-accent);
  background: rgba(34, 197, 94, 0.12);
  border: 1px solid rgba(34, 197, 94, 0.3);
  padding: 2px 8px;
  border-radius: 4px;
  letter-spacing: 0.05em;
}

.portal-card-title,
.portal-route-title {
  font-size: 1.1rem;
  font-weight: 700;
  color: var(--portal-gold);
  margin: 0 0 6px 0;
  line-height: 1.3;
}

.portal-card-desc,
.portal-route-desc {
  font-size: 0.88rem;
  color: var(--portal-text-body);
  line-height: 1.45;
  margin: 0 0 12px 0;
}

.portal-card-pills {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-bottom: 12px;
}

.portal-card-pills span {
  font-size: 0.74rem;
  background: var(--portal-pill-bg);
  border: 1px solid var(--portal-pill-border);
  padding: 3px 8px;
  border-radius: 6px;
  color: var(--portal-pill-text);
  font-weight: 600;
}

.portal-card-action,
.portal-route-action {
  padding-top: 10px;
  border-top: 1px solid var(--portal-card-border);
  display: flex;
  justify-content: flex-end;
}

.portal-card-link,
.portal-route-link {
  color: var(--portal-accent) !important;
  font-size: 0.84rem;
  font-weight: 700;
  text-decoration: none !important;
  display: inline-flex;
  align-items: center;
  gap: 4px;
  transition: transform 0.15s ease, color 0.15s ease;
}

.portal-card-link:hover,
.portal-route-link:hover {
  color: var(--portal-accent-hover) !important;
  transform: translateX(2px);
}

/* --------------------------------------------------------------------------
   7. RELEASE GATES SEQUENTIAL BAR
   -------------------------------------------------------------------------- */
.portal-gates-container {
  background: var(--portal-card-bg);
  border: 1px solid var(--portal-card-border);
  border-radius: 12px;
  padding: 18px 20px;
  margin: 16px 0 28px 0;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
  width: 100%;
  box-sizing: border-box;
}

.portal-gates-flow {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 8px;
  margin: 12px 0;
}

.portal-gate-node {
  background: var(--portal-pill-bg);
  border: 1px solid var(--portal-card-border);
  border-radius: 8px;
  padding: 8px 12px;
  text-align: center;
  flex: 1;
  min-width: 120px;
}

.portal-gate-title {
  font-size: 0.82rem;
  font-weight: 700;
  color: var(--portal-gold);
}

.portal-gate-sub {
  font-size: 0.72rem;
  color: var(--portal-text-muted);
  margin-top: 2px;
}

.portal-gate-arrow {
  color: var(--portal-accent);
  font-weight: 800;
  font-size: 1rem;
}

/* --------------------------------------------------------------------------
   8. COMPLETION CHECKLIST & CALLOUT BOX
   -------------------------------------------------------------------------- */
.portal-checklist-box,
.portal-alert-box {
  background: var(--portal-pill-bg);
  border: 1px solid var(--portal-card-border);
  border-left: 4px solid var(--portal-accent);
  border-radius: 8px;
  padding: 18px 20px;
  margin: 28px 0 20px 0;
  width: 100%;
  box-sizing: border-box;
}

.portal-checklist-title,
.portal-alert-title {
  font-size: 0.88rem;
  font-weight: 800;
  color: var(--portal-gold);
  letter-spacing: 0.04em;
  margin-bottom: 8px;
}

.portal-checklist-box p,
.portal-alert-box p {
  font-size: 0.86rem;
  color: var(--portal-text-body);
  margin: 0 0 10px 0;
}

.portal-checklist-box ul,
.portal-alert-box ul {
  margin: 0;
  padding-left: 20px;
}

.portal-checklist-box li,
.portal-alert-box li {
  font-size: 0.85rem;
  color: var(--portal-text-body);
  margin-bottom: 6px;
  line-height: 1.5;
}

.portal-checklist-box li strong,
.portal-alert-box li strong {
  color: var(--portal-accent);
}

/* --------------------------------------------------------------------------
   10. ROOT OVERVIEW DIRECTORY GRID & PILL LINKS (portal-overview.mdx)
   -------------------------------------------------------------------------- */
.portal-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18px;
  margin-bottom: 36px;
  width: 100%;
  box-sizing: border-box;
}
@media (max-width: 1100px) {
  .portal-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}
@media (max-width: 700px) {
  .portal-grid {
    grid-template-columns: 1fr;
  }
}

.portal-hero-icon {
  width: 28px;
  height: 28px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--portal-accent);
}

.portal-hero-sub {
  font-size: 0.88rem;
  color: var(--portal-text-body);
  margin: 0;
}

.portal-icon-badge {
  width: 36px;
  height: 36px;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 14px;
  color: #ffffff;
}

.badge-rose { background: #f43f5e; }

.portal-pills {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px 10px;
  margin-bottom: 16px;
}

.portal-pill-link {
  background: var(--portal-pill-bg);
  border: 1px solid var(--portal-pill-border);
  border-radius: 6px;
  padding: 8px 10px;
  color: var(--portal-pill-text) !important;
  text-decoration: none !important;
  font-size: 0.78rem;
  font-weight: 500;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  display: block;
  transition: all 0.15s ease;
}

.portal-pill-link:hover {
  background: var(--portal-pill-hover);
  border-color: var(--portal-accent);
  color: #ffffff !important;
}

.portal-card-foot {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  padding-top: 10px;
  border-top: 1px solid var(--portal-card-border);
}

.portal-view-link {
  color: var(--portal-accent) !important;
  font-size: 0.82rem;
  font-weight: 600;
  text-decoration: none !important;
  display: inline-flex;
  align-items: center;
  gap: 4px;
  transition: transform 0.15s ease, color 0.15s ease;
}

.portal-view-link:hover {
  color: var(--portal-accent-hover) !important;
  transform: translateX(2px);
}

