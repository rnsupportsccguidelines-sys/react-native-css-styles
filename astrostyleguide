### `order-store.ts` — actual Redux Toolkit state integration

The store rejects repeated dispatch while submitting and prevents automatic repeat after confirmation or an unknown outcome. It intentionally provides no arbitrary reset/retry action; reconciliation/new-order lifecycle needs the real product contract. This guard is in-memory and still requires durable request identity for restart safety.

```typescript
import { configureStore, createAsyncThunk, createSlice } from '@reduxjs/toolkit';
import { ChickenItem, PlaceChickenOrder, quote } from './place-order';

type OrderState = {
  status: 'idle' | 'submitting' | 'confirmed' | 'invalid' | 'unknown';
  orderId: string | null;
  error: string | null;
};
const initialState: OrderState = { status: 'idle', orderId: null, error: null };
type Input = { item: ChickenItem; quantity: number; requestId: string };

export const submitOrder = createAsyncThunk<
  { orderId: string }, Input,
  { state: { order: OrderState }; extra: { service: PlaceChickenOrder }; rejectValue: { kind: "invalid" | "unknown"; message: string } }
>('order/submit', async (input, { extra, rejectWithValue }) => {
  // Classify only validation performed before any submission as safe to correct.
  try {
    quote(input.item, input.quantity);
    if (!input.requestId.trim()) throw new Error('invalid-request-id');
  } catch (error) {
    return rejectWithValue({ kind: 'invalid', message:
      error instanceof Error ? error.message : 'invalid-input' });
  }
  try {
    return await extra.service.place(input.item, input.quantity, input.requestId);
  } catch {
    // Do not classify gateway outcome by its message: an unknown write may exist.
    return rejectWithValue({ kind: 'unknown', message: 'outcome-unknown' });
  }
}, {
  condition: (_, { getState }) => ['idle', 'invalid'].includes(getState().order.status),
});

const slice = createSlice({
  name: 'order', initialState, reducers: {},
  extraReducers: builder => {
    builder.addCase(submitOrder.pending, state => {
      state.status = 'submitting'; state.orderId = null; state.error = null;
    }).addCase(submitOrder.fulfilled, (state, action) => {
      state.status = 'confirmed'; state.orderId = action.payload.orderId;
    }).addCase(submitOrder.rejected, (state, action) => {
      const failure = action.payload ?? { kind: 'unknown', message: 'outcome-unknown' };
      state.status = failure.kind === 'invalid' ? 'invalid' : 'unknown';
      state.orderId = null; state.error = failure.message;
    });
  },
});

export function makeOrderStore(service: PlaceChickenOrder) {
  return configureStore({
    reducer: { order: slice.reducer },
    middleware: getDefault => getDefault({ thunk: { extraArgument: { service } } }),
  });
}
```

