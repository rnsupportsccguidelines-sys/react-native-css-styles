### AWS SNS Java Service Implementation (`NotificationUtil.java`)
Enterprise microservices communicate with Amazon Simple Notification Service (SNS) to route notifications to Apple APNs and Firebase FCM:

```java
package com.enterprise.mobile.backend.notification;

import com.amazonaws.services.sns.AmazonSNS;
import com.amazonaws.services.sns.AmazonSNSClientBuilder;
import com.amazonaws.services.sns.model.*;
import com.fasterxml.jackson.databind.ObjectMapper;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.stereotype.Component;

import javax.annotation.PostConstruct;
import java.util.HashMap;
import java.util.Map;

@Component
public class NotificationUtil {

    private static final Logger LOGGER = LoggerFactory.getLogger(NotificationUtil.class);
    private AmazonSNS snsClient;
    private final ObjectMapper objectMapper = new ObjectMapper();

    @Value("${aws.region:us-east-1}")
    private String awsRegion;

    @Value("${aws.sns.platform.app.arn.android}")
    private String androidPlatformAppArn;

    @Value("${aws.sns.platform.app.arn.ios}")
    private String iosPlatformAppArn;

    @PostConstruct
    public void init() {
        this.snsClient = AmazonSNSClientBuilder.standard()
                .withRegion(awsRegion)
                .build();
    }

    /**
     * Creates an AWS SNS Platform Endpoint for a mobile device token.
     * Gracefully recovers existing endpoint ARN if the token was previously registered.
     */
    public String createPlatformEndpoint(String deviceToken, String deviceType) {
        String platformAppArn = "ios".equalsIgnoreCase(deviceType) ? iosPlatformAppArn : androidPlatformAppArn;

        try {
            CreatePlatformEndpointRequest request = new CreatePlatformEndpointRequest()
                    .withPlatformApplicationArn(platformAppArn)
                    .withToken(deviceToken);

            CreatePlatformEndpointResult result = snsClient.createPlatformEndpoint(request);
            LOGGER.info("Created SNS endpoint: {}", result.getEndpointArn());
            return result.getEndpointArn();

        } catch (InvalidParameterException e) {
            String message = e.getMessage();
            LOGGER.warn("Device token already registered. Extracting existing endpoint from exception: {}", message);

            // Pattern match: "Endpoint already exists: <endpointArn>"
            java.util.regex.Pattern pattern = java.util.regex.Pattern.compile(".*Endpoint (arn:aws:sns[^ ]+) already exists.*");
            java.util.regex.Matcher matcher = pattern.matcher(message);
            if (matcher.find()) {
                return matcher.group(1);
            }
            throw e;
        }
    }

    /**
     * Publishes direct push notification JSON payload to a specific device endpoint ARN.
     */
    public void publishToDevice(String endpointArn, String title, String body, String orderId, String deviceType) throws Exception {
        Map<String, Object> rootMessage = new HashMap<>();

        if ("ios".equalsIgnoreCase(deviceType)) {
            // Apple APNs Payload
            Map<String, Object> aps = new HashMap<>();
            Map<String, String> alert = new HashMap<>();
            alert.put("title", title);
            alert.put("body", body);
            aps.put("alert", alert);
            aps.put("badge", 1);
            aps.put("sound", "default");

            Map<String, Object> apnsPayload = new HashMap<>();
            apnsPayload.put("aps", aps);
            apnsPayload.put("orderId", orderId);

            rootMessage.put("APNS", objectMapper.writeValueAsString(apnsPayload));
        } else {
            // Android FCM Payload
            Map<String, Object> fcmPayload = new HashMap<>();
            Map<String, String> data = new HashMap<>();
            data.put("title", title);
            data.put("body", body);
            data.put("orderId", orderId);
            fcmPayload.put("data", data);

            rootMessage.put("GCM", objectMapper.writeValueAsString(fcmPayload));
        }

        rootMessage.put("default", body);

        PublishRequest publishRequest = new PublishRequest()
                .withTargetArn(endpointArn)
                .withMessageStructure("json")
                .withMessage(objectMapper.writeValueAsString(rootMessage));

        PublishResult result = snsClient.publish(publishRequest);
        LOGGER.info("Successfully dispatched push. Message ID: {}", result.getMessageId());
    }
}
