/* 1. Collapse large space between title and description */
.portal-route-title,
.sl-markdown-content h3.portal-route-title {
  margin: 6px 0 4px 0 !important;
  line-height: 1.3 !important;
}
.portal-route-desc,
.sl-markdown-content p.portal-route-desc {
  margin: 4px 0 14px 0 !important;
  line-height: 1.45 !important;
}
/* 2. Format pills with badges and spacing */
.portal-route-pills {
  display: flex !important;
  flex-wrap: wrap !important;
  gap: 8px !important;
  margin-bottom: 14px !important;
}
.portal-route-pills span {
  font-size: 0.74rem !important;
  background: var(--portal-pill-bg, #1a2e23) !important;
  border: 1px solid var(--portal-pill-border, rgba(255, 255, 255, 0.12)) !important;
  padding: 3px 8px !important;
  border-radius: 6px !important;
  color: var(--portal-pill-text, #e2e8f0) !important;
  font-weight: 600 !important;
  display: inline-block !important;
  line-height: 1.4 !important;
}
