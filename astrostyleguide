### Self-Contained Kotlin Circuit Breaker

```kotlin
package com.enterprise.mobile.core.resilience

import kotlinx.coroutines.sync.Mutex
import kotlinx.coroutines.sync.withLock

enum class BreakerState { CLOSED, OPEN, HALF_OPEN }

class CircuitBreaker(
    private val failureThreshold: Int = 3,
    private val resetTimeoutMs: Long = 30000L
) {
    private val mutex = Mutex()
    private var state = BreakerState.CLOSED
    private var failureCount = 0
    private var lastFailureTime = 0L

    suspend fun <T> execute(
        action: suspend () -> T,
        fallback: suspend (Throwable) -> T
    ): T {
        val currentState = mutex.withLock {
            if (state == BreakerState.OPEN && System.currentTimeMillis() - lastFailureTime > resetTimeoutMs) {
                state = BreakerState.HALF_OPEN
            }
            state
        }

        if (currentState == BreakerState.OPEN) {
            return fallback(IllegalStateException("Circuit Breaker is OPEN"))
        }

        return try {
            val result = action()
            mutex.withLock {
                if (state == BreakerState.HALF_OPEN) {
                    state = BreakerState.CLOSED
                    failureCount = 0
                }
            }
            result
        } catch (t: Throwable) {
            mutex.withLock {
                failureCount++
                lastFailureTime = System.currentTimeMillis()
                if (failureCount >= failureThreshold) {
                    state = BreakerState.OPEN
                }
            }
            fallback(t)
        }
    }
}
```

