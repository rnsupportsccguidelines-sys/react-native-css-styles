import XCTest
@testable import MyChickenApp // Replace with the actual product module.

private actor FakeOrderGateway: OrderGateway {
    enum Mode: Sendable { case success, failure, empty, suspended }
    enum ServiceFailure: Error { case unavailable }
    private(set) var calls: [OrderRequest] = []
    private let mode: Mode
    private var pending: CheckedContinuation<OrderReceipt, any Error>?
    private var startedWaiters: [CheckedContinuation<Void, Never>] = []
    init(_ mode: Mode = .success) { self.mode = mode }

    func place(_ request: OrderRequest) async throws -> OrderReceipt {
        calls.append(request)
        switch mode {
        case .success: return OrderReceipt(orderId: "order-001")
        case .failure: throw ServiceFailure.unavailable
        case .empty: return OrderReceipt(orderId: " ")
        case .suspended:
            return try await withCheckedThrowingContinuation { continuation in
                pending = continuation
                startedWaiters.forEach { $0.resume() }
                startedWaiters.removeAll()
            }
        }
    }
    func waitUntilStarted() async {
        if pending != nil { return }
        await withCheckedContinuation { startedWaiters.append($0) }
    }
    func finish() {
        pending?.resume(returning: OrderReceipt(orderId: "order-001"))
        pending = nil
    }
}

@MainActor
