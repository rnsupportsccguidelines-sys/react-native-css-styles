// File: feature/user/domain/usecase/GetUserProfileUseCase.kt
package com.enterprise.mobile.feature.user.domain.usecase

import com.enterprise.mobile.feature.user.domain.model.UserDomainModel
import com.enterprise.mobile.feature.user.domain.repository.UserRepository
import javax.inject.Inject

/**
 * Single-responsibility use case executing business validation.
 */
class GetUserProfileUseCase @Inject constructor(
    private val userRepository: UserRepository
) {
    suspend operator fun invoke(userId: String): Result<UserDomainModel> {
        if (userId.isBlank()) {
            return Result.failure(IllegalArgumentException("User ID must not be empty."))
        }
        return userRepository.getUserProfile(userId)
    }
}
