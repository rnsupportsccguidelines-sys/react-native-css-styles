### iOS · APNs intent validation and notification delegate

`Core/Push/PushIntent.swift`

```swift
import Foundation

struct PushIntent: Decodable, Sendable {
    struct Destination: Decodable, Sendable {
        enum Kind: String, Decodable, Sendable { case home, order }
        let kind: Kind
        let orderId: String?
    }
    let version: Int
    let eventId: String
    let expiresAtMillis: Int64
    let destination: Destination
}

func decodePushIntent(_ raw: Any?, now: Date = .now) -> PushIntent? {
    guard let text = raw as? String, text.utf8.count <= 8192,
          text.utf16.count <= 2048,
          let data = text.data(using: .utf8),
          let intent = try? JSONDecoder().decode(PushIntent.self, from: data),
          intent.version == 1,
          Double(intent.expiresAtMillis) > now.timeIntervalSince1970 * 1000 else { return nil }
    func validID(_ value: String) -> Bool {
        let bytes = value.utf8
        return (1...128).contains(bytes.count) && bytes.allSatisfy {
            (65...90).contains($0) || (97...122).contains($0) ||
            (48...57).contains($0) || $0 == 95 || $0 == 45
        }
    }
    guard validID(intent.eventId) else { return nil }
    if intent.destination.kind == .order {
        guard let id = intent.destination.orderId, validID(id) else { return nil }
    }
    return intent
}
```

`Core/Push/PushNotificationCoordinator.swift`

The async delegate methods below require the corresponding supported OS baseline (iOS 15+). This suite's iOS feature baseline is iOS 17+. As in the iOS standards page, value types/decoders assume nonisolated default actor isolation; the UI coordinator explicitly uses `@MainActor`.

```swift
import Foundation
import UIKit
import UserNotifications

@MainActor
protocol PushRouting: AnyObject {
    func received(_ intent: PushIntent)
    func opened(_ intent: PushIntent) async throws
    func reportFailure(_ category: String)
}

@MainActor
final class PushNotificationCoordinator: NSObject, UNUserNotificationCenterDelegate {
    private let router: any PushRouting
    init(router: any PushRouting) { self.router = router }

    func installDelegate() {
        UNUserNotificationCenter.current().delegate = self
    }

    // Invoke from the product's contextual permission flow, not on every appearance.
    func requestAlertPermission() async throws -> Bool {
        let granted = try await UNUserNotificationCenter.current()
            .requestAuthorization(options: [.alert, .badge, .sound])
        if granted { UIApplication.shared.registerForRemoteNotifications() }
        return granted
    }

    nonisolated func userNotificationCenter(
        _ center: UNUserNotificationCenter,
        willPresent notification: UNNotification
    ) async -> UNNotificationPresentationOptions {
        guard let intent = decodePushIntent(notification.request.content.userInfo["intent"]) else { return [] }
        await received(intent)
        return [.banner, .sound]
    }

    nonisolated func userNotificationCenter(
        _ center: UNUserNotificationCenter,
        didReceive response: UNNotificationResponse
    ) async {
        guard let intent = decodePushIntent(response.notification.request.content.userInfo["intent"]) else { return }
        if response.actionIdentifier == UNNotificationDismissActionIdentifier { return }
        // Add a separate allowlisted mapping if the product defines custom actions.
        guard response.actionIdentifier == UNNotificationDefaultActionIdentifier else { return }
        await opened(intent)
    }

    private func received(_ intent: PushIntent) {
        router.received(intent)
    }
    private func opened(_ intent: PushIntent) async {
        do { try await router.opened(intent) }
        catch is CancellationError { return }
        catch { router.reportFailure("notification-routing") }
    }
}
```

**Hint:** Retain the coordinator at app lifetime, install its delegate before notifications need handling, and forward APNs registration success/failure from the app delegate to the approved token-registration adapter. Initial launch, scene readiness, background updates, and rich-media extensions require their own supported app/scene callbacks; they converge on the same validated router. Permission denial is a supported state, not an exception to loop-prompt. This sample chooses banners for valid foreground notifications; apply your actual privacy and foreground presentation policy.


### React Native · Firebase modular adapter and background entry point

`src/core/push/firebasePushAdapter.ts`

Use the modular API when supported by the installed React Native Firebase version. If another library owns notification interaction events, route its documented callbacks through this same adapter boundary rather than assuming both libraries emit the same tap events.

```typescript
import {
  getMessaging, getInitialNotification, onMessage,
  onNotificationOpenedApp, onTokenRefresh, setBackgroundMessageHandler,
} from '@react-native-firebase/messaging';
import type { PushAdapter } from './attachPushListeners';
import { parsePushIntent, type PushIntent } from './pushIntent';

export class FirebasePushAdapter implements PushAdapter {
  onForeground(handler: (intent: PushIntent) => void): () => void {
    return onMessage(getMessaging(), (message) => {
      const intent = parsePushIntent(message.data?.intent, Date.now());
      if (intent) handler(intent);
    });
  }
  onOpened(handler: (intent: PushIntent) => void): () => void {
    return onNotificationOpenedApp(getMessaging(), (message) => {
      const intent = parsePushIntent(message.data?.intent, Date.now());
      if (intent) handler(intent);
    });
  }
  async initialIntent(): Promise<PushIntent | null> {
    const message = await getInitialNotification(getMessaging());
    return parsePushIntent(message?.data?.intent, Date.now());
  }
}

export function attachTokenRotation(queueSync: (token: string) => void): () => void {
  return onTokenRefresh(getMessaging(), queueSync);
}

// Call from the JS entry point before AppRegistry.registerComponent.
export function registerBackgroundPushReceiver(
  receive: (intent: PushIntent) => Promise<void>,
  reportFailure: (category: 'background-push') => void,
): void {
  setBackgroundMessageHandler(getMessaging(), async (message) => {
    const intent = parsePushIntent(message.data?.intent, Date.now());
    if (!intent) return;
    try { await receive(intent); }
    catch { reportFailure('background-push'); }
  });
}
```

**Hint:** Complete native capabilities/configuration and permission handling before expecting delivery. Register the initial device token with the backend as well as subscribing to rotation; the rotation callback is not an initial-registration API. `queueSync` must be non-blocking and non-throwing. Background receipt may reconcile approved data; it must not navigate or depend on a mounted React screen. Create subscriptions once at the appropriate app/session root and retain their cleanup functions. See [React Native Firebase messaging](https://rnfirebase.io/messaging/usage).


