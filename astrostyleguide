### The Enterprise Dangerfile Rules (`Dangerfile.ts`)

Danger runs automatically on every Bitrise PR build. Ensure your PR complies with these programmatic checks:

```typescript
import { danger, warn, fail, message } from 'danger';

// 1. Enforce changelog update for any non-trivial PR
const hasCodeChanges = danger.git.modified_files.some(f => f.startsWith('src/') || f.startsWith('app/'));
const hasChangelog = danger.git.modified_files.includes('CHANGELOG.md');

if (hasCodeChanges && !hasChangelog) {
  warn('Please add a summary of your changes to CHANGELOG.md.');
}

// 2. Validate Conventional Commit message formatting
const validPrefixes = ['feat:', 'fix:', 'docs:', 'refactor:', 'test:', 'chore:'];
const commitSubject = danger.github.pr.title;
const isValidTitle = validPrefixes.some(prefix => commitSubject.startsWith(prefix));

if (!isValidTitle) {
  fail(`PR title must follow Conventional Commits (e.g., 'feat: add user profile' or 'fix: resolve crash').`);
}

// 3. Monitor bundle size and large PR warning
const totalLinesChanged = danger.github.pr.additions + danger.github.pr.deletions;
if (totalLinesChanged > 600) {
  warn(`This PR is large (${totalLinesChanged} lines). Consider breaking it into smaller reviewable units.`);
}
```

