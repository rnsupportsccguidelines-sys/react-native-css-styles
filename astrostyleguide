### Implementing State Modeling (TypeScript Example)

Every screen model must be expressed as an immutable, discriminated state union to eliminate undefined or conflicting intermediate UI states:

```typescript
// 1. Define explicit, exhaustive UI state variants
export type ScreenState<T> =
  | { status: 'idle' }
  | { status: 'loading' }
  | { status: 'success'; data: T; isStaleFromCache: boolean }
  | { status: 'error'; message: string; canRetry: boolean };

// 2. Define user actions (Intents)
export type OrderAction =
  | { type: 'FETCH_ORDERS' }
  | { type: 'REFRESH_ORDERS' }
  | { type: 'CANCEL_ORDER'; orderId: string };

// 3. State Reducer (Guarantees predictable state transitions)
export function orderReducer<T>(state: ScreenState<T>, action: OrderAction): ScreenState<T> {
  switch (action.type) {
    case 'FETCH_ORDERS':
      return { status: 'loading' };
    case 'REFRESH_ORDERS':
      // Preserve existing data while refreshing in background
      return state.status === 'success' ? state : { status: 'loading' };
    default:
      return state;
  }
}
```

