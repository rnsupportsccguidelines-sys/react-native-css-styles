## The Golden Rule: Never Block the Main Thread

On mobile platforms, the **Main Thread (UI Thread)** is solely responsible for rendering frames at 60Hz (16.6ms per frame) or 120Hz (8.3ms per frame) and responding to user gestures. 

If your code executes heavy loops, synchronous JSON parsing, or network calls on the main thread:
* **On Android:** Triggers an **ANR (Application Not Responding)** dialog after 5 seconds, prompting the user to force-close the app.
* **On iOS:** Triggers the system **Watchdog timer**, which abruptly terminates the application process.

### Concurrency Code Patterns Across Stacks

#### 1. React Native (TypeScript): Offloading Heavy Calculations

In React Native, JavaScript runs on its own engine thread, while native rendering occurs on the UI thread. However, long-running JavaScript synchronous loops will freeze user gesture responses:

```typescript
import React, { useState, useTransition } from 'react';
import { View, Text, FlatList, TextInput, ActivityIndicator, StyleSheet } from 'react-native';

export function SearchableDirectory({ dataset }: { dataset: Array<{ id: string; name: string }> }) {
  const [query, setQuery] = useState('');
  const [filteredData, setFilteredData] = useState(dataset);
  const [isPending, startTransition] = useTransition();

  const handleSearch = (text: string) => {
    setQuery(text);

    // Non-blocking transition: preserves instant typing responsiveness on UI thread
    startTransition(() => {
      const lower = text.toLowerCase();
      const results = dataset.filter(item => item.name.toLowerCase().includes(lower));
      setFilteredData(results);
    });
  };

  return (
    <View style={styles.container}>
      <TextInput
        value={query}
        onChangeText={handleSearch}
        placeholder="Search enterprise directory..."
        placeholderTextColor="#9ca3af"
        style={styles.input}
      />
      {isPending && <ActivityIndicator color="#22c55e" style={styles.loader} />}
      <FlatList
        data={filteredData}
        keyExtractor={item => item.id}
        renderItem={({ item }) => <Text style={styles.itemText}>{item.name}</Text>}
      />
    </View>
  );
}

const styles = StyleSheet.create({
  container: { flex: 1, padding: 16, backgroundColor: '#0d1912' },
  input: { height: 44, borderColor: '#1f3b2c', borderWidth: 1, borderRadius: 8, paddingHorizontal: 12, color: '#e2e8f0' },
  loader: { marginVertical: 8 },
  itemText: { paddingVertical: 10, borderBottomWidth: 1, borderBottomColor: '#1f3b2c', color: '#cbd5e1' },
});
```

#### 2. Native Android (Kotlin Coroutines): Dispatcher Switching

Android uses Coroutines to cleanly move work between threads. Always switch to `Dispatchers.IO` for network or disk operations:

```kotlin
package com.enterprise.mobile.feature.orders

import androidx.lifecycle.ViewModel
import androidx.lifecycle.viewModelScope
import kotlinx.coroutines.Dispatchers
import kotlinx.coroutines.flow.MutableStateFlow
import kotlinx.coroutines.flow.StateFlow
import kotlinx.coroutines.flow.asStateFlow
import kotlinx.coroutines.launch
import kotlinx.coroutines.withContext

sealed interface OrderUiState {
    object Loading : OrderUiState
    data class Success(val orders: List<Order>) : OrderUiState
    data class Error(val message: String) : OrderUiState
}

class OrdersViewModel(
    private val repository: OrderRepository
) : ViewModel() {

    private val _uiState = MutableStateFlow<OrderUiState>(OrderUiState.Loading)
    val uiState: StateFlow<OrderUiState> = _uiState.asStateFlow()

    fun fetchOrders() {
        viewModelScope.launch {
            _uiState.value = OrderUiState.Loading
            try {
                // withContext(Dispatchers.IO) ensures network work runs off the Main Thread
                val orderList = withContext(Dispatchers.IO) {
                    repository.getOrdersFromRemote()
                }
                // Automatically resumes on Main Thread to safely update state
                _uiState.value = OrderUiState.Success(orderList)
            } catch (e: Exception) {
                _uiState.value = OrderUiState.Error(e.localizedMessage ?: "Network request failed")
            }
        }
    }
}
```

#### 3. Native iOS (Swift & SwiftUI): Structured Concurrency & `@MainActor`

In modern Swift, annotate UI view models with `@MainActor` to guarantee that all UI updates are marshaled to the main thread:

```swift
import SwiftUI

enum ViewState<T> {
    case loading
    case success(T)
    case error(String)
}

@MainActor
final class OrdersViewModel: ObservableObject {
    @Published private(set) var state: ViewState<[Order]> = .loading
    private let service: OrderServiceProtocol

    init(service: OrderServiceProtocol = OrderService()) {
        self.service = service
    }

    func loadOrders() async {
        state = .loading
        do {
            // Asynchronous network call executes on background thread pool
            let orders = try await service.fetchOrders()
            // MainActor guarantees state assignment occurs on the Main Thread
            self.state = .success(orders)
        } catch {
            self.state = .error(error.localizedDescription)
        }
    }
}
```

