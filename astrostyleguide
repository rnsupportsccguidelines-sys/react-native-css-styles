---
interface Props {
  title?: string;
  id?: string;
}

const { title = "ARCHITECTURE DIAGRAM", id } = Astro.props;
const uniqueId = id || `diagram-${Math.random().toString(36).slice(2, 9)}`;
---

<div class="mermaid-premium-container" id={uniqueId}>
  <!-- COMPACT HEADER -->
  <div class="mermaid-header">
    <div class="mermaid-title-wrap">
      <span class="mermaid-badge">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
          <polyline points="2 17 12 22 22 17"></polyline>
          <polyline points="2 12 12 17 22 12"></polyline>
        </svg>
        DIAGRAM
      </span>
      <span class="mermaid-title">{title}</span>
    </div>

    <div class="mermaid-toolbar">
      <button type="button" class="mermaid-btn btn-zoom-out" title="Zoom Out (-)" aria-label="Zoom Out">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
      </button>

      <span class="mermaid-zoom-indicator" title="Click to Reset View">100%</span>

      <button type="button" class="mermaid-btn btn-zoom-in" title="Zoom In (+)" aria-label="Zoom In">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
          <line x1="12" y1="5" x2="12" y2="19"></line>
          <line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
      </button>

      <div class="mermaid-divider"></div>

      <button type="button" class="mermaid-btn btn-reset" title="Reset View (100%)" aria-label="Reset View">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
          <path d="M3 3v5h5"></path>
        </svg>
      </button>

      <div class="mermaid-divider"></div>

      <!-- Expand Button into Top-Layer Popup -->
      <button type="button" class="mermaid-btn btn-expand-modal" title="Expand Fullscreen Popup" aria-label="Expand Fullscreen Popup">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"></path>
        </svg>
        <span>Expand</span>
      </button>
    </div>
  </div>

  <!-- COMPACT VIEWPORT: Naturally hugs the diagram without tall empty gaps -->
  <div class="mermaid-viewport">
    <div class="mermaid-canvas">
      <slot />
    </div>

    <div class="mermaid-tip">
      Click + / − to zoom &bull; Click Expand for full popup
    </div>
  </div>

  <!-- NATIVE TOP-LAYER POPUP DIALOG (Guaranteed ABOVE website sticky topbars) -->
  <dialog class="mermaid-modal" id={`${uniqueId}-modal`}>
    <div class="modal-header">
      <div class="modal-title-wrap">
        <span class="mermaid-badge">EXPANDED VIEW</span>
        <span class="modal-title">{title}</span>
      </div>

      <div class="modal-controls">
        <div class="mermaid-toolbar">
          <button type="button" class="mermaid-btn modal-btn-zoom-out" title="Zoom Out (-)" aria-label="Zoom Out">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
          </button>
          <span class="mermaid-zoom-indicator modal-zoom-indicator" title="Reset View">100%</span>
          <button type="button" class="mermaid-btn modal-btn-zoom-in" title="Zoom In (+)" aria-label="Zoom In">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
              <line x1="12" y1="5" x2="12" y2="19"></line>
              <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
          </button>
          <div class="mermaid-divider"></div>
          <button type="button" class="mermaid-btn modal-btn-reset" title="Reset View" aria-label="Reset View">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
              <path d="M3 3v5h5"></path>
            </svg>
          </button>
        </div>

        <!-- HIGH-VISIBILITY CLOSE BUTTON: ALWAYS VISIBLE ON TOP -->
        <button type="button" class="btn-close-modal" title="Close Popup (Esc)" aria-label="Close Popup">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
          <span>Close (Esc)</span>
        </button>
      </div>
    </div>

    <!-- MODAL VIEWPORT FOR DRAG & UNBOUNDED ZOOM -->
    <div class="modal-viewport">
      <!-- The canvas moves here dynamically upon opening -->
      <div class="modal-floating-tip">
        Click &amp; Drag to pan &bull; Mouse wheel to zoom &bull; Press Esc to close
      </div>
    </div>
  </dialog>
</div>

