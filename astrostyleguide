import Foundation

/// Boundary contract defining user data operations.
/// The domain layer owns this protocol; the data layer implements it.
public protocol UserRepository: Sendable {
    /// Retrieves user profile by ID, executing local cache lookup with network fallback.
    func fetchUserProfile(userId: String) async throws -> UserDomainModel

    /// Observes real-time persistent user changes using Swift AsyncStream.
    func observeUserProfile(userId: String) -> AsyncStream<UserDomainModel?>
}
