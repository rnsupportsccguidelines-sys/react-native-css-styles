## 2. Production Reference: List API Fetch & Corresponding Test Suites

Below is the complete reference implementation for fetching and displaying a list of items (`/api/v1/orders`), paired with its exact corresponding unit test file across all three mobile runtimes:

<Tabs>
  <TabItem label="Android (Kotlin & Coroutines)">
    ### 1. Feature Implementation Code (`OrderListFeature.kt`)
    ```kotlin
    package com.enterprise.mobile.feature.orderlist

    import androidx.lifecycle.ViewModel
    import androidx.lifecycle.viewModelScope
    import kotlinx.coroutines.flow.MutableStateFlow
    import kotlinx.coroutines.flow.StateFlow
    import kotlinx.coroutines.flow.asStateFlow
    import kotlinx.coroutines.launch
    import retrofit2.http.GET

    // 1. Data Model
    data class OrderItem(
        val id: String,
        val title: String,
        val status: String,
        val amountCents: Long
    )

    // 2. Retrofit API Service
    interface OrderListApiService {
        @GET("api/v1/orders")
        suspend fun fetchOrders(): List<OrderItem>
    }

    // 3. Repository Interface & Implementation
    interface OrderListRepository {
        suspend fun getOrders(): Result<List<OrderItem>>
    }

    class OrderListRepositoryImpl(
        private val apiService: OrderListApiService
    ) : OrderListRepository {
        override suspend fun getOrders(): Result<List<OrderItem>> = runCatching {
            apiService.fetchOrders()
        }
    }

    // 4. UI State
    sealed interface OrderListUiState {
        object Loading : OrderListUiState
        data class Success(val orders: List<OrderItem>) : OrderListUiState
        data class Error(val message: String) : OrderListUiState
    }

    // 5. ViewModel Calling API and Holding List
    class OrderListViewModel(
        private val repository: OrderListRepository
    ) : ViewModel() {

        private val _uiState = MutableStateFlow<OrderListUiState>(OrderListUiState.Loading)
        val uiState: StateFlow<OrderListUiState> = _uiState.asStateFlow()

        fun loadOrders() {
            viewModelScope.launch {
                _uiState.value = OrderListUiState.Loading
                repository.getOrders()
                    .onSuccess { items ->
                        _uiState.value = OrderListUiState.Success(items)
                    }
                    .onFailure { throwable ->
                        _uiState.value = OrderListUiState.Error(
                            throwable.localizedMessage ?: "Failed to load orders"
                        )
                    }
            }
        }
    }
    ```

    ### 2. Test File Implementation (`OrderListViewModelTest.kt`)
    ```kotlin
    package com.enterprise.mobile.feature.orderlist

    import app.cash.turbine.test
    import io.kotest.matchers.shouldBe
    import io.kotest.matchers.types.shouldBeInstanceOf
    import io.mockk.coEvery
    import io.mockk.coVerify
    import io.mockk.mockk
    import kotlinx.coroutines.Dispatchers
    import kotlinx.coroutines.ExperimentalCoroutinesApi
    import kotlinx.coroutines.test.StandardTestDispatcher
    import kotlinx.coroutines.test.resetMain
    import kotlinx.coroutines.test.runTest
    import kotlinx.coroutines.test.setMain
    import org.junit.jupiter.api.AfterEach
    import org.junit.jupiter.api.BeforeEach
    import org.junit.jupiter.api.DisplayName
    import org.junit.jupiter.api.Test

    @OptIn(ExperimentalCoroutinesApi::class)
    class OrderListViewModelTest {

        private val testDispatcher = StandardTestDispatcher()
        private val repository: OrderListRepository = mockk()
        private lateinit var viewModel: OrderListViewModel

        @BeforeEach
        fun setUp() {
            Dispatchers.setMain(testDispatcher)
            viewModel = OrderListViewModel(repository)
        }

        @AfterEach
        fun tearDown() {
            Dispatchers.resetMain()
        }

        @Test
        @DisplayName("Given successful API fetch, ViewModel emits Loading then Success with order list")
        fun loadOrders_success_emitsOrdersList() = runTest(testDispatcher) {
            // Arrange: Mock API response returning a list of 2 items
            val mockItems = listOf(
                OrderItem("ORD-101", "Bulk Grain Shipment", "CONFIRMED", 125000L),
                OrderItem("ORD-102", "Feed Ingredients Batch A", "PENDING", 48000L)
            )
            coEvery { repository.getOrders() } returns Result.success(mockItems)

            // Act & Assert via Turbine
            viewModel.uiState.test {
                // Initial state
                awaitItem() shouldBe OrderListUiState.Loading

                viewModel.loadOrders()

                // Terminal Success state with parsed list
                val result = awaitItem()
                result.shouldBeInstanceOf<OrderListUiState.Success>()
                val success = result as OrderListUiState.Success
                success.orders.size shouldBe 2
                success.orders[0].id shouldBe "ORD-101"
                success.orders[0].status shouldBe "CONFIRMED"

                cancelAndIgnoreRemainingEvents()
            }

            coVerify(exactly = 1) { repository.getOrders() }
        }

        @Test
        @DisplayName("Given API error 500, ViewModel emits Loading then Error with message")
        fun loadOrders_failure_emitsErrorState() = runTest(testDispatcher) {
            // Arrange
            val errorMsg = "HTTP 500 Internal Server Error"
            coEvery { repository.getOrders() } returns Result.failure(RuntimeException(errorMsg))

            // Act & Assert
            viewModel.uiState.test {
                awaitItem() shouldBe OrderListUiState.Loading

                viewModel.loadOrders()

                val result = awaitItem()
                result.shouldBeInstanceOf<OrderListUiState.Error>()
                (result as OrderListUiState.Error).message shouldBe errorMsg

                cancelAndIgnoreRemainingEvents()
            }

            coVerify(exactly = 1) { repository.getOrders() }
        }
    }
    ```
