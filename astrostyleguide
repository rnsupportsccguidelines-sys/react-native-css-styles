    id: 'enterprise_core',
    name: 'Enterprise Core',
    primaryColor: '#007a3d',
    iconName: null,
  },
  {
    id: 'enterprise_vip',
    name: 'VIP Gold',
    primaryColor: '#d97706',
    iconName: 'VIP',
  },
];

const BrandContext = createContext<{
  brand: BrandConfig;
  switchBrand: (brand: BrandConfig) => Promise<void>;
}>({
  brand: AVAILABLE_BRANDS[0],
  switchBrand: async () => {},
});

export function BrandProvider({ children }: { readonly children: ReactNode }) {
  const [brand, setBrand] = useState<BrandConfig>(AVAILABLE_BRANDS[0]);

  const switchBrand = async (newBrand: BrandConfig) => {
    setBrand(newBrand);
  };

  return (
    <BrandContext.Provider value={{ brand, switchBrand }}>
      {children}
    </BrandContext.Provider>
  );
}

export function useBrand(): BrandConfig {
  return useContext(BrandContext).brand;
}
