### `orderCore.ts` — domain, repository, API port, and fake composition

```typescript
// domain/order.ts — example-owned types, not an enterprise HTTP schema.
export type OrderRequest = Readonly<{
  accountId: string;
  requestId: string;
  itemId: string;
  quantity: number;
}>;
export type OrderResult =
  | Readonly<{ kind: 'confirmed'; orderId: string }>
  | Readonly<{ kind: 'invalid' }>
  | Readonly<{ kind: 'unknown' }>;
export interface OrderRepository {
  place(request: OrderRequest): Promise<OrderResult>;
}

// domain/placeChickenOrder.ts
export function placeChickenOrder(repository: OrderRepository) {
  return async (request: OrderRequest): Promise<OrderResult> => {
    if (![request.accountId, request.requestId, request.itemId].every(id => id.trim().length > 0)
      || !Number.isInteger(request.quantity)
      || request.quantity < 1 || request.quantity > 20) {
      return { kind: 'invalid' };
    }
    return repository.place(request);
  };
}

// data/orderApi.ts — inject a fake or an approved real transport adapter.
export interface OrderApi {
  submit(request: OrderRequest): Promise<unknown>;
}

// repository/remoteOrderRepository.ts
export function remoteOrderRepository(api: OrderApi): OrderRepository {
  return {
    async place(request) {
      try {
        const response = await api.submit(request);
        if (typeof response !== 'object' || response === null
          || !('orderId' in response)
          || typeof response.orderId !== 'string'
          || response.orderId.trim().length === 0) {
          return { kind: 'unknown' };
        }
        return { kind: 'confirmed', orderId: response.orderId };
      } catch {
        // Conservative: no approved rejection / reconciliation contract is supplied.
        return { kind: 'unknown' };
      }
    },
  };
}

// Application composition — synthetic test/demo only. No network call.
export function makeDemoPlaceOrder() {
  const api: OrderApi = {
    submit: async () => ({ orderId: 'order-001' }),
  };
  return placeChickenOrder(remoteOrderRepository(api));
}
```

### `orderStore.ts` — Redux Toolkit coordination

Place beside `orderCore.ts` for this grouped example. In the real application, keep the slice in `ui/` and import only the required domain types and injected operation. See the [Redux Toolkit usage guide](https://redux.js.org/toolkit/usage/usage-guide).

```typescript
import { configureStore, createAsyncThunk, createSlice } from '@reduxjs/toolkit';
import type { PayloadAction } from '@reduxjs/toolkit';
import type { OrderRequest, OrderResult } from './orderCore';

type OrderState = {
  accountId: string | null;
  activeRequestId: string | null;
  status: 'idle' | 'submitting' | 'confirmed' | 'invalid' | 'unknown';
  orderId: string | null;
};
type Dependencies = {
  placeOrder: (request: OrderRequest) => Promise<OrderResult>;
};
const initialState: OrderState = {
  accountId: null, activeRequestId: null, status: 'idle', orderId: null,
};
export const submitOrder = createAsyncThunk<
  OrderResult, OrderRequest,
  { state: { order: OrderState }; extra: Dependencies }
>('order/submit', (request, { extra }) => extra.placeOrder(request), {
  condition: (request, { getState }) => {
    const state = getState().order;
    return state.accountId === request.accountId
      && (state.status === 'idle' || state.status === 'invalid');
  },
});
const slice = createSlice({
  name: 'order', initialState,
  reducers: {
    // Call only from the established session owner. Not a resubmit/reset button.
    accountChanged: (_state, action: PayloadAction<string | null>): OrderState => ({
      ...initialState, accountId: action.payload,
    }),
  },
  extraReducers: builder => builder
    .addCase(submitOrder.pending, (state, action) => {
      state.status = 'submitting';
      state.activeRequestId = action.meta.requestId;
      state.orderId = null;
    })
    .addCase(submitOrder.fulfilled, (state, action) => {
      if (state.accountId !== action.meta.arg.accountId
        || state.activeRequestId !== action.meta.requestId) return;
      state.status = action.payload.kind;
      state.orderId = action.payload.kind === 'confirmed' ? action.payload.orderId : null;
      state.activeRequestId = null;
    })
    .addCase(submitOrder.rejected, (state, action) => {
      if (state.accountId !== action.meta.arg.accountId
        || state.activeRequestId !== action.meta.requestId) return;
      state.status = 'unknown';
      state.activeRequestId = null;
    }),
});
export const { accountChanged } = slice.actions;
export function makeOrderStore(dependencies: Dependencies) {
  return configureStore({
    reducer: { order: slice.reducer },
    middleware: getDefaultMiddleware => getDefaultMiddleware({
      thunk: { extraArgument: dependencies },
    }),
  });
}
```

### Connect the synthetic operation

This integration fragment runs against the fake, not a live backend. Keep the store instance stable; do not recreate it on every render.

```typescript
import { makeDemoPlaceOrder } from './orderCore';
import { accountChanged, makeOrderStore, submitOrder } from './orderStore';

const store = makeOrderStore({ placeOrder: makeDemoPlaceOrder() });
store.dispatch(accountChanged('demo-account'));
await store.dispatch(submitOrder({
  accountId: 'demo-account',
  requestId: 'demo-request',
  itemId: 'chicken-grilled',
  quantity: 2,
}));
// Expected: status === 'confirmed', orderId === 'order-001'.
```

The slice blocks another submission while submitting, after confirmation, or with an unknown outcome. It also ignores stale results after account changes. `action.meta.requestId` is Redux Toolkit's execution identity, separate from the business `requestId` supplied in the request.

There is deliberately no Retry or New Order reset action. Add one only after the approved order/reconciliation lifecycle is defined. `accountChanged` belongs to the session owner, not a button used to bypass submission protection.

</TabItem>
