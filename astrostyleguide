import Foundation

/// Type-safe HTTP endpoint builder conforming to internal network standards.
public struct UserEndpoint: Sendable {
    public static func userProfileRequest(userId: String, baseURL: URL) -> URLRequest {
        let endpointURL = baseURL.appendingPathComponent("v1/users/\(userId)")
        var request = URLRequest(url: endpointURL)
        request.httpMethod = "GET"
        request.setValue("application/json", forHTTPHeaderField: "Accept")
        request.timeoutInterval = 15.0
        return request
    }
}
