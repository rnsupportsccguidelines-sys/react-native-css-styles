### HILT VIEWMODEL: `feature/user/presentation/UserProfileViewModel.kt`

```kotlin
package com.enterprise.mobile.feature.user.presentation

import androidx.lifecycle.ViewModel
import androidx.lifecycle.viewModelScope
import com.enterprise.mobile.feature.user.domain.usecase.GetUserProfileUseCase
import com.enterprise.mobile.feature.user.presentation.state.UserProfileUiEvent
import com.enterprise.mobile.feature.user.presentation.state.UserProfileUiState
import dagger.hilt.android.lifecycle.HiltViewModel
import kotlinx.coroutines.Job
import kotlinx.coroutines.flow.MutableStateFlow
import kotlinx.coroutines.flow.asStateFlow
import kotlinx.coroutines.flow.catch
import kotlinx.coroutines.flow.update
import kotlinx.coroutines.launch
import javax.inject.Inject

@HiltViewModel
class UserProfileViewModel @Inject constructor(
    private val profiles: GetUserProfileUseCase
) : ViewModel() {
    private val _uiState = MutableStateFlow(UserProfileUiState())
    val uiState = _uiState.asStateFlow()

    private var currentUserId: String? = null
    private var observationJob: Job? = null
    private var refreshJob: Job? = null

    fun load(userId: String) {
        val normalizedId = userId.trim()
        if (normalizedId == currentUserId) return
        observationJob?.cancel()
        refreshJob?.cancel()
        currentUserId = normalizedId
        _uiState.value = UserProfileUiState()
        if (normalizedId.isBlank()) {
            _uiState.update { it.copy(errorMessage = "A user ID is required.") }
            return
        }
        observationJob = viewModelScope.launch {
            profiles.observe(normalizedId)
                .catch {
                    _uiState.update { it.copy(errorMessage = "Unable to read saved profile.") }
                }
                .collect { user -> _uiState.update { it.copy(user = user) } }
        }
        refresh()
    }

    fun onEvent(event: UserProfileUiEvent) {
        when (event) {
            UserProfileUiEvent.RefreshProfile -> {
                // Restart observation as well, so retry recovers from read failures.
                val id = currentUserId?.takeIf { it.isNotBlank() } ?: return
                observationJob?.cancel()
                observationJob = viewModelScope.launch {
                    profiles.observe(id)
                        .catch {
                            _uiState.update { it.copy(errorMessage = "Unable to read saved profile.") }
                        }
                        .collect { user -> _uiState.update { it.copy(user = user) } }
                }
                refreshJob?.cancel()
                refresh()
            }
        }
    }

    private fun refresh() {
        val id = currentUserId?.takeIf { it.isNotBlank() } ?: return
        refreshJob = viewModelScope.launch {
            _uiState.update { it.copy(isRefreshing = true, errorMessage = null) }
            val result = profiles.refresh(id)
            _uiState.update {
                it.copy(
                    isRefreshing = false,
                    errorMessage = if (result.isFailure) {
                        "Unable to refresh profile. Please try again."
                    } else it.errorMessage
                )
            }
        }
    }
}
```

