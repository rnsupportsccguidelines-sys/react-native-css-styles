package com.enterprise.mobile.core.push

import android.net.Uri

sealed class AppDestination {
    object Home : AppDestination()
    data class OrderDetails(val orderId: String) : AppDestination()
    data class UserProfile(val userId: String) : AppDestination()
    object Unknown : AppDestination()
}

object DeepLinkRouter {

    fun parse(uri: Uri): AppDestination {
        val host = uri.host ?: return AppDestination.Home
        val pathSegments = uri.pathSegments

        return when (host) {
            "orders" -> {
                val orderId = pathSegments.firstOrNull()
                if (orderId != null) AppDestination.OrderDetails(orderId) else AppDestination.Home
            }
            "profile" -> {
                val userId = pathSegments.firstOrNull()
                if (userId != null) AppDestination.UserProfile(userId) else AppDestination.Home
            }
            else -> AppDestination.Unknown
        }
    }
}
