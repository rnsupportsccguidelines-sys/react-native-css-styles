### REPOSITORY IMPLEMENTATION: `feature/user/data/repository/UserRepositoryImpl.kt`

```kotlin
package com.enterprise.mobile.feature.user.data.repository

import com.enterprise.mobile.feature.user.data.local.dao.UserDao
import com.enterprise.mobile.feature.user.data.mapper.toDomain
import com.enterprise.mobile.feature.user.data.mapper.toEntity
import com.enterprise.mobile.feature.user.data.remote.UserApiService
import com.enterprise.mobile.feature.user.di.IoDispatcher
import com.enterprise.mobile.feature.user.domain.model.UserDomainModel
import com.enterprise.mobile.feature.user.domain.repository.UserRepository
import kotlinx.coroutines.CancellationException
import kotlinx.coroutines.CoroutineDispatcher
import kotlinx.coroutines.flow.Flow
import kotlinx.coroutines.flow.map
import kotlinx.coroutines.withContext
import retrofit2.HttpException
import java.io.IOException
import javax.inject.Inject
import javax.inject.Singleton

@Singleton
class UserRepositoryImpl @Inject constructor(
    private val apiService: UserApiService,
    private val userDao: UserDao,
    @IoDispatcher private val ioDispatcher: CoroutineDispatcher
) : UserRepository {

    override suspend fun refreshUserProfile(userId: String): Result<Unit> =
        withContext(ioDispatcher) {
            try {
                val response = apiService.fetchUserProfile(userId)
                if (!response.isSuccessful) throw HttpException(response)
                val dto = response.body()
                    ?: throw IOException("Profile response has no body.")
                if (dto.id != userId) {
                    throw IOException("Profile response identifier does not match request.")
                }
                userDao.insertUser(dto.toEntity(System.currentTimeMillis()))
                Result.success(Unit)
            } catch (error: CancellationException) {
                throw error
            } catch (error: Exception) {
                // Surface refresh failure; observation keeps existing Room data visible.
                // Report unexpected failures through approved, redacted telemetry.
                Result.failure(error)
            }
        }

    override fun observeUserProfile(userId: String): Flow<UserDomainModel?> =
        userDao.observeUserById(userId).map { it?.toDomain() }
}
