### OrderDomain.swift

Sendable domain values, repository protocol, and input validation.

```swift
import Foundation

struct OrderRequest: Sendable {
    let accountID: String
    let requestID: String
    let itemID: String
    let quantity: Int
}
enum OrderOutcome: Sendable, Equatable {
    case confirmed(orderID: String)
    case invalid
    case unknown
}
protocol OrderRepository: Sendable {
    func place(_ request: OrderRequest) async throws -> OrderOutcome
}
func parseQuantity(_ text: String) -> Int? {
    guard !text.isEmpty,
          text.unicodeScalars.allSatisfy({ (48...57).contains($0.value) }),
          let quantity = Int(text), (1...20).contains(quantity) else { return nil }
    return quantity
}
struct PlaceChickenOrder: Sendable {
    let repository: any OrderRepository
    func callAsFunction(_ request: OrderRequest) async throws -> OrderOutcome {
        try Task.checkCancellation()
        guard [request.accountID, request.requestID, request.itemID].allSatisfy({
            !$0.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty
        }), (1...20).contains(request.quantity) else { return .invalid }
        return try await repository.place(request)
    }
}
```

### OrderData.swift

Injected API protocol, response mapping, and synthetic API.

```swift
import Foundation

struct OrderResponse: Sendable { let orderID: String }
protocol OrderAPI: Sendable {
    func submit(_ request: OrderRequest) async throws -> OrderResponse
}
struct RemoteOrderRepository: OrderRepository {
    let api: any OrderAPI
    func place(_ request: OrderRequest) async throws -> OrderOutcome {
        do {
            let response = try await api.submit(request)
            guard !response.orderID.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty
            else { return .unknown }
            return .confirmed(orderID: response.orderID)
        } catch is CancellationError {
            throw CancellationError()
        } catch {
            return .unknown
        }
    }
}

// DEMO ONLY: no HTTP, inventory mutation, payment, or real order.
struct DemoOrderAPI: OrderAPI {
    var simulateUnknown = false
    func submit(_ request: OrderRequest) async throws -> OrderResponse {
        try await Task<Never, Never>.sleep(nanoseconds: 300_000_000)
        return OrderResponse(orderID: simulateUnknown ? "" : "order-001")
    }
}
```

### OrderViewModel.swift

Main-actor observable state, task ownership, and owner invalidation.

```swift
import Foundation
import Observation

enum OrderPhase: Equatable { case idle, invalid, submitting, confirmed, unknown }
struct OrderUIState {
    var quantityText = "2"
    var phase = OrderPhase.idle
    var requestID: String?
    var orderID: String?
    var editable: Bool { phase == .idle || phase == .invalid }
    var message: String {
        switch phase {
        case .idle: "Choose a quantity from 1 to 20."
        case .invalid: "Enter a whole quantity from 1 to 20."
        case .submitting: "Submitting your demo order…"
        case .confirmed: "Demo order confirmed: \(orderID ?? "")"
        case .unknown: "Outcome unknown. Verify the original order before submitting again."
        }
    }
}
@MainActor
@Observable
final class OrderViewModel {
    private(set) var state = OrderUIState()
    private let accountID: String
    private let placeOrder: PlaceChickenOrder
    private let newRequestID: () -> String
    @ObservationIgnored private var task: Task<Void, Never>?
    private var closed = false

    init(
        accountID: String,
        placeOrder: PlaceChickenOrder,
        newRequestID: @escaping () -> String = { UUID().uuidString }
    ) {
        self.accountID = accountID
        self.placeOrder = placeOrder
        self.newRequestID = newRequestID
    }
    func quantityChanged(_ value: String) {
        guard !closed, state.editable else { return }
        state.quantityText = value
        state.phase = .idle
    }
    func submit() {
        guard !closed, state.editable else { return }
        guard let quantity = parseQuantity(state.quantityText),
              !accountID.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty
        else { state.phase = .invalid; return }
        let request = OrderRequest(
            accountID: accountID, requestID: newRequestID(),
            itemID: "chicken-grilled", quantity: quantity
        )
        state.phase = .submitting
        state.requestID = request.requestID
        let operation = placeOrder
        task = Task { [weak self] in
            do {
                let outcome = try await operation(request)
                guard let self, !self.closed else { return }
                switch outcome {
                case .confirmed(let orderID):
                    self.state.phase = .confirmed
                    self.state.orderID = orderID
                case .invalid: self.state.phase = .invalid
                case .unknown: self.state.phase = .unknown
                }
            } catch {
                // Includes cancellation after dispatch: never claim a safe retry.
                guard let self, !self.closed else { return }
                self.state.phase = .unknown
            }
        }
    }
    // Demo lifecycle: only a confirmed order permits a fresh intended order.
    func newOrder() {
        guard !closed, state.phase == .confirmed else { return }
        state = OrderUIState()
    }
    // Call from session ownership before this account's feature is invalidated.
    func invalidateOwner() {
        closed = true
        if state.phase == .submitting { state.phase = .unknown }
        // Let an admitted operation finish; ignore stale UI updates.
        // The host must preserve unresolved operations through approved recovery.
    }
    deinit { task?.cancel() }
}
```

