## 7. Add a first regression test

Use the existing approved JUnit 4 and coroutine-test dependencies. This test file covers three meaningful boundaries; it is not the full test suite or proof of 100% coverage.

### PlaceChickenOrderTest.kt

```kotlin
package com.example.mychicken.orderdemo

import kotlinx.coroutines.test.runTest
import org.junit.Assert.assertEquals
import org.junit.Test

class PlaceChickenOrderTest {
    @Test
    fun invalidQuantityDoesNotCallApi() = runTest {
        var calls = 0
        val api = object : OrderApi {
            override suspend fun submit(request: OrderRequest): OrderResponse {
                calls++
                return OrderResponse("server-order")
            }
        }
        val operation = PlaceChickenOrder(RemoteOrderRepository(api))
        val result = operation(OrderRequest("demo", "request", "chicken-grilled", 0))
        assertEquals(OrderOutcome.Invalid, result)
        assertEquals(0, calls)
    }

    @Test
    fun responseIsMappedWithoutInventingAnOrderId() = runTest {
        val api = object : OrderApi {
            override suspend fun submit(request: OrderRequest) = OrderResponse("server-order")
        }
        val operation = PlaceChickenOrder(RemoteOrderRepository(api))
        assertEquals(
            OrderOutcome.Confirmed("server-order"),
            operation(OrderRequest("demo", "request", "chicken-grilled", 2)),
        )
    }

    @Test
    fun lostResponseDoesNotBecomeConfirmation() = runTest {
        val api = object : OrderApi {
            override suspend fun submit(request: OrderRequest): OrderResponse =
                error("Synthetic transport failure")
        }
        val result = PlaceChickenOrder(RemoteOrderRepository(api))(
            OrderRequest("demo", "request", "chicken-grilled", 2),
        )
        assertEquals(OrderOutcome.Unknown, result)
    }
}
```

