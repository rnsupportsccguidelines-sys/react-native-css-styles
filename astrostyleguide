<script>
  function setupAllDiagrams() {
    document.querySelectorAll('.mermaid-premium-container').forEach((container) => {
      if ((container as any).__mermaidZoomInitialized) return;
      (container as any).__mermaidZoomInitialized = true;

      const viewport = container.querySelector('.mermaid-viewport') as HTMLElement | null;
      const canvas = container.querySelector('.mermaid-canvas') as HTMLElement | null;
      const btnIn = container.querySelector('.btn-zoom-in');
      const btnOut = container.querySelector('.btn-zoom-out');
      const btnReset = container.querySelector('.btn-reset');
      const indicator = container.querySelector('.mermaid-zoom-indicator');
      const btnFullscreen = container.querySelector('.btn-fullscreen');
      const iconExpand = container.querySelector('.icon-expand') as HTMLElement | null;
      const iconCollapse = container.querySelector('.icon-collapse') as HTMLElement | null;

      if (!viewport || !canvas) return;

      let scale = 1.0;
      let panX = 0;
      let panY = 0;
      let isDragging = false;
      let startX = 0;
      let startY = 0;

      function renderTransform() {
        if (!canvas) return;
        canvas.style.transform = `translate(${panX}px, ${panY}px) scale(${scale})`;
        if (indicator) {
          indicator.textContent = `${Math.round(scale * 100)}%`;
        }
      }

      function zoom(delta: number) {
        const newScale = Math.min(Math.max(scale + delta, 0.3), 3.5);
        scale = Number(newScale.toFixed(2));
        renderTransform();
      }

      function reset() {
        scale = 1.0;
        panX = 0;
        panY = 0;
        renderTransform();
      }

      btnIn?.addEventListener('click', (e) => { e.preventDefault(); zoom(0.2); });
      btnOut?.addEventListener('click', (e) => { e.preventDefault(); zoom(-0.2); });
      btnReset?.addEventListener('click', (e) => { e.preventDefault(); reset(); });
      indicator?.addEventListener('click', (e) => { e.preventDefault(); reset(); });

      // Pan / Dragging
      viewport.addEventListener('mousedown', (e) => {
        if ((e.target as HTMLElement)?.closest('.mermaid-toolbar')) return;
        isDragging = true;
        viewport.classList.add('is-dragging');
        startX = e.clientX - panX;
        startY = e.clientY - panY;
      });

      window.addEventListener('mousemove', (e) => {
        if (!isDragging) return;
        panX = e.clientX - startX;
        panY = e.clientY - startY;
        renderTransform();
      });

      window.addEventListener('mouseup', () => {
        if (isDragging) {
          isDragging = false;
          viewport.classList.remove('is-dragging');
        }
      });

      // Mouse Wheel Zoom
      viewport.addEventListener('wheel', (e) => {
        e.preventDefault();
        const delta = e.deltaY > 0 ? -0.12 : 0.12;
        zoom(delta);
      }, { passive: false });

      // Fullscreen Toggle
      btnFullscreen?.addEventListener('click', (e) => {
        e.preventDefault();
        const isFull = container.classList.toggle('is-fullscreen');
        if (iconExpand && iconCollapse) {
          iconExpand.style.display = isFull ? 'none' : 'block';
          iconCollapse.style.display = isFull ? 'block' : 'none';
        }
        reset();
      });

      // ESC exits fullscreen
      window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && container.classList.contains('is-fullscreen')) {
          container.classList.remove('is-fullscreen');
          if (iconExpand && iconCollapse) {
            iconExpand.style.display = 'block';
            iconCollapse.style.display = 'none';
          }
          reset();
        }
      });
    });
  }

  setupAllDiagrams();
  document.addEventListener('astro:page-load', setupAllDiagrams);
</script>




