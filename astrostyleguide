## 1. Anatomy of `bitrise.yml`

The <code>bitrise.yml</code> file lives at the root of your mobile repository. It is the single declarative source of truth parsed by Bitrise runners.

```
+-------------------------------------------------------------------------------+
|                            BITRISE.YML HIERARCHY                              |
|                                                                               |
|  format_version: "11"       Specification standard                            |
|  app: envs                  Global environment defaults                       |
|  trigger_map                Git event router (Pushes, Pull Requests, Tags)    |
|  pipelines                  Multi-stage orchestration                         |
|    └── stages               Sequential phases                                 |
|          └── workflows      Individual task sequences (run in parallel)       |
|                └── steps    Modular atomic actions from StepLib               |
+-------------------------------------------------------------------------------+
```

---

## 2. The Complete Production `bitrise.yml`

Below is the complete, production-tested <code>bitrise.yml</code> configuration for enterprise React Native and mobile applications:

<div class="portal-code-frame">
  <div class="portal-code-header">
    <span class="portal-file-badge">bitrise.yml</span>
    <span class="portal-badge-hub">PRODUCTION SPECIFICATION</span>
  </div>
  <pre class="portal-code-block"><code>format_version: "11"
default_step_lib_source: https://github.com/bitrise-io/bitrise-steplib.git
project_type: react-native

app:
  envs:
  - PROJECT_LOCATION: android
  - MODULE: app
  - BITRISE_PROJECT_PATH: ios/MyMobileApp.xcworkspace
  - BITRISE_SCHEME: MyMobileApp

trigger_map:
- pull_request_source_branch: "*"
  workflow: pr-checks
- push_branch: develop
  workflow: deploy-dev
- push_branch: staging
  workflow: deploy-staging-qa
- push_branch: main
  workflow: release-prod

workflows:
  # =========================================================================
  # 1. PULL REQUEST QUALITY GATE (< 5 MIN SLA)
  # =========================================================================
  pr-checks:
    description: Code Quality, TypeScript Safety, Danger.js Bot &amp; Smoke Compile
    steps:
    - activate-ssh-key@4: {}
    - git-clone@8: {}
    
    # Restore node_modules cache based on package-lock checksum
    - restore-cache@1:
        inputs:
        - key: npm-v1-{{ checksum "package-lock.json" }}
    
    - npm@1:
        title: Install Dependencies
        inputs:
        - command: ci
    
    # Save cache if dependencies changed
    - save-cache@1:
        inputs:
        - key: npm-v1-{{ checksum "package-lock.json" }}
        - paths: node_modules

    - npm@1:
        title: Run ESLint
        inputs:
        - command: run lint

    - npm@1:
        title: TypeScript Type Check
        inputs:
        - command: run typecheck

    - npm@1:
        title: Run Danger.js Review Bot
        inputs:
        - command: run danger
        envs:
        - DANGER_GITHUB_API_TOKEN: $DANGER_GITHUB_API_TOKEN
        - DANGER_GITHUB_HOST: $DANGER_GITHUB_HOST
        - DANGER_GITHUB_API_BASE_URL: $DANGER_GITHUB_API_BASE_URL

    - npm@1:
        title: Run Jest Unit Tests
        inputs:
        - command: test

    - install-missing-android-tools@3: {}
    
    # Smoke compile to ensure zero native compilation breakages before merge
    - android-build@1:
        title: Smoke Compile devDebug APK
        inputs:
        - project_location: $PROJECT_LOCATION
        - module: $MODULE
        - variant: devDebug
        - build_type: apk

  # =========================================================================
  # 2. DEV DEPLOYMENT (TRIGGER: PUSH TO DEVELOP)
  # =========================================================================
  deploy-dev:
    description: Builds Dev Flavor APK and notifies Slack
    steps:
    - activate-ssh-key@4: {}
    - git-clone@8: {}
    - restore-cache@1:
        inputs:
        - key: npm-v1-{{ checksum "package-lock.json" }}
    - npm@1:
        inputs:
        - command: ci
    - install-missing-android-tools@3: {}
    - android-build@1:
        inputs:
        - project_location: $PROJECT_LOCATION
        - module: $MODULE
        - variant: devDebug
        - build_type: apk
    - deploy-to-bitrise-io@2: {}
    - slack@3:
        inputs:
        - webhook_url: $SLACK_WEBHOOK_URL
        - message: "New DEV build compiled and uploaded to Bitrise Artifacts."

  # =========================================================================
  # 3. STAGING / QA DEPLOYMENT (TRIGGER: PUSH TO STAGING)
  # =========================================================================
  deploy-staging-qa:
    description: Signs Staging APK and deploys to Firebase App Distribution
    steps:
    - activate-ssh-key@4: {}
    - git-clone@8: {}
    - restore-cache@1:
        inputs:
        - key: npm-v1-{{ checksum "package-lock.json" }}
    - npm@1:
        inputs:
        - command: ci
    - install-missing-android-tools@3: {}
    - android-build@1:
        inputs:
        - project_location: $PROJECT_LOCATION
        - module: $MODULE
        - variant: stagingRelease
        - build_type: apk
    - sign-apk@1: {}
    - firebase-app-distribution@0:
        inputs:
        - app_path: $BITRISE_APK_PATH
        - app_id: $FIREBASE_STAGING_APP_ID
        - groups: "QA-Testers, Mobile-Engineers"
        - release_notes: "Staging QA build from commit $BITRISE_GIT_COMMIT"
    - deploy-to-bitrise-io@2: {}

  # =========================================================================
  # 4. PRODUCTION RELEASE (TRIGGER: PUSH TO MAIN)
  # =========================================================================
  release-prod:
    description: Production release to Google Play Internal Track &amp; Apple TestFlight
    steps:
    - activate-ssh-key@4: {}
    - git-clone@8: {}
    - restore-cache@1:
        inputs:
        - key: npm-v1-{{ checksum "package-lock.json" }}
    - npm@1:
        inputs:
        - command: ci
    - install-missing-android-tools@3: {}
    
    # 4.1 Android Production App Bundle (.aab)
    - android-build@1:
        title: Build Production Android App Bundle (.aab)
        inputs:
        - project_location: $PROJECT_LOCATION
        - module: $MODULE
        - variant: prodRelease
        - build_type: aab
    - sign-apk@1: {}
    - google-play-deploy@3:
        inputs:
        - service_account_json_key_path: $GOOGLE_PLAY_SERVICE_ACCOUNT_URL
        - package_name: com.enterprise.mobileapp
        - app_path: $BITRISE_AAB_PATH
        - track: internal

    # 4.2 iOS Production Archive (.ipa)
    - xcode-archive@5:
        title: Archive Production iOS IPA
        inputs:
        - project_path: $BITRISE_PROJECT_PATH
        - scheme: $BITRISE_SCHEME
        - distribution_method: app-store
        - automatic_code_signing: api-key
    - deploy-to-itunesconnect-with-deliver@3:
        inputs:
        - api_key_url: $APP_STORE_CONNECT_API_KEY_URL
        - api_issuer_id: $APP_STORE_CONNECT_ISSUER_ID
        - api_key_id: $APP_STORE_CONNECT_KEY_ID
        - ipa_path: $BITRISE_IPA_PATH
        - submit_for_review: "no"
    - deploy-to-bitrise-io@2: {}</code></pre>
</div>

