---
/** Edit these routes to match your site's published URLs before publishing. */
const routes = {
  onboarding: 'onboarding/',
  architecture: 'architecture/',
  platforms: 'platforms/',
  push: 'push-notifications/',
  cicd: 'cicd/',
  testing: 'testing-quality/',
  observability: 'observability/',
  ai: 'genai-and-tools/',
  stores: 'app-store-and-distribution/',
  support: 'support/',
};

interface Props {
  /** Site-relative documentation root, for example /mobile/. */
  docsRoot?: string;
}
const { docsRoot = '/mobile/' } = Astro.props;
const siteBase = import.meta.env.BASE_URL.replace(/\/$/, '');
const root = docsRoot.replace(/^\/+|\/+$/g, '');
const href = (path: string) => `${siteBase}/${root ? `${root}/` : ''}${path}`;

const icons: Record<string, string> = {
  "onboarding": "M4 19.5A2.5 2.5 0 0 1 6.5 17H20 M6.5 3H20v19H6.5A2.5 2.5 0 0 1 4 19.5v-14A2.5 2.5 0 0 1 6.5 3Z M8 7h8 M8 11h5",
  "architecture": "m12 3 9 5-9 5-9-5 9-5Z M3 12l9 5 9-5 M3 16l9 5 9-5",
  "platforms": "M8 3H5a2 2 0 0 0-2 2v3 M16 3h3a2 2 0 0 1 2 2v3 M21 16v3a2 2 0 0 1-2 2h-3 M8 21H5a2 2 0 0 1-2-2v-3 M8 8h8v8H8Z",
  "push": "M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9 M10 21h4",
  "cicd": "M6 8V4 M4 6h4 M6 8v8 M6 16a2 2 0 1 0 0 4 2 2 0 0 0 0-4Z M18 4a2 2 0 1 0 0 4 2 2 0 0 0 0-4Z M18 8v7a3 3 0 0 1-3 3H9 M12 15l-3 3 3 3",
  "testing": "m12 3 8 3v6c0 4-4 7-8 9-4-2-8-5-8-9V6l8-3Z m-4 9 3 3 5-6",
  "observability": "M3 12h4l3-8 4 16 3-8h4",
  "ai": "m12 3 2.5 6.5L21 12l-6.5 2.5L12 21l-2.5-6.5L3 12l6.5-2.5L12 3Z M20 2v4 M18 4h4",
  "stores": "M12 16V3 m-4 4 4-4 4 4 M4 14v5a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-5",
  "support": "M4 13v-2a8 8 0 0 1 16 0v2 M4 12H3v6h4v-6H4Z M20 12h1v6h-4v-6h3Z M20 18v1a2 2 0 0 1-2 2h-4"
};

const sections = [
  { title: 'Onboarding', icon: 'onboarding', description: 'New to the team or new to mobile? Start here, set up your Mac, and run your first app.', links: [
    ['Start here', routes.onboarding],
    ['Mobile foundations', `${routes.onboarding}non-mobile-engineer-guide/`],
    ['Machine setup', `${routes.onboarding}machine-setup-guide/`],
    ['First run & contribution', `${routes.onboarding}first-local-run/`],
  ] },
  { title: 'Architecture', icon: 'architecture', description: 'Understand feature boundaries, resilient networking, feature flags, and contribution rules.', links: [
    ['Overview & layers', routes.architecture],
    ['Network resilience', `${routes.architecture}circuit-breaker-resilience/`],
    ['Feature flags', `${routes.architecture}feature-flags/`],
    ['Branching & PRs', `${routes.architecture}branching-prs/`],
  ] },
  { title: 'Platform & SDKs', icon: 'platforms', description: 'Use platform standards and shared foundations. React Native is preferred for new applications.', links: [
    ['Overview & SDK catalog', routes.platforms],
    ['Android standards', `${routes.platforms}native-android-standards/`],
    ['iOS standards', `${routes.platforms}native-ios-standards/`],
    ['React Native standards', `${routes.platforms}react-native-standards/`],
  ] },
  { title: 'Push Notifications & Deep Linking', icon: 'push', description: 'Configure mobile notification paths, backend delivery, and validated application links.', links: [
    ['Start here', routes.push],
    ['FCM setup', `${routes.push}fcm-mobile-setup/`],
    ['Direct APNs setup', `${routes.push}apns-ios-setup/`],
    ['Deep linking', `${routes.push}deep-linking/`],
  ] },
  { title: 'CI/CD', icon: 'cicd', description: 'Prepare source, enroll through GitOps, and follow governed builds through verified delivery.', links: [
    ['Start here', routes.cicd],
    ['GitOps enrollment', `${routes.cicd}gitops-enrollment/`],
    ['Bitrise pipelines', `${routes.cicd}bitrise-pipelines/`],
    ['Delivery & verification', `${routes.cicd}delivery-and-verification/`],
  ] },
  { title: 'Testing & Quality', icon: 'testing', description: 'Write meaningful tests, enforce production-code coverage, and verify journeys on real devices.', links: [
    ['Start here', routes.testing],
    ['Write tests', `${routes.testing}writing-tests/`],
    ['Coverage & gates', `${routes.testing}coverage-and-quality-gates/`],
    ['Sauce Labs testing', `${routes.testing}sauce-labs-real-device-testing/`],
  ] },
  { title: 'Observability', icon: 'observability', description: 'Integrate Datadog and investigate application experience, errors, and performance.', links: [
    ['Start here', routes.observability],
    ['Datadog integration', `${routes.observability}datadog-mobile-integration/`],
    ['Monitoring & troubleshooting', `${routes.observability}monitoring-and-troubleshooting/`],
  ] },
  { title: 'GenAI & Tools', icon: 'ai', description: 'Set up GitHub Copilot and ChatGPT with reviewed, copyable engineering rules.', links: [
    ['Start here', routes.ai],
    ['Engineering rules', `${routes.ai}engineering-rules/`],
    ['GitHub Copilot', `${routes.ai}github-copilot-setup/`],
    ['ChatGPT', `${routes.ai}chatgpt-setup/`],
  ] },
  { title: 'App Stores & Distribution', icon: 'stores', description: 'Follow signing approvals and the separate enterprise, Apple, and Google delivery processes.', links: [
    ['Start here', routes.stores],
    ['Enterprise distribution', `${routes.stores}enterprise-app-store/`],
    ['Apple App Store', `${routes.stores}apple-app-store/`],
    ['Google Play', `${routes.stores}google-play/`],
  ] },
  { title: 'Support & FAQ', icon: 'support', description: 'Find existing answers or open the enterprise Teams support channel.', links: [
    ['Browse FAQ', routes.support],
    ['Teams support', `${routes.support}support/`],
  ] },
];
---

<section class="portal" aria-label="Mobile engineering documentation">
  <div class="intro">
    <span class="eyebrow">ENTERPRISE MOBILE ENGINEERING</span>
    <h2>Your path from first setup to verified delivery</h2>
    <p>Choose a section below. New to the platform? Begin with Onboarding and understand the platform map before following the detailed guides.</p>
    <a class="start-link" href={href(routes.onboarding)}>Start with onboarding <span aria-hidden="true">→</span></a>
  </div>

  <div class="section-grid">
    {sections.map((section, index) => (
      <section class="section-card"  aria-labelledby={`portal-section-${index}`}>
        <header>
          <span class="section-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d={icons[section.icon]} /></svg></span>
          <h3 id={`portal-section-${index}`}>{section.title}</h3>
        </header>
        <p>{section.description}</p>
        <nav aria-label={section.title}>
          <ul>
            {section.links.map(([label, path]) => (
              <li><a href={href(path)}><span>{label}</span><span class="link-arrow" aria-hidden="true">↗</span></a></li>
            ))}
          </ul>
        </nav>
      </section>
    ))}
  </div>
</section>

<style>
  .portal {
    --brand: #008544;
    --accent: var(--brand);
    --brand-readable: #62d69b;
    --portal-text: var(--sl-color-white, #f1f5f9);
    --portal-muted: var(--sl-color-gray-2, #cbd5e1);
    --portal-surface: var(--sl-color-gray-6, #172033);
    --portal-border: var(--sl-color-gray-5, #475569);
    color: var(--portal-text);
  }
  :global([data-theme="light"]) .portal { --brand-readable: #008544; }
  .intro { max-width: 52rem; margin-block-end: 2rem; }
  .eyebrow { font-size: .75rem; font-weight: 700; letter-spacing: .12em; color: var(--brand-readable); }
  .intro h2 { margin: .65rem 0; font-size: clamp(1.65rem, 3vw, 2.4rem); line-height: 1.2; letter-spacing: -.025em; }
  .intro p { color: var(--portal-muted); line-height: 1.7; margin: 0; }
  .start-link { display: inline-flex; gap: .7rem; align-items: center; margin-block-start: 1rem; font-weight: 650; color: var(--brand-readable); }
  .section-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  .section-card { display: flex; flex-direction: column; min-width: 0; margin: 0; padding: 1.25rem; border: 1px solid var(--portal-border); border-block-start: 3px solid var(--accent); border-radius: .85rem; background: var(--portal-surface); }
  .section-card header { display: flex; align-items: flex-start; gap: .7rem; }
  .section-icon { display: grid; place-items: center; flex: 0 0 2rem; width: 2rem; height: 2rem; border: 1px solid var(--portal-border); border-radius: .5rem; color: var(--portal-text); font-size: 1.15rem; }
  .section-icon { color: var(--brand-readable); background: color-mix(in srgb, var(--accent) 8%, var(--portal-surface)); border-color: color-mix(in srgb, var(--accent) 30%, var(--portal-border)); }
  .section-icon svg { display: block; width: 1.3rem; height: 1.3rem; }
  .section-card h3 { margin: .15rem 0 0; font-size: 1.1rem; line-height: 1.4; color: var(--portal-text); overflow-wrap: anywhere; }
  .section-card p { margin: 1rem 0 1.25rem; font-size: .9rem; line-height: 1.65; color: var(--portal-muted); }
  .section-card nav { margin-block-start: auto; }
  .section-card ul { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .55rem; list-style: none; margin: 0; padding: 0; }
  .section-card li { margin: 0; min-width: 0; }
  .section-card a { display: flex; align-items: center; justify-content: space-between; gap: .5rem; min-height: 2.75rem; height: 100%; padding: .55rem .65rem; border: 1px solid var(--portal-border); border-radius: .45rem; color: var(--portal-text); font-size: .8rem; line-height: 1.45; text-decoration: none; overflow-wrap: anywhere; }
  .link-arrow { flex-shrink: 0; color: var(--portal-muted); }
  .section-card a:hover { background: color-mix(in srgb, var(--brand) 7%, var(--portal-surface)); border-color: var(--brand-readable); text-decoration: underline; text-underline-offset: .2em; }
  .portal a:focus-visible { outline: 3px solid var(--brand-readable); outline-offset: 3px; }
  @media (max-width: 64rem) { .section-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 42rem) { .section-grid { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 24rem) { .section-card ul { grid-template-columns: minmax(0, 1fr); } }
</style>


