    type="text"
    id="portal-faq-search-input"
    class="portal-faq-search"
    placeholder="Search FAQs by keyword (e.g., SSL, Artifactory, Circuit Breaker, 80%, KeyStore, Killswitch)..."
    oninput="
      const q = this.value.toLowerCase().trim();
      document.querySelectorAll('details.portal-faq-item').forEach(el => {
        const match = !q || el.textContent.toLowerCase().includes(q);
