/* ==========================================================================
   LIGHT THEME POLISH: TABS, EXPAND MODAL & MERMAID DIAGRAMS
   Scoped to :root[data-theme='light'], html[data-theme='light']
   ========================================================================== */
/* 1. TABS IN LIGHT THEME */
:root[data-theme='light'] starlight-tabs,
:root[data-theme='light'] .portal-tabs-container,
html[data-theme='light'] starlight-tabs,
html[data-theme='light'] .portal-tabs-container {
  background: #ffffff !important;
  border: 1px solid #d4e2d8 !important;
  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.05) !important;
}
:root[data-theme='light'] starlight-tabs [role="tablist"],
:root[data-theme='light'] .portal-tabs-nav,
html[data-theme='light'] starlight-tabs [role="tablist"],
html[data-theme='light'] .portal-tabs-nav {
  background: #f4f8f5 !important;
  border-bottom: 1px solid #d4e2d8 !important;
}
:root[data-theme='light'] starlight-tabs [role="tab"],
:root[data-theme='light'] .portal-tab-btn,
html[data-theme='light'] starlight-tabs [role="tab"],
html[data-theme='light'] .portal-tab-btn {
  background: #ffffff !important;
  border: 1px solid #cfe0d4 !important;
  color: #374151 !important;
  font-weight: 700 !important;
}
:root[data-theme='light'] starlight-tabs [role="tab"]:hover,
:root[data-theme='light'] .portal-tab-btn:hover,
html[data-theme='light'] starlight-tabs [role="tab"]:hover,
html[data-theme='light'] .portal-tab-btn:hover {
  background: #eaf4ed !important;
  border-color: #007a3d !important;
  color: #007a3d !important;
}
:root[data-theme='light'] starlight-tabs [role="tab"][aria-selected="true"],
:root[data-theme='light'] .portal-tab-btn.active,
html[data-theme='light'] starlight-tabs [role="tab"][aria-selected="true"],
html[data-theme='light'] .portal-tab-btn.active {
  background: #007a3d !important;
  border-color: #007a3d !important;
  color: #ffffff !important;
  box-shadow: 0 2px 8px rgba(0, 122, 61, 0.25) !important;
}
/* 2. FILE HEADERS IN LIGHT THEME */
:root[data-theme='light'] .portal-file-header,
html[data-theme='light'] .portal-file-header {
  background: #edf5ef !important;
  border: 1px solid #d4e2d8 !important;
  border-bottom: none !important;
  color: #143823 !important;
}
:root[data-theme='light'] .portal-file-path,
html[data-theme='light'] .portal-file-path {
  color: #143823 !important;
  font-weight: 700 !important;
}
:root[data-theme='light'] .portal-file-tag,
html[data-theme='light'] .portal-file-tag {
  background: rgba(0, 122, 61, 0.12) !important;
  color: #007a3d !important;
  border: 1px solid rgba(0, 122, 61, 0.3) !important;
}
/* 3. DIAGRAM WRAPPER & EXPAND BUTTON IN LIGHT THEME */
:root[data-theme='light'] .portal-diagram-wrap,
html[data-theme='light'] .portal-diagram-wrap {
  background: #ffffff !important;
  border: 1px solid #d4e2d8 !important;
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.05) !important;
}
:root[data-theme='light'] .portal-diagram-header,
html[data-theme='light'] .portal-diagram-header {
  background: #f4f8f5 !important;
  border-bottom: 1px solid #d4e2d8 !important;
}
:root[data-theme='light'] .portal-diagram-badge,
html[data-theme='light'] .portal-diagram-badge {
  color: #007a3d !important;
  font-weight: 800 !important;
}
:root[data-theme='light'] .portal-expand-btn,
html[data-theme='light'] .portal-expand-btn {
  background: #ffffff !important;
  border: 1.5px solid #007a3d !important;
  color: #007a3d !important;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08) !important;
}
:root[data-theme='light'] .portal-expand-btn:hover,
html[data-theme='light'] .portal-expand-btn:hover {
  background: #007a3d !important;
  color: #ffffff !important;
  box-shadow: 0 4px 12px rgba(0, 122, 61, 0.3) !important;
}
/* 4. EXPAND MODAL DIALOG IN LIGHT THEME */
:root[data-theme='light'] .portal-diagram-wrap:has(.portal-diagram-toggle:checked),
:root[data-theme='light'] .portal-diagram-wrap.is-fullscreen,
html[data-theme='light'] .portal-diagram-wrap:has(.portal-diagram-toggle:checked),
html[data-theme='light'] .portal-diagram-wrap.is-fullscreen {
  background: #ffffff !important;
  border: 2px solid #007a3d !important;
  box-shadow: 0 25px 60px rgba(0, 0, 0, 0.25), 0 0 0 100vmax rgba(15, 23, 42, 0.45) !important;
}
:root[data-theme='light'] .portal-diagram-wrap:has(.portal-diagram-toggle:checked) .portal-diagram-header,
:root[data-theme='light'] .portal-diagram-wrap.is-fullscreen .portal-diagram-header,
html[data-theme='light'] .portal-diagram-wrap:has(.portal-diagram-toggle:checked) .portal-diagram-header,
html[data-theme='light'] .portal-diagram-wrap.is-fullscreen .portal-diagram-header {
  background: #f4f8f5 !important;
  border-bottom: 1px solid #d4e2d8 !important;
}
:root[data-theme='light'] .portal-diagram-wrap:has(.portal-diagram-toggle:checked) .portal-diagram-viewport,
:root[data-theme='light'] .portal-diagram-wrap.is-fullscreen .portal-diagram-viewport,
html[data-theme='light'] .portal-diagram-wrap:has(.portal-diagram-toggle:checked) .portal-diagram-viewport,
html[data-theme='light'] .portal-diagram-wrap.is-fullscreen .portal-diagram-viewport {
  background: #ffffff !important;
}
/* 5. MERMAID DIAGRAMS IN LIGHT THEME */
:root[data-theme='light'] .portal-diagram-viewport svg,
:root[data-theme='light'] .starlight-mermaid svg,
html[data-theme='light'] .portal-diagram-viewport svg,
html[data-theme='light'] .starlight-mermaid svg {
  /* Presentation Layer Nodes (Emerald) */
  & .composeBox rect,
  & [class*="composeBox"] rect,
  & [class*="composeBox"] polygon {
    fill: #e8f9ee !important;
    stroke: #16a34a !important;
    stroke-width: 2px !important;
  }
  & .composeBox .nodeLabel,
  & [class*="composeBox"] .nodeLabel,
  & [class*="composeBox"] text,
  & [class*="composeBox"] span {
    color: #14532d !important;
    fill: #14532d !important;
  }
  /* Domain Layer Nodes (Violet/Purple) */
  & .domainBox rect,
  & [class*="domainBox"] rect,
  & [class*="domainBox"] polygon {
    fill: #f5f0ff !important;
    stroke: #9333ea !important;
    stroke-width: 2px !important;
  }
  & .domainBox .nodeLabel,
  & [class*="domainBox"] .nodeLabel,
  & [class*="domainBox"] text,
  & [class*="domainBox"] span {
    color: #581c87 !important;
    fill: #581c87 !important;
  }
  /* Data Layer Nodes (Amber/Gold) */
  & .dataBox rect,
  & [class*="dataBox"] rect,
  & [class*="dataBox"] polygon {
    fill: #fffbeb !important;
    stroke: #d97706 !important;
    stroke-width: 2px !important;
  }
  & .dataBox .nodeLabel,
  & [class*="dataBox"] .nodeLabel,
  & [class*="dataBox"] text,
  & [class*="dataBox"] span {
    color: #78350f !important;
    fill: #78350f !important;
  }
  /* Presentation Subgraph Cluster */
  & .subPres rect,
  & [class*="subPres"] rect {
    fill: #f0fdf4 !important;
    stroke: #86efac !important;
    stroke-width: 1.5px !important;
  }
  & .subPres span,
  & [class*="subPres"] span,
  & .subPres text,
  & [class*="subPres"] text {
    color: #15803d !important;
    fill: #15803d !important;
    font-weight: 700 !important;
  }
  /* Domain Subgraph Cluster */
  & .subDom rect,
  & [class*="subDom"] rect {
    fill: #faf5ff !important;
    stroke: #d8b4fe !important;
    stroke-width: 1.5px !important;
  }
  & .subDom span,
  & [class*="subDom"] span,
  & .subDom text,
  & [class*="subDom"] text {
    color: #7e22ce !important;
    fill: #7e22ce !important;
    font-weight: 700 !important;
  }
  /* Data Subgraph Cluster */
  & .subDat rect,
  & [class*="subDat"] rect {
    fill: #fffdf5 !important;
    stroke: #fde68a !important;
    stroke-width: 1.5px !important;
  }
  & .subDat span,
  & [class*="subDat"] span,
  & .subDat text,
  & [class*="subDat"] text {
    color: #b45309 !important;
    fill: #b45309 !important;
    font-weight: 700 !important;
  }
  /* Connecting Links & Labels */
  & .edgePath path {
    stroke: #64748b !important;
  }
  & .edgeLabel {
    background-color: #ffffff !important;
    color: #334155 !important;
    fill: #334155 !important;
  }
  & .edgeLabel rect {
    fill: #ffffff !important;
    opacity: 0.95 !important;
  }
  /* Sequence Diagrams in Light Theme */
  & .actor {
    fill: #f0fdf4 !important;
    stroke: #16a34a !important;
    stroke-width: 1.5px !important;
  }
  & text.actor,
  & text.actor > tspan {
    fill: #14532d !important;
    font-weight: 700 !important;
  }
  & .actor-line {
    stroke: #cbd5e1 !important;
  }
  & .messageLine0,
  & .messageLine1 {
    stroke: #0f766e !important;
  }
  & .messageText {
    fill: #0f172a !important;
    font-weight: 600 !important;
  }
  & .sequenceNumber {
    fill: #ffffff !important;
  }
  & [class*="sequenceNumber"] {
    fill: #ffffff !important;
  }
  & circle.sequenceNumber {
    fill: #16a34a !important;
  }
}
