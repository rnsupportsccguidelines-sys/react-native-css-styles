## Code Comparison: UI State & Data Fetching

To evaluate the developer experience across stacks, compare this standard enterprise pattern—fetching an order list with loading states and pull-to-refresh:

### 1. React Native (TypeScript + React Hooks)

```typescript
import React, { useState, useEffect } from 'react';
import { View, Text, FlatList, RefreshControl, StyleSheet, ActivityIndicator } from 'react-native';
import { useOrdersQuery } from '@enterprise/orders-sdk';

export function OrderListScreen() {
  const { data: orders, isLoading, isError, refetch } = useOrdersQuery();
  const [refreshing, setRefreshing] = useState(false);

  const onRefresh = async () => {
    setRefreshing(true);
    await refetch();
    setRefreshing(false);
  };

  if (isLoading && !refreshing) {
    return <ActivityIndicator size="large" color="#22c55e" style={styles.center} />;
  }

  if (isError) {
    return <Text style={styles.errorText}>Unable to load enterprise orders.</Text>;
  }

  return (
    <View style={styles.container}>
      <FlatList
        data={orders}
        keyExtractor={item => item.id}
        refreshControl={<RefreshControl refreshing={refreshing} onRefresh={onRefresh} tintColor="#22c55e" />}
        renderItem={({ item }) => (
          <View style={styles.card}>
            <Text style={styles.title}>{item.orderNumber}</Text>
            <Text style={styles.status}>{item.status}</Text>
          </View>
        )}
      />
    </View>
  );
}

const styles = StyleSheet.create({
  container: { flex: 1, backgroundColor: '#0d1912', padding: 16 },
  center: { flex: 1, justifyContent: 'center', alignItems: 'center' },
  card: { padding: 14, backgroundColor: '#13251c', borderRadius: 8, marginBottom: 10, borderColor: '#1f3b2c', borderWidth: 1 },
  title: { color: '#f3d17b', fontWeight: '700', fontSize: 16 },
  status: { color: '#cbd5e1', marginTop: 4, fontSize: 14 },
  errorText: { color: '#ef4444', textAlign: 'center', marginTop: 40 },
});
```

### 2. Native Android (Kotlin + Jetpack Compose)

```kotlin
package com.enterprise.mobile.feature.orders

import androidx.compose.foundation.background
import androidx.compose.foundation.layout.*
import androidx.compose.foundation.lazy.LazyColumn
import androidx.compose.foundation.lazy.items
import androidx.compose.material3.*
import androidx.compose.runtime.*
import androidx.compose.ui.Alignment
import androidx.compose.ui.Modifier
import androidx.compose.ui.graphics.Color
import androidx.compose.ui.unit.dp
import androidx.lifecycle.viewmodel.compose.viewModel

@Composable
fun OrderListScreen(
    viewModel: OrdersViewModel = viewModel()
) {
    val uiState by viewModel.uiState.collectAsState()

    Box(
        modifier = Modifier
            .fillMaxSize()
            .background(Color(0xFF0D1912))
            .padding(16.dp)
    ) {
        when (val state = uiState) {
            is OrderUiState.Loading -> {
                CircularProgressIndicator(
                    color = Color(0xFF22C55E),
                    modifier = Modifier.align(Alignment.Center)
                )
            }
            is OrderUiState.Error -> {
                Text(
                    text = state.message,
                    color = Color(0xFFEF4444),
                    modifier = Modifier.align(Alignment.Center)
                )
            }
            is OrderUiState.Success -> {
                LazyColumn(verticalArrangement = Arrangement.spacedBy(10.dp)) {
                    items(state.orders) { order ->
                        Card(
                            colors = CardDefaults.cardColors(containerColor = Color(0xFF13251C)),
                            modifier = Modifier.fillMaxWidth()
                        ) {
                            Column(modifier = Modifier.padding(14.dp)) {
                                Text(order.orderNumber, color = Color(0xFFF3D17B), style = MaterialTheme.typography.titleMedium)
                                Text(order.status, color = Color(0xFFCBD5E1), style = MaterialTheme.typography.bodyMedium)
                            }
                        }
                    }
                }
            }
        }
    }
}
```

### 3. Native iOS (Swift + SwiftUI)

```swift
import SwiftUI

struct OrderListView: View {
    @StateObject private var viewModel = OrdersViewModel()

    var body: some View {
        ZStack {
            Color(red: 13/255, green: 25/255, blue: 18/255)
                .ignoresSafeArea()

            switch viewModel.state {
            case .loading:
                ProgressView()
                    .tint(Color(red: 34/255, green: 197/255, blue: 94/255))
            case .error(let message):
                Text(message)
                    .foregroundColor(.red)
            case .success(let orders):
                List(orders) { order in
                    VStack(alignment: .leading, spacing: 4) {
                        Text(order.orderNumber)
                            .font(.headline)
                            .foregroundColor(Color(red: 243/255, green: 209/255, blue: 123/255))
                        Text(order.status)
                            .font(.subheadline)
                            .foregroundColor(Color(red: 203/255, green: 213/255, blue: 225/255))
                    }
                    .listRowBackground(Color(red: 19/255, green: 37/255, blue: 28/255))
                }
                .scrollContentBackground(.hidden)
                .refreshable {
                    await viewModel.loadOrders()
                }
            }
        }
        .task {
            await viewModel.loadOrders()
        }
    }
}
