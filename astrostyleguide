import androidx.compose.ui.Modifier
import androidx.compose.ui.res.stringResource
import androidx.compose.ui.tooling.preview.Preview
import androidx.compose.ui.unit.dp
import androidx.lifecycle.Lifecycle
import androidx.lifecycle.compose.LocalLifecycleOwner
import androidx.lifecycle.compose.collectAsStateWithLifecycle
import androidx.lifecycle.repeatOnLifecycle
import com.enterprise.mobile.R
import com.enterprise.mobile.feature.user.domain.ProfileFailure
import com.enterprise.mobile.feature.user.domain.UserDomainModel

@Composable
fun UserProfileRoute(
    accountId: String,
    userId: String,
    viewModel: UserProfileViewModel,
    modifier: Modifier = Modifier,
) {
    val state by viewModel.state.collectAsStateWithLifecycle()
    val lifecycleOwner = LocalLifecycleOwner.current
    var revision by remember(accountId, userId) { mutableIntStateOf(0) }

    LaunchedEffect(accountId, userId, revision, lifecycleOwner) {
        lifecycleOwner.lifecycle.repeatOnLifecycle(Lifecycle.State.STARTED) {
            viewModel.load(accountId, userId)
        }
    }

    // Hide another account/profile immediately, before the effect starts loading.
    val sameProfile = state.key?.accountId == accountId && state.key?.userId == userId.trim()
    val visibleState = if (sameProfile) state else state.copy(user = null)
    UserProfileScreen(
        state = visibleState,
        onRefresh = { revision += 1 },
        modifier = modifier,
    )
}

@Composable
fun UserProfileScreen(
    state: UserProfileUiState,
    onRefresh: () -> Unit,
    modifier: Modifier = Modifier,
) {
    Column(
        modifier = modifier.fillMaxSize()
            .verticalScroll(rememberScrollState()).padding(24.dp),
        verticalArrangement = Arrangement.spacedBy(16.dp),
    ) {
        Text(stringResource(R.string.profile_title), style = MaterialTheme.typography.headlineMedium)
        if (state.isRefreshing) {
            LinearProgressIndicator(modifier = Modifier.fillMaxWidth())
        }
        state.user?.let { user ->
            Text(user.name, style = MaterialTheme.typography.titleLarge)
            Text(user.email, style = MaterialTheme.typography.bodyLarge)
            if (user.isVip) Text(stringResource(R.string.profile_vip))
        }
        state.failure?.let { failure ->
            Text(profileFailureMessage(failure), color = MaterialTheme.colorScheme.error)
        }
        if (state.user == null && !state.isRefreshing && state.failure == null) {
            Text(stringResource(R.string.profile_empty))
        }
        Button(onClick = onRefresh, enabled = !state.isRefreshing) {
            Text(stringResource(
                if (state.failure == null) R.string.profile_refresh else R.string.profile_retry
            ))
        }
    }
}

@Composable
private fun profileFailureMessage(failure: ProfileFailure): String = stringResource(
    when (failure) {
        ProfileFailure.INVALID_KEY -> R.string.profile_invalid_key
        ProfileFailure.SESSION_EXPIRED -> R.string.profile_session_expired
        ProfileFailure.ACCESS_DENIED -> R.string.profile_access_denied
        ProfileFailure.NOT_FOUND -> R.string.profile_not_found
        ProfileFailure.CACHE_INVALIDATION -> R.string.profile_access_unverified
        else -> R.string.profile_load_failed
    }
)

