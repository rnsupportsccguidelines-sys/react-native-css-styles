## 4. Add success and failure tests

| Scenario | Expected screen | Assertion |
|---|---|---|
| `demo-user` + `demo-only` | Home. | Home appears and Login fields disappear. |
| `demo-user` + wrong password | Login with `Invalid demo credentials.` | Error appears and Home remains absent. |
| Empty username | Login with `Enter a username.` | No success state. |
| Empty password | Login with `Enter a password.` | No success state. |

**Invalid-login test success means the app correctly rejected the credentials.** The test passes when it observes the expected error. A failed test means an assertion or execution failed.

<Tabs>
<TabItem label="login.test.js — Jest">

Place this beside `LoginDemo.jsx`. The existing Jest configuration must discover it and transform JSX through the React Native preset.

```jsx
import React from 'react';
import {fireEvent, render, screen} from '@testing-library/react-native';
import LoginDemo from './LoginDemo';
import {authenticateDemo} from './authenticate-demo';

describe('demo authentication policy', () => {
  test.each([
    ['', 'demo-only', {ok: false, message: 'Enter a username.'}],
    ['   ', 'demo-only', {ok: false, message: 'Enter a username.'}],
    ['demo-user', '', {ok: false, message: 'Enter a password.'}],
    ['wrong-user', 'demo-only', {ok: false, message: 'Invalid demo credentials.'}],
    ['demo-user', 'wrong-password', {ok: false, message: 'Invalid demo credentials.'}],
    ['demo-user', 'demo-only', {ok: true}],
    [' demo-user ', 'demo-only', {ok: true}],
  ])('checks username %s with controlled fixture input', (username, password, expected) => {
    expect(authenticateDemo(username, password)).toEqual(expected);
  });
});

describe('Login screen', () => {
  test('shows Home after successful demo login', () => {
    render(<LoginDemo />);
    fireEvent.changeText(screen.getByTestId('login.username'), 'demo-user');
    fireEvent.changeText(screen.getByTestId('login.password'), 'demo-only');
    fireEvent.press(screen.getByTestId('login.submit'));

    expect(screen.getByTestId('home.heading')).toBeTruthy();
    expect(screen.queryByTestId('login.username')).toBeNull();
  });

  test('shows an error and stays on Login for a wrong password', () => {
    render(<LoginDemo />);
    fireEvent.changeText(screen.getByTestId('login.username'), 'demo-user');
    fireEvent.changeText(screen.getByTestId('login.password'), 'wrong-password');
    fireEvent.press(screen.getByTestId('login.submit'));

    expect(screen.getByText('Invalid demo credentials.')).toBeTruthy();
    expect(screen.queryByTestId('home.heading')).toBeNull();
    expect(screen.getByTestId('login.password').props.value).toBe('');
  });

  test('rejects an empty username', () => {
    render(<LoginDemo />);
    fireEvent.press(screen.getByTestId('login.submit'));
    expect(screen.getByText('Enter a username.')).toBeTruthy();
  });

  test('rejects an empty password', () => {
    render(<LoginDemo />);
    fireEvent.changeText(screen.getByTestId('login.username'), 'demo-user');
    fireEvent.press(screen.getByTestId('login.submit'));
    expect(screen.getByText('Enter a password.')).toBeTruthy();
  });

  test('resets the demo after success', () => {
    render(<LoginDemo />);
    fireEvent.changeText(screen.getByTestId('login.username'), 'demo-user');
    fireEvent.changeText(screen.getByTestId('login.password'), 'demo-only');
    fireEvent.press(screen.getByTestId('login.submit'));
    fireEvent.press(screen.getByTestId('login.reset'));

    expect(screen.getByTestId('login.username').props.value).toBe('');
    expect(screen.getByTestId('login.password').props.value).toBe('');
    expect(screen.queryByTestId('home.heading')).toBeNull();
  });
});
```

