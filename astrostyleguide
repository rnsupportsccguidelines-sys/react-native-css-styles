```swift
import Foundation

final class OrderRepositoryImpl: OrderRepositoryProtocol {
    private let networkClient: NetworkClientProtocol
    private let database: LocalDatabaseProtocol

    init(networkClient: NetworkClientProtocol, database: LocalDatabaseProtocol) {
        self.networkClient = networkClient
        self.database = database
    }

    func submitOrder(_ order: Order) async throws -> String {
        let dto = OrderRequestDTO(from: order)
        let response: OrderResponseDTO = try await networkClient.post("/v1/orders", body: dto)
        try await database.persistOrderConfirmation(response.confirmationId)
        return response.confirmationId
    }
