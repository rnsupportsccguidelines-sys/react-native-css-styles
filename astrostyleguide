### 2. Initialize Datadog in Root Application
Configure the SDK in your application root file (`index.js` or `App.tsx`) before mounting the component hierarchy:

```typescript
import { 
  DdSdkReactNative, 
  DdSdkReactNativeConfiguration, 
  UploadFrequency, 
  BatchSize 
} from '@datadog/mobile-react-native';

const initDatadog = async () => {
  const config = new DdSdkReactNativeConfiguration(
    process.env.DATADOG_CLIENT_TOKEN || "puba1b2c3d4e5f6g7h8i9j0",
    process.env.APP_ENV || "production",
    process.env.DATADOG_APPLICATION_ID || "12345678-abcd-1234-abcd-123456789abc",
    true, // trackUserInteractions (taps, scrolls)
    true, // trackXhrResources (network payloads)
    true  // trackErrors (unhandled JS exceptions)
  );

  config.site = "US1";
  config.nativeCrashReportEnabled = true;
  config.sampleRate = 100; // 100% telemetry capture
  config.uploadFrequency = UploadFrequency.AVERAGE;
  config.batchSize = BatchSize.MEDIUM;

  // Mask user input to satisfy TGRC & GDPR rules
  config.telemetryConfigurationSampleRate = 100;
  
  await DdSdkReactNative.initialize(config);
};

initDatadog();
```

