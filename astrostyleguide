package com.enterprise.mobile.core.storage

import androidx.room.*

@Entity(tableName = "outbox_mutations")
data class OutboxEntity(
    @PrimaryKey val idempotencyKey: String,
    val endpoint: String,
    val payloadJson: String,
    val createdAtTimestamp: Long = System.currentTimeMillis(),
    val retryCount: Int = 0
)

@Dao
interface OutboxDao {
    @Query("SELECT * FROM outbox_mutations ORDER BY createdAtTimestamp ASC")
    suspend fun getPendingMutations(): List<OutboxEntity>

    @Insert(onConflict = OnConflictStrategy.REPLACE)
    suspend fun enqueue(mutation: OutboxEntity)

    @Delete
    suspend fun delete(mutation: OutboxEntity)
}
```

### Android Sync Worker

```kotlin
package com.enterprise.mobile.core.sync

import android.content.Context
import androidx.work.CoroutineWorker
import androidx.work.WorkerParameters
import okhttp3.MediaType.Companion.toMediaType
import okhttp3.OkHttpClient
import okhttp3.Request
import okhttp3.RequestBody.Companion.toRequestBody

class OutboxSyncWorker(
    appContext: Context,
    workerParams: WorkerParameters,
    private val outboxDao: OutboxDao,
    private val httpClient: OkHttpClient
) : CoroutineWorker(appContext, workerParams) {

    override suspend fun doWork(): Result {
        val pending = outboxDao.getPendingMutations()

        for (mutation in pending) {
            val request = Request.Builder()
                .url(mutation.endpoint)
                .header("X-Idempotency-Key", mutation.idempotencyKey)
                .post(mutation.payloadJson.toRequestBody("application/json".toMediaType()))
                .build()

            try {
                val response = httpClient.newCall(request).execute()
                if (response.isSuccessful) {
                    outboxDao.delete(mutation)
                }
            } catch (e: Exception) {
                return Result.retry()
            }
        }

        return Result.success()
    }
}
