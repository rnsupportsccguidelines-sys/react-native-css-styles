import SwiftUI

@MainActor
struct UserProfileRoute: View {
    let userID: String
    @State private var viewModel: UserProfileViewModel
    @State private var revision = 0

    init(userID: String, viewModel: UserProfileViewModel) {
        self.userID = userID
        _viewModel = State(initialValue: viewModel)
    }

    private struct RequestKey: Equatable {
        let userID: String
        let revision: Int
    }

    var body: some View {
        let key = RequestKey(userID: userID, revision: revision)
        UserProfileView(state: viewModel.state) { revision += 1 }
            .navigationTitle("User profile")
            .task(id: key) {
                await viewModel.load(userID: key.userID)
            }
    }
}

@MainActor
struct UserProfileView: View {
    let state: UserProfileUIState
    let onRefresh: () -> Void

    var body: some View {
        ScrollView {
            VStack(alignment: .leading, spacing: 16) {
                if state.isLoading {
                    ProgressView(state.user == nil ? "Loading profile…" : "Refreshing…")
                        .accessibilityLabel("Profile loading")
                }
                if let user = state.user {
                    Text(user.name).font(.title2).fontWeight(.semibold)
                    Text(user.email).foregroundStyle(.secondary)
                    if user.isVIP {
                        Label("VIP account", systemImage: "star.fill")
                            .font(.callout)
                    }
                }
                if let message = state.message {
                    Text(message)
                        .foregroundStyle(.secondary)
                        .accessibilityIdentifier("profile.message")
                }
                if !state.isLoading && state.user == nil && state.message == nil {
                    Text("No saved profile is available.")
                }
                Button(state.message == nil ? "Refresh profile" : "Retry",
                       action: onRefresh)
                    .buttonStyle(.borderedProminent)
                    .disabled(state.isLoading)
            }
            .frame(maxWidth: .infinity, alignment: .leading)
            .padding(24)
        }
    }
}
```

<Aside type="tip" title="Hint · let SwiftUI own cancellation">
Changing `userID` or the refresh revision changes `.task(id:)`, cancelling the previous view task and starting a new one. Await `viewModel.load` directly. The route's parent owns the `NavigationStack`; nesting a new stack inside every feature screen is unnecessary.
</Aside>

`@State` preserves its initial reference while the route keeps the same identity. When the authenticated account changes, recreate the account-scoped factory and route with a new identity. Do not expect a new initializer argument to replace the existing `@State` object automatically. Pass a stable ViewModel instance from the owning feature coordinator rather than rebuilding the entire dependency graph on each body evaluation.

Replace the example strings with localized resources and use the enterprise theme. The scrollable layout supports larger text; test Dynamic Type, VoiceOver, contrast, and loading/error states on supported devices.

