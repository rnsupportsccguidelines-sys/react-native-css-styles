---
interface Props {
  basePath?: string;
}

const { basePath = '/mobile-draft' } = Astro.props;
const PORTAL_BASE = basePath; // When switching to production tomorrow, simply change '/mobile-draft' to '/mobile'
---

<div class="portal-hero-card portal-hero-row">
  <div class="portal-hero-icon">
    <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <rect x="5" y="2" width="14" height="20" rx="2" ry="2"/>
      <line x1="12" y1="18" x2="12.01" y2="18"/>
    </svg>
  </div>
  <div>
    <div class="portal-hero-title">Mobile Engineering Platform Hub</div>
    <div class="portal-hero-sub">Centralized developer portal for architecture standards, automated CI/CD, analytics, App Store distribution, and engineering guidelines.</div>
  </div>
</div>

<div class="portal-disclaimer-banner">
  <div class="portal-disclaimer-icon">
    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
      <line x1="12" y1="9" x2="12" y2="13"/>
      <line x1="12" y1="17" x2="12.01" y2="17"/>
    </svg>
  </div>
  <div class="portal-disclaimer-content">
    <div class="portal-disclaimer-title">PORTAL NAVIGATION NOTICE</div>
    <p class="portal-disclaimer-text">
      Currently routing through <strong><code>{PORTAL_BASE}</code></strong>. Select any card below to jump directly into the verified documentation runbooks, SDK setups, or deployment checklists.
    </p>
  </div>
</div>

<div class="portal-cards-grid">

  {/* Build and Release Kit */}
  <div class="portal-card">
    <div>
      <div class="portal-card-topbar">
        <div class="portal-icon-badge badge-green">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/>
            <path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/>
          </svg>
        </div>
        <h3 class="portal-card-title">Build and Release Kit</h3>
        <span class="portal-tag-pill">TOOLING</span>
      </div>
      <p class="portal-card-desc">
        Complete mobile toolchain bootstrap, workstation provisioning for macOS &amp; Windows, and starter kits.
      </p>
      <div class="portal-card-pills">
        <a href={`${PORTAL_BASE}/build-and-release-kit/`} class="portal-pill-link">Build Kit Overview</a>
        <a href={`${PORTAL_BASE}/build-and-release-kit/setup/`} class="portal-pill-link">Workstation Setup</a>
        <a href={`${PORTAL_BASE}/build-and-release-kit/dependencies/`} class="portal-pill-link">SDK Dependencies</a>
      </div>
    </div>
    <div class="portal-card-foot">
      <a href={`${PORTAL_BASE}/build-and-release-kit/`} class="portal-card-link">Explore Build Kit &rarr;</a>
    </div>
  </div>

  {/* Architecture Pattern */}
  <div class="portal-card">
    <div>
      <div class="portal-card-topbar">
        <div class="portal-icon-badge badge-green">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="7" height="7"/>
            <rect x="14" y="3" width="7" height="7"/>
            <rect x="14" y="14" width="7" height="7"/>
            <rect x="3" y="14" width="7" height="7"/>
          </svg>
        </div>
        <h3 class="portal-card-title">Architecture Pattern</h3>
        <span class="portal-tag-pill">STANDARDS</span>
      </div>
      <p class="portal-card-desc">
        4-Layer Clean Architecture, boundary rules, Circuit Breaker network resilience, and offline caching.
      </p>
      <div class="portal-card-pills">
        <a href={`${PORTAL_BASE}/architecture-pattern/`} class="portal-pill-link">Clean Architecture</a>
        <a href={`${PORTAL_BASE}/architecture-pattern/circuit-breaker/`} class="portal-pill-link">Circuit Breaker</a>
        <a href={`${PORTAL_BASE}/architecture-pattern/offline-sync/`} class="portal-pill-link">Offline Cache</a>
      </div>
    </div>
    <div class="portal-card-foot">
      <a href={`${PORTAL_BASE}/architecture-pattern/`} class="portal-card-link">View Architecture &rarr;</a>
    </div>
  </div>

  {/* Analytics & Monitoring */}
  <div class="portal-card">
    <div>
      <div class="portal-card-topbar">
        <div class="portal-icon-badge badge-purple">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
          </svg>
        </div>
        <h3 class="portal-card-title">Analytics &amp; Monitoring</h3>
        <span class="portal-tag-pill">DATADOG</span>
      </div>
      <p class="portal-card-desc">
        Real User Monitoring (RUM), crash telemetry, synthetic monitoring, and the iOS Datadog wrapper library.
      </p>
      <div class="portal-card-pills">
        <a href={`${PORTAL_BASE}/analytics/`} class="portal-pill-link">Analytics Overview</a>
        <a href={`${PORTAL_BASE}/analytics/datadog/setup/`} class="portal-pill-link">Datadog Setup</a>
        <a href={`${PORTAL_BASE}/analytics/ios-datadog-wrapper/`} class="portal-pill-link">iOS Wrapper Library</a>
      </div>
    </div>
    <div class="portal-card-foot">
      <a href={`${PORTAL_BASE}/analytics/`} class="portal-card-link">View Analytics &rarr;</a>
    </div>
  </div>

  {/* App Store & Distribution */}
  <div class="portal-card">
    <div>
      <div class="portal-card-topbar">
        <div class="portal-icon-badge badge-rose">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="21 8 21 21 3 21 3 8"/>
            <rect x="1" y="3" width="22" height="5"/>
            <line x1="10" y1="12" x2="14" y2="12"/>
          </svg>
        </div>
        <h3 class="portal-card-title">App Store &amp; Distribution</h3>
        <span class="portal-tag-pill">PUBLISHING</span>
      </div>
      <p class="portal-card-desc">
        Apple AppStore uploads, code signing certs, remote data wipe on stolen devices, Enterprise Store, and Google Play.
      </p>
      <div class="portal-card-pills">
        <a href={`${PORTAL_BASE}/app-store/apple-appstore-upload/`} class="portal-pill-link">Apple Upload</a>
        <a href={`${PORTAL_BASE}/app-store/code-signing/`} class="portal-pill-link">Code Signing</a>
        <a href={`${PORTAL_BASE}/app-store/data-wipe/`} class="portal-pill-link">Remote Data Wipe</a>
        <a href={`${PORTAL_BASE}/app-store/enterprise-app-store/`} class="portal-pill-link">Enterprise Store</a>
        <a href={`${PORTAL_BASE}/app-store/google-app-store-deployment/`} class="portal-pill-link">Google Play</a>
      </div>
    </div>
    <div class="portal-card-foot">
      <a href={`${PORTAL_BASE}/app-store/`} class="portal-card-link">Manage Distribution &rarr;</a>
    </div>
  </div>

  {/* Bitrise MCP */}
  <div class="portal-card">
    <div>
      <div class="portal-card-topbar">
        <div class="portal-icon-badge badge-teal">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="4" y="4" width="16" height="16" rx="2"/>
            <rect x="9" y="9" width="6" height="6"/>
            <line x1="9" y1="1" x2="9" y2="4"/>
            <line x1="15" y1="1" x2="15" y2="4"/>
            <line x1="9" y1="20" x2="9" y2="23"/>
            <line x1="15" y1="20" x2="15" y2="23"/>
            <line x1="20" y1="9" x2="23" y2="9"/>
            <line x1="20" y1="14" x2="23" y2="14"/>
            <line x1="1" y1="9" x2="4" y2="9"/>
            <line x1="1" y1="14" x2="4" y2="14"/>
          </svg>
        </div>
        <h3 class="portal-card-title">Bitrise MCP</h3>
        <span class="portal-tag-pill">AI ASSISTANT</span>
      </div>
      <p class="portal-card-desc">
        Model Context Protocol gateway integration to inspect builds, trigger workflows, and debug CI/CD failures via AI chat.
      </p>
      <div class="portal-card-pills">
        <a href={`${PORTAL_BASE}/bitrise-mcp/`} class="portal-pill-link">MCP Overview</a>
        <a href={`${PORTAL_BASE}/bitrise-mcp/gateway-setup/`} class="portal-pill-link">Gateway Auth</a>
        <a href={`${PORTAL_BASE}/bitrise-mcp/cursor-copilot/`} class="portal-pill-link">IDE Integration</a>
      </div>
    </div>
    <div class="portal-card-foot">
      <a href={`${PORTAL_BASE}/bitrise-mcp/`} class="portal-card-link">Connect Bitrise MCP &rarr;</a>
    </div>
  </div>

  {/* CI/CD & Automation */}
  <div class="portal-card">
    <div>
      <div class="portal-card-topbar">
        <div class="portal-icon-badge badge-coral">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="23 4 23 10 17 10"/>
            <polyline points="1 20 1 14 7 14"/>
            <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/>
          </svg>
        </div>
        <h3 class="portal-card-title">CI/CD &amp; Automation</h3>
        <span class="portal-tag-pill">PIPELINES</span>
      </div>
      <p class="portal-card-desc">
        Bitrise shared workflows, camp.yml build declarative specs, Danger PR code review automation, and 80% coverage gates.
      </p>
      <div class="portal-card-pills">
        <a href={`${PORTAL_BASE}/cicd/`} class="portal-pill-link">Pipelines Overview</a>
        <a href={`${PORTAL_BASE}/cicd/camp-spec/`} class="portal-pill-link">camp.yml Spec</a>
        <a href={`${PORTAL_BASE}/cicd/danger-bot/`} class="portal-pill-link">Danger Inspection</a>
      </div>
    </div>
    <div class="portal-card-foot">
      <a href={`${PORTAL_BASE}/cicd/`} class="portal-card-link">View CI/CD Workflows &rarr;</a>
    </div>
  </div>

  {/* Development Platforms */}
  <div class="portal-card">
    <div>
      <div class="portal-card-topbar">
        <div class="portal-icon-badge badge-purple">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="16 18 22 12 16 6"/>
            <polyline points="8 6 2 12 8 18"/>
          </svg>
        </div>
        <h3 class="portal-card-title">Development Platforms</h3>
        <span class="portal-tag-pill">SDKs &amp; STACKS</span>
      </div>
      <p class="portal-card-desc">
        Native Android (Kotlin &amp; Compose), Native iOS (Swift &amp; SwiftUI), and Cross-Platform React Native standards.
      </p>
      <div class="portal-card-pills">
        <a href={`${PORTAL_BASE}/development-platforms/android/`} class="portal-pill-link">Android (Kotlin)</a>
        <a href={`${PORTAL_BASE}/development-platforms/ios/`} class="portal-pill-link">iOS (Swift)</a>
        <a href={`${PORTAL_BASE}/development-platforms/react-native/`} class="portal-pill-link">React Native</a>
      </div>
    </div>
    <div class="portal-card-foot">
      <a href={`${PORTAL_BASE}/development-platforms/`} class="portal-card-link">Browse Platforms &rarr;</a>
    </div>
  </div>

  {/* Push Notifications Backend */}
  <div class="portal-card">
    <div>
      <div class="portal-card-topbar">
        <div class="portal-icon-badge badge-amber">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
            <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
          </svg>
        </div>
        <h3 class="portal-card-title">Push Notifications Backend</h3>
        <span class="portal-tag-pill">MESSAGING</span>
      </div>
      <p class="portal-card-desc">
        Push architecture through Firebase Cloud Messaging (FCM), backend Java implementations, and the PushJS library.
      </p>
      <div class="portal-card-pills">
        <a href={`${PORTAL_BASE}/push-notifications-backend/firebase-cloud-messaging/`} class="portal-pill-link">Firebase FCM</a>
        <a href={`${PORTAL_BASE}/push-notifications-backend/java/`} class="portal-pill-link">Java Backend</a>
        <a href={`${PORTAL_BASE}/push-notifications-backend/pushjs/`} class="portal-pill-link">PushJS Library</a>
      </div>
    </div>
    <div class="portal-card-foot">
      <a href={`${PORTAL_BASE}/push-notifications-backend/`} class="portal-card-link">View Push Services &rarr;</a>
    </div>
  </div>

  {/* Guidelines & Governance */}
  <div class="portal-card">
    <div>
      <div class="portal-card-topbar">
        <div class="portal-icon-badge badge-green">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          </svg>
        </div>
        <h3 class="portal-card-title">Guidelines &amp; Governance</h3>
        <span class="portal-tag-pill">COMPLIANCE</span>
      </div>
      <p class="portal-card-desc">
        Enterprise security baselines, OWASP MASVS compliance, Git branching policies, PR rules, and quality standards.
      </p>
      <div class="portal-card-pills">
        <a href={`${PORTAL_BASE}/guidelines/`} class="portal-pill-link">Engineering Guidelines</a>
        <a href={`${PORTAL_BASE}/guidelines/security/`} class="portal-pill-link">Security Policies</a>
        <a href={`${PORTAL_BASE}/guidelines/branching/`} class="portal-pill-link">Branching Strategy</a>
      </div>
    </div>
    <div class="portal-card-foot">
      <a href={`${PORTAL_BASE}/guidelines/`} class="portal-card-link">View Guidelines &rarr;</a>
    </div>
  </div>

  {/* Engineering FAQs & Self-Service */}
  <div class="portal-card">
    <div>
      <div class="portal-card-topbar">
        <div class="portal-icon-badge badge-teal">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/>
            <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/>
            <line x1="12" y1="17" x2="12.01" y2="17"/>
          </svg>
        </div>
        <h3 class="portal-card-title">Engineering FAQs &amp; Self-Service</h3>
        <span class="portal-tag-pill">KNOWLEDGE BASE</span>
      </div>
      <p class="portal-card-desc">
        Instant keyword searchable runbooks and verified answers across workstation setups, SSL certs, Bitrise CI/CD, and App Store releases.
      </p>
      <div class="portal-card-pills">
        <a href={`${PORTAL_BASE}/faqs/`} class="portal-pill-link">Browse FAQs</a>
        <a href={`${PORTAL_BASE}/faqs/troubleshooting/`} class="portal-pill-link">Runbooks</a>
        <a href={`${PORTAL_BASE}/support/`} class="portal-pill-link">Live Support</a>
      </div>
    </div>
    <div class="portal-card-foot">
      <a href={`${PORTAL_BASE}/faqs/`} class="portal-card-link">Search FAQs &rarr;</a>
    </div>
  </div>

</div>

<div class="portal-support-spotlight">
  <div class="portal-support-spotlight-header" style="margin-bottom: 12px; padding-bottom: 12px;">
    <div style="display: flex; align-items: center; gap: 12px;">
      <div class="portal-icon-badge badge-green">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
        </svg>
      </div>
      <div>
        <div style="font-size: 1.15rem; font-weight: 800; color: var(--portal-gold, #f3d17b);">
          Need Live Technical Support or Incident Escalation?
        </div>
        <div style="font-size: 0.86rem; color: var(--portal-text-body, #cbd5e1);">
          Reach the on-call Mobile Platform Engineers in <code>#mobile-platform-support</code> or explore self-service engineering FAQs.
        </div>
      </div>
    </div>
    <span class="portal-support-live-pill">
      <span class="portal-support-pulse"></span>
      LIVE HELP &bull; P1 SLA
    </span>
  </div>
  <div style="display: flex; gap: 12px; flex-wrap: wrap;">
    <a href="https://teams.enterprise.internal/l/channel/mobile-platform-support" target="_blank" rel="noopener noreferrer" class="portal-support-cta" style="width: auto; margin-top: 0; padding: 10px 18px;">
      Ask in #mobile-platform-support &rarr;
    </a>
    <a href={`${PORTAL_BASE}/faqs/`} class="portal-download-btn portal-download-btn-secondary" style="padding: 10px 18px;">
      Browse Engineering FAQs
    </a>
    <a href={`${PORTAL_BASE}/support/`} class="portal-download-btn" style="padding: 10px 18px;">
      View Support Channels &amp; SLAs
    </a>
  </div>
</div>
