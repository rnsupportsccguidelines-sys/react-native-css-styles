import { useCallback, useEffect } from 'react';
import { useUserProfileStore } from '../store/useUserProfileStore';
import { userContainer } from '../../di/userContainer';

export function useUserProfile(userId: string) {
  const uiState = useUserProfileStore((state) => state.uiState);
  const setLoading = useUserProfileStore((state) => state.setLoading);
  const setSuccess = useUserProfileStore((state) => state.setSuccess);
  const setError = useUserProfileStore((state) => state.setError);

  const fetchProfile = useCallback(async () => {
    if (!userId) return;

    setLoading();
    try {
      const useCase = userContainer.resolveGetUserProfileUseCase();
      const domainUser = await useCase.execute(userId);
      setSuccess(domainUser);
    } catch (err: unknown) {
      const message = err instanceof Error ? err.message : 'An unexpected error occurred.';
      setError(message);
    }
  }, [userId, setLoading, setSuccess, setError]);

  useEffect(() => {
    fetchProfile();
  }, [fetchProfile]);

  return {
    uiState,
    refreshProfile: fetchProfile,
  };
}
