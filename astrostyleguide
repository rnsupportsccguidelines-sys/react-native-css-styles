package com.enterprise.mobile.core.foundation

import android.content.Context
import com.enterprise.mobile.core.security.vault.KeyStoreVault
import com.enterprise.mobile.core.localization.LocaleManager
import kotlinx.coroutines.CoroutineDispatcher
import kotlinx.coroutines.withContext
import javax.inject.Inject
import javax.inject.Singleton

@Singleton
class AppFoundationsImpl @Inject constructor(
    private val keyStoreVault: KeyStoreVault,
    private val ioDispatcher: CoroutineDispatcher
) : AppFoundations {

    @Volatile
    private var ready: Boolean = false

    override suspend fun initialize(context: Context): Result<Unit> =
        withContext(ioDispatcher) {
            try {
                // 1. Initialize hardware KeyStore and encryption keys
                keyStoreVault.getSecret("probe_key")

                // 2. Resolve per-app localization preferences
                LocaleManager.isRTL()

                ready = true
                Result.success(Unit)
            } catch (e: Exception) {
                ready = false
                Result.failure(e)
            }
        }

    override fun isReady(): Boolean = ready
}
```

