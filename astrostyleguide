## 1. Implement Danger in trusted review tooling

The latest handbook sets a **10-character trimmed PR body minimum**. This rewrite uses that source value instead of earlier 15/20 examples. The user's explicit assignee/reviewer requirement is blocking even though the handbook sample only warns for a missing assignee. Two completed approvals remain enforced by repository branch protection.

**File: `ci/review/prPolicy.ts` in the trusted tooling checkout.**

```typescript
export type PrInput = Readonly<{
  body: string;
  title: string;
  draft: boolean;
  assigneeCount: number;
  hasDesignatedReviewer: boolean;
  additions: number;
  deletions: number;
  changedFiles: readonly string[];
}>;

export type PrPolicy = Readonly<{
  minimumDescriptionLength: number;
  lockfile: string;
}>;

export type ReviewFindings = Readonly<{
  failures: readonly string[];
  warnings: readonly string[];
}>;

export function evaluatePr(input: PrInput, policy: PrPolicy): ReviewFindings {
  if (!Number.isSafeInteger(policy.minimumDescriptionLength) ||
      policy.minimumDescriptionLength < 1) {
    throw new Error('Invalid trusted description policy');
  }
  if (!policy.lockfile) throw new Error('Missing trusted lockfile policy');
  const failures: string[] = [];
  const warnings: string[] = [];
  if (input.body.trim().length < policy.minimumDescriptionLength) {
    failures.push('Provide the required description with context and verification.');
  }
  if (input.assigneeCount < 1) failures.push('Assign the PR to its responsible owner.');
  if (!input.hasDesignatedReviewer) failures.push('Designate the required reviewer or team.');
  const wip = /\[wip\]|\(wip\)|^\s*wip:/i.test(input.title);
  if (input.draft || wip) failures.push('Complete draft/WIP work before merge.');
  if (input.additions + input.deletions > 500) {
    warnings.push('More than 500 changed lines: consider a smaller review slice.');
  }
  const files = new Set(input.changedFiles);
  const isTest = (file: string): boolean =>
    /(?:\.(?:test|spec)\.[^/]+$|(?:^|\/)__tests__\/)/.test(file) ||
    /(?:^|\/)(?:Tests|UITests|androidTest|test)\//.test(file);
  const sourceChanged = input.changedFiles.some(file =>
    /(?:\.(?:kt|java|swift|js|jsx|ts|tsx))$/.test(file) && !isTest(file));
  const testsChanged = input.changedFiles.some(isTest);
  if (sourceChanged && !testsChanged) {
    warnings.push('Source changed without test-file changes: explain regression coverage.');
  }
  if (files.has('package.json') && !files.has(policy.lockfile)) {
    failures.push('Update the project lockfile with package.json under the supplied rule.');
  }
  return { failures, warnings };
}
```

**File: `dangerfile.ts` in that same checkout.**

```typescript
import { danger, fail, warn, markdown } from 'danger';
import { evaluatePr } from './ci/review/prPolicy';

const pr = danger.github.pr;
const rawDraft: unknown = 'draft' in pr ? pr.draft : undefined;
// Latest Master Handbook threshold; keep this file in trusted tooling.
const minimum = 10;

if (typeof rawDraft !== 'boolean' ||
    !Number.isSafeInteger(minimum) || minimum < 1) {
  fail('Required PR metadata or approved description policy is unavailable.');
} else {
  const requested = danger.github.requested_reviewers;
  const designated = requested.users.some(user => user.login !== pr.user.login) ||
    requested.teams.length > 0 ||
    danger.github.reviews.some(review =>
      review.user.login !== pr.user.login && review.user.type !== 'Bot');
  const findings = evaluatePr({
    body: pr.body ?? '',
    title: pr.title,
    draft: rawDraft,
    assigneeCount: pr.assignees?.length ?? (pr.assignee ? 1 : 0),
    hasDesignatedReviewer: designated,
    additions: pr.additions,
    deletions: pr.deletions,
    changedFiles: [
      ...danger.git.created_files,
      ...danger.git.modified_files,
      ...danger.git.deleted_files,
    ],
  }, {
    minimumDescriptionLength: minimum,
    lockfile: 'package-lock.json',
  });
  findings.failures.forEach(text => fail(text));
  findings.warnings.forEach(text => warn(text));
  markdown([
    '| PR policy result | Count |',
    '| :--- | ---: |',
    `| Failures | ${findings.failures.length} |`,
    `| Warnings | ${findings.warnings.length} |`,
  ].join('\n'));
}
```

