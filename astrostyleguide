<TabItem label="login.e2e.cjs — Appium">

Place this in `e2e/appium/`. The file uses the WebdriverIO Mocha runner. On Android, the selectors use the accessible labels. On iOS, they use the `testID` identifiers exposed by React Native. Inspect those elements on the actual target devices.

```javascript
const {browser, $, expect} = require('@wdio/globals');

function control(androidLabel, iosIdentifier) {
  return $(browser.isIOS ? `~${iosIdentifier}` : `~${androidLabel}`);
}

async function enterLogin(username, password) {
  const usernameField = control('Username', 'login.username');
  await usernameField.waitForDisplayed();
  await usernameField.setValue(username);

  const passwordField = control('Password', 'login.password');
  await passwordField.waitForDisplayed();
  await passwordField.setValue(password);

  const submit = control('Sign in', 'login.submit');
  await submit.waitForDisplayed();
  await submit.click();
}

describe('MyChickenapp Login device journey', () => {
  beforeEach(async () => {
    // The Reset demo button belongs to this synthetic teaching screen.
    const reset = control('Reset demo', 'login.reset');
    await reset.waitForDisplayed();
    await reset.click();
    await control('Username', 'login.username').waitForDisplayed();
  });

  it('shows an error for invalid credentials and stays on Login', async () => {
    await enterLogin('demo-user', 'wrong-password');

    const error = browser.isIOS
      ? await $('~login.error')
      : await $('~Invalid demo credentials.');
    await expect(error).toBeDisplayed();
    if (browser.isIOS) {
      await expect(error).toHaveAttribute('label', 'Invalid demo credentials.');
    } else {
      await expect(error).toHaveText('Invalid demo credentials.');
    }
    await expect(control('Home screen', 'home.heading')).not.toBeExisting();
    await expect(control('Username', 'login.username')).toBeDisplayed();
  });

  it('shows Home for valid demo credentials', async () => {
    await enterLogin('demo-user', 'demo-only');
    await expect(control('Home screen', 'home.heading')).toBeDisplayed();
    await expect(control('Username', 'login.username')).not.toBeExisting();
  });
});
```

The demo has an explicit Reset demo button to restore the fixture between tests. For real authentication, use the approved account/session reset procedure and test account isolation. If the selected device's keyboard covers a button, add the platform's reviewed dismissal or scroll action before tapping. [React Native accessibility](https://reactnative.dev/docs/accessibility)

