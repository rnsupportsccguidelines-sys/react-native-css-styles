### orderDomain.ts

Domain values, strict quantity parsing, repository contract, and use case.

```typescript
export type OrderRequest = Readonly<{
  accountId: string;
  requestId: string;
  itemId: string;
  quantity: number;
}>;
export type OrderOutcome =
  | Readonly<{ kind: 'confirmed'; orderId: string }>
  | Readonly<{ kind: 'invalid' }>
  | Readonly<{ kind: 'unknown' }>;
export interface OrderRepository {
  place(request: OrderRequest): Promise<OrderOutcome>;
}
export function parseQuantity(text: string): number | null {
  if (!/^[0-9]+$/.test(text)) return null;
  const quantity = Number(text);
  return Number.isSafeInteger(quantity) && quantity >= 1 && quantity <= 20
    ? quantity : null;
}
export function makePlaceChickenOrder(repository: OrderRepository) {
  return async (request: OrderRequest): Promise<OrderOutcome> => {
    if (![request.accountId, request.requestId, request.itemId].every(id => id.trim())
      || !Number.isSafeInteger(request.quantity)
      || request.quantity < 1 || request.quantity > 20) return { kind: 'invalid' };
    return repository.place(request);
  };
}
```

