kind: espresso # Use xcuitest for iOS, or appium for cross-platform
sauce:
  region: us-west-1
  concurrency: 2
  metadata:
    build: "Bitrise Build $BITRISE_BUILD_NUMBER"
    tags:
      - "staging"
      - "regression"

