**File: `data/resilience/CircuitBreaker.kt`**

Uses the project's existing `kotlinx-coroutines-core` dependency. State is mutex-protected; the network call runs outside the mutex. Non-cancellable finalization prevents a cancelled coroutine from stranding a half-open probe.

```kotlin
import kotlinx.coroutines.CancellationException
import kotlinx.coroutines.NonCancellable
import kotlinx.coroutines.currentCoroutineContext
import kotlinx.coroutines.ensureActive
import kotlinx.coroutines.sync.Mutex
import kotlinx.coroutines.sync.withLock
import kotlinx.coroutines.withContext

class CircuitOpenException : Exception("Dependency temporarily unavailable")

class CircuitBreaker(
    private val failureThreshold: Int,
    private val cooldownMillis: Long,
    private val countsAsFailure: (Exception) -> Boolean,
    private val nowMillis: () -> Long = { System.nanoTime() / 1_000_000 },
) {
    init {
        require(failureThreshold > 0)
        require(cooldownMillis > 0)
    }

    private enum class State { CLOSED, OPEN, HALF_OPEN }
    private enum class Outcome { SUCCESS, FAILURE, IGNORED, CANCELLED }
    private data class Ticket(val epoch: Long, val probe: Boolean)
    private val mutex = Mutex()
    private var state = State.CLOSED
    private var failures = 0
    private var openedAt = 0L
    private var epoch = 0L

    private suspend fun admit(): Ticket = mutex.withLock {
        when (state) {
            State.CLOSED -> Ticket(epoch, false)
            State.HALF_OPEN -> throw CircuitOpenException()
            State.OPEN -> {
                if (nowMillis() - openedAt < cooldownMillis) {
                    throw CircuitOpenException()
                }
                state = State.HALF_OPEN
                epoch += 1
                Ticket(epoch, true)
            }
        }
    }

    private fun open() {
        state = State.OPEN
        openedAt = nowMillis()
        failures = 0
        epoch += 1
    }

    private suspend fun finish(ticket: Ticket, outcome: Outcome) {
        withContext(NonCancellable) {
            mutex.withLock {
                if (ticket.epoch != epoch) return@withLock
                if (ticket.probe) {
                    if (outcome == Outcome.FAILURE || outcome == Outcome.CANCELLED) {
                        open()
                    } else {
                        state = State.CLOSED
                        failures = 0
                        epoch += 1
                    }
                } else when (outcome) {
                    Outcome.SUCCESS, Outcome.IGNORED -> failures = 0
                    Outcome.FAILURE -> {
                        failures += 1
                        if (failures >= failureThreshold) open()
                    }
                    Outcome.CANCELLED -> Unit
                }
            }
        }
    }

    suspend fun <T> execute(operation: suspend () -> T): T {
        currentCoroutineContext().ensureActive()
        val ticket = admit()
        val value: T
        try {
            currentCoroutineContext().ensureActive()
            value = operation()
            currentCoroutineContext().ensureActive()
        } catch (error: Exception) {
            val outcome = when {
                error is CancellationException -> Outcome.CANCELLED
                countsAsFailure(error) -> Outcome.FAILURE
                else -> Outcome.IGNORED
            }
            finish(ticket, outcome)
            throw error
        }
        finish(ticket, Outcome.SUCCESS)
        return value
    }
}
```

