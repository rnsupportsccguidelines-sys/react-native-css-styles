package com.enterprise.mobile.core.foundation

import android.content.Context
import androidx.startup.Initializer
import com.enterprise.mobile.core.di.FoundationEntryPoint
import dagger.hilt.android.EntryPointAccessors
import kotlinx.coroutines.CoroutineScope
import kotlinx.coroutines.Dispatchers
import kotlinx.coroutines.launch

/**
 * Jetpack App Startup Initializer to bootstrap foundations deterministically.
 */
class StartupInitializer : Initializer<Unit> {

    override fun create(context: Context) {
        val entryPoint = EntryPointAccessors.fromApplication(
            context.applicationContext,
            FoundationEntryPoint::class.java
        )
        val foundations = entryPoint.appFoundations()

        CoroutineScope(Dispatchers.Main.immediate).launch {
            foundations.initialize(context.applicationContext)
        }
    }

    override fun dependencies(): List<Class<out Initializer<*>>> = emptyList()
}
```

