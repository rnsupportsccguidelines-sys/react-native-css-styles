    ```typescript
    import { useState, useCallback } from 'react';

    // 1. Data Model
    export interface OrderItem {
      id: string;
      title: string;
      status: 'CONFIRMED' | 'PENDING' | 'CANCELLED';
      amountCents: number;
    }

    // 2. API Fetcher Function
    export const fetchOrdersApi = async (): Promise<OrderItem[]> => {
      const response = await fetch('https://api.enterprise.internal/api/v1/orders', {
        headers: { Accept: 'application/json' },
      });
      if (!response.ok) {
        throw new Error(`Server returned HTTP ${response.status}`);
      }
      return response.json();
    };

    // 3. UI State Hook
    export interface UseOrderListResult {
      orders: OrderItem[];
      loading: boolean;
      error: string | null;
      loadOrders: () => Promise<void>;
    }

    export const useOrderList = (fetcher = fetchOrdersApi): UseOrderListResult => {
      const [orders, setOrders] = useState<OrderItem[]>([]);
      const [loading, setLoading] = useState<boolean>(false);
      const [error, setError] = useState<string | null>(null);

      const loadOrders = useCallback(async () => {
        setLoading(true);
        setError(null);
        try {
          const data = await fetcher();
          setOrders(data);
        } catch (err: any) {
          setError(err.message || 'Failed to fetch orders');
        } finally {
          setLoading(false);
        }
      }, [fetcher]);

      return { orders, loading, error, loadOrders };
    };
    ```

    ### 2. Test File Implementation (`useOrderList.test.ts`)
    ```typescript
    import { renderHook, act } from '@testing-library/react-hooks';
    import { useOrderList, OrderItem } from './useOrderList';

    describe('useOrderList Hook Jest Unit Tests', () => {
      beforeEach(() => {
        jest.clearAllMocks();
      });

      it('loadOrders fetches items and updates orders list on success', async () => {
        // Arrange: Mock fetcher returning 2 items
        const mockOrders: OrderItem[] = [
          { id: 'ORD-101', title: 'Bulk Grain Shipment', status: 'CONFIRMED', amountCents: 125000 },
          { id: 'ORD-102', title: 'Feed Ingredients Batch A', status: 'PENDING', amountCents: 48000 },
        ];
        const mockFetcher = jest.fn().mockResolvedValue(mockOrders);

        const { result } = renderHook(() => useOrderList(mockFetcher));

        // Assert initial state
        expect(result.current.orders).toEqual([]);
        expect(result.current.loading).toBe(false);
        expect(result.current.error).toBeNull();

        // Act: Trigger API fetch
        await act(async () => {
          await result.current.loadOrders();
        });

        // Assert final state
        expect(mockFetcher).toHaveBeenCalledTimes(1);
        expect(result.current.loading).toBe(false);
        expect(result.current.error).toBeNull();
        expect(result.current.orders).toHaveLength(2);
        expect(result.current.orders[0].id).toBe('ORD-101');
        expect(result.current.orders[0].status).toBe('CONFIRMED');
      });

      it('loadOrders sets error state when API request fails', async () => {
        // Arrange: Mock fetcher rejecting with an error
        const errorMessage = 'Server returned HTTP 500';
        const mockFetcher = jest.fn().mockRejectedValue(new Error(errorMessage));

        const { result } = renderHook(() => useOrderList(mockFetcher));

        // Act
        await act(async () => {
          await result.current.loadOrders();
        });

        // Assert
        expect(mockFetcher).toHaveBeenCalledTimes(1);
        expect(result.current.loading).toBe(false);
        expect(result.current.orders).toEqual([]);
        expect(result.current.error).toBe(errorMessage);
      });
    });
