import messaging, { FirebaseMessagingTypes } from '@react-native-firebase/messaging';
import { Linking } from 'react-native';

export class PushNotificationService {

  static async initialize(): Promise<void> {
    const authStatus = await messaging().requestPermission();
    const enabled =
      authStatus === messaging.AuthorizationStatus.AUTHORIZED ||
      authStatus === messaging.AuthorizationStatus.PROVISIONAL;

    if (!enabled) return;

    // Retrieve FCM Device Token
    const token = await messaging().getToken();
    console.log('FCM Registration Token:', token);

    // Foreground Notification Listener
    messaging().onMessage(async (remoteMessage: FirebaseMessagingTypes.RemoteMessage) => {
      console.log('Foreground Push Message Received:', remoteMessage);
    });

    // Background Tap Notification Listener
    messaging().onNotificationOpenedApp((remoteMessage: FirebaseMessagingTypes.RemoteMessage) => {
      const link = remoteMessage.data?.deep_link;
      if (typeof link === 'string') {
        Linking.openURL(link);
      }
    });

    // Cold-Start Push Notification Tap
    const initialNotification = await messaging().getInitialNotification();
    if (initialNotification?.data?.deep_link) {
      Linking.openURL(initialNotification.data.deep_link as string);
    }
  }
}
