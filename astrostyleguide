import kotlinx.coroutines.test.StandardTestDispatcher
import kotlinx.coroutines.test.runCurrent
import kotlinx.coroutines.test.runTest
import org.junit.Assert.assertEquals
import org.junit.Assert.assertFalse
import org.junit.Assert.assertNull
import org.junit.Assert.assertTrue
import org.junit.Test

@OptIn(ExperimentalCoroutinesApi::class)
class UserProfileViewModelTest {
    private val cached = UserDomainModel(
        id = "user-1",
        name = "Sample User",
        email = "sample@example.invalid",
        isVip = false,
        cachedAtMillis = 1L,
    )

    private class FakeRepository : UserRepository {
        var cachedValue: UserDomainModel? = null
        var refresh: suspend (ProfileKey) -> UserDomainModel = {
            error("Configure the expected refresh in this test")
        }
        override suspend fun cachedProfile(key: ProfileKey) = cachedValue
        override suspend fun refreshProfile(key: ProfileKey) = refresh(key)
    }

    // The production contract requires diagnostics to be non-throwing.
    private val diagnostics = object : ProfileDiagnostics {
        override fun report(stage: String, failure: ProfileFailure) = Unit
    }

    @Test
    fun refreshFailureKeepsCachedContent() = runTest {
        val repository = FakeRepository().apply {
            cachedValue = cached
            refresh = { throw ProfileException(ProfileFailure.HTTP_ERROR) }
        }
        val model = UserProfileViewModel(
            GetUserProfileUseCase(repository),
            diagnostics,
            StandardTestDispatcher(testScheduler),
        )
        model.load("account-a", "user-1")

        assertEquals(cached, model.state.value.user)
        assertEquals(ProfileFailure.HTTP_ERROR, model.state.value.failure)
        assertFalse(model.state.value.isRefreshing)
    }

    @Test
    fun deniedAccessClearsDisplayedContent() = runTest {
        val repository = FakeRepository().apply {
            cachedValue = cached
            refresh = { throw ProfileException(ProfileFailure.ACCESS_DENIED) }
        }
        val model = UserProfileViewModel(
            GetUserProfileUseCase(repository),
            diagnostics,
            StandardTestDispatcher(testScheduler),
        )
        model.load("account-a", "user-1")

        assertNull(model.state.value.user)
        assertEquals(ProfileFailure.ACCESS_DENIED, model.state.value.failure)
        assertFalse(model.state.value.isRefreshing)
    }

    @Test
    fun cancellingVisibleLoadDoesNotBecomeAnError() = runTest {
        val refreshStarted = CompletableDeferred<Unit>()
        val repository = FakeRepository().apply {
            cachedValue = cached
            refresh = {
                refreshStarted.complete(Unit)
                CompletableDeferred<UserDomainModel>().await()
            }
        }
        val model = UserProfileViewModel(
            GetUserProfileUseCase(repository),
            diagnostics,
            StandardTestDispatcher(testScheduler),
        )
        val job = launch { model.load("account-a", "user-1") }
        runCurrent()
        assertTrue(refreshStarted.isCompleted)
        job.cancel(CancellationException("Synthetic navigation"))
        job.join()

        assertEquals(cached, model.state.value.user)
        assertNull(model.state.value.failure)
        assertFalse(model.state.value.isRefreshing)
    }
}
