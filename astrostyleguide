                    color = Color(0xFFEF4444),
                    modifier = Modifier.align(Alignment.Center)
                )
            }
            is OrderUiState.Success -> {
                LazyColumn(verticalArrangement = Arrangement.spacedBy(10.dp)) {
                    items(state.orders) { order ->
                        Card(
                            colors = CardDefaults.cardColors(containerColor = Color(0xFF13251C)),
                            modifier = Modifier.fillMaxWidth()
                        ) {
                            Column(modifier = Modifier.padding(14.dp)) {
                                Text(order.orderNumber, color = Color(0xFFF3D17B), style = MaterialTheme.typography.titleMedium)
                                Text(order.status, color = Color(0xFFCBD5E1), style = MaterialTheme.typography.bodyMedium)
                            }
                        }
                    }
                }
            }
        }
    }
