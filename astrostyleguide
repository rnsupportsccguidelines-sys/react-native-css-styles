import Foundation
import SwiftData

/// Actor-isolated repository managing persistence synchronization and network fallback.
public final class UserRepositoryImpl: UserRepository, @unchecked Sendable {
    private let session: URLSession
    private let baseURL: URL
    private let modelContainer: ModelContainer

    public init(
        session: URLSession = .shared,
        baseURL: URL,
        modelContainer: ModelContainer
    ) {
        self.session = session
        self.baseURL = baseURL
        self.modelContainer = modelContainer
    }

    public func fetchUserProfile(userId: String) async throws -> UserDomainModel {
        // 1. Check for Task cooperative cancellation
        try Task.checkCancellation()

        let context = ModelContext(modelContainer)

        // 2. Network-first fetch with offline database fallback
        do {
            let request = UserEndpoint.userProfileRequest(userId: userId, baseURL: baseURL)
            let (data, response) = try await session.data(for: request)

            guard let httpResponse = response as? HTTPURLResponse,
                  (200...299).contains(httpResponse.statusCode) else {
                throw URLError(.badServerResponse)
            }

            let dto = try JSONDecoder().decode(UserNetworkDTO.self, from: data)

            // Cache entity into SwiftData
            let persistent = dto.toPersistentModel()
            context.insert(persistent)
            try context.save()

            return dto.toDomainModel()
        } catch {
            // Rethrow cooperative cancellation immediately
            if error is CancellationError { throw error }

            // 3. Fallback to cached SwiftData record on network failure
            let descriptor = FetchDescriptor<UserPersistentModel>(
                predicate: #Predicate { $0.id == userId }
            )

            if let cached = try? context.fetch(descriptor).first {
                return cached.toDomainModel()
            }

            throw error
        }
    }

    public func observeUserProfile(userId: String) -> AsyncStream<UserDomainModel?> {
        AsyncStream { continuation in
            let context = ModelContext(modelContainer)
            let descriptor = FetchDescriptor<UserPersistentModel>(
                predicate: #Predicate { $0.id == userId }
            )

            if let cached = try? context.fetch(descriptor).first {
                continuation.yield(cached.toDomainModel())
            }

            continuation.onTermination = { _ in }
        }
    }
}
