  screenKey: string;
  userId: string;
  isActive: boolean;
}>;

export function UserProfileRoute({ screenKey, userId, isActive }: RouteProps) {
  const { state, refresh } = useUserProfile(screenKey, userId, isActive);
  // Avoid showing the prior screen entry for a frame when route params change.
  const visibleState = state.user?.id !== userId.trim()
    ? { ...state, user: null } : state;
  return <UserProfileView state={visibleState} onRefresh={refresh} isActive={isActive} />;
}

export function UserProfileView({ state, onRefresh, isActive }: Readonly<{
  state: UserProfileUIState;
  onRefresh: () => void;
  isActive: boolean;
}>) {
  const disabled = !isActive || state.isRefreshing;
  return (
    <SafeAreaView style={styles.root}>
      <ScrollView contentContainerStyle={styles.content}>
        <Text accessibilityRole="header" style={styles.title}>User profile</Text>
        {state.isRefreshing && (
          <View style={styles.progress}>
            <ActivityIndicator accessibilityLabel="Profile loading" />
            <Text>{state.user ? 'Refreshing…' : 'Loading profile…'}</Text>
          </View>
        )}
        {state.user && (
          <View style={styles.card}>
            <Text style={styles.name}>{state.user.name}</Text>
            <Text style={styles.secondary}>{state.user.email}</Text>
            {state.user.isVip && <Text style={styles.badge}>VIP account</Text>}
          </View>
        )}
        {state.message && (
          <Text accessibilityLiveRegion="polite" style={styles.secondary}>{state.message}</Text>
        )}
        {!state.user && !state.isRefreshing && !state.message && <Text>No saved profile is available.</Text>}
        <Pressable
          accessibilityRole="button"
          accessibilityState={{ disabled, busy: state.isRefreshing }}
          disabled={disabled}
          onPress={onRefresh}
          style={[styles.button, disabled && styles.disabled]}
        >
          <Text style={styles.buttonText}>{state.message ? 'Retry' : 'Refresh profile'}</Text>
        </Pressable>
      </ScrollView>
    </SafeAreaView>
  );
}

