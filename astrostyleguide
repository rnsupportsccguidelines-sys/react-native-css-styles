import SwiftUI

@main
struct EnterpriseMobileApp: App {
    @State private var isFoundationsReady: Bool = false
    @State private var launchError: Error?

    var body: some Scene {
        WindowGroup {
            Group {
                if isFoundationsReady {
                    RootContentView()
                } else if let error = launchError {
                    FoundationErrorView(error: error)
                } else {
                    FoundationSplashView()
                }
            }
            .task {
                do {
                    try await AppFoundationsCoordinator.shared.initialize()
                    isFoundationsReady = true
                } catch {
                    launchError = error
                }
            }
        }
    }
}
