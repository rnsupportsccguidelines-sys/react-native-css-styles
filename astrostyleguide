### B. Copy the helper

**File:** `src/links/DeepLinkService.ts`.

```typescript
// Teaching contract only: replace through an approved application routing decision.
export const UPDATE_URL = 'https://links.example.invalid/updates';

export class DeepLinkService {
  private pending = false;
  private draining = false;

  accept(raw: string): boolean {
    // Strict equality deliberately rejects query strings, fragments, extra paths,
    // credentials, alternate ports, whitespace, encodings and lookalike hosts.
    if (raw !== UPDATE_URL) return false;
    this.pending = true;
    return true;
  }

  consumeIfReady(openAuthorizedUpdates: () => boolean): void {
    if (!this.pending || this.draining) return;
    this.draining = true;
    this.pending = false;
    try {
      if (!openAuthorizedUpdates()) this.pending = true;
    } catch {
      this.pending = true;
      throw new Error('Authorized link handling failed');
    } finally {
      this.draining = false;
    }
  }

  clear(): void { this.pending = false; }
}

export const deepLinkService = new DeepLinkService();
```

### C. Wire initial and subsequent URLs

Merge this into the existing stable root/session coordinator. It owns link receipt; do not also enable an independent navigation-library linking configuration for the same URLs:

```tsx
import { useEffect } from 'react';
import { Linking } from 'react-native';
import { deepLinkService } from './src/links/DeepLinkService';

// Inside the existing component. attemptOpen and reportLinkFailure are stable,
// host-provided functions; attemptOpen applies readiness/auth/account checks.
useEffect(() => {
  let active = true;
  let receivedLiveURL = false;
  const receive = (url: string) => {
    if (deepLinkService.accept(url)) attemptOpen();
  };
  const subscription = Linking.addEventListener('url', ({ url }) => {
    receivedLiveURL = true;
    receive(url);
  });
  void Linking.getInitialURL().then(url => {
    // Do not let a late initial URL overwrite a newer live URL in this binding.
    if (active && !receivedLiveURL && url) receive(url);
  }).catch(() => { if (active) reportLinkFailure(); });
  return () => { active = false; subscription.remove(); };
}, [attemptOpen, reportLinkFailure]);
```

The host's `attemptOpen` calls:

```typescript
deepLinkService.consumeIfReady(() => {
  // Return true only when the existing authorized updates action accepts the intent.
  return false; // Required replacement; not a working navigation implementation.
});
```

Invoke it again when startup/authentication/navigation becomes ready. Preserve the Redux Toolkit store and existing providers. Keep callbacks stable so rerenders do not repeatedly re-read the initial URL. The host must clear pending state on logout/account replacement and prevent old-account callbacks from navigating.

This is a manual generic-route adapter. If the app already uses React Navigation's `linking` integration, adapt that existing single owner instead of creating a second independent receiver. Reuse the validation/authentication boundary whichever library owns dispatch.

