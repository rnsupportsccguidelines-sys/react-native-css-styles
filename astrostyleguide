### B. Copy `FcmService.swift`

```swift
import Foundation
import FirebaseCore
@preconcurrency import FirebaseMessaging

@MainActor
final class FcmService: NSObject, MessagingDelegate {
    static let shared = FcmService()
    private var started = false
    private var apnsReady = false
    private var enqueueTokenSync: ((String) -> Void)?
    private var onFailure: (() -> Void)?
    private override init() { super.init() }

    // Call during application startup, before registering for APNs.
    func start(
        enqueueTokenSync: @escaping (String) -> Void,
        onFailure: @escaping () -> Void
    ) {
        self.enqueueTokenSync = enqueueTokenSync
        self.onFailure = onFailure
        guard !started else { return }
        if FirebaseApp.app() == nil { FirebaseApp.configure() }
        Messaging.messaging().delegate = self
        started = true
    }

    // AppDelegate forwards the APNs token; backend receives the FCM token instead.
    func acceptAPNsToken(_ token: Data) {
        Messaging.messaging().apnsToken = token
        Messaging.messaging().isAutoInitEnabled = true
        apnsReady = true
        refreshRegistration()
    }

    // Invoke again after sign-in/account/preference changes as appropriate.
    func refreshRegistration() {
        guard started, apnsReady else { return }
        Messaging.messaging().token { token, error in
            let failed = error != nil
            Task { @MainActor in
                if !failed, let token, !token.isEmpty {
                    self.enqueueTokenSync?(token)
                } else {
                    self.onFailure?()
                }
            }
        }
    }

    nonisolated func messaging(
        _ messaging: Messaging,
        didReceiveRegistrationToken fcmToken: String?
    ) {
        guard let token = fcmToken, !token.isEmpty else { return }
        Task { @MainActor in self.enqueueTokenSync?(token) }
    }
}
```

