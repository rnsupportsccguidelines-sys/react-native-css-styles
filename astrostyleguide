import Foundation

/// Single-responsibility use case enforcing business validation.
/// Completely decoupled from UI and transport mechanisms.
public struct GetUserProfileUseCase: Sendable {
    private let userRepository: UserRepository

    public init(userRepository: UserRepository) {
        self.userRepository = userRepository
    }

    public func execute(userId: String) async throws -> UserDomainModel {
        let trimmedId = userId.trimmingCharacters(in: .whitespacesAndNewlines)
        guard !trimmedId.isEmpty else {
            throw UserDomainError.invalidUserId("User ID must not be empty or blank.")
        }
        return try await userRepository.fetchUserProfile(userId: trimmedId)
    }
}

public enum UserDomainError: LocalizedError, Sendable {
    case invalidUserId(String)
    case userNotFound(String)

    public var errorDescription: String? {
        switch self {
        case .invalidUserId(let message): return message
        case .userNotFound(let id): return "User profile not found for identifier: \(id)"
        }
    }
}
