```typescript
import type { UserDomainModel, ProfileErrorCode, GetUserProfileUseCase } from '../../domain/profile';

export interface UserProfileUIState {
  readonly user: UserDomainModel | null;
  readonly isRefreshing: boolean;
  readonly message: string | null;
}
export const initialProfileState: UserProfileUIState = Object.freeze({
  user: null, isRefreshing: false, message: null,
});

/** Non-throwing diagnostics adapter: report categories, never credentials or payloads. */
export type ProfileDiagnostics = (event: Readonly<{
  stage: 'cache-read' | 'refresh';
  code: ProfileErrorCode | 'unexpected';
}>) => void;

export interface ProfileDependencies {
  readonly useCase: GetUserProfileUseCase;
  readonly report: ProfileDiagnostics;
}

export interface ProfileLoadArg {
  readonly screenKey: string;
  readonly userId: string;
}

export interface ProfileFailure {
  readonly code: ProfileErrorCode | 'unexpected';
  readonly message: string;
  readonly clearContent: boolean;
}
```

The slice stores a separate entry for each navigation screen instance. Each entry tracks the latest request ID, so one screen cannot overwrite another screen's state and an old request cannot clear a newer loading indicator.

### `src/features/user/presentation/state/profileSlice.ts`

```typescript
import { createAsyncThunk, createSlice, type PayloadAction } from '@reduxjs/toolkit';
import { checkCancellation, isCancellation, ProfileError, type UserDomainModel } from '../../domain/profile';
import {
  initialProfileState, type ProfileDependencies, type ProfileFailure,
  type ProfileLoadArg, type UserProfileUIState,
} from './profileTypes';

interface ProfileEntry extends UserProfileUIState {
  readonly userId: string;
  readonly requestId: string | null;
}
export interface ProfilesState {
  readonly entries: Record<string, ProfileEntry | undefined>;
}
const initialState: ProfilesState = { entries: {} };

// JSON encoding prevents arbitrary route keys from becoming prototype property names.
export const profileEntryKey = (screenKey: string): string => JSON.stringify([screenKey]);

function toFailure(error: unknown): ProfileFailure {
  const code = error instanceof ProfileError ? error.code : 'unexpected';
  const clearContent = ['unauthorized', 'forbidden', 'not-found', 'cache-invalidation'].includes(code);
  const message = code === 'invalid-id' ? 'A valid user ID is required.'
    : code === 'unauthorized' ? 'Your session has expired. Please sign in again.'
    : code === 'forbidden' ? 'You do not have access to this profile.'
    : code === 'not-found' ? 'This profile is no longer available.'
    : code === 'cache-invalidation' ? 'Profile access could not be verified. Please sign in again.'
    : 'Unable to refresh the profile. Please try again.';
  return { code, message, clearContent: clearContent || code === 'invalid-id' };
}

export const loadUserProfile = createAsyncThunk<
  UserDomainModel,
  ProfileLoadArg,
  {
    state: { profiles: ProfilesState };
    extra: ProfileDependencies;
    rejectValue: ProfileFailure;
  }
>('profiles/load', async (arg, api) => {
  const { extra, signal, requestId, dispatch, getState, rejectWithValue } = api;
  const key = profileEntryKey(arg.screenKey);
  const isCurrent = (): boolean => getState().profiles.entries[key]?.requestId === requestId;
  try {
    const userId = extra.useCase.normalizeId(arg.userId);
    checkCancellation(signal);
    try {
      const cached = await extra.useCase.cachedProfile(userId);
      checkCancellation(signal);
      if (!isCurrent()) throw new ProfileError('cancelled');
      dispatch(profilesSlice.actions.cacheLoaded({ screenKey: arg.screenKey, requestId, user: cached }));
    } catch (error: unknown) {
      if (isCancellation(error, signal) || !isCurrent()) throw new ProfileError('cancelled');
      extra.report({ stage: 'cache-read', code: toFailure(error).code });
      // A disposable cache failure must not prevent a recoverable remote fetch.
    }
    const user = await extra.useCase.refreshProfile(userId, signal);
    checkCancellation(signal);
    if (!isCurrent()) throw new ProfileError('cancelled');
    return user;
  } catch (error: unknown) {
    if (isCancellation(error, signal) || !isCurrent()) {
      return rejectWithValue({ code: 'cancelled', message: '', clearContent: false });
    }
    const failure = toFailure(error);
    extra.report({ stage: 'refresh', code: failure.code });
    return rejectWithValue(failure);
  }
});

const profilesSlice = createSlice({
  name: 'profiles',
  initialState,
  reducers: {
    cacheLoaded(state, action: PayloadAction<{
      screenKey: string; requestId: string; user: UserDomainModel | null;
    }>) {
      const entry = state.entries[profileEntryKey(action.payload.screenKey)];
      if (entry?.requestId === action.payload.requestId) entry.user = action.payload.user;
    },
    profileRemoved(state, action: PayloadAction<string>) {
      delete state.entries[profileEntryKey(action.payload)];
    },
    profilesCleared: () => initialState,
  },
  extraReducers: (builder) => {
    builder.addCase(loadUserProfile.pending, (state, action) => {
      const key = profileEntryKey(action.meta.arg.screenKey);
      const previous = state.entries[key];
      state.entries[key] = {
        user: previous?.userId === action.meta.arg.userId ? previous.user : null,
        userId: action.meta.arg.userId,
        requestId: action.meta.requestId,
        isRefreshing: true,
        message: null,
      };
    });
    builder.addCase(loadUserProfile.fulfilled, (state, action) => {
      const entry = state.entries[profileEntryKey(action.meta.arg.screenKey)];
      if (entry?.requestId !== action.meta.requestId) return;
      entry.user = action.payload;
      entry.isRefreshing = false;
      entry.message = null;
      entry.requestId = null;
    });
    builder.addCase(loadUserProfile.rejected, (state, action) => {
      const entry = state.entries[profileEntryKey(action.meta.arg.screenKey)];
      if (entry?.requestId !== action.meta.requestId) return;
      entry.isRefreshing = false;
      entry.requestId = null;
      if (action.meta.aborted || action.payload?.code === 'cancelled') return;
      entry.message = action.payload?.message ?? 'Unable to load the profile. Please try again.';
      if (action.payload?.clearContent) entry.user = null;
    });
  },
});

export const { profileRemoved, profilesCleared } = profilesSlice.actions;
export const profilesReducer = profilesSlice.reducer;
export const selectProfile = (
  state: { profiles: ProfilesState }, screenKey: string,
): UserProfileUIState => state.profiles.entries[profileEntryKey(screenKey)] ?? initialProfileState;
```

<Aside type="tip" title="Hint · draft mutation is valid inside createSlice">
Assignments such as `entry.user = action.payload` are intentional: Redux Toolkit uses Immer to produce immutable updates from these reducer drafts. Do not mutate selected Redux objects in components, hooks, repositories, or ordinary functions. Keep reducers free of HTTP, storage, logging, and navigation effects.
</Aside>

`rejectWithValue` carries a typed, serializable failure contract. Abort actions stop progress without becoming error banners. The request-ID check applies to cached content, success, and failure—not just to the final network result. Unknown technical failures map to safe UI copy instead of raw exception messages.

