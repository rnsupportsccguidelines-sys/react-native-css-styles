    classDef domainLayer fill:#e0f2fe,stroke:#0284c7,stroke-width:2px,color:#0369a1;
    classDef dataLayer fill:#dcfce7,stroke:#16a34a,stroke-width:2px,color:#14532d;
    classDef networkLayer fill:#fef3c7,stroke:#d97706,stroke-width:2px,color:#78350f;
