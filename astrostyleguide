### `PlaceChickenOrder.swift` — sample application code

```swift
import Foundation

struct ChickenItem: Sendable {
    let id: String
    let unitPriceMinor: Int64
    let available: Bool
}
struct OrderRequest: Sendable, Equatable {
    let requestId: String
    let itemId: String
    let quantity: Int
}
struct OrderReceipt: Sendable, Equatable { let orderId: String }
protocol OrderGateway: Sendable {
    func place(_ request: OrderRequest) async throws -> OrderReceipt
}
enum OrderFailure: Error, Equatable {
    case invalidItem, unavailable, invalidQuantity, invalidPrice, invalidTotal
    case invalidRequestId, alreadySubmitting, invalidReceipt
}

func quote(_ item: ChickenItem, quantity: Int) throws -> Int64 {
    if item.id.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty {
        throw OrderFailure.invalidItem
    }
    guard item.available else { throw OrderFailure.unavailable }
    guard (1...20).contains(quantity) else { throw OrderFailure.invalidQuantity }
    guard item.unitPriceMinor > 0 else { throw OrderFailure.invalidPrice }
    let (total, overflow) = item.unitPriceMinor.multipliedReportingOverflow(by: Int64(quantity))
    guard !overflow else { throw OrderFailure.invalidTotal }
    return total
}

// Retain one instance for the active order flow, not one per tap.
actor PlaceChickenOrder {
    private let gateway: any OrderGateway
    private var submitting = false
    init(gateway: any OrderGateway) { self.gateway = gateway }

    func place(_ item: ChickenItem, quantity: Int,
               requestId: String) async throws -> OrderReceipt {
        _ = try quote(item, quantity: quantity)
        guard !requestId.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty else {
            throw OrderFailure.invalidRequestId
        }
        guard !submitting else { throw OrderFailure.alreadySubmitting }
        submitting = true
        defer { submitting = false }
        let receipt = try await gateway.place(OrderRequest(
            requestId: requestId, itemId: item.id, quantity: quantity))
        guard !receipt.orderId.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty else {
            throw OrderFailure.invalidReceipt
        }
        return receipt
    }
}
```

### `PlaceChickenOrderTests.swift` — deterministic async tests

The fake actor provides an explicit start/finish gate for the concurrent-submission test; no timing sleeps are used.

```swift
import XCTest
@testable import MyChickenApp // Replace with the actual product module.

private actor FakeOrderGateway: OrderGateway {
    enum Mode: Sendable { case success, failure, empty, suspended }
    enum ServiceFailure: Error { case unavailable }
    private(set) var calls: [OrderRequest] = []
    private let mode: Mode
    private var pending: CheckedContinuation<OrderReceipt, any Error>?
    private var startedWaiters: [CheckedContinuation<Void, Never>] = []
    init(_ mode: Mode = .success) { self.mode = mode }

    func place(_ request: OrderRequest) async throws -> OrderReceipt {
        calls.append(request)
        switch mode {
        case .success: return OrderReceipt(orderId: "order-001")
        case .failure: throw ServiceFailure.unavailable
        case .empty: return OrderReceipt(orderId: " ")
        case .suspended:
            return try await withCheckedThrowingContinuation { continuation in
                pending = continuation
                startedWaiters.forEach { $0.resume() }
                startedWaiters.removeAll()
            }
        }
    }
    func waitUntilStarted() async {
        if pending != nil { return }
        await withCheckedContinuation { startedWaiters.append($0) }
    }
    func finish() {
        pending?.resume(returning: OrderReceipt(orderId: "order-001"))
        pending = nil
    }
}

@MainActor
final class PlaceChickenOrderTests: XCTestCase {
    private let item = ChickenItem(id: "chicken-grilled", unitPriceMinor: 1250, available: true)

    func testCalculatesTotal() throws {
        XCTAssertEqual(try quote(item, quantity: 1), 1250)
        XCTAssertEqual(try quote(item, quantity: 2), 2500)
        XCTAssertEqual(try quote(item, quantity: 20), 25000)
    }

    func testInvalidInputsNeverSubmit() async {
        let gateway = FakeOrderGateway()
        let service = PlaceChickenOrder(gateway: gateway)
        let cases: [(ChickenItem, Int, String, OrderFailure)] = [
            (item, 0, "request-001", .invalidQuantity),
            (item, -1, "request-001", .invalidQuantity),
            (item, 21, "request-001", .invalidQuantity),
            (ChickenItem(id: item.id, unitPriceMinor: 1250, available: false), 1, "request-001", .unavailable),
            (ChickenItem(id: " ", unitPriceMinor: 1250, available: true), 1, "request-001", .invalidItem),
            (ChickenItem(id: item.id, unitPriceMinor: 0, available: true), 1, "request-001", .invalidPrice),
            (ChickenItem(id: item.id, unitPriceMinor: Int64.max, available: true), 2, "request-001", .invalidTotal),
            (item, 1, " ", .invalidRequestId)
        ]
        for (selected, quantity, id, expected) in cases {
            do {
                _ = try await service.place(selected, quantity: quantity, requestId: id)
                XCTFail("Expected validation failure")
            } catch { XCTAssertEqual(error as? OrderFailure, expected) }
        }
        let calls = await gateway.calls
        XCTAssertTrue(calls.isEmpty)
    }

    func testReturnsActualConfirmationAndForwardsIdentity() async throws {
