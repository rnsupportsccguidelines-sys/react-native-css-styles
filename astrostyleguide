const path = require('node:path');

function required(name) {
  const value = process.env[name];
  if (!value || value.includes('REPLACE_WITH_')) {
    throw new Error(`Missing approved runtime input: ${name}`);
  }
  return value;
}

const platform = required('MOBILE_TEST_PLATFORM');
if (!['android', 'ios'].includes(platform)) {
  throw new Error('MOBILE_TEST_PLATFORM must be android or ios');
}
const region = required('MOBILE_SAUCE_REGION');
if (!['us', 'eu'].includes(region)) {
  throw new Error('This example supports approved us or eu region mappings');
}
const appRef = required('MOBILE_SAUCE_APP_REF');
if (!/^storage:[^\s]+$/.test(appRef) || appRef.startsWith('storage:filename=')) {
  throw new Error('Use the storage reference for the exact uploaded app file');
}
const appRoot = required('MOBILE_APP_CHECKOUT');
if (!path.isAbsolute(appRoot)) {
  throw new Error('MOBILE_APP_CHECKOUT must be an absolute checkout path');
}

exports.config = {
