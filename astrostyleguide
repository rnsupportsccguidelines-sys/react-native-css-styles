```kotlin
package com.example.mychicken.notifications

import android.Manifest
import android.app.NotificationChannel
import android.app.NotificationManager
import android.app.PendingIntent
import android.content.Context
import android.content.Intent
import android.content.pm.PackageManager
import android.os.Build
import androidx.core.app.NotificationCompat
import androidx.core.app.NotificationManagerCompat
import androidx.core.content.ContextCompat
import com.example.mychicken.R

object NotificationService {
    const val CHANNEL_ID = "app_updates"
    private const val OPEN_EXTRA = "mychicken.notification_open"
    private var pendingOpen = false // Access only on the main thread.

    fun createChannel(context: Context) {
        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
            val channel = NotificationChannel(
                CHANNEL_ID, context.getString(R.string.push_channel_name),
                NotificationManager.IMPORTANCE_DEFAULT,
            )
            context.getSystemService(NotificationManager::class.java)
                .createNotificationChannel(channel)
        }
    }

    fun canPost(context: Context): Boolean {
        val runtimeAllowed = Build.VERSION.SDK_INT < 33 ||
            ContextCompat.checkSelfPermission(context, Manifest.permission.POST_NOTIFICATIONS) ==
            PackageManager.PERMISSION_GRANTED
        return runtimeAllowed && NotificationManagerCompat.from(context).areNotificationsEnabled()
    }

    fun showUpdate(context: Context, messageId: String?) {
        if (!canPost(context)) return
        createChannel(context)
        val launch = context.packageManager.getLaunchIntentForPackage(context.packageName) ?: return
        launch.addFlags(Intent.FLAG_ACTIVITY_CLEAR_TOP or Intent.FLAG_ACTIVITY_SINGLE_TOP)
        launch.putExtra(OPEN_EXTRA, true)
        val pendingIntent = PendingIntent.getActivity(
            context, 0, launch, PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_IMMUTABLE,
        )
        val notification = NotificationCompat.Builder(context, CHANNEL_ID)
            .setSmallIcon(R.drawable.ic_stat_notification)
            .setContentTitle(context.getString(R.string.push_title))
            .setContentText(context.getString(R.string.push_body))
            .setContentIntent(pendingIntent)
            .setAutoCancel(true)
            .build()
        try {
            // Same provider ID replaces the matching local notification. This is
            // not an exactly-once guarantee or business-operation deduplication.
            NotificationManagerCompat.from(context)
                .notify(messageId ?: "generic-update", 1, notification)
        } catch (_: SecurityException) {
            // Permission may change between checking and posting. Do not retry/spam.
        }
    }

    // Call on main thread from the existing Activity.onCreate/onNewIntent.
    fun captureOpen(intent: Intent?) {
        if (intent == null) return
        val fromNotification = intent.getBooleanExtra(OPEN_EXTRA, false) ||
            intent.hasExtra("google.message_id")
        if (fromNotification) {
            pendingOpen = true
            intent.removeExtra(OPEN_EXTRA)
            intent.removeExtra("google.message_id")
        }
    }

    // Host calls after startup, authentication, and navigation are ready.
    // Return true only after accepting a generic, authorized "open updates" action.
    fun consumeOpenIfReady(openAuthorizedUpdates: () -> Boolean) {
        if (pendingOpen && openAuthorizedUpdates()) pendingOpen = false
    }

    // Host calls on logout/account replacement to avoid carrying an old intent.
    fun clearPendingOpen() { pendingOpen = false }
}
```

The channel ID is shared with the manifest. The app cannot override a user's blocked channel. Set `allowLocalPresentation` from the actual thread-safe preference policy; it defaults to a non-presenting host example. The helper posts generic local text only for notification messages actually delivered to its service; it does not post data-only messages or duplicate background alerts already displayed by FCM. [Android receive behavior](https://firebase.google.com/docs/cloud-messaging/android/receive-messages).

