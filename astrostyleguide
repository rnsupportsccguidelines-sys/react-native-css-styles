### React Native · Redux-backed preferences

`src/core/foundations/foundationSlice.ts`

```typescript
import { createSlice, type PayloadAction } from '@reduxjs/toolkit';

export type ThemePreference = 'system' | 'light' | 'dark';
export type SupportedLanguage = 'en' | 'ar';
export type ApprovedBrandId = 'core' | 'partner';

export interface FoundationPreferences {
  theme: ThemePreference;
  language: SupportedLanguage | 'system';
  brand: ApprovedBrandId;
}

export interface FoundationState extends FoundationPreferences {
  localeStatus: 'idle' | 'loading' | 'ready' | 'error';
}
const initialState: FoundationState = {
  theme: 'system', language: 'system', brand: 'core', localeStatus: 'idle',
};

const foundationSlice = createSlice({
  name: 'foundation',
  initialState,
  reducers: {
    themeChanged(state, action: PayloadAction<ThemePreference>) {
      state.theme = action.payload;
    },
    languageChanged(state, action: PayloadAction<FoundationPreferences['language']>) {
      state.language = action.payload;
      state.localeStatus = 'loading';
    },
    localeStatusChanged(state, action: PayloadAction<FoundationState['localeStatus']>) {
      state.localeStatus = action.payload;
    },
    brandChanged(state, action: PayloadAction<ApprovedBrandId>) {
      state.brand = action.payload;
    },
    accountBrandReset(state) {
      state.brand = initialState.brand;
    },
  },
});

export const {
  themeChanged, languageChanged, localeStatusChanged, brandChanged, accountBrandReset,
} = foundationSlice.actions;
export const foundationReducer = foundationSlice.reducer;
```

Register `foundationReducer` under `foundation` in the existing root store and update the application's inferred state types. Draft assignments inside `createSlice` are valid Immer updates. Persist only preferences that the product intends to retain; an account brand must not accidentally carry into another account.

`src/core/foundations/theme/ThemeProvider.tsx`

```tsx
import { createContext, useContext, useMemo, type ReactNode } from 'react';
import { useColorScheme } from 'react-native';
import { useAppSelector } from '../../../app/hooks';

type Mode = 'light' | 'dark';
export interface ThemePalette {
  readonly primary: string;
  readonly onPrimary: string;
  readonly background: string;
  readonly surface: string;
  readonly border: string;
  readonly textPrimary: string;
  readonly textMuted: string;
}
export type ThemeTokens = Readonly<Record<Mode, ThemePalette>>;

const ThemeContext = createContext<ThemePalette | null>(null);

// tokens is the complete, generated token set for the currently resolved brand.
export function ThemeProvider({ tokens, children }: Readonly<{
  tokens: ThemeTokens;
  children: ReactNode;
}>) {
  const preference = useAppSelector((state) => state.foundation.theme);
  const system = useColorScheme();
  const mode: Mode = preference === 'system'
    ? (system === 'dark' ? 'dark' : 'light') : preference;
  const palette = useMemo(() => tokens[mode], [tokens, mode]);
  return <ThemeContext.Provider value={palette}>{children}</ThemeContext.Provider>;
}

export function useAppTheme(): ThemePalette {
  const palette = useContext(ThemeContext);
  if (!palette) throw new Error('ThemeProvider is required.');
  return palette;
}
```

<Aside type="tip" title="Hint · Context distributes derived values; Redux owns preferences">
Theme mode and selected brand are application preferences in Redux Toolkit. The theme provider distributes the resolved palette; it does not maintain a second theme preference. Missing providers fail explicitly instead of silently rendering a default brand. Validate persisted/remote preference values before dispatch—TypeScript types do not validate runtime input.
</Aside>

**Review:** No raw visual values in feature components; generated token files may contain literals. Every published token needs the supported variants and meaningful fallbacks. Confirm which rules are actually enforced in CI; code review remains necessary for visual and accessibility behavior.


