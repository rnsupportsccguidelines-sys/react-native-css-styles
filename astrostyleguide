class LoginDeviceTest {
    @get:Rule
    val activity = ActivityScenarioRule(MainActivity::class.java)

    @Test
    fun validDemoLoginShowsHome() {
        waitForLabel("Username")
        onView(withContentDescription("Username"))
            .perform(replaceText("demo-user"), closeSoftKeyboard())

        waitForLabel("Password")
        onView(withContentDescription("Password"))
            .perform(replaceText("demo-only"), closeSoftKeyboard())

        waitForLabel("Sign in")
        onView(withContentDescription("Sign in")).perform(click())

        waitForLabel("Home screen")
        onView(withContentDescription("Home screen"))
            .check(matches(isDisplayed()))
    }

    @Test
    fun invalidDemoLoginShowsError() {
        waitForLabel("Username")
        onView(withContentDescription("Username"))
            .perform(replaceText("demo-user"), closeSoftKeyboard())
        waitForLabel("Password")
        onView(withContentDescription("Password"))
            .perform(replaceText("wrong-password"), closeSoftKeyboard())
        waitForLabel("Sign in")
        onView(withContentDescription("Sign in")).perform(click())

        waitForLabel("Invalid demo credentials.")
        onView(withContentDescription("Invalid demo credentials."))
            .check(matches(isDisplayed()))
        onView(withContentDescription("Home screen")).check(doesNotExist())
    }

    // Bounded wait for this local RN demo's JS-driven screen updates.
    private fun waitForLabel(label: String, timeoutMs: Long = 15_000) {
        val target = allOf(withContentDescription(label), isDisplayed())
        onView(isRoot()).perform(object : ViewAction {
            override fun getConstraints(): Matcher<View> = isRoot()

            override fun getDescription(): String =
                "Wait up to $timeoutMs ms for $label"

            override fun perform(controller: UiController, root: View) {
                val deadline = SystemClock.uptimeMillis() + timeoutMs
                while (true) {
                    if (containsView(root, target)) return
                    if (SystemClock.uptimeMillis() >= deadline) {
                        throw AssertionError("Visible element not found: $label")
                    }
                    controller.loopMainThreadForAtLeast(50)
                }
            }
        })
    }

    private fun containsView(view: View, matcher: Matcher<View>): Boolean {
        if (matcher.matches(view)) return true
        if (view is ViewGroup) {
            for (index in 0 until view.childCount) {
                if (containsView(view.getChildAt(index), matcher)) return true
            }
        }
        return false
    }
}
```

