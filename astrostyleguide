Using **Swift concurrency actors** to manage thread-safe outbox operations and **BackgroundTasks** (`BGAppRefreshTask`) for reliable offline draining:

#### 1. Outbox Actor Manager (`OutboxManager.swift`)
```swift
import Foundation
import BackgroundTasks

public struct OutboxRecord: Codable, Identifiable {
    public let id: String // Idempotency UUID
    public let endpoint: URL
    public let payload: Data
    public let createdAt: Date
    public var retryCount: Int
}

public actor OutboxManager {
    public static let shared = OutboxManager()
    private let storageKey = "enterprise.outbox.records"
    private var isDraining = false

    private init() {}

    public func enqueue(endpoint: URL, payload: Data) throws -> String {
        let idempotencyId = UUID().uuidString
        let record = OutboxRecord(
            id: idempotencyId,
            endpoint: endpoint,
            payload: payload,
            createdAt: Date(),
            retryCount: 0
        )

        var records = loadRecords()
        records.append(record)
        saveRecords(records)

        Task { await drain() }
        return idempotencyId
    }

    public func drain() async {
        guard !isDraining else { return }
        isDraining = true
        defer { isDraining = false }

        var records = loadRecords()
        var remaining: [OutboxRecord] = []

        for var record in records {
            var request = URLRequest(url: record.endpoint)
            request.httpMethod = "POST"
            request.setValue("application/json", forHTTPHeaderField: "Content-Type")
            request.setValue(record.id, forHTTPHeaderField: "X-Idempotency-Key")
            request.httpBody = record.payload

            do {
                let (_, response) = try await URLSession.shared.data(for: request)
                guard let httpResponse = response as? HTTPURLResponse else {
                    remaining.append(record)
                    continue
                }

                if (200...299).contains(httpResponse.statusCode) || (400...499).contains(httpResponse.statusCode) {
                    // Success or non-retryable 4xx client error: resolve mutation
                    continue
                } else {
                    record.retryCount += 1
                    remaining.append(record)
                }
            } catch {
                record.retryCount += 1
                remaining.append(record)
            }
        }

        saveRecords(remaining)
    }

    private func loadRecords() -> [OutboxRecord] {
        guard let data = UserDefaults.standard.data(forKey: storageKey),
              let list = try? JSONDecoder().decode([OutboxRecord].self, from: data) else {
            return []
        }
        return list
    }

    private func saveRecords(_ records: [OutboxRecord]) {
        if let data = try? JSONEncoder().encode(records) {
            UserDefaults.standard.set(data, forKey: storageKey)
        }
    }
}
