## 4. Standard Shared SDK Initialization Entry Point

Every enterprise mobile application must bootstrap core shared SDKs (Observability, Remote Config, and Telemetry) during early application startup.

<Tabs>
  <TabItem label="Android (Kotlin / Hilt)">

```kotlin
// File: Application.kt
package com.enterprise.mobile

import android.app.Application
import com.enterprise.mobile.core.config.AppConfigProvider
import com.enterprise.mobile.core.observability.EnterpriseObservability
import dagger.hilt.android.HiltAndroidApp
import javax.inject.Inject

@HiltAndroidApp
class EnterpriseApplication : Application() {

    @Inject lateinit var appConfigProvider: AppConfigProvider
    @Inject lateinit var observability: EnterpriseObservability

    override fun onCreate() {
        super.onCreate()

        // 1. Initialize Datadog Telemetry & RUM
        observability.initialize(
            context = this,
            clientToken = BuildConfig.DATADOG_CLIENT_TOKEN,
            environment = BuildConfig.BUILD_TYPE,
            appVariant = "enterprise-android"
        )

        // 2. Bootstrap Unleash Remote Configuration Edge Client
        appConfigProvider.bootstrap(this)
    }
}
```

  </TabItem>
  <TabItem label="iOS (Swift / SwiftUI)">

```swift
// File: EnterpriseApp.swift
import SwiftUI
import EnterpriseObservability
import EnterpriseConfig

@main
struct EnterpriseApp: App {
    @State private var flagManager = RemoteConfigManager.shared

    init() {
        // 1. Initialize Enterprise Datadog Telemetry & RUM
        EnterpriseObservability.initialize(
            clientToken: AppEnvironment.datadogClientToken,
            environment: AppEnvironment.currentEnv,
            serviceName: "enterprise-ios"
        )

        // 2. Register Enterprise Custom Typography & Fonts
        EnterpriseFontRegistrar.registerCustomFonts()
    }

    var body: some Scene {
        WindowGroup {
            RootCoordinatorView()
                .environment(flagManager)
                .task {
                    // 3. Fetch Unleash remote flags on launch
                    await flagManager.syncFlags()
                }
        }
    }
}
```

  </TabItem>
  <TabItem label="React Native (TypeScript)">

```tsx
// File: App.tsx
import React, { useEffect } from 'react';
import { SafeAreaProvider } from 'react-native-safe-area-context';
import { initializeObservability } from '@enterprise/observability';
import { UnleashProvider } from '@enterprise/feature-flags';
import { EnterpriseThemeProvider } from '@enterprise/design-system';
import { RootNavigator } from './src/navigation/RootNavigator';

export const App: React.FC = () => {
  useEffect(() => {
    // 1. Initialize Datadog Telemetry & RUM
    initializeObservability({
      clientToken: process.env.DATADOG_CLIENT_TOKEN ?? '',
      environment: __DEV__ ? 'development' : 'production',
      serviceName: 'enterprise-mobile-rn',
    });
  }, []);

  return (
    <SafeAreaProvider>
      <EnterpriseThemeProvider mode="system">
        <UnleashProvider>
          <RootNavigator />
        </UnleashProvider>
      </EnterpriseThemeProvider>
    </SafeAreaProvider>
  );
};
