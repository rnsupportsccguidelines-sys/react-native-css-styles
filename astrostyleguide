<script>
  function getSvgDimensions(svgEl: SVGSVGElement) {
    if (svgEl.viewBox && svgEl.viewBox.baseVal && svgEl.viewBox.baseVal.width > 0) {
      return {
        width: svgEl.viewBox.baseVal.width,
        height: svgEl.viewBox.baseVal.height
      };
    }
    const vb = svgEl.getAttribute('viewBox');
    if (vb) {
      const parts = vb.trim().split(/[\s,]+/).map(Number);
      if (parts.length === 4 && parts[2] > 0 && parts[3] > 0) {
        return { width: parts[2], height: parts[3] };
      }
    }
    const w = parseFloat(svgEl.getAttribute('width') || '0');
    const h = parseFloat(svgEl.getAttribute('height') || '0');
    if (w > 0 && h > 0) {
      return { width: w, height: h };
    }
    const rect = svgEl.getBoundingClientRect();
    return {
      width: rect.width || 800,
      height: rect.height || 600
    };
  }

  function setupAllDiagrams() {
    document.querySelectorAll('.mermaid-premium-container').forEach((container) => {
      if ((container as any).__mermaidModalInitialized) return;
      (container as any).__mermaidModalInitialized = true;

      const inlineViewport = container.querySelector('.mermaid-viewport') as HTMLElement | null;
      const inlineCanvas = container.querySelector('.mermaid-canvas') as HTMLElement | null;
      const inlineIndicator = container.querySelector('.mermaid-zoom-indicator');
      const btnIn = container.querySelector('.btn-zoom-in');
      const btnOut = container.querySelector('.btn-zoom-out');
      const btnReset = container.querySelector('.btn-reset');
      const btnOpen = container.querySelector('.btn-expand-modal');

      const modal = container.querySelector('dialog.mermaid-modal') as HTMLDialogElement | null;
      if (!modal || !inlineViewport || !inlineCanvas) return;

      const modalViewport = modal.querySelector('.modal-viewport') as HTMLElement | null;
      const btnCloseModal = modal.querySelector('.btn-close-modal');
      const modalIndicator = modal.querySelector('.modal-zoom-indicator');
      const modalBtnIn = modal.querySelector('.modal-btn-zoom-in');
      const modalBtnOut = modal.querySelector('.modal-btn-zoom-out');
      const modalBtnReset = modal.querySelector('.modal-btn-reset');

      let placeholder: HTMLElement | null = null;
      let dims = { width: 800, height: 600 };

      // --- INLINE ZOOM LOGIC ---
      let inlineScale = 1.0;
      let inlinePanX = 0;
      let inlinePanY = 0;
      let inlineDragging = false;
      let inlineStartX = 0;
      let inlineStartY = 0;

      function renderInline() {
        if (!inlineCanvas) return;
        inlineCanvas.style.transform = `translate(${inlinePanX}px, ${inlinePanY}px) scale(${inlineScale})`;
        if (inlineIndicator) inlineIndicator.textContent = `${Math.round(inlineScale * 100)}%`;

        if (inlineScale > 1.05 || inlinePanX !== 0 || inlinePanY !== 0) {
          container.classList.add('is-zoomed');
        } else {
          container.classList.remove('is-zoomed');
        }
      }

      function zoomInline(delta: number) {
        inlineScale = Math.min(Math.max(inlineScale + delta, 0.4), 3.0);
        inlineScale = Number(inlineScale.toFixed(2));
        renderInline();
      }

      function resetInline() {
        inlineScale = 1.0;
        inlinePanX = 0;
        inlinePanY = 0;
        renderInline();
      }

      btnIn?.addEventListener('click', () => zoomInline(0.2));
      btnOut?.addEventListener('click', () => zoomInline(-0.2));
      btnReset?.addEventListener('click', resetInline);
      inlineIndicator?.addEventListener('click', resetInline);

      inlineViewport.addEventListener('mousedown', (e) => {
        if ((e.target as HTMLElement)?.closest('.mermaid-toolbar')) return;
        inlineDragging = true;
        container.classList.add('is-dragging');
        inlineStartX = e.clientX - inlinePanX;
        inlineStartY = e.clientY - inlinePanY;
      });

      window.addEventListener('mousemove', (e) => {
        if (!inlineDragging) return;
        inlinePanX = e.clientX - inlineStartX;
        inlinePanY = e.clientY - inlineStartY;
        renderInline();
      });

      window.addEventListener('mouseup', () => {
        if (inlineDragging) {
          inlineDragging = false;
          container.classList.remove('is-dragging');
        }
      });

      inlineViewport.addEventListener('wheel', (e) => {
        e.preventDefault();
        zoomInline(e.deltaY > 0 ? -0.1 : 0.1);
      }, { passive: false });

      inlineViewport.addEventListener('dblclick', (e) => {
        if ((e.target as HTMLElement)?.closest('.mermaid-toolbar')) return;
        btnOpen?.click();
      });

      // --- TOP-LAYER MODAL ZOOM & PAN LOGIC ---
      let modalScale = 1.0;
      let modalPanX = 0;
      let modalPanY = 0;
      let modalDragging = false;
      let modalStartX = 0;
      let modalStartY = 0;

      function renderModal() {
        if (!inlineCanvas) return;
        inlineCanvas.style.transform = `translate(${modalPanX}px, ${modalPanY}px) scale(${modalScale})`;
        if (modalIndicator) modalIndicator.textContent = `${Math.round(modalScale * 100)}%`;
      }

      function zoomModal(delta: number) {
        modalScale = Math.min(Math.max(modalScale + delta, 0.2), 4.0);
        modalScale = Number(modalScale.toFixed(2));
        renderModal();
      }

      function resetModal() {
        const modalW = window.innerWidth * 0.90;
        const modalH = window.innerHeight * 0.90;
        const availW = modalW - 60;
        const availH = modalH - 120;
        const scaleW = availW / dims.width;
        const scaleH = availH / dims.height;
        const fitScale = Math.min(scaleW, scaleH);
        modalScale = fitScale < 1 ? Number(fitScale.toFixed(2)) : 1.0;
        modalPanX = 0;
        modalPanY = 0;
        renderModal();
      }

      // OPEN MODAL (NATIVE HTML5 .showModal() -> GUARANTEED TOP LAYER!)
      btnOpen?.addEventListener('click', (e) => {
        e.preventDefault();
        if (!modalViewport) return;

        const svg = inlineCanvas.querySelector('svg') as SVGSVGElement | null;
        if (svg) {
          dims = getSvgDimensions(svg);
          // Concrete dimensions guarantee SVG NEVER collapses to 0 in flexbox
          svg.style.width = `${dims.width}px`;
          svg.style.height = `${dims.height}px`;
          svg.style.maxWidth = 'none';
          svg.style.maxHeight = 'none';
          svg.style.display = 'block';
          svg.style.margin = '0 auto';
        }

        // Insert placeholder into inline container and move canvas into modal viewport
        placeholder = document.createElement('div');
        placeholder.className = 'canvas-placeholder';
        inlineCanvas.parentNode?.insertBefore(placeholder, inlineCanvas);
        modalViewport.appendChild(inlineCanvas);

        modal.showModal();
        resetModal();
      });

      // CLOSE MODAL: Restore canvas to inline container
      function closeModal() {
        if (!modal) return;
        const svg = inlineCanvas.querySelector('svg') as SVGSVGElement | null;
        if (svg) {
          svg.style.width = '';
          svg.style.height = '';
          svg.style.maxWidth = '';
          svg.style.maxHeight = '';
          svg.style.display = '';
          svg.style.margin = '';
        }

        if (placeholder && placeholder.parentNode) {
          placeholder.parentNode.insertBefore(inlineCanvas, placeholder);
          placeholder.remove();
          placeholder = null;
        }

        if (modal.open) {
          modal.close();
        }
        resetInline();
      }

      btnCloseModal?.addEventListener('click', (e) => {
        e.preventDefault();
        closeModal();
      });

      modal.addEventListener('close', () => {
        if (placeholder) closeModal();
      });

      // Click outside 90% dialog (on opaque backdrop) to close
      modal.addEventListener('click', (e) => {
        const rect = modal.getBoundingClientRect();
        const isInDialog = (
          rect.top <= e.clientY &&
          e.clientY <= rect.top + rect.height &&
          rect.left <= e.clientX &&
          e.clientX <= rect.left + rect.width
        );
        if (!isInDialog) {
          closeModal();
        }
      });

      modalBtnIn?.addEventListener('click', () => zoomModal(0.2));
      modalBtnOut?.addEventListener('click', () => zoomModal(-0.2));
      modalBtnReset?.addEventListener('click', resetModal);
      modalIndicator?.addEventListener('click', resetModal);

      // Pan inside modal
      if (modalViewport) {
        modalViewport.addEventListener('mousedown', (e) => {
          modalDragging = true;
          modalViewport.classList.add('is-dragging');
          modalStartX = e.clientX - modalPanX;
          modalStartY = e.clientY - modalPanY;
        });

        window.addEventListener('mousemove', (e) => {
          if (!modalDragging) return;
          modalPanX = e.clientX - modalStartX;
          modalPanY = e.clientY - modalStartY;
          renderModal();
        });

        window.addEventListener('mouseup', () => {
          if (modalDragging) {
            modalDragging = false;
            modalViewport.classList.remove('is-dragging');
          }
        });

        modalViewport.addEventListener('wheel', (e) => {
          e.preventDefault();
          zoomModal(e.deltaY > 0 ? -0.12 : 0.12);
        }, { passive: false });
      }
    });
  }

  setupAllDiagrams();
  document.addEventListener('astro:page-load', setupAllDiagrams);
</script>




