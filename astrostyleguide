#### Domain Layer: Entities, Contract & Use Case
```kotlin
package com.enterprise.mobile.domain

data class Order(
    val id: String,
    val totalAmount: Double,
    val items: List<OrderItem>
)

interface OrderRepository {
    suspend fun submitOrder(order: Order): Result<String>
}

class SubmitOrderUseCase(
    private val repository: OrderRepository
) {
    suspend operator fun invoke(order: Order): Result<String> {
        if (order.items.isEmpty()) {
            return Result.failure(IllegalArgumentException("Order must contain at least one item."))
        }
        return repository.submitOrder(order)
    }
}
```

#### Data Layer: Repository Implementation with Local Cache & Remote API
```kotlin
package com.enterprise.mobile.data

import com.enterprise.mobile.domain.Order
import com.enterprise.mobile.domain.OrderRepository
import kotlinx.coroutines.Dispatchers
import kotlinx.coroutines.withContext

class OrderRepositoryImpl(
    private val apiService: OrderApiService,
    private val orderDao: OrderDao
) : OrderRepository {

    override suspend fun submitOrder(order: Order): Result<String> = withContext(Dispatchers.IO) {
        try {
            val response = apiService.postOrder(order.toDto())
            // Save confirmation locally for offline persistence
            orderDao.insertOrder(order.toEntity(response.confirmationId))
            Result.success(response.confirmationId)
        } catch (e: Exception) {
            Result.failure(e)
        }
    }
}
```

#### Presentation Layer: ViewModel & Compose Screen
```kotlin
package com.enterprise.mobile.presentation

import androidx.lifecycle.ViewModel
import androidx.lifecycle.viewModelScope
import com.enterprise.mobile.domain.Order
import com.enterprise.mobile.domain.SubmitOrderUseCase
import kotlinx.coroutines.flow.MutableStateFlow
import kotlinx.coroutines.flow.StateFlow
import kotlinx.coroutines.launch

sealed interface OrderState {
    object Idle : OrderState
    object Loading : OrderState
    data class Success(val confirmationId: String) : OrderState
    data class Error(val message: String) : OrderState
}

class OrderViewModel(
    private val submitOrderUseCase: SubmitOrderUseCase
) : ViewModel() {

    private val _state = MutableStateFlow<OrderState>(OrderState.Idle)
    val state: StateFlow<OrderState> = _state

    fun submit(order: Order) {
        viewModelScope.launch {
            _state.value = OrderState.Loading
            submitOrderUseCase(order).fold(
                onSuccess = { _state.value = OrderState.Success(it) },
                onFailure = { _state.value = OrderState.Error(it.localizedMessage ?: "Submission failed") }
            )
        }
    }
}
```
