// src/components/mobile/SdkCatalog.astro

const { sdks = [] } = Astro.props;

const processedSdks = sdks.map((sdk: any) => {
  if (!sdk.installation) return sdk;
  const newInstallation: Record<string, any> = {};
  
  Object.keys(sdk.installation).forEach((platformKey) => {
    const item = sdk.installation[platformKey];
    newInstallation[platformKey] = {
      ...item,
      title: item.title || platformKey.toUpperCase(),
      dependency: item.dependency || '',
      fileName: item.fileName || '',
      code: item.code || item.mdContent || ''
    };
  });

  return { ...sdk, installation: newInstallation };
});
---

<div class="portal-catalog-wrap">
  <div class="portal-catalog-controls">
    <div class="portal-filter-group">
      <button type="button" class="portal-filter-pill active" data-filter="all">All Platforms ({processedSdks.length})</button>
      <button type="button" class="portal-filter-pill" data-filter="android">Android Native</button>
      <button type="button" class="portal-filter-pill" data-filter="ios">iOS Native</button>
      <button type="button" class="portal-filter-pill" data-filter="react-native">React Native</button>
    </div>

    <div class="portal-search-box">
      <svg class="portal-search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
      <input type="text" id="sdkSearchInput" class="portal-search-input" placeholder="Search SDKs by name or keyword..." autocomplete="off" />
    </div>
  </div>

  <div class="portal-sdk-grid" id="sdkGridContainer">
    {processedSdks && processedSdks.map((sdk: any) => (
      <div class="portal-sdk-card" data-sdk-id={sdk.id} data-platforms={sdk.platforms ? sdk.platforms.join(' ') : ''} data-name={sdk.name.toLowerCase()} data-desc={sdk.description.toLowerCase()} data-cat={(sdk.category || '').toLowerCase()}>
        <div style="display: flex; flex-direction: column; width: 100%;">
          <div class="portal-sdk-topbar">
            <span class="portal-sdk-title">{sdk.name}</span>
            <span class="portal-version-badge">{sdk.version}</span>
          </div>
          {sdk.category && <div class="portal-category-tag">{sdk.category}</div>}
          <p class="portal-sdk-desc">{sdk.description}</p>
        </div>

        <div style="display: flex; flex-direction: column; width: 100%;">
          <div class="portal-sdk-pills">
            {sdk.platforms && sdk.platforms.includes('android') && (
              <span class="portal-sdk-pill badge-android">Android</span>
            )}
            {sdk.platforms && sdk.platforms.includes('ios') && (
              <span class="portal-sdk-pill badge-ios">iOS</span>
            )}
            {sdk.platforms && sdk.platforms.includes('react-native') && (
              <span class="portal-sdk-pill badge-rn">React Native</span>
            )}
          </div>

          <button type="button" class="portal-btn-install" data-sdk-id={sdk.id}>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
            View Installation Instructions
          </button>
        </div>

        <div class="sdk-hidden-data" style="display: none;" data-sdk-raw={JSON.stringify(sdk)}></div>
      </div>
    ))}
  </div>
</div>

<dialog id="sdkModalDialog" class="portal-modal-dialog">
  <div class="portal-modal-container">
    <div class="portal-modal-header">
      <div class="portal-modal-header-left">
        <div class="portal-modal-title-row">
          <h2 id="modalTitle" class="portal-modal-title">SDK Installation</h2>
          <span id="modalVersion" class="portal-version-badge">v1.0.0</span>
        </div>
        <div id="modalCategory" class="portal-category-tag"></div>
        <p id="modalDesc" class="portal-modal-desc"></p>
      </div>
      <button type="button" id="modalCloseBtn" class="portal-modal-close-btn" title="Close Dialog">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
    </div>

    <div id="modalTabsBar" class="portal-modal-tabs-nav"></div>
    <div id="modalBodyContent" class="portal-modal-body"></div>
  </div>
</dialog>

<script is:inline>
  (function() {
    var activePlatformKey = 'android';
    var currentActiveSdk = null;

    function ensureDialogInBody() {
      var dialog = document.getElementById('sdkModalDialog');
      if (dialog && dialog.parentElement !== document.body) {
        document.body.appendChild(dialog);
      }
      return dialog;
    }

    function openModalForCard(card) {
      var dialog = ensureDialogInBody();
      if (!dialog || !card) return;

      var hiddenDataEl = card.querySelector('.sdk-hidden-data');
      if (!hiddenDataEl) return;

      var sdk = JSON.parse(hiddenDataEl.getAttribute('data-sdk-raw') || '{}');
      currentActiveSdk = sdk;

      var modalTitle = document.getElementById('modalTitle');
      var modalVersion = document.getElementById('modalVersion');
      var modalCategory = document.getElementById('modalCategory');
      var modalDesc = document.getElementById('modalDesc');
      var modalTabsBar = document.getElementById('modalTabsBar');

      if (modalTitle) modalTitle.textContent = sdk.name;
      if (modalVersion) modalVersion.textContent = sdk.version;
      if (modalCategory) modalCategory.textContent = (sdk.category || '').toUpperCase();
      if (modalDesc) modalDesc.textContent = sdk.description;

      if (modalTabsBar) modalTabsBar.innerHTML = '';

      var platforms = Object.keys(sdk.installation || {});
      if (platforms.indexOf(activePlatformKey) === -1 && platforms.length > 0) {
        activePlatformKey = platforms[0];
      }

      platforms.forEach(function(pKey) {
        var tabBtn = document.createElement('button');
        tabBtn.type = 'button';
        tabBtn.className = 'portal-modal-tab-btn ' + (pKey === activePlatformKey ? 'active' : '');
        tabBtn.setAttribute('data-target-platform', pKey);
        tabBtn.textContent = sdk.installation[pKey].title || pKey.toUpperCase();
        if (modalTabsBar) modalTabsBar.appendChild(tabBtn);
      });

      renderActivePlatformPane(sdk);

      if (typeof dialog.showModal === 'function') {
        dialog.showModal();
      } else {
        dialog.setAttribute('open', '');
      }
      document.body.style.overflow = 'hidden';
    }

    function renderActivePlatformPane(sdk) {
      var modalBodyContent = document.getElementById('modalBodyContent');
      if (!modalBodyContent || !sdk.installation) return;

      var data = sdk.installation[activePlatformKey];
      if (!data) return;

      var depEscaped = (data.dependency || '').replace(/'/g, "\\'");

      modalBodyContent.innerHTML = 
        '<div class="portal-install-box">' +
          '<div style="flex-grow: 1; min-width: 0;">' +
            '<div style="font-size: 0.75rem; font-weight: 700; color: var(--portal-text-muted, #9ca3af); text-transform: uppercase; margin-bottom: 6px; letter-spacing: 0.05em;">PACKAGE DEPENDENCY</div>' +
            '<div class="portal-install-cmd">' + escapeHtml(data.dependency || '') + '</div>' +
          '</div>' +
          '<button type="button" class="portal-btn-copy" onclick="navigator.clipboard.writeText(\'' + depEscaped + '\');this.innerHTML=\'Copied!\';setTimeout(()=>this.innerHTML=\'Copy\',2000)">' +
            '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>' +
            ' Copy' +
          '</button>' +
        '</div>' +
        (data.fileName ? 
          '<div class="portal-code-header">' +
            '<span class="portal-file-badge">' + escapeHtml(data.fileName) + '</span>' +
            '<span style="font-size: 0.70rem; font-weight: 800; padding: 2px 8px; border-radius: 4px; background: rgba(34,197,94,0.15); border: 1px solid rgba(34,197,94,0.35); color: #22c55e;">INITIALIZATION &amp; SETUP</span>' +
          '</div>' : '') +
        '<div class="portal-code-frame">' +
          '<pre class="portal-code-block"><code>' + escapeHtml(data.code || '') + '</code></pre>' +
        '</div>';
    }

    function escapeHtml(str) {
      return (str || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }

    function closeModal() {
      var dialog = document.getElementById('sdkModalDialog');
      if (dialog) {
        if (typeof dialog.close === 'function') {
          dialog.close();
        } else {
          dialog.removeAttribute('open');
        }
      }
      document.body.style.overflow = '';
      currentActiveSdk = null;
    }

    function filterCards() {
      var activeFilterBtn = document.querySelector('.portal-filter-pill.active');
      var filter = activeFilterBtn ? activeFilterBtn.getAttribute('data-filter') : 'all';
      var searchInput = document.getElementById('sdkSearchInput');
      var q = searchInput ? searchInput.value.toLowerCase().trim() : '';

      document.querySelectorAll('.portal-sdk-card').forEach(function(card) {
        var platforms = (card.getAttribute('data-platforms') || '').split(' ');
        var name = card.getAttribute('data-name') || '';
        var desc = card.getAttribute('data-desc') || '';
        var cat = card.getAttribute('data-cat') || '';

        var matchesPlatform = (filter === 'all' || platforms.indexOf(filter) !== -1);
        var matchesSearch = (!q || name.indexOf(q) !== -1 || desc.indexOf(q) !== -1 || cat.indexOf(q) !== -1);

        if (matchesPlatform && matchesSearch) {
          card.style.setProperty('display', 'flex', 'important');
        } else {
          card.style.setProperty('display', 'none', 'important');
        }
      });
    }

    function setupCatalogListeners() {
      ensureDialogInBody();

      document.addEventListener('click', function(e) {
        var filterBtn = e.target.closest('.portal-filter-pill');
        if (filterBtn && filterBtn.hasAttribute('data-filter')) {
          document.querySelectorAll('.portal-filter-pill').forEach(function(b) { b.classList.remove('active'); });
          filterBtn.classList.add('active');
          filterCards();
          return;
        }

        var trigger = e.target.closest('.portal-btn-install');
        if (trigger) {
          var card = trigger.closest('.portal-sdk-card');
          openModalForCard(card);
          return;
        }

        if (e.target.closest('#modalCloseBtn')) {
          closeModal();
          return;
        }

        var tabBtn = e.target.closest('.portal-modal-tab-btn');
        if (tabBtn) {
          activePlatformKey = tabBtn.getAttribute('data-target-platform');
          document.querySelectorAll('.portal-modal-tab-btn').forEach(function(b) { b.classList.remove('active'); });
          tabBtn.classList.add('active');

          if (currentActiveSdk) {
            renderActivePlatformPane(currentActiveSdk);
          }
          return;
        }

        var dialog = document.getElementById('sdkModalDialog');
        if (e.target === dialog) {
          closeModal();
          return;
        }
      });

      var searchInput = document.getElementById('sdkSearchInput');
      if (searchInput) {
        searchInput.addEventListener('input', filterCards);
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupCatalogListeners);
    } else {
      setupCatalogListeners();
    }
    document.addEventListener('astro:page-load', setupCatalogListeners);
  })();
</script>





