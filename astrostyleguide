### `place-order.ts` — sample application code

```typescript
export type ChickenItem = Readonly<{
  id: string;
  unitPriceMinor: number;
  available: boolean;
}>;
export type OrderRequest = Readonly<{
  requestId: string;
  itemId: string;
  quantity: number;
}>;
export type OrderReceipt = Readonly<{ orderId: string }>;
export interface OrderGateway {
  place(request: OrderRequest): Promise<OrderReceipt>;
}
export class OrderError extends Error {}

export function quote(item: ChickenItem, quantity: number): number {
  if (!item.id.trim()) throw new OrderError('invalid-item');
  if (!item.available) throw new OrderError('unavailable');
  if (!Number.isInteger(quantity) || quantity < 1 || quantity > 20) {
    throw new OrderError('invalid-quantity');
  }
  if (!Number.isSafeInteger(item.unitPriceMinor) || item.unitPriceMinor <= 0) {
    throw new OrderError('invalid-price');
  }
  const total = item.unitPriceMinor * quantity;
  if (!Number.isSafeInteger(total)) throw new OrderError('invalid-total');
  return total;
}

// Keep one instance per active order flow; recreating it per tap loses the guard.
export class PlaceChickenOrder {
  private submitting = false;
  constructor(private readonly gateway: OrderGateway) {}

  async place(item: ChickenItem, quantity: number,
              requestId: string): Promise<OrderReceipt> {
    quote(item, quantity);
    if (!requestId.trim()) throw new OrderError('invalid-request-id');
    if (this.submitting) throw new OrderError('already-submitting');
    this.submitting = true;
    try {
      const receipt = await this.gateway.place({
        requestId, itemId: item.id, quantity,
      });
      if (!receipt.orderId.trim()) throw new OrderError('invalid-receipt');
      return receipt;
    } finally {
      this.submitting = false;
    }
  }
}
```

