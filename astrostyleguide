Do not substitute the backend `unleash-client` package. See the [JavaScript SDK and React Native custom storage reference](https://docs.getunleash.io/sdks/javascript-browser#custom-store).

### B. Add the retained client owner

**File: `configuration/featureFlags.ts`**

```typescript
import { UnleashClient } from 'unleash-proxy-client';
import AsyncStorage from '@react-native-async-storage/async-storage';

type Config = Readonly<{
  url: string;
  frontendToken: string;
  appName: string;
  cacheNamespace: string; // Distinct approved app + environment namespace.
}>;
export function createFeatureFlags(
  config: Config,
  onChanged: () => void,
  onFailure: () => void,
) {
  const url = new URL(config.url);
  if (url.protocol !== 'https:' || !config.frontendToken.trim()
    || !config.appName.trim() || !config.cacheNamespace.trim()) {
    throw new Error('Invalid feature-flag configuration');
  }
  const client = new UnleashClient({
    url: config.url,
    clientKey: config.frontendToken,
    appName: config.appName,
    refreshInterval: 15, // Reference interval in seconds; review for your app.
    storageProvider: {
      save: async (name: string, data: unknown) => {
        try {
          await AsyncStorage.setItem(
            `${config.cacheNamespace}:${name}`, JSON.stringify(data),
          );
        } catch { onFailure(); }
      },
      get: async (name: string) => {
        try {
          const raw = await AsyncStorage.getItem(`${config.cacheNamespace}:${name}`);
          return raw === null ? undefined : JSON.parse(raw);
        } catch { onFailure(); return undefined; }
      },
    },
  });
  let started = false;
  let stopped = false;
  let initialized = false;
  const receive = () => {
    if (stopped) return;
    initialized = true;
    onChanged();
  };
  const failure = () => { if (!stopped) onFailure(); };
  // Register before start so initial cache/network events are not missed.
  client.on('initialized', receive);
  client.on('ready', receive);
  client.on('update', receive);
  client.on('error', failure);

  return {
    start() {
      if (started || stopped) return;
      started = true;
      void client.start().catch(failure);
    },
    canStartOrder(appSupportsOrdering: boolean, accessAllowed: boolean): boolean {
      return initialized && !stopped && appSupportsOrdering && accessAllowed
        && client.isEnabled('chicken-ordering-enabled') === true;
    },
    orderPresentation(): 'standard' | 'compact' {
      if (!initialized || stopped) return 'standard';
      const variant = client.getVariant('chicken-order-presentation');
      return variant.enabled && variant.name === 'compact' ? 'compact' : 'standard';
    },
    stop() {
      if (stopped) return;
      stopped = true;
      initialized = false;
      client.stop();
      client.off('initialized', receive);
      client.off('ready', receive);
      client.off('update', receive);
      client.off('error', failure);
    },
  };
}
```

Callbacks must be non-throwing. Route errors to approved sanitized diagnostics; never log the raw SDK error or token configuration. Call `stop()` only when this owner ends. It is final for this wrapper; create a newly owned instance if a later lifecycle needs one.

