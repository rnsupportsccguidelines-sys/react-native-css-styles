### `OrderFeature.kt` — domain, repository, API port, and fake composition

```kotlin
package com.example.mychicken.order

import java.util.concurrent.CancellationException

// Domain — example-owned models, not an enterprise HTTP schema.
data class OrderRequest(
    val accountId: String,
    val requestId: String,
    val itemId: String,
    val quantity: Int,
)
sealed interface OrderResult {
    data class Confirmed(val orderId: String) : OrderResult
    data object Invalid : OrderResult
    data object Unknown : OrderResult
}
interface OrderRepository {
    suspend fun place(request: OrderRequest): OrderResult
}
class PlaceChickenOrder(private val repository: OrderRepository) {
    suspend operator fun invoke(request: OrderRequest): OrderResult {
        val ids = listOf(request.accountId, request.requestId, request.itemId)
        if (ids.any { it.isBlank() } || request.quantity !in 1..20) {
            return OrderResult.Invalid
        }
        return repository.place(request)
    }
}

// Data — implement this port using the approved transport adapter.
data class OrderResponse(val orderId: String)
interface OrderApi {
    suspend fun submit(request: OrderRequest): OrderResponse
}

// Repository implementation — one call, no retry or local fallback.
class RemoteOrderRepository(private val api: OrderApi) : OrderRepository {
    override suspend fun place(request: OrderRequest): OrderResult {
        return try {
            val response = api.submit(request)
            if (response.orderId.isBlank()) OrderResult.Unknown
            else OrderResult.Confirmed(response.orderId)
        } catch (cancelled: CancellationException) {
            // Preserve cancellation. An already-dispatched write still needs
            // reconciliation; cancellation does not prove order failure.
            throw cancelled
        } catch (failure: Exception) {
            OrderResult.Unknown
        }
    }
}

// Application composition — synthetic test/demo only. No network call.
fun makeDemoPlaceOrder(): PlaceChickenOrder {
    val api = object : OrderApi {
        override suspend fun submit(request: OrderRequest) = OrderResponse("order-001")
    }
    return PlaceChickenOrder(RemoteOrderRepository(api))
}
```

Invoke `makeDemoPlaceOrder()` from a controlled coroutine/test with `OrderRequest("demo-account", "demo-request", "chicken-grilled", 2)`. Expected result: `Confirmed("order-001")`. The fake never contacts a backend.

A lifecycle-aware ViewModel owns submission state. Serialize submissions for the active order flow, publish UI-facing state, and reject stale session/request results. Native cancellation propagates; an already-dispatched order must not become retryable merely because its coroutine was cancelled. See [Android's architecture guidance](https://developer.android.com/topic/architecture).

</TabItem>
