    links.accept(intent.dataString)
    intent.data = null // Avoid reconsuming the stored intent after handling.
}

// Merge with any existing notification onNewIntent handler; do not declare it twice.
override fun onNewIntent(intent: Intent) {
    super.onNewIntent(intent)
    setIntent(intent)
    if (intent.action == Intent.ACTION_VIEW) {
        links.accept(intent.dataString)
        intent.data = null
    }
}

// At the real startup/authentication/navigation-ready boundary:
links.consumeIfReady {
    false // Replace with the existing authorized updates action's acceptance result.
}
```

Import `android.content.Intent`; `links` is the host-owned `DeepLinkService` instance. Trigger consumption after new input and whenever readiness changes. A rejected link should follow the app's safe non-sensitive fallback, not be forwarded to arbitrary navigation.

