import type { AccountBalance } from './signInAndLoadBalance';

function deferred<T>() {
  let resolve!: (value: T) => void;
  let reject!: (reason: Error) => void;
  const promise = new Promise<T>((yes, no) => { resolve = yes; reject = no; });
  return { promise, resolve, reject };
}
const expected: AccountBalance = { minorUnits: 12500, currency: 'USD' };

test('real thunk and reducer publish the loaded balance', async () => {
  const store = makeBalanceStore({ load: async () => expected });
  store.dispatch(accountChanged('fixture-account'));
  await store.dispatch(loadBalance('fixture-account')).unwrap();
  expect(store.getState().balance).toMatchObject({ status: 'ready', value: expected });
});

test('balance failure does not leave a success state', async () => {
  const store = makeBalanceStore({ load: async () => { throw new Error('fixture failure'); } });
  store.dispatch(accountChanged('fixture-account'));
  const result = await store.dispatch(loadBalance('fixture-account'));
  expect(loadBalance.rejected.match(result)).toBe(true);
  expect(store.getState().balance).toMatchObject({ status: 'failed', value: null });
});

test('old completion cannot populate a new account', async () => {
  const old = deferred<AccountBalance>();
  const reader: BalanceReader = { load: () => old.promise };
  const store = makeBalanceStore(reader);
  store.dispatch(accountChanged('old-account'));
  const task = store.dispatch(loadBalance('old-account'));
  store.dispatch(accountChanged('new-account'));
  old.resolve(expected);
  await task;
  expect(store.getState().balance).toMatchObject({
    accountId: 'new-account', status: 'idle', value: null,
  });
});

test('old rejection cannot fail a new account', async () => {
  const old = deferred<AccountBalance>();
  const store = makeBalanceStore({ load: () => old.promise });
  store.dispatch(accountChanged('old-account'));
  const task = store.dispatch(loadBalance('old-account'));
  store.dispatch(accountChanged('new-account'));
  old.reject(new Error('fixture old failure'));
  await task;
  expect(store.getState().balance).toMatchObject({
    accountId: 'new-account', status: 'idle', value: null,
  });
});

test('a late result for the same account cannot replace the latest result', async () => {
  const old = deferred<AccountBalance>();
  let calls = 0;
  const store = makeBalanceStore({ load: () => ++calls === 1 ? old.promise : Promise.resolve(expected) });
  store.dispatch(accountChanged('fixture-account'));
  const first = store.dispatch(loadBalance('fixture-account'));
  await store.dispatch(loadBalance('fixture-account'));
  old.resolve({ minorUnits: 1, currency: 'USD' });
  await first;
  expect(store.getState().balance.value).toEqual(expected);
});

test('cancellation clears loading without reporting success', async () => {
