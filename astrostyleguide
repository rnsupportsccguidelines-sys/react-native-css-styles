        Scheduler["Background Task Scheduler (WorkManager / BGAppRefresh)"]
        Batcher["Outbox Drainer (Reads PENDING records sequentially)"]
        Scheduler -->|"Radio connected & active"| Batcher
        OutboxQueue -.->|"Pulls pending records"| Batcher
