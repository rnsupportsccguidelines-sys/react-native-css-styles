### `feature/user/domain/UserProfile.kt`

```kotlin
package com.enterprise.mobile.feature.user.domain

import javax.inject.Inject

data class UserDomainModel(
    val id: String,
    val name: String,
    val email: String,
    val isVip: Boolean,
    val cachedAtMillis: Long,
)

data class ProfileKey(val accountId: String, val userId: String)

enum class ProfileFailure {
    INVALID_KEY, SESSION_EXPIRED, ACCESS_DENIED, NOT_FOUND,
    INVALID_PAYLOAD, HTTP_ERROR, CACHE_ERROR, CACHE_INVALIDATION, UNEXPECTED,
}

class ProfileException(val failure: ProfileFailure) : Exception(failure.name)

interface UserRepository {
    suspend fun cachedProfile(key: ProfileKey): UserDomainModel?
    suspend fun refreshProfile(key: ProfileKey): UserDomainModel
}

class GetUserProfileUseCase @Inject constructor(
    private val repository: UserRepository,
) {
    fun validatedKey(accountId: String, rawUserId: String): ProfileKey {
        val userId = rawUserId.trim()
        // Example API contract; update this rule if the real API uses other IDs.
        if (accountId.isBlank() || !USER_ID.matches(userId)) {
            throw ProfileException(ProfileFailure.INVALID_KEY)
        }
        return ProfileKey(accountId, userId)
    }

    suspend fun cachedProfile(key: ProfileKey): UserDomainModel? =
        repository.cachedProfile(validatedKey(key.accountId, key.userId))

    suspend fun refreshProfile(key: ProfileKey): UserDomainModel =
        repository.refreshProfile(validatedKey(key.accountId, key.userId))

    private companion object {
        val USER_ID = Regex("[A-Za-z0-9_-]{1,128}")
    }
}
```

<Aside type="tip" title="Hint · validate before side effects">
The account ID comes from the trusted authenticated session, not an arbitrary deep-link parameter. Preserve its canonical value. Normalize only the user ID according to the API contract. Kotlin `val` prevents property reassignment; it does not make arbitrary nested mutable objects immutable. This model contains value fields only.
</Aside>

`cachedAtMillis` records client cache time, not server modification time. Define business freshness, expiry, and retention separately.

