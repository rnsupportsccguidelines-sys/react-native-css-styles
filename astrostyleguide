import { BasePage } from '@enterprise/rn-appium-framework';

export class ChickenOrderPage extends BasePage {
  async place(quantity: string): Promise<void> {
    await this.tapById('chicken.item.grilled');
    await this.setValueById('chicken.quantity', quantity);
    await this.tapById('chicken.place-order');
  }

  async confirmation() {
    return this.waitForId('chicken.confirmation');
  }

  async orderId() {
    return this.waitForId('chicken.order-id');
  }
}
