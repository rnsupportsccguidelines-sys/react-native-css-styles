```typescript
import type { AppDispatch } from '../../app/store';
import type { ApprovedBrandId } from '../foundations/foundationSlice';
import { brandChanged } from '../foundations/foundationSlice';
import { approvedBrandId } from './brandRegistry';

export interface BrandRuntime {
  // Prepare tokens/assets without changing the currently visible UI.
  prepare(id: ApprovedBrandId): Promise<void>;
  // Publish the prepared token/asset set synchronously, then invoke publishPreference.
  // Must either commit a coherent set or leave the previous set intact.
  commit(id: ApprovedBrandId, publishPreference: () => void): void;
  applyNativeIcon(id: ApprovedBrandId): Promise<void>;
}

export class BrandCoordinator {
  private queue: Promise<void> = Promise.resolve();
  constructor(
    private readonly runtime: BrandRuntime,
    private readonly dispatch: AppDispatch,
    private readonly reportFailure: (stage: 'brand-icon') => void,
  ) {}

  apply(candidate: unknown): Promise<void> {
    const id = approvedBrandId(candidate);
    if (!id) return Promise.reject(new Error('Unsupported brand.'));
    const operation = this.queue.then(async () => {
      await this.runtime.prepare(id);
      this.runtime.commit(id, () => this.dispatch(brandChanged(id)));
      try { await this.runtime.applyNativeIcon(id); }
      catch { this.reportFailure('brand-icon'); }
    });
    this.queue = operation.catch(() => undefined);
    return operation;
  }
}
```

**Hint:** The application must authorize `candidate` for the current tenant before calling the coordinator and serialize this work with account changes. The runtime is the approved generated-asset/native bridge adapter, not a second brand preference store. `commit` has an explicit coherent-publication contract; implement it with the app's resolved-theme boundary. Preparation/commit failures reject to the caller; icon failure is reported separately because the already-committed in-app brand remains valid. Reporting must not throw. No native module name is invented here—bind the actual approved icon adapter to `applyNativeIcon`.


