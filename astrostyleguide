### C. Copy `FcmService.kt`

```kotlin
package com.example.mychicken.notifications

import android.content.Context
import com.google.firebase.messaging.FirebaseMessaging
import com.google.firebase.messaging.FirebaseMessagingService
import com.google.firebase.messaging.RemoteMessage

class FcmService : FirebaseMessagingService() {
    override fun onNewToken(token: String) {
        // Host binding must enqueue work durably, not perform network I/O here.
        if (token.isNotBlank()) hooks?.enqueueTokenSync?.invoke(token)
    }

    override fun onMessageReceived(message: RemoteMessage) {
        // Only callbacks delivered here are app-handled. Background notification
        // payloads may already have been displayed by the SDK/OS.
        if (message.notification != null) {
            if (hooks?.allowLocalPresentation?.invoke() == true) {
                NotificationService.showUpdate(applicationContext, message.messageId)
            }
        } else {
            // A data message is only a hint to reconcile authorized current state.
            // The host schedules bounded work; raw payload is not trusted/routed.
            hooks?.enqueueContentRefresh?.invoke()
        }
    }

    override fun onDeletedMessages() {
        hooks?.enqueueContentRefresh?.invoke()
    }

    data class Hooks(
        val enqueueTokenSync: (String) -> Unit,
        val enqueueContentRefresh: () -> Unit,
        val allowLocalPresentation: () -> Boolean,
        val onRegistrationFailure: () -> Unit,
    )

    companion object {
        @Volatile private var hooks: Hooks? = null

        // Call from Application.onCreate, including background process startup.
        // Bindings must be thread-safe and non-blocking; scope sync to the
        // current authenticated account at execution, not to a captured user.
        fun initialize(context: Context, bindings: Hooks) {
            hooks = bindings
            NotificationService.createChannel(context.applicationContext)
        }

        // Call after sign-in and whenever account/preferences require reconciliation.
        // Successful token fetch is not successful backend registration.
        fun refreshRegistration() {
            val bindings = checkNotNull(hooks) { "Initialize FcmService first" }
            FirebaseMessaging.getInstance().isAutoInitEnabled = true
            FirebaseMessaging.getInstance().token
                .addOnSuccessListener { token ->
                    if (token.isNotBlank()) bindings.enqueueTokenSync(token)
                    else bindings.onRegistrationFailure()
                }
                .addOnFailureListener { bindings.onRegistrationFailure() }
        }
    }
}
```

