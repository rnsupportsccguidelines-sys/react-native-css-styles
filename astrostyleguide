```kotlin
package com.example.mobile.balance

data class AccountBalance(val minorUnits: Long, val currency: String)

interface SessionGateway {
    suspend fun authenticate(username: String, password: String): String
    suspend fun balance(session: String): AccountBalance
}

class SignInAndLoadBalance(private val gateway: SessionGateway) {
    suspend operator fun invoke(username: String, password: String): AccountBalance {
        val session = gateway.authenticate(username, password)
        return gateway.balance(session)
    }
}
```

**File: `app/src/test/java/com/example/mobile/balance/SignInAndLoadBalanceTest.kt`.** The fake records actual calls and injects deterministic failures. It never reaches a real service.

```kotlin
package com.example.mobile.balance

import kotlinx.coroutines.test.runTest
import org.junit.Assert.assertEquals
import org.junit.Assert.assertSame
import org.junit.Assert.fail
import org.junit.Test

class SignInAndLoadBalanceTest {
    private class FakeGateway : SessionGateway {
        var authenticationFailure: Exception? = null
        var balanceFailure: Exception? = null
        val calls = mutableListOf<String>()
        override suspend fun authenticate(username: String, password: String): String {
            calls += "authenticate"
            check(username == "fixture-user" && password == "fixture-only")
            authenticationFailure?.let { throw it }
            return "fixture-session"
        }
        override suspend fun balance(session: String): AccountBalance {
            calls += "balance:$session"
            balanceFailure?.let { throw it }
            return AccountBalance(12500, "USD")
        }
    }

    @Test fun returnsBalanceForAuthenticatedSession() = runTest {
        val gateway = FakeGateway()
        val result = SignInAndLoadBalance(gateway)("fixture-user", "fixture-only")
        assertEquals(AccountBalance(12500, "USD"), result)
        assertEquals(listOf("authenticate", "balance:fixture-session"), gateway.calls)
    }

    @Test fun authenticationFailureDoesNotLoadBalance() = runTest {
        val gateway = FakeGateway()
        val expected = IllegalStateException("fixture authentication failure")
        gateway.authenticationFailure = expected
        try {
            SignInAndLoadBalance(gateway)("fixture-user", "fixture-only")
            fail("Expected authentication failure")
        } catch (actual: IllegalStateException) {
            assertSame(expected, actual)
        }
        assertEquals(listOf("authenticate"), gateway.calls)
    }

    @Test fun balanceFailureIsNotConvertedToSuccess() = runTest {
        val gateway = FakeGateway()
        val expected = IllegalStateException("fixture balance failure")
        gateway.balanceFailure = expected
        try {
            SignInAndLoadBalance(gateway)("fixture-user", "fixture-only")
            fail("Expected balance failure")
        } catch (actual: IllegalStateException) {
            assertSame(expected, actual)
        }
        assertEquals(listOf("authenticate", "balance:fixture-session"), gateway.calls)
    }
}
```

The strings above are local fake values, not a usable account. Do not put real test credentials in unit tests. Cancellation should propagate through real coroutine adapters; use the application's existing cancellation/session regression tests as well.

