<TabItem label="Android (Kotlin)">

In native Android, the Circuit Breaker is injected via Hilt into repository implementations and switches dispatchers cleanly:

```kotlin
package com.enterprise.mobile.data.resilience

import com.enterprise.resilience.CircuitBreaker
import com.enterprise.resilience.CircuitBreakerConfig
import kotlinx.coroutines.Dispatchers
import kotlinx.coroutines.withContext

class OrderRepositoryImpl(
    private val api: OrderApiService,
    private val dao: OrderDao
) : OrderRepository {

    // 1. Initialize the Circuit Breaker with enterprise defaults
    private val breaker = CircuitBreaker(
        CircuitBreakerConfig(
            serviceName = "OrderApiService",
            failureThreshold = 3,
            resetTimeoutMs = 30000L,
            requestTimeoutMs = 5000L
        )
    )

    // 2. Execute network query with local Room SQLite fallback
    override suspend fun getOrders(): Result<List<Order>> = withContext(Dispatchers.IO) {
        breaker.execute(
            action = {
                val remoteOrders = api.fetchOrders()
                dao.insertAll(remoteOrders.map { it.toEntity() })
                Result.success(remoteOrders.map { it.toDomain() })
            },
            fallback = { exception ->
                val cachedOrders = dao.getAllOrders()
                if (cachedOrders.isNotEmpty()) {
                    Result.success(cachedOrders.map { it.toDomain() })
                } else {
                    Result.failure(exception)
                }
            }
        )
    }
}
```
</TabItem>
<TabItem label="iOS (Swift)">

In native iOS, the Circuit Breaker is implemented as an `actor` to guarantee thread-safe state mutations across concurrent async tasks:

```swift
import Foundation

public actor CircuitBreaker {
    public enum State {
        case closed, open, halfOpen
    }

    private var state: State = .closed
    private var failureCount = 0
    private let failureThreshold: Int
    private let resetTimeout: TimeInterval
    private var lastFailureTime: Date?

    public init(failureThreshold: Int = 3, resetTimeout: TimeInterval = 30) {
        self.failureThreshold = failureThreshold
        self.resetTimeout = resetTimeout
    }

    public func execute<T>(
        action: () async throws -> T,
        fallback: (Error) async throws -> T
    ) async throws -> T {
        // Evaluate reset window before dispatching
        if state == .open, let lastFail = lastFailureTime, Date().timeIntervalSince(lastFail) > resetTimeout {
            state = .halfOpen
        }

        if state == .open {
            return try await fallback(NSError(domain: "CircuitBreakerOpen", code: 503))
        }

        do {
            let result = try await action()
            if state == .halfOpen {
                state = .closed
                failureCount = 0
            }
            return result
        } catch {
            failureCount += 1
            lastFailureTime = Date()
            if failureCount >= failureThreshold {
                state = .open
            }
            return try await fallback(error)
        }
    }
}
```
