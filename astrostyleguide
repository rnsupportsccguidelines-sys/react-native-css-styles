## Code Comparison: UI State & Data Fetching

To evaluate the developer experience across stacks, compare this standard enterprise pattern—fetching an order list with loading states and pull-to-refresh:

<Tabs>
  <TabItem label="React Native (TypeScript)">

```typescript
import React, { useState, useEffect } from 'react';
import { View, Text, FlatList, RefreshControl, StyleSheet, ActivityIndicator } from 'react-native';

interface Order {
  id: string;
  orderNumber: string;
  status: string;
}

export function OrderListScreen() {
  const [orders, setOrders] = useState<Order[]>([]);
  const [isLoading, setIsLoading] = useState(true);
  const [isError, setIsError] = useState(false);
  const [refreshing, setRefreshing] = useState(false);

  const fetchOrders = async () => {
    try {
      setIsError(false);
      const res = await fetch('https://api.example.com/v1/orders');
      if (!res.ok) throw new Error('Network error');
      const data: Order[] = await res.json();
      setOrders(data);
    } catch (err) {
      setIsError(true);
    } finally {
      setIsLoading(false);
      setRefreshing(false);
    }
  };

  useEffect(() => {
    fetchOrders();
  }, []);

  const onRefresh = async () => {
    setRefreshing(true);
    await fetchOrders();
  };

  if (isLoading && !refreshing) {
    return <ActivityIndicator size="large" color="#22c55e" style={styles.center} />;
  }

  if (isError) {
    return <Text style={styles.errorText}>Unable to load enterprise orders.</Text>;
  }

  return (
    <View style={styles.container}>
      <FlatList
        data={orders}
        keyExtractor={item => item.id}
        refreshControl={<RefreshControl refreshing={refreshing} onRefresh={onRefresh} tintColor="#22c55e" />}
        renderItem={({ item }) => (
          <View style={styles.card}>
            <Text style={styles.title}>{item.orderNumber}</Text>
            <Text style={styles.status}>{item.status}</Text>
          </View>
        )}
      />
    </View>
  );
}

const styles = StyleSheet.create({
  container: { flex: 1, backgroundColor: '#0d1912', padding: 16 },
  center: { flex: 1, justifyContent: 'center', alignItems: 'center' },
  card: { padding: 14, backgroundColor: '#13251c', borderRadius: 8, marginBottom: 10, borderColor: '#1f3b2c', borderWidth: 1 },
  title: { color: '#f3d17b', fontWeight: '700', fontSize: 16 },
  status: { color: '#cbd5e1', marginTop: 4, fontSize: 14 },
  errorText: { color: '#ef4444', textAlign: 'center', marginTop: 40 },
});
```

  </TabItem>
  <TabItem label="Native Android (Kotlin / Compose)">

```kotlin
