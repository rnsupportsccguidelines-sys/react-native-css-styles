import SwiftUI

/// Stateful Screen Container: wires ViewModel lifecycle and intent dispatch.
public struct UserProfileRoute: View {
    let userId: String
    @State private var viewModel: UserProfileViewModel

    public init(userId: String, viewModel: UserProfileViewModel) {
        self.userId = userId
        self._viewModel = State(initialValue: viewModel)
    }

    public var body: some View {
        UserProfileView(
            uiState: viewModel.uiState,
            onRefresh: { viewModel.send(.refreshProfile(userId)) }
        )
        .task {
            viewModel.send(.refreshProfile(userId))
        }
    }
}

/// Stateless Content View: pure UI renderer receiving immutable state and emitting closures.
/// Enables rapid SwiftUI previews and deterministic UI testing.
public struct UserProfileView: View {
    let uiState: UserProfileUIState
    let onRefresh: () -> Void

    public init(uiState: UserProfileUIState, onRefresh: @escaping () -> Void) {
        self.uiState = uiState
        self.onRefresh = onRefresh
    }

    public var body: some View {
        NavigationStack {
            ZStack {
                switch uiState {
                case .idle, .loading:
                    ProgressView("Loading Profile...")
                        .progressViewStyle(.circular)

                case .success(let user):
                    ProfileContent(user: user, onRefresh: onRefresh)

                case .error(let message):
                    ErrorContent(message: message, onRetry: onRefresh)
                }
            }
            .navigationTitle("User Profile")
            .navigationBarTitleDisplayMode(.inline)
        }
    }
}

private struct ProfileContent: View {
    let user: UserDomainModel
    let onRefresh: () -> Void

    var body: some View {
        VStack(alignment: .leading, spacing: 16) {
            Text(user.name)
                .font(.title)
                .fontWeight(.bold)

            Text(user.email)
                .font(.body)
                .foregroundStyle(.secondary)

