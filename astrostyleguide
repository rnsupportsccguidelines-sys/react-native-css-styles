### Configure the targets

Add the production files to the application/domain target and the tests to its **unit test target**. The sample uses XCTest to match the supplied references. Replace the test import with the actual module name. Do not add test helpers to the shipped application target.

**Files: `AccountBalance.swift`, `SessionGateway.swift`, `SignInAndLoadBalance.swift`.**

```swift
struct AccountBalance: Equatable, Sendable {
    let minorUnits: Int64
    let currency: String
}

protocol SessionGateway: Sendable {
    func authenticate(username: String, password: String) async throws -> String
    func balance(session: String) async throws -> AccountBalance
}

struct SignInAndLoadBalance: Sendable {
    let gateway: any SessionGateway
    func callAsFunction(username: String, password: String) async throws -> AccountBalance {
        let session = try await gateway.authenticate(username: username, password: password)
        return try await gateway.balance(session: session)
    }
}
```

**File: `MobileTests/SignInAndLoadBalanceTests.swift`.**

```swift
import XCTest
@testable import Mobile // Replace with the actual production module.

private enum FixtureFailure: Error, Equatable { case authentication, balance }

private actor FakeGateway: SessionGateway {
    private let failure: FixtureFailure?
    private var calls: [String] = []
    init(failure: FixtureFailure? = nil) { self.failure = failure }
    func authenticate(username: String, password: String) async throws -> String {
        calls.append("authenticate")
        if failure == .authentication { throw FixtureFailure.authentication }
        return "fixture-session"
    }
    func balance(session: String) async throws -> AccountBalance {
        calls.append("balance:\(session)")
        if failure == .balance { throw FixtureFailure.balance }
        return AccountBalance(minorUnits: 12500, currency: "USD")
    }
    func recordedCalls() -> [String] { calls }
}

final class SignInAndLoadBalanceTests: XCTestCase {
    func testReturnsBalanceForAuthenticatedSession() async throws {
        let gateway = FakeGateway()
        let result = try await SignInAndLoadBalance(gateway: gateway)(
            username: "fixture-user", password: "fixture-only")
        XCTAssertEqual(result, AccountBalance(minorUnits: 12500, currency: "USD"))
        let calls = await gateway.recordedCalls()
        XCTAssertEqual(calls, ["authenticate", "balance:fixture-session"])
    }

    func testAuthenticationFailureDoesNotLoadBalance() async {
        let gateway = FakeGateway(failure: .authentication)
        do {
            _ = try await SignInAndLoadBalance(gateway: gateway)(
                username: "fixture-user", password: "fixture-only")
            XCTFail("Expected authentication failure")
        } catch {
            XCTAssertEqual(error as? FixtureFailure, .authentication)
        }
        let calls = await gateway.recordedCalls()
        XCTAssertEqual(calls, ["authenticate"])
    }

    func testBalanceFailurePropagates() async {
        let gateway = FakeGateway(failure: .balance)
        do {
            _ = try await SignInAndLoadBalance(gateway: gateway)(
                username: "fixture-user", password: "fixture-only")
            XCTFail("Expected balance failure")
        } catch {
            XCTAssertEqual(error as? FixtureFailure, .balance)
        }
        let calls = await gateway.recordedCalls()
        XCTAssertEqual(calls, ["authenticate", "balance:fixture-session"])
    }
}
```

Actor-isolated recording avoids shared mutable test state. Read awaited values before passing them to XCTest assertion autoclosures. These tests do not validate Keychain, SwiftData, network authentication, or UI integration; those are additional boundaries in the real app.

