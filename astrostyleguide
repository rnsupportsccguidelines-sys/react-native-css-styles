#### Domain Layer: Entities, Protocol & Interactor
```swift
import Foundation

struct Order: Identifiable {
    let id: String
    let totalAmount: Decimal
    let items: [OrderItem]
}

protocol OrderRepositoryProtocol {
    func submitOrder(_ order: Order) async throws -> String
}

final class SubmitOrderUseCase {
    private let repository: OrderRepositoryProtocol

    init(repository: OrderRepositoryProtocol) {
        self.repository = repository
    }

    func execute(order: Order) async throws -> String {
        guard !order.items.isEmpty else {
            throw DomainError.emptyOrder
        }
        return try await repository.submitOrder(order)
    }
}
```

#### Data Layer: Repository Implementation
```swift
import Foundation

final class OrderRepositoryImpl: OrderRepositoryProtocol {
    private let networkClient: NetworkClientProtocol
    private let database: LocalDatabaseProtocol

    init(networkClient: NetworkClientProtocol, database: LocalDatabaseProtocol) {
        self.networkClient = networkClient
        self.database = database
    }

    func submitOrder(_ order: Order) async throws -> String {
        let dto = OrderRequestDTO(from: order)
        let response: OrderResponseDTO = try await networkClient.post("/v1/orders", body: dto)
        // Cache to local SQLite/CoreData storage
        try await database.persistOrderConfirmation(response.confirmationId)
        return response.confirmationId
    }
}
```

#### Presentation Layer: SwiftUI View & `@MainActor` ViewModel
```swift
import SwiftUI

@MainActor
final class OrderViewModel: ObservableObject {
    @Published var state: ViewState<String> = .idle
    private let useCase: SubmitOrderUseCase

    init(useCase: SubmitOrderUseCase) {
        self.useCase = useCase
    }

    func submit(order: Order) async {
        state = .loading
        do {
            let confirmationId = try await useCase.execute(order: order)
            self.state = .success(confirmationId)
        } catch {
            self.state = .error(error.localizedDescription)
        }
    }
}
```
