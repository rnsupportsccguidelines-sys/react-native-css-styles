enum CleanupError: Error { case invalidScope, alreadyRunning }

protocol CleanupPorts: Sendable {
    func blockProtectedAccess(_ scope: CleanupScope) async
    func recordPending(_ scope: CleanupScope) async throws
    func stopWriters(_ scope: CleanupScope) async throws
    func removeCredentials(_ scope: CleanupScope) async throws
    func removeData(_ scope: CleanupScope) async throws
    func removeCaches(_ scope: CleanupScope) async throws
    func destroyKeys(_ scope: CleanupScope) async throws
    func resetMemoryAndNavigation(_ scope: CleanupScope) async throws
    func verify(_ scope: CleanupScope) async throws
    func markComplete(_ scope: CleanupScope) async throws
    func reportFailure(_ stage: CleanupStage) async
}

actor AccountCleanupCoordinator {
    private let ports: any CleanupPorts
    private var isRunning = false
    init(ports: any CleanupPorts) { self.ports = ports }

    // Actor methods can interleave at await: reject overlapping executions explicitly.
    func execute(_ scope: CleanupScope) async throws -> CleanupResult {
        guard !scope.accountRef.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty else {
            throw CleanupError.invalidScope
        }
        guard !isRunning else { throw CleanupError.alreadyRunning }
        isRunning = true
        defer { isRunning = false }
        let ports = self.ports
        await ports.blockProtectedAccess(scope)

        if let failure = try await Self.attempt(.checkpoint, ports: ports, operation: {
            try await ports.recordPending(scope)
        }) { return CleanupResult(complete: false, failedStages: [failure]) }
        if let failure = try await Self.attempt(.stopWriters, ports: ports, operation: {
            try await ports.stopWriters(scope)
        }) { return CleanupResult(complete: false, failedStages: [failure]) }

        let operations: [(CleanupStage, @Sendable () async throws -> Void)] = [
            (.credentials, { try await ports.removeCredentials(scope) }),
            (.data, { try await ports.removeData(scope) }),
            (.caches, { try await ports.removeCaches(scope) }),
            (.keys, { try await ports.destroyKeys(scope) }),
            (.memory, { try await ports.resetMemoryAndNavigation(scope) }),
            (.verify, { try await ports.verify(scope) }),
        ]
        var failed: [CleanupStage] = []
        for (stage, operation) in operations {
            if let failure = try await Self.attempt(stage, ports: ports, operation: operation) {
                failed.append(failure)
            }
        }
        if !failed.isEmpty { return CleanupResult(complete: false, failedStages: failed) }
        if let failure = try await Self.attempt(.complete, ports: ports, operation: {
            try await ports.markComplete(scope)
        }) { return CleanupResult(complete: false, failedStages: [failure]) }
        return CleanupResult(complete: true, failedStages: [])
    }

    private nonisolated static func attempt(
        _ stage: CleanupStage,
        ports: any CleanupPorts,
        operation: @Sendable () async throws -> Void
    ) async throws -> CleanupStage? {
        do {
            try Task.checkCancellation()
            try await operation()
            return nil
        } catch is CancellationError {
            throw CancellationError()
        } catch {
            try Task.checkCancellation()
            await ports.reportFailure(stage)
            return stage
        }
    }
}
```

**Hint:** The actor guards overlapping cleanup but does not control external logins; the session owner provides that wider gate. Implement UI/navigation ports on the main actor and persistence ports with their correct storage isolation. Ports pass Sendable values, not a SwiftData `ModelContext`. Preserve cancellation and journal state; never turn a cancelled operation into reported completion. Implement scoped Keychain deletion through the credential adapter and inspect file/database deletion outcomes instead of using `try?` on required cleanup.


