Using the official Unleash Android Proxy SDK (`io.getunleash:unleash-android-proxy-sdk`) with Jetpack Compose:

#### 1. Unleash Manager (`com.enterprise.mobile.core.flags.UnleashManager.kt`)
```kotlin
package com.enterprise.mobile.core.flags

import android.content.Context
import io.getunleash.UnleashClient
import io.getunleash.UnleashConfig
import io.getunleash.UnleashContext
import kotlinx.coroutines.flow.MutableStateFlow
import kotlinx.coroutines.flow.StateFlow
import kotlinx.coroutines.flow.asStateFlow
import javax.inject.Inject
import javax.inject.Singleton

@Singleton
class UnleashManager @Inject constructor(
    private val context: Context
) {
    private var unleashClient: UnleashClient? = null
    private val _flagsUpdated = MutableStateFlow(System.currentTimeMillis())
    val flagsUpdated: StateFlow<Long> = _flagsUpdated.asStateFlow()

    fun initialize(userId: String, appVersion: String) {
        val config = UnleashConfig.newBuilder()
            .appName("enterprise-android-app")
            .unleashAPI("https://flags.enterprise.internal/proxy")
            .customHttpHeader("Authorization", "mobile:production.android_key")
            .fetchTogglesInterval(15)
            .build()

        val unleashContext = UnleashContext.newBuilder()
            .userId(userId)
            .appName("enterprise-android-app")
            .addProperty("appVersion", appVersion)
            .addProperty("platform", "android")
            .build()

        unleashClient = UnleashClient(config, context, unleashContext)
        unleashClient?.addStatusListener {
            _flagsUpdated.value = System.currentTimeMillis()
        }
    }

    fun isEnabled(flagKey: String, defaultValue: Boolean = false): Boolean {
        return unleashClient?.isEnabled(flagKey) ?: defaultValue
    }
}
```

