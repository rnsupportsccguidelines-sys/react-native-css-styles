---
interface Props {
  title?: string;
  id?: string;
}

const { title = "ARCHITECTURE DIAGRAM", id } = Astro.props;
const toggleId = id
  ? `diagram-${id}-toggle`
  : `diagram-${Math.random().toString(36).slice(2, 9)}-toggle`;
---

<div class="portal-diagram-wrap">
  <input type="checkbox" id={toggleId} class="portal-diagram-toggle" />
  <div class="portal-diagram-header">
    <span class="portal-diagram-badge">{title}</span>
    <label for={toggleId} class="portal-expand-btn" title="Toggle Fullscreen">
      <svg class="portal-icon-expand" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"></path>
      </svg>
      <svg class="portal-icon-close" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
      <span class="portal-text-expand">Expand Diagram</span>
      <span class="portal-text-close">Close Fullscreen</span>
    </label>
  </div>
  <div class="portal-diagram-viewport">
    <slot />
  </div>
</div>
