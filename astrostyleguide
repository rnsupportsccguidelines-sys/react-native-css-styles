## Implementation Across Platforms

The enterprise resilience library is available across all three tier-1 mobile stacks. Observe the complete implementation patterns below:

<Tabs syncKey="mobile-platform">
<TabItem label="React Native (TypeScript)">

Using the official enterprise resilience client with MMKV local cache fallback:

```typescript
import { CircuitBreaker } from '@enterprise/resilience-sdk';
import { MMKV } from 'react-native-mmkv';

const storage = new MMKV({ id: 'user-cache-secure' });

export interface OrderDashboard {
  userId: string;
  activeOrders: number;
  totalSpent: number;
}

// 1. Initialize Circuit Breaker for the Orders Domain
export const ordersBreaker = new CircuitBreaker({
  name: 'OrdersServiceBreaker',
  failureThreshold: 3,
  resetTimeoutMs: 30000,
  requestTimeoutMs: 5000,
  onStateChange: (from, to) => {
    console.warn(`[Resilience] Orders Breaker transitioned: ${from} -> ${to}`);
  },
});

// 2. Wrap network request with automatic offline cache fallback
export async function getOrderDashboard(userId: string): Promise<OrderDashboard> {
  const cacheKey = `dashboard_${userId}`;

  return await ordersBreaker.execute(
    // Primary Action: Remote Network Query
    async () => {
      const response = await fetch(`https://api.enterprise.internal/v1/orders/dashboard/${userId}`, {
        headers: { 'Accept': 'application/json' },
      });

      if (!response.ok) {
        throw new Error(`HTTP Error: ${response.status}`);
      }

      const freshData: OrderDashboard = await response.json();
      // Update encrypted local cache on successful network call
      storage.set(cacheKey, JSON.stringify(freshData));
      return freshData;
    },
    // Fallback Action: Executed immediately when breaker is Open or network drops
    async (error) => {
      const cached = storage.getString(cacheKey);
      if (cached) {
        console.info(`[Resilience] Serving cached dashboard data due to: ${error.message}`);
        return JSON.parse(cached) as OrderDashboard;
      }
      throw new Error('Offline and no cached dashboard data available.');
    }
  );
}
```
