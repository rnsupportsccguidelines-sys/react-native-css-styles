test('repeated dispatch while pending makes one submission', async () => {
  let calls = 0;
  let complete!: (receipt: OrderReceipt) => void;
  const pending = new Promise<OrderReceipt>(resolve => { complete = resolve; });
  const store = makeOrderStore(new PlaceChickenOrder({
    place: async () => { calls++; return pending; },
  }));
  const first = store.dispatch(submitOrder(input));
  const second = await store.dispatch(submitOrder(input));
  expect(submitOrder.rejected.match(second) && second.meta.condition).toBe(true);
  expect(calls).toBe(1);
  expect(store.getState().order.status).toBe('submitting');
  complete({ orderId: 'order-001' });
  await first;
  expect(store.getState().order.status).toBe('confirmed');
});

test('unknown outcome blocks an automatic repeat', async () => {
  let calls = 0;
  const store = makeOrderStore(new PlaceChickenOrder({
    place: async () => { calls++; throw new Error('network-timeout'); },
  }));
  await store.dispatch(submitOrder(input));
  expect(store.getState().order.status).toBe('unknown');
  await store.dispatch(submitOrder(input));
  expect(calls).toBe(1);
});

