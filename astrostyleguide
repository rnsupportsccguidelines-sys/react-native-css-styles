package com.enterprise.mobile.core.wipe

import android.content.Context
import com.enterprise.mobile.core.security.vault.KeyStoreVault
import dagger.hilt.android.qualifiers.ApplicationContext
import kotlinx.coroutines.Dispatchers
import kotlinx.coroutines.withContext
import java.io.File
import javax.inject.Inject
import javax.inject.Singleton

@Singleton
class EnterpriseDataWiper @Inject constructor(
    @ApplicationContext private val context: Context,
    private val keyStoreVault: KeyStoreVault
) {

    suspend fun executeCompleteWipe(): Result<Unit> = withContext(Dispatchers.IO) {
        runCatching {
            // Stage 1: Purge hardware KeyStore encryption keys
            keyStoreVault.purgeVault()

            // Stage 2: Delete Room databases
            context.databaseList().forEach { dbName ->
                context.deleteDatabase(dbName)
            }

            // Stage 3: Purge cache and code cache directories
            context.cacheDir.deleteRecursively()
            context.codeCacheDir.deleteRecursively()

            // Stage 4: Delete SharedPreferences files
            val sharedPrefsDir = File(context.filesDir.parent, "shared_prefs")
            if (sharedPrefsDir.exists()) {
                sharedPrefsDir.deleteRecursively()
            }
        }
    }
}
```

