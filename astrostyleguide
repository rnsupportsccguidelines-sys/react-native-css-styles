            set -euo pipefail
            bash scripts/ci/detect-affected.sh
            while IFS='=' read -r key value; do
              case "$key" in
                RUN_AUTH_TESTS|RUN_ORDERS_TESTS|RUN_CORE_TESTS)
                  case "$value" in true|false) ;; *) exit 1 ;; esac ;;
                AFFECTED_REASON) ;;
                *) exit 1 ;;
              esac
              envman add --key "$key" --value "$value"
            done < .tmp/ci/affected.env
  - share-pipeline-variable@1:
