package com.enterprise.mobile.core.push

import kotlinx.serialization.SerialName
import kotlinx.serialization.Serializable
import kotlinx.serialization.json.Json

@Serializable
sealed interface PushDestination {
    @Serializable @SerialName("home")
    data object Home : PushDestination
    @Serializable @SerialName("order")
    data class Order(val orderId: String) : PushDestination
}

@Serializable
data class PushIntent(
    val version: Int,
    val eventId: String,
    val expiresAtMillis: Long,
    val destination: PushDestination,
)

object PushIntentDecoder {
    private val json = Json { classDiscriminator = "kind"; ignoreUnknownKeys = true }
    private val idPattern = Regex("[A-Za-z0-9_-]{1,128}")

    fun parse(raw: String?, nowMillis: Long): PushIntent? {
        if (raw == null || raw.length > 2048) return null
        val intent = try { json.decodeFromString<PushIntent>(raw) }
        catch (_: kotlinx.serialization.SerializationException) { return null }
        catch (_: IllegalArgumentException) { return null }
        if (intent.version != 1 || !idPattern.matches(intent.eventId) ||
            intent.expiresAtMillis <= nowMillis) return null
        val destination = intent.destination
        if (destination is PushDestination.Order && !idPattern.matches(destination.orderId)) return null
        return intent
    }
}
```

