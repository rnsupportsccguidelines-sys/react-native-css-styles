import { MMKV } from 'react-native-mmkv';

// Initialized with hardware-backed encryption key from Keychain/KeyStore
export const secureStorage = new MMKV({
  id: 'enterprise-secure-storage',
  encryptionKey: 'resolved-from-hardware-keychain',
});

export const StorageService = {
  setString: (key: string, value: string) => secureStorage.set(key, value),
  getString: (key: string): string | undefined => secureStorage.getString(key),
  setObject: <T>(key: string, value: T) => secureStorage.set(key, JSON.stringify(value)),
  getObject: <T>(key: string): T | null => {
    const raw = secureStorage.getString(key);
    return raw ? (JSON.parse(raw) as T) : null;
  },
  delete: (key: string) => secureStorage.delete(key),
};
```

#### 2. Durable Outbox Sync Queue (`src/core/sync/OutboxManager.ts`)
```typescript
import NetInfo from '@react-native-community/netinfo';
import { StorageService } from '../storage/SecureStorage';

export interface OutboxMutation {
  id: string; // Idempotency UUID
  endpoint: string;
  payload: Record<string, unknown>;
  createdAt: number;
  retryCount: number;
}

export class OutboxManager {
  private static QUEUE_KEY = 'offline_outbox_queue';
  private static isDraining = false;

  static enqueue(endpoint: string, payload: Record<string, unknown>): string {
    const queue = StorageService.getObject<OutboxMutation[]>(this.QUEUE_KEY) ?? [];
    const mutation: OutboxMutation = {
      id: `mut_${Date.now()}_${Math.random().toString(36).substring(2, 9)}`,
      endpoint,
      payload,
      createdAt: Date.now(),
      retryCount: 0,
    };

    queue.push(mutation);
    StorageService.setObject(this.QUEUE_KEY, queue);

    // Trigger immediate drain if connected
    this.drain();
    return mutation.id;
  }

  static async drain(): Promise<void> {
    if (this.isDraining) return;
    const net = await NetInfo.fetch();
    if (!net.isConnected || !net.isInternetReachable) return;

    this.isDraining = true;
    const queue = StorageService.getObject<OutboxMutation[]>(this.QUEUE_KEY) ?? [];
    const remaining: OutboxMutation[] = [];

    for (const item of queue) {
      try {
        const response = await fetch(item.endpoint, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-Idempotency-Key': item.id,
          },
          body: JSON.stringify(item.payload),
        });

        if (!response.ok && response.status < 500) {
          // Client error (4xx) - cannot be retried, discard with logging
          console.error(`[Outbox] Dropping non-retryable mutation: ${item.id}`, response.status);
          continue;
        }

        if (!response.ok) {
          throw new Error(`Server returned status: ${response.status}`);
        }
      } catch (error) {
        item.retryCount += 1;
        remaining.push(item);
      }
    }

    StorageService.setObject(this.QUEUE_KEY, remaining);
    this.isDraining = false;
  }
}

// Auto-drain when connection is restored
NetInfo.addEventListener((state) => {
  if (state.isConnected && state.isInternetReachable) {
    OutboxManager.drain();
  }
});
```
