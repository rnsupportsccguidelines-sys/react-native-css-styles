import SwiftUI

@Observable
public final class LocaleCoordinator {
    public static let shared = LocaleCoordinator()

    public private(set) var currentLocale: Locale = Locale.current

    public var isRTL: Bool {
        Locale.characterDirection(forLanguage: currentLocale.identifier) == .rightToLeft
    }

    private init() {}

    public func setLocale(identifier: String) {
        currentLocale = Locale(identifier: identifier)
        UserDefaults.standard.set([identifier], forKey: "AppleLanguages")
        UserDefaults.standard.synchronize()
    }

    public func localizedString(key: String) -> String {
        guard let path = Bundle.main.path(forResource: currentLocale.identifier, ofType: "lproj"),
              let bundle = Bundle(path: path) else {
            return NSLocalizedString(key, comment: "")
        }
        return bundle.localizedString(forKey: key, value: nil, table: nil)
    }
}
