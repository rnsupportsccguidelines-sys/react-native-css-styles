### Implementing Circuit Breaker & Offline Fallback

The following TypeScript snippet demonstrates how mobile applications implement a resilient Circuit Breaker pattern with local offline caching using standard `@react-native-async-storage/async-storage`:

```typescript
import AsyncStorage from '@react-native-async-storage/async-storage';

// Standard Circuit Breaker state machine
export class CircuitBreaker {
  private failureCount = 0;
  private state: 'CLOSED' | 'OPEN' | 'HALF_OPEN' = 'CLOSED';
  private nextAttempt = Date.now();

  constructor(
    private failureThreshold = 3,
    private resetTimeoutMs = 30000
  ) {}

  async execute<T>(action: () => Promise<T>): Promise<T> {
    if (this.state === 'OPEN') {
      if (Date.now() > this.nextAttempt) {
        this.state = 'HALF_OPEN';
      } else {
        throw new Error('Circuit breaker is OPEN: fast-failing request.');
      }
    }

    try {
      const result = await action();
      this.failureCount = 0;
      this.state = 'CLOSED';
      return result;
    } catch (error) {
      this.failureCount++;
      if (this.failureCount >= this.failureThreshold) {
        this.state = 'OPEN';
        this.nextAttempt = Date.now() + this.resetTimeoutMs;
      }
      throw error;
    }
  }
}

interface UserProfile {
  id: string;
  name: string;
  email: string;
}

const profileBreaker = new CircuitBreaker(3, 30000);

export async function getUserProfile(userId: string): Promise<UserProfile> {
  const cacheKey = `@cache:user:${userId}`;

  try {
    // Execute request within resilience guard
    return await profileBreaker.execute(async () => {
      const response = await fetch(`https://api.example.com/v1/users/${userId}`);
      if (!response.ok) throw new Error(`HTTP Error: ${response.status}`);
      
      const data: UserProfile = await response.json();
      await AsyncStorage.setItem(cacheKey, JSON.stringify(data));
      return data;
    });
  } catch (err) {
    // Gracefully serve stale cached data when offline or circuit is open
    const cachedData = await AsyncStorage.getItem(cacheKey);
    if (cachedData) {
      return JSON.parse(cachedData) as UserProfile;
    }
    throw new Error('Offline and no cached data available for this user.');
  }
}
```

