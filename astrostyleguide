Admission and completion transitions are synchronous on the owning JavaScript runtime. No network operation is executed while updating state. Do not share this mutable instance across independent JS runtimes.

```typescript
export class CircuitOpenError extends Error {
  constructor() {
    super('Dependency temporarily unavailable');
    this.name = 'CircuitOpenError';
  }
}

type Outcome = 'success' | 'failure' | 'ignored' | 'cancelled';
type Ticket = Readonly<{ epoch: number; probe: boolean }>;

export class CircuitBreaker {
  private state: 'closed' | 'open' | 'halfOpen' = 'closed';
  private failures = 0;
  private openedAt = 0;
  private epoch = 0;

  constructor(
    private readonly failureThreshold: number,
    private readonly cooldownMs: number,
    private readonly countsAsFailure: (error: unknown) => boolean,
    private readonly now: () => number,
  ) {
    if (!Number.isSafeInteger(failureThreshold) || failureThreshold < 1) {
      throw new Error('failureThreshold must be a positive safe integer');
    }
    if (!Number.isFinite(cooldownMs) || cooldownMs <= 0) {
      throw new Error('cooldownMs must be positive and finite');
    }
  }

  private admit(): Ticket {
    if (this.state === 'halfOpen') throw new CircuitOpenError();
    if (this.state === 'open') {
      if (this.now() - this.openedAt < this.cooldownMs) {
        throw new CircuitOpenError();
      }
      this.state = 'halfOpen';
      this.epoch += 1;
      return { epoch: this.epoch, probe: true };
    }
    return { epoch: this.epoch, probe: false };
  }

  private open(): void {
    this.state = 'open';
    this.openedAt = this.now();
    this.failures = 0;
    this.epoch += 1;
  }

  private finish(ticket: Ticket, outcome: Outcome): void {
    if (ticket.epoch !== this.epoch) return;
    if (ticket.probe) {
      if (outcome === 'failure' || outcome === 'cancelled') this.open();
      else {
        this.state = 'closed';
        this.failures = 0;
        this.epoch += 1;
      }
    } else if (outcome === 'failure') {
      this.failures += 1;
      if (this.failures >= this.failureThreshold) this.open();
    } else if (outcome !== 'cancelled') {
      this.failures = 0;
    }
  }

  async execute<T>(
    signal: AbortSignal,
    operation: (signal: AbortSignal) => Promise<T>,
  ): Promise<T> {
    const checkCancellation = (): void => {
      if (signal.aborted) {
        const error = new Error('Operation cancelled');
        error.name = 'AbortError';
        throw error;
      }
    };
    checkCancellation();
    const ticket = this.admit();
    let value: T;
    try {
      checkCancellation();
      value = await operation(signal);
      checkCancellation();
    } catch (error: unknown) {
      const cancelled = signal.aborted ||
        (error instanceof Error && error.name === 'AbortError');
      this.finish(ticket, cancelled ? 'cancelled' :
        this.countsAsFailure(error) ? 'failure' : 'ignored');
      throw error;
    }
    this.finish(ticket, 'success');
    return value;
  }
}
```

