### 2. Enterprise Wrapper Implementation (`DatadogAnalyticsWrapper.swift`)
Enterprise iOS standards utilize a singleton wrapper pattern reading configuration values from build scheme environment variables:

```swift
import Foundation
import UIKit
import DatadogCore
import DatadogRUM
import DatadogCrashReporting

@objc public final class DatadogAnalyticsWrapper: NSObject {
    @objc public static let shared = DatadogAnalyticsWrapper()

    private override init() {
        super.init()
    }

    @objc public func configure() {
        guard let clientToken = ProcessInfo.processInfo.environment["CLIENT_TOKEN"],
              let env = ProcessInfo.processInfo.environment["ENV"],
              let appName = ProcessInfo.processInfo.environment["APP_NAME"],
              let applicationId = ProcessInfo.processInfo.environment["APPLICATION_ID"] else {
            print("[Datadog] Missing environment configuration. Skipping telemetry init.")
            return
        }

        Datadog.initialize(
            with: Datadog.Configuration(
                clientToken: clientToken,
                env: env,
                site: .us1
            ),
            trackingConsent: .granted
        )

        // Enable RUM with automated view and tap tracking
        RUM.enable(
            with: RUM.Configuration(
                applicationID: applicationId,
                uiKitViewsPredicate: DefaultUIKitRUMViewsPredicate(),
                uiKitActionsPredicate: DefaultUIKitRUMActionsPredicate()
            )
        )

        // Enable Native Crash Reporting
        CrashReporting.enable()

        print("[Datadog] Initialized successfully for \(appName) [\(env)]")
    }

    @objc public func log(action: String, attributes: [String: Any]? = nil) {
        RUMMonitor.shared().addAction(
            type: .custom,
            name: action,
            attributes: attributes ?? [:]
        )
    }
}
```

