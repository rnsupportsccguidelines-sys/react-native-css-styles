import Foundation
import SwiftData

/// Dependency Injection Container conforming to Enterprise DI specifications.
@MainActor
public final class UserContainer {
    public static let shared = UserContainer()

    private let modelContainer: ModelContainer

    private init() {
        do {
            let schema = Schema([UserPersistentModel.self])
            let config = ModelConfiguration(schema: schema, isStoredInMemoryOnly: false)
            self.modelContainer = try ModelContainer(for: schema, configurations: [config])
        } catch {
            fatalError("Failed to initialize SwiftData ModelContainer: \(error)")
        }
    }

    public func makeUserRepository() -> UserRepository {
        UserRepositoryImpl(
            session: .shared,
            baseURL: URL(string: "https://api.enterprise.internal")!,
            modelContainer: modelContainer
        )
    }

    public func makeGetUserProfileUseCase() -> GetUserProfileUseCase {
        GetUserProfileUseCase(userRepository: makeUserRepository())
    }

    public func makeUserProfileViewModel() -> UserProfileViewModel {
        UserProfileViewModel(getUserProfileUseCase: makeGetUserProfileUseCase())
    }
}
