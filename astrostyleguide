├── core/                                   # Shared enterprise infrastructure
│   ├── network/                            # Axios/Fetch client, interceptors & SSL pinning
│   ├── security/                           # Hardware Keychain / KeyStore JSI bridge
│   ├── storage/                            # MMKV root configuration & encryption keys
│   └── theme/                              # Enterprise design tokens (Colors, Typography, Spacing)
│
├── di/                                     # Global inversion-of-control container
│   └── serviceContainer.ts                 # Service locator wiring shared infrastructure
│
└── features/user/                          # USER FEATURE MODULE (Vertical Slice)
    ├── data/                               # Data Layer: Single Source of Truth
    │   ├── remote/
