import { MMKV } from 'react-native-mmkv';
import type { UserDomainModel } from '../../domain/model/UserDomainModel';

export interface IUserStorage {
  getUser(userId: string): UserDomainModel | null;
  saveUser(user: UserDomainModel): void;
  removeUser(userId: string): void;
}

/**
 * Synchronous local cache powered by Tencent MMKV with C++ JSI bindings.
 * Operates up to 30x faster than legacy AsyncStorage.
 */
export class UserStorage implements IUserStorage {
  private readonly storage: MMKV;

  constructor() {
    this.storage = new MMKV({
      id: 'enterprise-user-cache',
      encryptionKey: 'enterprise-secure-mmkv-key',
    });
  }

  getUser(userId: string): UserDomainModel | null {
    const raw = this.storage.getString(`user_${userId}`);
    if (!raw) return null;
    try {
      return JSON.parse(raw) as UserDomainModel;
    } catch {
      return null;
    }
  }

  saveUser(user: UserDomainModel): void {
    this.storage.set(`user_${user.id}`, JSON.stringify(user));
  }

  removeUser(userId: string): void {
    this.storage.delete(`user_${userId}`);
  }
}
