                )
            }
            is OrderUiState.Success -> {
                LazyColumn(verticalArrangement = Arrangement.spacedBy(10.dp)) {
                    items(state.orders) { order ->
                        Card(
                            colors = CardDefaults.cardColors(containerColor = Color(0xFF13251C)),
