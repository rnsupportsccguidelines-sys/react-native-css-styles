An actor serializes state access. The operation runs across an `await`, so other callers can be admitted while the first is suspended. Epochs protect against stale completions during that reentrancy.

```swift
import Foundation

struct CircuitOpenError: Error, Sendable {}

actor CircuitBreaker {
    private enum State { case closed, open, halfOpen }
    private enum Outcome { case success, failure, ignored, cancelled }
    private struct Ticket {
        let epoch: UInt64
        let probe: Bool
    }

    private let failureThreshold: Int
    private let cooldown: TimeInterval
    private let countsAsFailure: @Sendable (any Error) -> Bool
    private let now: @Sendable () -> TimeInterval
    private var state = State.closed
    private var failures = 0
    private var openedAt: TimeInterval = 0
    private var epoch: UInt64 = 0

    init(
        failureThreshold: Int,
        cooldown: TimeInterval,
        countsAsFailure: @escaping @Sendable (any Error) -> Bool,
        now: @escaping @Sendable () -> TimeInterval = {
            ProcessInfo.processInfo.systemUptime
        }
    ) {
        precondition(failureThreshold > 0)
        precondition(cooldown.isFinite && cooldown > 0)
        self.failureThreshold = failureThreshold
        self.cooldown = cooldown
        self.countsAsFailure = countsAsFailure
        self.now = now
    }

    private func admit() throws -> Ticket {
        switch state {
        case .closed:
            return Ticket(epoch: epoch, probe: false)
        case .halfOpen:
            throw CircuitOpenError()
        case .open:
            guard now() - openedAt >= cooldown else { throw CircuitOpenError() }
            state = .halfOpen
            epoch &+= 1
            return Ticket(epoch: epoch, probe: true)
        }
    }

    private func open() {
        state = .open
        openedAt = now()
        failures = 0
        epoch &+= 1
    }

    private func finish(_ ticket: Ticket, _ outcome: Outcome) {
        guard ticket.epoch == epoch else { return }
        if ticket.probe {
            switch outcome {
            case .failure, .cancelled:
                open()
            case .success, .ignored:
                state = .closed
                failures = 0
                epoch &+= 1
            }
        } else {
            switch outcome {
            case .success, .ignored:
                failures = 0
            case .failure:
                failures += 1
                if failures >= failureThreshold { open() }
            case .cancelled:
                break
            }
        }
    }

    func execute<T: Sendable>(
        _ operation: @Sendable () async throws -> T
    ) async throws -> T {
        try Task.checkCancellation()
        let ticket = try admit()
        let value: T
        do {
            try Task.checkCancellation()
            value = try await operation()
            try Task.checkCancellation()
        } catch {
            if error is CancellationError || Task.isCancelled {
                finish(ticket, .cancelled)
                throw CancellationError()
            }
            finish(ticket, countsAsFailure(error) ? .failure : .ignored)
            throw error
        }
        finish(ticket, .success)
        return value
    }
}
```

