### Storage.swift

The local store owns its context and all persistent models. Its interface accepts and returns Sendable value snapshots, including on writes.

```swift
import Foundation
import SwiftData

@Model
final class UserPersistentModel {
    @Attribute(.unique) var cacheKey: String
    var accountID: String
    var userID: String
    var name: String
    var email: String
    var isVIP: Bool
    var cachedAt: Date

    init(accountID: String, user: UserDomainModel) {
        // Length prefix avoids ambiguous composite-key concatenation.
        cacheKey = "\(accountID.utf8.count):\(accountID):\(user.id)"
        self.accountID = accountID
        userID = user.id
        name = user.name
        email = user.email
        isVIP = user.isVIP
        cachedAt = user.cachedAt
    }
}

protocol UserLocalStore: Sendable {
    func read(accountID: String, userID: String) async throws -> UserDomainModel?
    func save(accountID: String, user: UserDomainModel) async throws -> UserDomainModel
    func remove(accountID: String, userID: String) async throws
}

@ModelActor
actor SwiftDataUserLocalStore: UserLocalStore {
    func read(accountID: String, userID: String) throws -> UserDomainModel? {
        try Task.checkCancellation()
        return try find(accountID: accountID, userID: userID).map(snapshot)
    }

    func save(accountID: String, user: UserDomainModel) throws -> UserDomainModel {
        try Task.checkCancellation()
        do {
            let record: UserPersistentModel
            if let existing = try find(accountID: accountID, userID: user.id) {
                record = existing
                record.name = user.name
                record.email = user.email
                record.isVIP = user.isVIP
                record.cachedAt = user.cachedAt
            } else {
                record = UserPersistentModel(accountID: accountID, user: user)
                modelContext.insert(record)
            }
            // No suspension between mutation and save: actor work stays serialized.
            try Task.checkCancellation()
            try modelContext.save()
            return snapshot(record)
        } catch {
            modelContext.rollback()
            throw error
        }
    }

    func remove(accountID: String, userID: String) throws {
        try Task.checkCancellation()
        do {
            if let record = try find(accountID: accountID, userID: userID) {
                modelContext.delete(record)
                try modelContext.save()
            }
        } catch {
            modelContext.rollback()
            throw error
        }
    }

    private func find(accountID: String, userID: String) throws -> UserPersistentModel? {
        var descriptor = FetchDescriptor<UserPersistentModel>(
            predicate: #Predicate { $0.accountID == accountID && $0.userID == userID }
        )
        descriptor.fetchLimit = 1
        return try modelContext.fetch(descriptor).first
    }

    private func snapshot(_ record: UserPersistentModel) -> UserDomainModel {
        UserDomainModel(
            id: record.userID, name: record.name, email: record.email,
            isVIP: record.isVIP, cachedAt: record.cachedAt
        )
    }
}
```

<Aside type="tip" title="Hint · serialize mutation and save">
No suspension occurs between changing a record and saving it. A failed save rolls back pending changes in this dedicated context. Keep this context private to the feature store; rollback must not undo unrelated work. Share one store instance rather than constructing a new context for every request.
</Aside>

The key is account-scoped so two accounts cannot accidentally share a cached profile with the same user ID. The explicit update-or-insert logic controls which fields change; a uniqueness constraint alone does not define a complete synchronization policy.

`@ModelActor` provides isolation, not a blanket promise that storage work runs on a background thread. The executor depends on construction and configuration. Profile startup, database size, and query performance on devices. This schema uses a local unique attribute; review schema restrictions before adding CloudKit synchronization.

  </TabItem>
