  "name": "my-mobile-app",
  "version": "1.0.0",
  "scripts": {
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests --runInBand",
    "test:coverage": "jest --coverage --maxWorkers=2",
