## Cross-Platform Clean Architecture Implementation

The complete 4-layer structure is demonstrated below across all tier-1 mobile platforms:

<Tabs>
<TabItem label="React Native (TypeScript)">

### Domain Layer: Entities, Contract & Use Case
```typescript
// src/domain/entities/Order.ts
export interface OrderItem {
  id: string;
  name: string;
  quantity: number;
  unitPrice: number;
}

export interface Order {
  id: string;
  items: OrderItem[];
  totalAmount: number;
}

// src/domain/repositories/OrderRepository.ts
export interface OrderRepository {
  submitOrder(order: Order): Promise<{ confirmationId: string }>;
}

// src/domain/usecases/SubmitOrderUseCase.ts
import { Order } from '../entities/Order';
import { OrderRepository } from '../repositories/OrderRepository';

export class SubmitOrderUseCase {
  constructor(private orderRepository: OrderRepository) {}

  async execute(order: Order): Promise<{ confirmationId: string }> {
    if (order.items.length === 0) {
      throw new Error('Cannot submit an order with zero items.');
    }
    return await this.orderRepository.submitOrder(order);
  }
}
```

### Data Layer: Repository Implementation with Resilience
```typescript
// src/data/repositories/OrderRepositoryImpl.ts
import { OrderRepository } from '../../domain/repositories/OrderRepository';
import { Order } from '../../domain/entities/Order';
import { CircuitBreaker } from '../../core/resilience/CircuitBreaker';

export class OrderRepositoryImpl implements OrderRepository {
  private breaker = new CircuitBreaker({ failureThreshold: 3, resetTimeoutMs: 15000 });

  async submitOrder(order: Order): Promise<{ confirmationId: string }> {
    return await this.breaker.execute(async () => {
      const response = await fetch('https://api.enterprise.com/v1/orders', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(order),
      });
      if (!response.ok) throw new Error(`HTTP Error: ${response.status}`);
      return await response.json();
    });
  }
}
```

### Presentation Layer: Hook & View Component
```typescript
// src/presentation/hooks/useSubmitOrder.ts
import { useState } from 'react';
import { SubmitOrderUseCase } from '../../domain/usecases/SubmitOrderUseCase';
import { Order } from '../../domain/entities/Order';

export function useSubmitOrder(useCase: SubmitOrderUseCase) {
  const [submitting, setSubmitting] = useState(false);
  const [confirmationId, setConfirmationId] = useState<string | null>(null);
  const [error, setError] = useState<string | null>(null);

  const submit = async (order: Order) => {
    setSubmitting(true);
    setError(null);
    try {
      const result = await useCase.execute(order);
      setConfirmationId(result.confirmationId);
    } catch (err: unknown) {
      setError(err instanceof Error ? err.message : 'Unknown submission error');
    } finally {
      setSubmitting(false);
    }
  };

  return { submit, submitting, confirmationId, error };
}
```
</TabItem>

