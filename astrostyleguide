## 3. Copy the feature files

<Tabs>
<TabItem label="authenticate-demo.js">

```javascript
// Synthetic fixture for the documentation demo. Keep real authentication in its approved adapter.
export function authenticateDemo(username, password) {
  if (!username.trim()) {
    return {ok: false, message: 'Enter a username.'};
  }
  if (!password) {
    return {ok: false, message: 'Enter a password.'};
  }
  if (username.trim() !== 'demo-user' || password !== 'demo-only') {
    return {ok: false, message: 'Invalid demo credentials.'};
  }
  return {ok: true};
}
```

