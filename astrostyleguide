```kotlin
package com.enterprise.mobile.core.branding

import android.content.ComponentName
import android.content.Context
import android.content.pm.PackageManager

object DynamicIconManager {

    enum class AppIcon(val aliasName: String) {
        DEFAULT("com.enterprise.mobile.MainActivityDefault"),
        SEASONAL("com.enterprise.mobile.MainActivitySeasonal"),
        VIP_TIER("com.enterprise.mobile.MainActivityVip")
    }

    fun setAppIcon(context: Context, icon: AppIcon) {
        val packageManager = context.packageManager
        val packageName = context.packageName

        AppIcon.values().forEach { target ->
            val state = if (target == icon) {
                PackageManager.COMPONENT_ENABLED_STATE_ENABLED
            } else {
                PackageManager.COMPONENT_ENABLED_STATE_DISABLED
            }

            val component = ComponentName(packageName, target.aliasName)
            packageManager.setComponentEnabledSetting(
                component,
                state,
                PackageManager.DONT_KILL_APP
            )
        }
    }
}
