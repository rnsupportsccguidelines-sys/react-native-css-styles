### Durable Outbox Sync Queue

```typescript
// src/core/sync/OutboxManager.ts
import NetInfo from '@react-native-community/netinfo';
import { StorageService } from '../storage/StorageService';

export interface OutboxMutation {
  id: string; // Idempotency UUID
  endpoint: string;
  payload: Record<string, unknown>;
  createdAt: number;
  retryCount: number;
}

export class OutboxManager {
  private static QUEUE_KEY = '@offline_outbox_queue';
  private static isDraining = false;

  static async enqueue(endpoint: string, payload: Record<string, unknown>): Promise<string> {
    const queue = (await StorageService.getObject<OutboxMutation[]>(this.QUEUE_KEY)) ?? [];
    const mutation: OutboxMutation = {
      id: `mut_${Date.now()}_${Math.random().toString(36).substring(2, 9)}`,
      endpoint,
      payload,
      createdAt: Date.now(),
      retryCount: 0,
    };

    queue.push(mutation);
    await StorageService.setObject(this.QUEUE_KEY, queue);
    this.drainQueue();
    return mutation.id;
  }

  static async drainQueue(): Promise<void> {
    if (this.isDraining) return;
    const netState = await NetInfo.fetch();
    if (!netState.isConnected) return;

    this.isDraining = true;
    try {
      const queue = (await StorageService.getObject<OutboxMutation[]>(this.QUEUE_KEY)) ?? [];
      const remaining: OutboxMutation[] = [];

      for (const item of queue) {
        try {
          const res = await fetch(item.endpoint, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'X-Idempotency-Key': item.id,
            },
            body: JSON.stringify(item.payload),
          });

          if (!res.ok && res.status >= 500) {
            item.retryCount++;
            remaining.push(item);
          }
        } catch {
          item.retryCount++;
          remaining.push(item);
        }
      }

      await StorageService.setObject(this.QUEUE_KEY, remaining);
    } finally {
      this.isDraining = false;
    }
  }
}
```
