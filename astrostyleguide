## 5. Copy the implementation

### OrderDomain.kt

Domain models, repository contract, and quantity validation.

```kotlin
package com.example.mychicken.orderdemo

data class OrderRequest(
    val accountId: String,
    val requestId: String,
    val itemId: String,
    val quantity: Int,
)
sealed interface OrderOutcome {
    data class Confirmed(val orderId: String) : OrderOutcome
    data object Invalid : OrderOutcome
    data object Unknown : OrderOutcome
}
interface OrderRepository {
    suspend fun place(request: OrderRequest): OrderOutcome
}
fun parseQuantity(text: String): Int? {
    if (text.isEmpty() || text.any { it !in '0'..'9' }) return null
    return text.toIntOrNull()?.takeIf { it in 1..20 }
}
class PlaceChickenOrder(private val repository: OrderRepository) {
    suspend operator fun invoke(request: OrderRequest): OrderOutcome {
        if (listOf(request.accountId, request.requestId, request.itemId).any { it.isBlank() }
            || request.quantity !in 1..20) return OrderOutcome.Invalid
        return repository.place(request)
    }
}
```

### OrderData.kt

Injected API port, response mapping, and fake API.

```kotlin
package com.example.mychicken.orderdemo

import kotlinx.coroutines.CancellationException
import kotlinx.coroutines.delay

data class OrderResponse(val orderId: String)
interface OrderApi {
    suspend fun submit(request: OrderRequest): OrderResponse
}
class RemoteOrderRepository(private val api: OrderApi) : OrderRepository {
    override suspend fun place(request: OrderRequest): OrderOutcome = try {
        val response = api.submit(request)
        if (response.orderId.isBlank()) OrderOutcome.Unknown
        else OrderOutcome.Confirmed(response.orderId)
    } catch (cancelled: CancellationException) {
        throw cancelled
    } catch (_: Exception) {
        OrderOutcome.Unknown
    }
}

// DEMO ONLY: no HTTP, inventory mutation, payment, or real order.
class DemoOrderApi(private val simulateUnknown: Boolean = false) : OrderApi {
    override suspend fun submit(request: OrderRequest): OrderResponse {
        delay(300)
        return OrderResponse(if (simulateUnknown) "" else "order-001")
    }
}
```

### OrderViewModel.kt

Read-only state, submission coordination, and owner invalidation.

```kotlin
package com.example.mychicken.orderdemo

import androidx.annotation.MainThread
import androidx.lifecycle.ViewModel
import androidx.lifecycle.viewModelScope
import java.util.UUID
import kotlinx.coroutines.CancellationException
import kotlinx.coroutines.flow.MutableStateFlow
import kotlinx.coroutines.flow.asStateFlow
import kotlinx.coroutines.launch

enum class OrderPhase { IDLE, INVALID, SUBMITTING, CONFIRMED, UNKNOWN }
data class OrderUiState(
    val quantityText: String = "2",
    val phase: OrderPhase = OrderPhase.IDLE,
    val requestId: String? = null,
    val orderId: String? = null,
) {
    val editable: Boolean get() = phase == OrderPhase.IDLE || phase == OrderPhase.INVALID
    val message: String get() = when (phase) {
        OrderPhase.IDLE -> "Choose a quantity from 1 to 20."
        OrderPhase.INVALID -> "Enter a whole quantity from 1 to 20."
        OrderPhase.SUBMITTING -> "Submitting your demo order…"
        OrderPhase.CONFIRMED -> "Demo order confirmed: $orderId"
        OrderPhase.UNKNOWN -> "Outcome unknown. Verify the original order before submitting again."
    }
}
class OrderViewModel(
    private val accountId: String,
    private val placeOrder: PlaceChickenOrder,
    private val newRequestId: () -> String = { UUID.randomUUID().toString() },
) : ViewModel() {
    private val mutableState = MutableStateFlow(OrderUiState())
    val state = mutableState.asStateFlow()
    private var closed = false

    @MainThread
    fun quantityChanged(value: String) {
        if (closed || !mutableState.value.editable) return
        mutableState.value = mutableState.value.copy(quantityText = value, phase = OrderPhase.IDLE)
    }

    @MainThread
    fun submit() {
        val current = mutableState.value
        if (closed || !current.editable) return
        val quantity = parseQuantity(current.quantityText)
        if (quantity == null || accountId.isBlank()) {
            mutableState.value = current.copy(phase = OrderPhase.INVALID)
            return
        }
        val request = OrderRequest(accountId, newRequestId(), "chicken-grilled", quantity)
        mutableState.value = current.copy(phase = OrderPhase.SUBMITTING, requestId = request.requestId)
        viewModelScope.launch {
            try {
                val outcome = placeOrder(request)
                if (closed) return@launch
                mutableState.value = when (outcome) {
                    is OrderOutcome.Confirmed -> mutableState.value.copy(
                        phase = OrderPhase.CONFIRMED, orderId = outcome.orderId,
                    )
                    OrderOutcome.Invalid -> mutableState.value.copy(phase = OrderPhase.INVALID)
                    OrderOutcome.Unknown -> mutableState.value.copy(phase = OrderPhase.UNKNOWN)
                }
            } catch (cancelled: CancellationException) {
                if (!closed) mutableState.value = mutableState.value.copy(phase = OrderPhase.UNKNOWN)
                throw cancelled
            } catch (_: Exception) {
                if (!closed) mutableState.value = mutableState.value.copy(phase = OrderPhase.UNKNOWN)
            }
        }
    }

    // Demo lifecycle: a confirmed order can be followed by a new intended order.
    // Unknown orders deliberately have no reset/retry action.
    @MainThread
    fun newOrder() {
        if (!closed && mutableState.value.phase == OrderPhase.CONFIRMED) {
            mutableState.value = OrderUiState()
        }
    }

    // Call from session ownership when this account's feature is invalidated.
    @MainThread
    fun invalidateOwner() {
        closed = true
        if (mutableState.value.phase == OrderPhase.SUBMITTING) {
            mutableState.value = mutableState.value.copy(phase = OrderPhase.UNKNOWN)
        }
        // Ignore late results. This does not cancel/undo a server-side write.
    }
    override fun onCleared() {
        closed = true
        super.onCleared()
    }
}
```

### ChickenOrderScreen.kt

Compose UI and the isolated demo route/factory.

```kotlin
package com.example.mychicken.orderdemo

import androidx.compose.foundation.layout.Arrangement
import androidx.compose.foundation.layout.Column
import androidx.compose.foundation.layout.fillMaxWidth
import androidx.compose.foundation.layout.padding
import androidx.compose.foundation.rememberScrollState
import androidx.compose.foundation.text.KeyboardOptions
import androidx.compose.foundation.verticalScroll
import androidx.compose.material3.Button
import androidx.compose.material3.CircularProgressIndicator
import androidx.compose.material3.MaterialTheme
import androidx.compose.material3.OutlinedTextField
import androidx.compose.material3.Text
import androidx.compose.runtime.Composable
import androidx.compose.runtime.getValue
import androidx.compose.runtime.remember
import androidx.compose.ui.Modifier
import androidx.compose.ui.text.input.KeyboardType
import androidx.compose.ui.unit.dp
import androidx.lifecycle.ViewModel
import androidx.lifecycle.ViewModelProvider
import androidx.lifecycle.compose.collectAsStateWithLifecycle
import androidx.lifecycle.viewmodel.compose.viewModel

@Composable
fun ChickenOrderScreen(model: OrderViewModel) {
    val state by model.state.collectAsStateWithLifecycle()
    Column(
        modifier = Modifier.verticalScroll(rememberScrollState()).padding(24.dp),
        verticalArrangement = Arrangement.spacedBy(16.dp),
    ) {
        Text("My Chicken App", style = MaterialTheme.typography.headlineMedium)
        Text("DEMO · Grilled chicken · No real order will be placed")
        OutlinedTextField(
            value = state.quantityText,
            onValueChange = model::quantityChanged,
            enabled = state.editable,
            label = { Text("Quantity") },
            singleLine = true,
            isError = state.phase == OrderPhase.INVALID,
            keyboardOptions = KeyboardOptions(keyboardType = KeyboardType.Number),
            modifier = Modifier.fillMaxWidth(),
        )
        Text(state.message)
        if (state.phase == OrderPhase.SUBMITTING) CircularProgressIndicator()
        Button(onClick = model::submit, enabled = state.editable) { Text("Place demo order") }
        if (state.phase == OrderPhase.CONFIRMED) {
            Button(onClick = model::newOrder) { Text("Start a new demo order") }
        }
    }
}

// Mount this composable inside the existing Activity/navigation destination.
// This manual factory is for the isolated demo; use existing Hilt bindings in production.
@Composable
fun DemoChickenOrderRoute() {
    val factory = remember {
        object : ViewModelProvider.Factory {
            override fun <T : ViewModel> create(modelClass: Class<T>): T {
                require(modelClass == OrderViewModel::class.java)
                @Suppress("UNCHECKED_CAST")
                return OrderViewModel(
                    accountId = "demo-account",
                    placeOrder = PlaceChickenOrder(RemoteOrderRepository(DemoOrderApi())),
                ) as T
            }
        }
    }
    val model: OrderViewModel = viewModel(key = "chicken-order-demo", factory = factory)
    ChickenOrderScreen(model)
}
```

