```typescript
import { useState, useEffect } from 'react';
import { appFoundations } from './appFoundations';

/**
 * Hook to gate root rendering until foundation services are fully initialized.
 */
export function useFoundationsReady(): { isReady: boolean; error: Error | null } {
  const [isReady, setIsReady] = useState<boolean>(appFoundations.isReady());
  const [error, setError] = useState<Error | null>(null);

  useEffect(() => {
    if (appFoundations.isReady()) {
      setIsReady(true);
      return;
    }

    let isMounted = true;

    appFoundations
      .initialize()
      .then(() => {
        if (isMounted) setIsReady(true);
      })
      .catch((err: Error) => {
        if (isMounted) setError(err);
      });

    return () => {
      isMounted = false;
    };
  }, []);

  return { isReady, error };
}
```

