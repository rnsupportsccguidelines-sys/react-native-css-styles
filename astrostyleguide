### Handling Process Death with State Restoration

When the user minimizes the app and opens a memory-intensive tool (like the device camera), the OS may silently kill your background process. When the user returns, the OS restores the view, but in-memory variables are lost.

<Tabs>
  <TabItem label="Android (SavedStateHandle)">

```kotlin
package com.enterprise.mobile.feature.checkout

import androidx.lifecycle.SavedStateHandle
import androidx.lifecycle.ViewModel

class CheckoutViewModel(
    private val savedStateHandle: SavedStateHandle
) : ViewModel() {

    // SavedStateHandle automatically persists state across OS process termination
    var currentStep: Int
        get() = savedStateHandle["checkout_step"] ?: 1
        set(value) { savedStateHandle["checkout_step"] = value }

    var selectedShippingId: String?
        get() = savedStateHandle["shipping_id"]
        set(value) { savedStateHandle["shipping_id"] = value }

    fun advanceToNextStep(shippingId: String) {
        this.selectedShippingId = shippingId
        this.currentStep = currentStep + 1
    }
}
