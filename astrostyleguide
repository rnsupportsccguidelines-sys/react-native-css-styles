/* ==========================================================================
   MODAL DIALOG MODE (LIKE SDK MASTER CATALOG)
   Side menu stays visible in background; diagram opens as a centered modal.
   ========================================================================== */
/* 1. Prevent background page scroll while modal is open */
html:has(.portal-diagram-toggle:checked),
body:has(.portal-diagram-toggle:checked) {
  overflow: hidden !important;
}
/* 2. Elevate main frame so modal floats in front of the side menu without hiding it */
:root:has(.portal-diagram-toggle:checked) .page,
:root:has(.portal-diagram-toggle:checked) .main-frame,
:root:has(.portal-diagram-toggle:checked) .main-pane {
  isolation: auto !important;
  z-index: 999999 !important;
}
/* 3. Centered Modal Dialog Card with dimmed backdrop */
.portal-diagram-wrap:has(.portal-diagram-toggle:checked),
.portal-diagram-wrap.is-fullscreen {
  position: fixed !important;
  inset: 0 !important;
  top: 0 !important;
  left: 0 !important;
  right: 0 !important;
  bottom: 0 !important;
  margin: auto !important;
  width: 92vw !important;
  max-width: 1250px !important;
  height: 88vh !important;
  max-height: 88vh !important;
  z-index: 2147483647 !important;
  background: #0d1912 !important;
  border: 1.5px solid var(--portal-accent, #22c55e) !important;
  border-radius: 16px !important;
  box-shadow: 0 25px 60px rgba(0, 0, 0, 0.85), 0 0 0 100vmax rgba(0, 0, 0, 0.75) !important;
  display: flex !important;
  flex-direction: column !important;
  overflow: hidden !important;
  backdrop-filter: blur(8px) !important;
  -webkit-backdrop-filter: blur(8px) !important;
}
/* 4. Modal Header with Title Badge and Close Button */
.portal-diagram-wrap:has(.portal-diagram-toggle:checked) .portal-diagram-header,
.portal-diagram-wrap.is-fullscreen .portal-diagram-header {
  position: sticky !important;
  top: 0 !important;
  left: 0 !important;
  right: 0 !important;
  z-index: 10 !important;
  background: #08130e !important;
  padding: 14px 22px !important;
  border-bottom: 1px solid var(--portal-card-border, #1f3b2c) !important;
  display: flex !important;
  align-items: center !important;
  justify-content: space-between !important;
  width: 100% !important;
  box-sizing: border-box !important;
  flex-shrink: 0 !important;
}
/* 5. Solid Red Close Button at top-right of the modal */
.portal-diagram-wrap:has(.portal-diagram-toggle:checked) .portal-expand-btn,
.portal-diagram-wrap.is-fullscreen .portal-expand-btn {
  background: #ef4444 !important;
  border: 2px solid #ffffff !important;
  color: #ffffff !important;
  font-size: 0.88rem !important;
  font-weight: 800 !important;
  padding: 8px 18px !important;
  border-radius: 8px !important;
  box-shadow: 0 4px 16px rgba(239, 68, 68, 0.6) !important;
  cursor: pointer !important;
  display: inline-flex !important;
  align-items: center !important;
  gap: 8px !important;
  z-index: 11 !important;
}
.portal-diagram-wrap:has(.portal-diagram-toggle:checked) .portal-expand-btn:hover,
.portal-diagram-wrap.is-fullscreen .portal-expand-btn:hover {
  background: #dc2626 !important;
  border-color: #ffffff !important;
  color: #ffffff !important;
  box-shadow: 0 6px 20px rgba(239, 68, 68, 0.8) !important;
  transform: scale(1.04) !important;
}
/* 6. Switch button text and icon to "Close Fullscreen" */
.portal-diagram-wrap:has(.portal-diagram-toggle:checked) .portal-icon-expand,
.portal-diagram-wrap:has(.portal-diagram-toggle:checked) .portal-text-expand {
  display: none !important;
}
.portal-diagram-wrap:has(.portal-diagram-toggle:checked) .portal-icon-close,
.portal-diagram-wrap:has(.portal-diagram-toggle:checked) .portal-text-close {
  display: inline-flex !important;
  align-items: center !important;
  gap: 6px !important;
}
/* 7. Scaled Diagram Viewport inside the Modal */
.portal-diagram-wrap:has(.portal-diagram-toggle:checked) .portal-diagram-viewport,
.portal-diagram-wrap.is-fullscreen .portal-diagram-viewport {
  flex: 1 !important;
  height: calc(88vh - 65px) !important;
  max-height: calc(88vh - 65px) !important;
  padding: 30px 24px !important;
  overflow: auto !important;
}
.portal-diagram-wrap:has(.portal-diagram-toggle:checked) .portal-diagram-viewport svg,
.portal-diagram-wrap.is-fullscreen .portal-diagram-viewport svg {
  max-width: 88vw !important;
  max-height: 75vh !important;
  width: auto !important;
  height: auto !important;
}
