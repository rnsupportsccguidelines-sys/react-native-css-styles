    ### 1. Feature Implementation Code (`OrderListFeature.swift`)
    ```swift
    import Foundation

    // 1. Data Model
    struct OrderItem: Codable, Equatable, Identifiable {
        let id: String
        let title: String
        let status: String
        let amountCents: Int
    }

    // 2. Service Protocol & Network Client
    protocol OrderListServiceProtocol {
        func fetchOrders() async throws -> [OrderItem]
    }

    final class OrderListService: OrderListServiceProtocol {
        private let session: URLSession
        private let endpoint: URL

        init(session: URLSession = .shared, endpoint: URL) {
            self.session = session
            self.endpoint = endpoint
        }

        func fetchOrders() async throws -> [OrderItem] {
            let (data, response) = try await session.data(from: endpoint)
            guard let httpResponse = response as? HTTPURLResponse, (200...299).contains(httpResponse.statusCode) else {
                throw URLError(.badServerResponse)
            }
            return try JSONDecoder().decode([OrderItem].self, from: data)
        }
    }

    // 3. UI State
    enum OrderListState: Equatable {
        case loading
        case success([OrderItem])
        case error(String)
    }

    // 4. Observable ViewModel
    @MainActor
    final class OrderListViewModel: ObservableObject {
        @Published private(set) var state: OrderListState = .loading
        private let service: OrderListServiceProtocol

        init(service: OrderListServiceProtocol) {
            self.service = service
        }

        func loadOrders() async {
            state = .loading
            do {
                let items = try await service.fetchOrders()
                state = .success(items)
            } catch {
                state = .error(error.localizedDescription)
            }
        }
    }
    ```

