### `PlaceChickenOrder.kt` — sample application code

```kotlin
package com.example.mychicken.order

import java.util.concurrent.atomic.AtomicBoolean

data class ChickenItem(val id: String, val unitPriceMinor: Long, val available: Boolean)
data class OrderRequest(val requestId: String, val itemId: String, val quantity: Int)
data class OrderReceipt(val orderId: String)
interface OrderGateway { suspend fun place(request: OrderRequest): OrderReceipt }
class OrderFailure(val reason: String) : IllegalArgumentException(reason)

fun quote(item: ChickenItem, quantity: Int): Long {
    if (item.id.isBlank()) throw OrderFailure("invalid-item")
    if (!item.available) throw OrderFailure("unavailable")
    if (quantity !in 1..20) throw OrderFailure("invalid-quantity")
    if (item.unitPriceMinor <= 0) throw OrderFailure("invalid-price")
    if (item.unitPriceMinor > Long.MAX_VALUE / quantity) throw OrderFailure("invalid-total")
    return item.unitPriceMinor * quantity
}

// Retain one instance for the active order flow, not one per tap.
class PlaceChickenOrder(private val gateway: OrderGateway) {
    private val submitting = AtomicBoolean(false)

    suspend fun place(item: ChickenItem, quantity: Int, requestId: String): OrderReceipt {
        quote(item, quantity)
        if (requestId.isBlank()) throw OrderFailure("invalid-request-id")
        if (!submitting.compareAndSet(false, true)) throw OrderFailure("already-submitting")
        try {
            val receipt = gateway.place(OrderRequest(requestId, item.id, quantity))
            if (receipt.orderId.isBlank()) throw OrderFailure("invalid-receipt")
            return receipt
        } finally {
            submitting.set(false)
        }
    }
}
```

### `PlaceChickenOrderTest.kt` — deterministic JVM tests

```kotlin
package com.example.mychicken.order

import kotlinx.coroutines.CompletableDeferred
import kotlinx.coroutines.CoroutineStart
import kotlinx.coroutines.async
import kotlinx.coroutines.test.runTest
import org.junit.Assert.*
import org.junit.Test

class PlaceChickenOrderTest {
    private val item = ChickenItem("chicken-grilled", 1250, true)
    private class FakeGateway : OrderGateway {
        val calls = mutableListOf<OrderRequest>()
        var reply: suspend () -> OrderReceipt = { OrderReceipt("order-001") }
        override suspend fun place(request: OrderRequest): OrderReceipt {
            calls += request
            return reply()
        }
    }

    @Test fun calculatesTotalAndAcceptedQuantityBoundaries() {
        assertEquals(1250L, quote(item, 1))
        assertEquals(2500L, quote(item, 2))
        assertEquals(25000L, quote(item, 20))
    }

    @Test fun invalidInputsNeverSubmit() = runTest {
        val gateway = FakeGateway()
        val service = PlaceChickenOrder(gateway)
        val cases = listOf(
            Triple(item, 0, "request-001") to "invalid-quantity",
            Triple(item, -1, "request-001") to "invalid-quantity",
            Triple(item, 21, "request-001") to "invalid-quantity",
            Triple(item.copy(available = false), 1, "request-001") to "unavailable",
            Triple(item.copy(id = " "), 1, "request-001") to "invalid-item",
            Triple(item.copy(unitPriceMinor = 0), 1, "request-001") to "invalid-price",
            Triple(item.copy(unitPriceMinor = Long.MAX_VALUE), 2, "request-001") to "invalid-total",
            Triple(item, 1, " ") to "invalid-request-id"
        )
        for ((input, expected) in cases) {
            val (selected, quantity, id) = input
            val error = runCatching { service.place(selected, quantity, id) }.exceptionOrNull()
            assertEquals(expected, (error as? OrderFailure)?.reason)
        }
        assertTrue(gateway.calls.isEmpty())
    }

    @Test fun returnsActualConfirmationAndForwardsIdentity() = runTest {
        val gateway = FakeGateway()
        val result = PlaceChickenOrder(gateway).place(item, 2, "request-001")
        assertEquals(OrderReceipt("order-001"), result)
        assertEquals(listOf(OrderRequest("request-001", item.id, 2)), gateway.calls)
    }

    @Test fun propagatesServiceFailure() = runTest {
        val gateway = FakeGateway()
        val expected = IllegalStateException("service-unavailable")
        gateway.reply = { throw expected }
        val error = runCatching {
            PlaceChickenOrder(gateway).place(item, 1, "request-001")
        }.exceptionOrNull()
        assertSame(expected, error)
    }

    @Test fun rejectsEmptyConfirmation() = runTest {
        val gateway = FakeGateway()
        gateway.reply = { OrderReceipt(" ") }
        val error = runCatching {
            PlaceChickenOrder(gateway).place(item, 1, "request-001")
        }.exceptionOrNull()
        assertEquals("invalid-receipt", (error as? OrderFailure)?.reason)
    }

    @Test fun repeatedTapMakesOneSubmission() = runTest {
        val gateway = FakeGateway()
        val pending = CompletableDeferred<OrderReceipt>()
        gateway.reply = { pending.await() }
        val service = PlaceChickenOrder(gateway)
        val first = async(start = CoroutineStart.UNDISPATCHED) {
            service.place(item, 1, "request-001")
        }
        val secondError = runCatching {
            service.place(item, 1, "request-001")
        }.exceptionOrNull()
        assertEquals("already-submitting", (secondError as? OrderFailure)?.reason)
        assertEquals(1, gateway.calls.size)
        pending.complete(OrderReceipt("order-001"))
        assertEquals(OrderReceipt("order-001"), first.await())
    }
}
```

