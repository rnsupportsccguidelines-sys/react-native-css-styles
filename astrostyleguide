```kotlin
package com.enterprise.mobile.feature.user.domain.repository

import com.enterprise.mobile.feature.user.domain.model.UserDomainModel
import kotlinx.coroutines.flow.Flow

/**
 * Boundary contract defining user data operations.
 * The domain layer owns this interface; the data layer implements it.
 */
interface UserRepository {
    suspend fun getUserProfile(userId: String): Result<UserDomainModel>
    fun observeUserProfile(userId: String): Flow<UserDomainModel?>
}
```

<div class="portal-file-header">
  <span class="portal-file-path">feature/user/domain/usecase/GetUserProfileUseCase.kt</span>
  <span class="portal-file-tag">BUSINESS USE CASE</span>
</div>

```kotlin
package com.enterprise.mobile.feature.user.domain.usecase

import com.enterprise.mobile.feature.user.domain.model.UserDomainModel
import com.enterprise.mobile.feature.user.domain.repository.UserRepository
import javax.inject.Inject

/**
 * Single-responsibility use case executing business validation.
 * Isolated from Android framework and presentation dependencies.
 */
class GetUserProfileUseCase @Inject constructor(
    private val userRepository: UserRepository
) {
    suspend operator fun invoke(userId: String): Result<UserDomainModel> {
        if (userId.isBlank()) {
            return Result.failure(IllegalArgumentException("User ID must not be empty or blank."))
        }
        return userRepository.getUserProfile(userId.trim())
    }
}
