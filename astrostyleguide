### Presentation.swift

Content, progress, and errors are independent properties so a temporary network failure does not discard usable cached content.

```swift
import Foundation
import Observation

struct UserProfileUIState: Equatable {
    var user: UserDomainModel?
    var isLoading = false
    var message: String?
}

@Observable
@MainActor
final class UserProfileViewModel {
    private(set) var state = UserProfileUIState()
    @ObservationIgnored private let useCase: GetUserProfileUseCase
    @ObservationIgnored private var currentUserID: String?
    @ObservationIgnored private var generation = UUID()

    init(useCase: GetUserProfileUseCase) {
        self.useCase = useCase
    }

    /// The caller owns and awaits this operation. No nested unstructured Task.
    func load(userID rawID: String) async {
        let request = UUID()
        generation = request
        let userID: String
        do {
            userID = try useCase.normalizedID(rawID)
        } catch {
            currentUserID = nil
            state = UserProfileUIState(message: "A valid user ID is required.")
            return
        }
        if currentUserID != userID {
            state = UserProfileUIState() // Do not show a different profile.
            currentUserID = userID
        }
        state.isLoading = true
        state.message = nil
        defer {
            if generation == request { state.isLoading = false }
        }

        do {
            do {
                let cached = try await useCase.cachedProfile(userID: userID)
                try Task.checkCancellation()
                guard generation == request else { return }
                state.user = cached
            } catch {
                if isCancellation(error) { throw CancellationError() }
                guard generation == request else { return }
                // Cache-read failure must not prevent a recoverable remote fetch.
                state.message = "Saved profile is unavailable. Trying to refresh."
            }
            let fresh = try await useCase.refreshProfile(userID: userID)
            try Task.checkCancellation()
            guard generation == request else { return }
            state.user = fresh
            state.message = nil
        } catch {
            guard generation == request else { return }
            if isCancellation(error) { return } // Cancellation is not a UI failure.
            if let failure = error as? UserProfileError {
                switch failure {
                case .cacheInvalidationFailed:
                    state.user = nil
                    state.message = "Profile access could not be verified. Please sign in again."
                case .sessionExpired:
                    state.user = nil
                    state.message = "Your session has expired. Please sign in again."
                case .accessDenied:
                    state.user = nil
                    state.message = "You do not have access to this profile."
                case .notFound:
                    state.user = nil
                    state.message = "This profile is no longer available."
                default:
                    state.message = "Unable to refresh the profile. Please try again."
                }
            } else {
                state.message = "Unable to refresh the profile. Please try again."
            }
        }
    }

    private func isCancellation(_ error: any Error) -> Bool {
        Task.isCancelled || error is CancellationError ||
            (error as? URLError)?.code == .cancelled
    }
}
```

<Aside type="tip" title="Hint · await work instead of hiding a Task">
`load` is asynchronous and is awaited by the SwiftUI task. It does not create an unstructured task inside the ViewModel. Cancellation can therefore propagate through the use case and repository. The generation token additionally prevents a late result from an older request from changing the current screen—even if a dependency ignores cancellation.
</Aside>

Each suspension is followed by a cancellation check or request-generation check before publishing data. The deferred loading reset also checks the generation, so an older request cannot stop a newer request's loading indicator. Cancellation does not become a user-visible error.

Do not expose raw `localizedDescription` values from transport or persistence errors. The example uses safe messages; production should map error categories to localized UI copy and send redacted technical diagnostics through the approved observability layer.

