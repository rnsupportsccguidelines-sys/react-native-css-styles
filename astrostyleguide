## Unidirectional Data Flow (UDF) & State Architecture

To prevent race conditions, stale views, and inconsistent screen states, all user actions follow a strict **Unidirectional Data Flow (UDF)** loop:

```mermaid
flowchart TD
    subgraph Loop["Unidirectional Data Flow (UDF) Cycle"]
        UI["1. Declarative View\n(Renders current immutable state)"]
        Action["2. User Intent / Action\n(Button tap, scroll, text input)"]
        Reducer["3. State Holder / ViewModel\n(Processes intent via Domain Use Case)"]
        NewState["4. New Immutable State\n(Emitted as fresh state snapshot)"]

        UI -->|"User interacts"| Action
        Action -->|"Dispatched to"| Reducer
        Reducer -->|"Calculates & emits"| NewState
        NewState -->|"Re-renders"| UI
    end

    classDef default fill:#13251c,stroke:#1f3b2c,stroke-width:1.5px,color:#e2e8f0;
    classDef highlight fill:#1b3826,stroke:#22c55e,stroke-width:2px,color:#f3d17b;
    classDef nodeBox fill:#102619,stroke:#22c55e,stroke-width:1.5px,color:#ffffff;
    class Loop highlight;
    class UI,Action,Reducer,NewState nodeBox;
```

### Implementing UDF State Modeling (TypeScript Example)

Every screen model must be expressed as an immutable, discriminated state union to eliminate undefined or conflicting intermediate UI states:

```typescript
// 1. Define explicit, exhaustive UI state states
export type ScreenState<T> =
  | { status: 'idle' }
  | { status: 'loading' }
  | { status: 'success'; data: T; isStaleFromCache: boolean }
  | { status: 'error'; message: string; canRetry: boolean };

// 2. Define user actions (Intents)
export type OrderAction =
  | { type: 'FETCH_ORDERS' }
  | { type: 'REFRESH_ORDERS' }
  | { type: 'CANCEL_ORDER'; orderId: string };

// 3. State Reducer (Guarantees predictable state transitions)
export function orderReducer(state: ScreenState<Order[]>, action: OrderAction): ScreenState<Order[]> {
  switch (action.type) {
    case 'FETCH_ORDERS':
      return { status: 'loading' };
    case 'REFRESH_ORDERS':
      // Preserve existing data while refreshing in background
      return state.status === 'success' ? state : { status: 'loading' };
    default:
      return state;
  }
}
```

