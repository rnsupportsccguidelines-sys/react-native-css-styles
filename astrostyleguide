## 4. Production Release Workflows (`bitrise.yml`)

The following complete, copy-paste ready Bitrise workflow definitions demonstrate how to compile signed release artifacts and distribute them directly to Google Play and Apple TestFlight.

```yaml
format_version: '11'
default_step_lib_source: https://github.com/bitrise-io/bitrise-steplib.git
project_type: react-native

app:
  envs:
    - PACKAGE_NAME: "com.enterprise.mobileapp"
    - BUNDLE_ID: "com.enterprise.mobileapp"
    - GOOGLE_PLAY_TRACK: "internal"

workflows:
  # =========================================================================
  # WORKFLOW: Release Android to Google Play Internal Testing
  # =========================================================================
  release_android:
    summary: Builds signed Android AAB and publishes to Google Play Internal track
    steps:
      - activate-ssh-key@4:
          run_if: '{{getenv "SSH_RSA_PRIVATE_KEY" | ne ""}}'

      - git-clone@8: {}

      - yarn@0:
          inputs:
            - command: install --frozen-lockfile

      - install-missing-android-tools@3:
          inputs:
            - gradlew_path: android/gradlew

      # Inject dynamic build number into Android versionCode
      - change-android-versioncode-and-versionname@1:
          inputs:
            - build_gradle_path: android/app/build.gradle
            - new_version_code: $BITRISE_BUILD_NUMBER

      # Download enterprise release keystore
      - file-downloader@1:
          inputs:
            - source: $BITRISEIO_ANDROID_KEYSTORE_URL
            - destination: android/app/release.keystore

      # Download Google Play Service Account JSON key
      - file-downloader@1:
          inputs:
            - source: $BITRISEIO_GPLAY_SERVICE_ACCOUNT_JSON_URL
            - destination: /tmp/gplay-service-account.json

      # Compile signed Release Android App Bundle (AAB)
      - android-build@1:
          inputs:
            - project_location: android
            - module: app
            - variant: release
            - build_type: aab
            - app_path: android/app/build/outputs/bundle/release/app-release.aab

      # Deploy AAB + ProGuard/R8 mapping.txt directly to Google Play Developer API
      - google-play-deploy@3:
          inputs:
            - service_account_json_key_path: /tmp/gplay-service-account.json
            - package_name: $PACKAGE_NAME
            - app_path: $BITRISE_AAB_PATH
            - mapping_file: android/app/build/outputs/mapping/release/mapping.txt
            - track: $GOOGLE_PLAY_TRACK
            - user_fraction: "1.0"
            - whatsnew_dir: android/whatsnew

      - deploy-to-bitrise-io@2:
          inputs:
            - notify_user_groups: none
            - is_compress: "true"

  # =========================================================================
  # WORKFLOW: Release iOS to Apple TestFlight Internal QA
  # =========================================================================
  release_ios:
    summary: Builds signed iOS IPA and publishes to Apple TestFlight via deliver
    steps:
      - activate-ssh-key@4:
          run_if: '{{getenv "SSH_RSA_PRIVATE_KEY" | ne ""}}'

      - git-clone@8: {}

      - yarn@0:
          inputs:
            - command: install --frozen-lockfile

      - cocoapods-install@2:
          inputs:
            - is_repo_update: false
            - podfile_path: ios/Podfile

      # Auto-sync provisioning profiles and certificates via App Store Connect API
      - auto-provision-ios@3:
          inputs:
            - distribution_type: app-store
            - api_key_path: $APP_STORE_CONNECT_API_KEY_P8
            - key_id: $APP_STORE_CONNECT_KEY_ID
            - issuer_id: $APP_STORE_CONNECT_ISSUER_ID

      # Set iOS CFBundleVersion to match Bitrise Build Number
      - set-ios-info-plist-unified@1:
          inputs:
            - info_plist_file: ios/MobileApp/Info.plist
            - bundle_version: $BITRISE_BUILD_NUMBER

      # Archive signed iOS Application (.ipa) and dSYM symbols
      - xcode-archive@4:
          inputs:
            - project_path: ios/MobileApp.xcworkspace
            - scheme: MobileApp
            - configuration: Release
            - distribution_method: app-store
            - automatic_code_signing: api-key

      # Deploy to TestFlight via Fastlane deliver engine using API Key
      - deploy-to-itunesconnect-with-deliver@3:
          inputs:
            - ipa_path: $BITRISE_IPA_PATH
            - dsym_path: $BITRISE_DSYM_PATH
            - api_key_path: $APP_STORE_CONNECT_API_KEY_P8
            - key_id: $APP_STORE_CONNECT_KEY_ID
            - issuer_id: $APP_STORE_CONNECT_ISSUER_ID
            - platform: ios
            - skip_waiting_for_build_processing: "false"
            - skip_metadata: "true"
            - skip_screenshots: "true"
            - team_id: $APPLE_TEAM_ID

      - deploy-to-bitrise-io@2:
          inputs:
            - notify_user_groups: none
```

