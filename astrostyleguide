    import XCTest
    @testable import EnterpriseOrderFeature

    final class OrderListViewModelTests: XCTestCase {

        // 1. Hermetic Mock Service
        final class MockOrderListService: OrderListServiceProtocol {
            var resultToReturn: Result<[OrderItem], Error> = .success([])
            private(set) var fetchCallCount = 0

            func fetchOrders() async throws -> [OrderItem] {
                fetchCallCount += 1
                switch resultToReturn {
                case .success(let items):
                    return items
                case .failure(let error):
                    throw error
                }
            }
        }

