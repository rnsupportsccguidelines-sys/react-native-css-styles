### 2. Version Gate Controller (`useVersionGate.ts`)
```typescript
import { useState, useEffect } from 'react';
import { Platform, Linking, BackHandler } from 'react-native';
import { compareVersions } from 'compare-versions';
import DeviceInfo from 'react-native-device-info';

export type GateStatus = 'ALLOWED' | 'SOFT_UPDATE' | 'HARD_UPDATE' | 'KILLSWITCH';

interface PolicyPayload {
  latest_version: string;
  min_supported_version: string;
  store_url: string;
  soft_update_title: string;
  soft_update_message: string;
  force_update_title: string;
  force_update_message: string;
}

export const useVersionGate = () => {
  const [gateStatus, setGateStatus] = useState<GateStatus>('ALLOWED');
  const [policy, setPolicy] = useState<PolicyPayload | null>(null);
  const [killswitchDetails, setKillswitchDetails] = useState<any>(null);

  useEffect(() => {
    const evaluatePolicy = async () => {
      try {
        const response = await fetch('https://config.enterprise.internal/mobile/v1/version-policy');
        const data = await response.json();

        // 1. Evaluate Emergency Killswitch First
        if (data.emergency_killswitch?.active) {
          setKillswitchDetails(data.emergency_killswitch);
          setGateStatus('KILLSWITCH');
          return;
        }

        const platformPolicy: PolicyPayload = Platform.OS === 'ios' ? data.ios : data.android;
        setPolicy(platformPolicy);

        const currentVersion = DeviceInfo.getVersion(); // e.g. "2.2.0"

        // 2. Evaluate Hard Blocking Upgrade
        if (compareVersions(currentVersion, platformPolicy.min_supported_version) < 0) {
          setGateStatus('HARD_UPDATE');
          return;
        }

        // 3. Evaluate Soft Update
        if (compareVersions(currentVersion, platformPolicy.latest_version) < 0) {
          setGateStatus('SOFT_UPDATE');
          return;
        }

        // 4. Allowed Version
        setGateStatus('ALLOWED');
      } catch (error) {
        // Fallback: If policy cannot be fetched, fail open to avoid lockouts during network drops
        setGateStatus('ALLOWED');
      }
    };

    evaluatePolicy();
  }, []);

  const openStore = () => {
    if (policy?.store_url) {
      Linking.openURL(policy.store_url);
    }
  };

  const skipSoftUpdate = () => {
    setGateStatus('ALLOWED');
  };

  return { gateStatus, policy, killswitchDetails, openStore, skipSoftUpdate };
};
```

