import { UserApiService, type IUserApiService } from '../data/remote/userApiService';
import { UserStorage, type IUserStorage } from '../data/local/userStorage';
import { UserRepositoryImpl } from '../data/repository/UserRepositoryImpl';
import type { IUserRepository } from '../domain/repository/UserRepository';
import { GetUserProfileUseCase } from '../domain/usecase/getUserProfileUseCase';

/**
 * Inversion of Control (IoC) Service Locator.
 * Assembles clean architecture dependencies without manual wiring in components.
 */
class UserContainer {
  private apiService: IUserApiService | null = null;
  private storage: IUserStorage | null = null;
  private userRepository: IUserRepository | null = null;

  resolveApiService(): IUserApiService {
    if (!this.apiService) {
      this.apiService = new UserApiService();
    }
    return this.apiService;
  }

  resolveStorage(): IUserStorage {
    if (!this.storage) {
      this.storage = new UserStorage();
    }
    return this.storage;
  }

  resolveUserRepository(): IUserRepository {
    if (!this.userRepository) {
      this.userRepository = new UserRepositoryImpl(
        this.resolveApiService(),
        this.resolveStorage()
      );
    }
    return this.userRepository;
  }

  resolveGetUserProfileUseCase(): GetUserProfileUseCase {
    return new GetUserProfileUseCase(this.resolveUserRepository());
  }
}

export const userContainer = new UserContainer();
