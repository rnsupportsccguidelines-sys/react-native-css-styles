## 3. Step 2: Crafting the Production `dangerfile.ts`

Create a file named <code>dangerfile.ts</code> in the root directory of your repository. This file defines the exact quality rules enforced on every GitHub Pull Request:

<div class="portal-code-frame">
  <div class="portal-code-header">
    <span class="portal-file-badge">dangerfile.ts</span>
    <span class="portal-badge-hub">TYPESCRIPT QUALITY RULES</span>
  </div>
  <pre class="portal-code-block"><code>import { danger, warn, fail, message } from "danger";

// ---------------------------------------------------------------------------
// RULE 1: Enforce Pull Request Description Quality
// ---------------------------------------------------------------------------
const prBody = danger.github.pr.body;
if (!prBody || prBody.trim().length < 15) {
  fail("This Pull Request requires a description. Please provide context, user impact, and QA testing steps.");
}

// ---------------------------------------------------------------------------
// RULE 2: Enforce Assignee Assignment
// ---------------------------------------------------------------------------
if (!danger.github.pr.assignee) {
  warn("This Pull Request needs an assignee. Please assign yourself or a lead engineer.");
}

// ---------------------------------------------------------------------------
// RULE 3: Block Work-In-Progress (WIP) Pull Requests from Merging
// ---------------------------------------------------------------------------
const prTitle = danger.github.pr.title;
if (
  prTitle.toLowerCase().includes("[wip]") ||
  prTitle.toLowerCase().startsWith("wip:") ||
  prTitle.toLowerCase().includes("(wip)")
) {
  fail("This Pull Request is marked as [WIP]. Remove the WIP tag before merging to branch.");
}

// ---------------------------------------------------------------------------
// RULE 4: Guard Against Giant Pull Request Diffs (> 500 lines)
// ---------------------------------------------------------------------------
const totalModifications = danger.github.pr.additions + danger.github.pr.deletions;
if (totalModifications > 500) {
  warn(
    `Big PR! This change modifies ${totalModifications} lines. Consider breaking changes into smaller, incremental review slices.`
  );
}

// ---------------------------------------------------------------------------
// RULE 5: Automated Test Coverage Verification
// ---------------------------------------------------------------------------
const modifiedAppCode = danger.git.modified_files.some(file => 
  file.startsWith("src/") &amp;&amp; !file.includes(".test.") &amp;&amp; !file.includes(".spec.")
);

const modifiedTests = danger.git.modified_files.some(file => 
  file.includes(".test.") || file.includes(".spec.") || file.includes("__tests__")
);

if (modifiedAppCode &amp;&amp; !modifiedTests) {
  warn("Source code in `src/` was modified, but no corresponding test files were updated. Please verify if unit tests are needed.");
}

if (modifiedTests) {
  message("Great engineering discipline! This Pull Request includes automated test modifications.");
}

// ---------------------------------------------------------------------------
// RULE 6: Lockfile Synchronization Guard
// ---------------------------------------------------------------------------
const packageChanged = danger.git.modified_files.includes("package.json");
const lockfileChanged = danger.git.modified_files.includes("package-lock.json");

if (packageChanged &amp;&amp; !lockfileChanged) {
  fail("`package.json` was updated, but `package-lock.json` was not. Run `npm install` and commit the updated lockfile.");
}</code></pre>
</div>

