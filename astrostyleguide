export class DemoOrderApi implements OrderApi {
  constructor(private readonly simulateUnknown = false) {}
  async submit(_request: OrderRequest): Promise<unknown> {
    await new Promise<void>(resolve => setTimeout(resolve, 300));
    return { orderId: this.simulateUnknown ? '' : 'order-001' };
  }
}
