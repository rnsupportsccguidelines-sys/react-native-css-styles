### orderViewModel.ts

Redux Toolkit state, async submission, request identity, and owner invalidation.

```typescript
import { configureStore, createAsyncThunk, createSlice } from '@reduxjs/toolkit';
import type { PayloadAction } from '@reduxjs/toolkit';
import { parseQuantity } from './orderDomain';
import type { OrderOutcome, OrderRequest } from './orderDomain';

type OrderPhase = 'idle' | 'invalid' | 'submitting' | 'confirmed' | 'unknown';
export type OrderState = {
  accountId: string;
  quantityText: string;
  phase: OrderPhase;
  requestId: string | null;
  orderId: string | null;
  closed: boolean;
};
type Dependencies = { placeOrder: (request: OrderRequest) => Promise<OrderOutcome> };
const initialState: OrderState = {
  accountId: '', quantityText: '2', phase: 'idle',
  requestId: null, orderId: null, closed: false,
};
export const canEditOrder = (state: OrderState): boolean =>
  !state.closed && (state.phase === 'idle' || state.phase === 'invalid');

export const submitOrder = createAsyncThunk<
  OrderOutcome, void,
  { state: { order: OrderState }; extra: Dependencies }
>('order/submit', async (_, { getState, extra, requestId }) => {
  const state = getState().order;
  if (state.closed) return { kind: 'unknown' };
  const quantity = parseQuantity(state.quantityText);
  if (quantity === null || !state.accountId.trim()) return { kind: 'invalid' };
  // Demo operation identity. A real backend defines idempotency/reconciliation.
  return extra.placeOrder({
    accountId: state.accountId, requestId,
    itemId: 'chicken-grilled', quantity,
  });
}, {
  condition: (_, { getState }) => canEditOrder(getState().order),
});
const slice = createSlice({
  name: 'order', initialState,
  reducers: {
    quantityChanged(state, action: PayloadAction<string>) {
      if (!canEditOrder(state)) return;
      state.quantityText = action.payload;
      state.phase = 'idle';
    },
    newOrder(state) {
      if (!state.closed && state.phase === 'confirmed') {
        return { ...initialState, accountId: state.accountId };
      }
    },
    // Session owner invokes this before invalidating the account's feature.
    ownerClosed(state) {
      state.closed = true;
      if (state.phase === 'submitting') state.phase = 'unknown';
    },
  },
  extraReducers: builder => builder
    .addCase(submitOrder.pending, (state, action) => {
      state.phase = 'submitting';
      state.requestId = action.meta.requestId;
      state.orderId = null;
    })
    .addCase(submitOrder.fulfilled, (state, action) => {
      if (state.closed || state.requestId !== action.meta.requestId) return;
      state.phase = action.payload.kind;
      state.orderId = action.payload.kind === 'confirmed' ? action.payload.orderId : null;
    })
    .addCase(submitOrder.rejected, (state, action) => {
      if (state.closed || state.requestId !== action.meta.requestId) return;
      state.phase = 'unknown';
    }),
});
export const { quantityChanged, newOrder, ownerClosed } = slice.actions;
export function makeOrderStore(accountId: string, dependencies: Dependencies) {
  return configureStore({
    reducer: { order: slice.reducer },
    preloadedState: { order: { ...initialState, accountId } },
    middleware: defaults => defaults({ thunk: { extraArgument: dependencies } }),
  });
}
export type OrderStore = ReturnType<typeof makeOrderStore>;
export type OrderRootState = ReturnType<OrderStore['getState']>;
export type OrderDispatch = OrderStore['dispatch'];

export function orderMessage(state: OrderState): string {
  switch (state.phase) {
    case 'idle': return 'Choose a quantity from 1 to 20.';
    case 'invalid': return 'Enter a whole quantity from 1 to 20.';
    case 'submitting': return 'Submitting your demo order…';
    case 'confirmed': return `Demo order confirmed: ${state.orderId}`;
    case 'unknown': return 'Outcome unknown. Verify the original order before submitting again.';
  }
}
```

