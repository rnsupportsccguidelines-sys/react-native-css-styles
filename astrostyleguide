    primary = Color(0xFF007A3D), onPrimary = Color(0xFFFFFFFF),
    background = Color(0xFFF4F8F5), onBackground = Color(0xFF0F172A),
    surface = Color(0xFFFFFFFF), onSurface = Color(0xFF0F172A),
    onSurfaceVariant = Color(0xFF475569), outline = Color(0xFFD4E2D8),
)
private val DarkColors = darkColorScheme(
    primary = Color(0xFF22C55E), onPrimary = Color(0xFF09130E),
    background = Color(0xFF09130E), onBackground = Color(0xFFF1F5F9),
    surface = Color(0xFF0D1912), onSurface = Color(0xFFF1F5F9),
    onSurfaceVariant = Color(0xFF94A3B8), outline = Color(0xFF193828),
