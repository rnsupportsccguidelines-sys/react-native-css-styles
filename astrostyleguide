import {
  getMessaging, getToken, onMessage, onTokenRefresh,
  onNotificationOpenedApp, getInitialNotification, setBackgroundMessageHandler,
  registerDeviceForRemoteMessages, setAutoInitEnabled,
} from '@react-native-firebase/messaging';
import { Platform } from 'react-native';
import { notificationService } from './NotificationService';

export type FcmBindings = {
  // Resolve only after durable enqueue; the worker validates current account ownership.
  enqueueTokenSync(token: string): Promise<void>;
  enqueueContentRefresh(): Promise<void>;
  // Fixed categories only. Do not attach error objects, tokens, or payloads.
  reportFailure(category: 'registration' | 'message' | 'initial-open'): void;
};

export class FcmService {
  private stopListeners: Array<() => void> = [];
  private generation = 0;

  start(bindings: FcmBindings): () => void {
    this.stop();
    const generation = this.generation;
    const active = () => generation === this.generation;
    const run = (task: () => Promise<void>, category: Parameters<FcmBindings['reportFailure']>[0]) => {
      void Promise.resolve().then(() => active() ? task() : undefined)
        .catch(() => { if (active()) bindings.reportFailure(category); });
    };
    const messaging = getMessaging();
    this.stopListeners = [
      onTokenRefresh(messaging, token => {
        if (token) run(() => bindings.enqueueTokenSync(token), 'registration');
      }),
      onMessage(messaging, () => {
        // FCM-only template uses app-controlled foreground refresh, not a second local alert.
        run(() => bindings.enqueueContentRefresh(), 'message');
      }),
      onNotificationOpenedApp(messaging, () => {
        if (active()) notificationService.captureOpen();
      }),
    ];
    void getInitialNotification(messaging).then(message => {
      if (active() && message) notificationService.captureOpen();
    }).catch(() => { if (active()) bindings.reportFailure('initial-open'); });
    run(async () => {
      await setAutoInitEnabled(messaging, true);
      // iOS requires completed APNs registration before fetching the FCM token.
      if (Platform.OS === 'ios' && !messaging.isDeviceRegisteredForRemoteMessages) {
        await registerDeviceForRemoteMessages(messaging);
      }
      const token = await getToken(messaging);
      if (active() && token) await bindings.enqueueTokenSync(token);
    }, 'registration');
    return () => { if (active()) this.stop(); };
  }

  stop(): void {
    this.generation += 1;
    this.stopListeners.forEach(stop => stop());
    this.stopListeners = [];
  }

  // Call once in index.js, before AppRegistry.registerComponent. No UI/navigation.
  static installBackgroundHandler(enqueueRefresh: () => Promise<void>): void {
    setBackgroundMessageHandler(getMessaging(), async () => {
      // Reject on failure rather than falsely claiming a refresh completed.
      // Caller supplies safe reporting/durable handling in this background-safe binding.
      await enqueueRefresh();
    });
  }
}

export const fcmService = new FcmService();
```

### D. Copy `NotificationService.ts`

```typescript
import { PermissionsAndroid, Platform } from 'react-native';
import { AuthorizationStatus, getMessaging, requestPermission } from '@react-native-firebase/messaging';

type OpenHandler = () => boolean;

export class NotificationService {
  private pendingOpen = false;
  private handler: OpenHandler | undefined;

  async requestPresentationPermission(): Promise<boolean> {
    if (Platform.OS === 'android') {
      if (Number(Platform.Version) < 33) return true;
      const result = await PermissionsAndroid.request(
        PermissionsAndroid.PERMISSIONS.POST_NOTIFICATIONS,
      );
      return result === PermissionsAndroid.RESULTS.GRANTED;
    }
    if (Platform.OS === 'ios') {
      const status = await requestPermission(getMessaging());
      return status === AuthorizationStatus.AUTHORIZED || status === AuthorizationStatus.PROVISIONAL;
    }
    return false;
  }

  captureOpen(): void {
    this.pendingOpen = true;
    this.consumeOpenIfReady();
  }

  // Bind only when startup/authentication/navigation are ready; handler validates
  // current account/access and returns true after accepting the generic updates action.
  setOpenHandler(handler: OpenHandler): () => void {
    this.handler = handler;
    this.consumeOpenIfReady();
    return () => { if (this.handler === handler) this.handler = undefined; };
  }

  consumeOpenIfReady(): void {
    if (this.pendingOpen && this.handler?.()) this.pendingOpen = false;
  }

  clearPendingOpen(): void { this.pendingOpen = false; }
}

export const notificationService = new NotificationService();
```

For Android before API 33, the permission method's `true` means **no runtime request is needed**, not that app/channel settings are enabled. Check presentation on the real device. For iOS, use the library's authorization flow without replacing its native notification delegate with the Swift coordinator in another tab.

This template performs **in-app refresh for foreground receipt**, while the configured system notification handles ordinary background alert presentation. It does not create a foreground local banner in JavaScript. If your approved app requires local display, supply its actual notification-library contract rather than assuming one.

Notifee v7+ can own open events instead of React Native Firebase's `onNotificationOpenedApp`/`getInitialNotification`. Do not combine this template unchanged with that integration. [RN Firebase handlers and open-event caveat](https://rnfirebase.io/messaging/usage).

### E. Install the background entry point and app bindings

In the existing `index.js`, before `AppRegistry.registerComponent`:

```javascript
import { FcmService } from './src/notifications/FcmService';

FcmService.installBackgroundHandler(async () => {
  // REQUIRED: invoke the existing background-safe durable refresh enqueue.
  // No navigation, UI updates, order submission, or raw payload logging.
});
```

The empty body is a **required integration point**, not a completed refresh implementation. Background execution is bounded and not guaranteed. Do not import an interactive auth/navigation flow into this handler. For headless iOS launches, use the installed RNFB version's headless-prop integration/guard so a background start does not run the interactive app tree. Enable Remote notifications background capability only for the approved background-data flow. [Background handling and headless starts](https://rnfirebase.io/messaging/usage).

In the existing React root/session coordinator, start the listeners **only after the approved opt-in/account state**; preserve Redux Toolkit and all existing providers:

```tsx
import { useEffect } from 'react';
import { fcmService } from './src/notifications/FcmService';
import { notificationService } from './src/notifications/NotificationService';

// Inside the existing root/session component. These are host-supplied values:
// pushEnabled: boolean, accountRevision: stable primitive,
// bindings: stable FcmBindings object with real implementations.
useEffect(() => {
  if (!pushEnabled) return;
  return fcmService.start(bindings);
}, [pushEnabled, accountRevision, bindings]);

// Separate readiness-boundary effect. openAuthorizedUpdates must be stable and
// verify current authentication/account/access before accepting the action.
useEffect(() => {
  if (!navigationAndAuthReady) return;
  return notificationService.setOpenHandler(openAuthorizedUpdates);
}, [navigationAndAuthReady, accountRevision, openAuthorizedUpdates]);
```

Request presentation permission from the appropriate user-facing preference action:

```typescript
try {
  const allowed = await notificationService.requestPresentationPermission();
  // Update the actual preference UI. Do not treat allowed as backend registration.
} catch {
  // Record a safe permission-request error; do not misreport it as granted/denied.
}
```

On logout/account replacement, clear the open handler/readiness, stop listeners, clear the pending open, and invoke the real backend disassociation/cancellation contract. Generation guards stop obsolete callback delivery but **do not undo a registration already in flight**; the backend worker must enforce current account ownership. Stopping listeners does not delete a token, revoke permission, disable messaging, or remove a backend association.

The helpers coalesce opens into one in-memory generic intent; they do not preserve a durable queue of individual notification links. Add account-scoped persistence only against the approved product contract.

### F. Rebuild and run

Run your actual repository Android/iOS commands or launch from Android Studio/Xcode after the native changes. Do not assume the repo has an `npm run android` script unless `package.json` defines one. Verify both platforms independently; a Metro reload cannot install native modules.

