import React, { useEffect, useState } from 'react';
import { AppState, type AppStateStatus } from 'react-native';
import AsyncStorage from '@react-native-async-storage/async-storage';

export function usePersistedDraft(formId: string, initialDraft: string) {
  const [draft, setDraft] = useState(initialDraft);
  const storageKey = `@draft:${formId}`;

  useEffect(() => {
    // 1. Restore draft on initial mount
    AsyncStorage.getItem(storageKey).then(saved => {
      if (saved) setDraft(saved);
    });

    // 2. Persist to storage when app moves to background
    const subscription = AppState.addEventListener('change', (nextState: AppStateStatus) => {
      if (nextState === 'background' || nextState === 'inactive') {
        AsyncStorage.setItem(storageKey, draft);
      }
    });

    return () => subscription.remove();
  }, [formId, draft]);

  return [draft, setDraft] as const;
}
```

