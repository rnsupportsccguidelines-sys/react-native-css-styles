import { z } from 'zod';

const destinationSchema = z.discriminatedUnion('kind', [
  z.object({ kind: z.literal('home') }),
  z.object({
    kind: z.literal('order'),
    orderId: z.string().regex(/^[A-Za-z0-9_-]{1,128}$/),
  }),
]);

const pushIntentSchema = z.object({
  version: z.literal(1),
  eventId: z.string().regex(/^[A-Za-z0-9_-]{1,128}$/),
  expiresAtMillis: z.number().int().nonnegative(),
  destination: destinationSchema,
});
export type PushIntent = z.infer<typeof pushIntentSchema>;

export function parsePushIntent(raw: unknown, nowMillis: number): PushIntent | null {
  if (typeof raw !== 'string' || raw.length > 2048) return null;
  let decoded: unknown;
  try { decoded = JSON.parse(raw); }
  catch { return null; } // Invalid external input is an expected rejection path.
  const parsed = pushIntentSchema.safeParse(decoded);
  if (!parsed.success || parsed.data.expiresAtMillis <= nowMillis) return null;
  return parsed.data;
}
```

The application limit above is a string-length bound, not the provider's byte-size limit. Set actual payload limits in the gateway/adapter as well. Expiry checks are client freshness checks and depend on the clock; they do not authenticate a command. Rooted/compromised clients and server authorization require separate controls.

### Subscription ownership · adapter contract

`src/core/push/attachPushListeners.ts`

```typescript
import type { PushIntent } from './pushIntent';

type Unsubscribe = () => void;
export interface PushAdapter {
  onForeground(handler: (intent: PushIntent) => void): Unsubscribe;
  onOpened(handler: (intent: PushIntent) => void): Unsubscribe;
  initialIntent(): Promise<PushIntent | null>;
}

export function attachPushListeners(
  adapter: PushAdapter,
  receiveForeground: (intent: PushIntent) => Promise<void>,
  routeIntent: (intent: PushIntent) => Promise<void>,
  reportFailure: (category: 'foreground' | 'initial-notification' | 'routing') => void,
): Unsubscribe {
  let active = true;
  const deliver = (intent: PushIntent): void => {
    if (!active) return;
    void Promise.resolve().then(() => active ? routeIntent(intent) : undefined).catch(() => {
      if (active) reportFailure('routing');
    });
  };
  const removeForeground = adapter.onForeground((intent) => {
    if (!active) return;
    void Promise.resolve().then(() => active ? receiveForeground(intent) : undefined).catch(() => {
      if (active) reportFailure('foreground');
    });
  });
  let removeOpened: Unsubscribe;
  try {
    removeOpened = adapter.onOpened(deliver);
  } catch (error: unknown) {
    active = false;
    removeForeground();
    throw error;
  }
  void Promise.resolve().then(() => adapter.initialIntent()).then((intent) => {
    if (intent) deliver(intent);
  }).catch(() => {
    if (active) reportFailure('initial-notification');
  });
  return () => {
    active = false;
    try { removeForeground(); }
    finally { removeOpened(); }
  };
}
```

The adapter emits validated intents; map the SDK's actual payload shape before this boundary. Diagnostics must be non-throwing and contain no payload/token data. Subscription removal is synchronous, non-throwing, and must be safe when cleanup repeats. The initial-notification call is wrapped in a promise chain so a synchronous adapter failure is also reported.

<Aside type="tip" title="Hint · one router handles every entry point">
Cold-start notification, background tap, explicit foreground-banner interaction, and ordinary deep links must converge on the same application router. That router serializes routing, deduplicates event IDs, checks the current session and backend authorization, and constructs a valid back stack. Foreground receipt updates/presents content but does not auto-navigate. Listener cleanup prevents new delivery; it does not cancel a navigation already in progress. The router must recheck session identity before committing navigation.
</Aside>

For URL-based deep links, validate scheme, host, path, parameters, and supported destinations; prefer verified app/universal links where applicable. Do not pass arbitrary incoming URLs directly to the OS. A regex-valid resource ID is not proof that the current account may view it.

Never log registration tokens or complete notification payloads. Synchronize token registration/rotation to the backend, handle account association changes, and distinguish provider acceptance, device delivery, display, and user-open metrics.


