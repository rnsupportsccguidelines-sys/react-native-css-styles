package com.enterprise.mobile.core.push

import com.google.firebase.messaging.FirebaseMessagingService
import com.google.firebase.messaging.RemoteMessage
import dagger.hilt.android.AndroidEntryPoint
import javax.inject.Inject

interface PushIngress {
    // Bounded, non-blocking handoff. Receipt may update/present; it must not auto-navigate.
    fun received(intent: PushIntent)
    // Called only for a user-open action; application router performs auth/deduplication.
    fun opened(intent: PushIntent)
}
interface PushTokenRegistry {
    // Queue approved registration work; never log the registration token.
    fun scheduleTokenSync(token: String)
}

@AndroidEntryPoint
class EnterprisePushService : FirebaseMessagingService() {
    @Inject lateinit var ingress: PushIngress
    @Inject lateinit var tokens: PushTokenRegistry

    override fun onNewToken(token: String) {
        tokens.scheduleTokenSync(token)
    }
    override fun onMessageReceived(message: RemoteMessage) {
        val intent = PushIntentDecoder.parse(message.data["intent"], System.currentTimeMillis()) ?: return
        ingress.received(intent)
    }
}

// Call from the explicit notification-open path in Activity onCreate/onNewIntent.
fun handleNotificationOpen(raw: String?, ingress: PushIngress) {
    PushIntentDecoder.parse(raw, System.currentTimeMillis())?.let(ingress::opened)
}
