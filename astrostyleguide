import { Tabs, TabItem } from '@astrojs/starlight/components';

export const customMarkdownFaqs = import.meta.glob('./faqs/*.md', { eager: true });
export const resolvedFaqs = await Promise.all(
  Object.entries(customMarkdownFaqs).map(async ([filePath, mod]) => ({
    filePath,
    title: mod.frontmatter?.title || filePath.replace('./faqs/', '').replace('.md', ''),
    htmlContent: typeof mod.compiledContent === 'function' ? await mod.compiledContent() : '',
  }))
);

