/**
 * Pure, immutable business model.
 * Zero Android SDK dependencies (no Parcelable, no Context, no Compose).
 */
data class UserDomainModel(
    val id: String,
    val name: String,
    val email: String,
    val isVip: Boolean,
    val lastSyncTimestamp: Long
)
