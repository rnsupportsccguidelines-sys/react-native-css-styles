Using `unleash-proxy-client` with Tencent MMKV for instant synchronous startup reads:

#### 1. Unleash Service Initialization (`src/core/flags/UnleashService.ts`)
```typescript
import { UnleashClient } from 'unleash-proxy-client';
import { MMKV } from 'react-native-mmkv';
import { AppState, AppStateStatus } from 'react-native';

const storage = new MMKV({ id: 'enterprise-feature-flags' });

export class UnleashService {
  private static instance: UnleashClient | null = null;

  static initialize(userId: string, appVersion: string): UnleashClient {
    if (!this.instance) {
      this.instance = new UnleashClient({
        url: 'https://flags.enterprise.internal/proxy',
        clientKey: process.env.EXPO_PUBLIC_UNLEASH_CLIENT_KEY ?? '',
        appName: 'enterprise-mobile-app',
        refreshInterval: 15,
        storageProvider: {
          save: (name: string, data: any) => storage.set(name, JSON.stringify(data)),
          get: (name: string) => {
            const data = storage.getString(name);
            return data ? JSON.parse(data) : undefined;
          },
        },
        context: {
          userId,
          appName: 'enterprise-mobile-app',
          environment: __DEV__ ? 'development' : 'production',
          properties: {
            appVersion,
            platform: 'react-native',
          },
        },
      });

      // Pause polling in background to prevent battery drain
      AppState.addEventListener('change', (state: AppStateStatus) => {
        if (state === 'active') {
          this.instance?.start();
        } else {
          this.instance?.stop();
        }
      });

      this.instance.start();
    }
    return this.instance;
  }

  static isEnabled(flagName: string, defaultValue = false): boolean {
    if (!this.instance) return defaultValue;
    return this.instance.isEnabled(flagName);
  }
}
```

#### 2. Declarative Hook & Component Gate (`src/presentation/flags/useFeatureFlag.ts`)
```typescript
import { useState, useEffect } from 'react';
import { UnleashService } from '../../core/flags/UnleashService';

export function useFeatureFlag(flagName: string, defaultValue = false): boolean {
  const [enabled, setEnabled] = useState(() => UnleashService.isEnabled(flagName, defaultValue));

  useEffect(() => {
    // Re-evaluate flag state when local storage updates or proxy polls
    const interval = setInterval(() => {
      const current = UnleashService.isEnabled(flagName, defaultValue);
      setEnabled((prev) => (prev !== current ? current : prev));
    }, 1000);

    return () => clearInterval(interval);
  }, [flagName, defaultValue]);

  return enabled;
}

// UI Gating Component
export function FeatureGate({
  flag,
  fallback = null,
  children,
}: {
  flag: string;
  fallback?: React.ReactNode;
  children: React.ReactNode;
}) {
  const isEnabled = useFeatureFlag(flag);
  return isEnabled ? <>{children}</> : <>{fallback}</>;
}
```
