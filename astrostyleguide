/* Disclaimer Banner & Warning Variant */
.portal-alert-box.warning,
.portal-disclaimer-banner {
  background: rgba(250, 204, 21, 0.05) !important;
  border: 1px solid rgba(250, 204, 21, 0.25) !important;
  border-left: 4px solid var(--portal-gold, #facc15) !important;
  border-radius: 8px !important;
  padding: 14px 18px !important;
  margin: 16px 0 24px 0 !important;
  display: flex !important;
  align-items: flex-start !important;
  gap: 14px !important;
  width: 100% !important;
  box-sizing: border-box !important;
}

.portal-disclaimer-icon {
  flex-shrink: 0 !important;
  color: var(--portal-gold, #facc15) !important;
  margin-top: 2px !important;
}

.portal-disclaimer-content {
  flex: 1 !important;
}

.portal-disclaimer-title {
  font-size: 0.84rem !important;
  font-weight: 800 !important;
  color: var(--portal-gold, #facc15) !important;
  letter-spacing: 0.04em !important;
  margin-bottom: 4px !important;
  text-transform: uppercase !important;
}

.portal-disclaimer-text {
  font-size: 0.88rem !important;
  color: var(--portal-text-body, #e2e8f0) !important;
  line-height: 1.5 !important;
  margin: 0 !important;
}

.portal-disclaimer-text a {
  color: var(--portal-accent, #22c55e) !important;
  font-weight: 600 !important;
  text-decoration: underline !important;
  text-underline-offset: 3px !important;
}

.portal-disclaimer-text a:hover {
  color: var(--portal-gold, #facc15) !important;
}

/* Light Mode Overrides */
html[data-theme='light'] .portal-alert-box.warning,
html[data-theme='light'] .portal-disclaimer-banner {
  background: #fefce8 !important;
  border-color: #fde047 !important;
  border-left-color: #ca8a04 !important;
}

html[data-theme='light'] .portal-disclaimer-title {
  color: #a16207 !important;
}

html[data-theme='light'] .portal-disclaimer-text {
  color: #334155 !important;
}
