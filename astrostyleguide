### Swift Outbox Record & Queue Manager

```swift
import Foundation

public struct OutboxRecord: Codable {
    public let id: UUID
    public let endpoint: URL
    public let payload: Data
    public let timestamp: Date
}

public actor OutboxSyncManager {
    public static let shared = OutboxSyncManager()
    private let storageKey = "enterprise_outbox_queue"

    public func enqueue(endpoint: URL, payload: Data) {
        var current = fetchRecords()
        let record = OutboxRecord(id: UUID(), endpoint: endpoint, payload: payload, timestamp: Date())
        current.append(record)
        saveRecords(current)
    }

    public func drainQueue() async {
        var current = fetchRecords()
        guard !current.isEmpty else { return }

        var remaining: [OutboxRecord] = []

        for record in current {
            var request = URLRequest(url: record.endpoint)
            request.httpMethod = "POST"
            request.setValue("application/json", forHTTPHeaderField: "Content-Type")
            request.setValue(record.id.uuidString, forHTTPHeaderField: "X-Idempotency-Key")
            request.httpBody = record.payload

            do {
                let (_, response) = try await URLSession.shared.data(for: request)
                if let httpRes = response as? HTTPURLResponse, httpRes.statusCode >= 500 {
                    remaining.append(record)
                }
            } catch {
                remaining.append(record)
            }
        }

        saveRecords(remaining)
    }

    private func fetchRecords() -> [OutboxRecord] {
        guard let data = UserDefaults.standard.data(forKey: storageKey),
              let decoded = try? JSONDecoder().decode([OutboxRecord].self, from: data) else {
            return []
        }
        return decoded
    }

    private func saveRecords(_ records: [OutboxRecord]) {
        if let data = try? JSONEncoder().encode(records) {
            UserDefaults.standard.set(data, forKey: storageKey)
        }
    }
}
