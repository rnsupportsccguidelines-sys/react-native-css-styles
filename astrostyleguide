import org.junit.Assert.assertEquals
import org.junit.Assert.fail
import org.junit.Test

class CircuitBreakerTest {
    @Test
    fun openCircuitDoesNotInvokeOperation() = runTest {
        val breaker = CircuitBreaker(1, 100, { true }, { 0L })
        try {
            breaker.execute<Unit> { throw IllegalStateException("synthetic") }
            fail("Expected original failure")
        } catch (_: IllegalStateException) {
            // Qualifying failure opens the circuit.
        }
        var calls = 0
        try {
            breaker.execute { calls += 1 }
            fail("Expected open-circuit rejection")
        } catch (_: CircuitOpenException) {
