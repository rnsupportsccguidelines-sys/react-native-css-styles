import Foundation
import UnleashProxyClientSwift

@MainActor
public final class UnleashManager: ObservableObject {
    public static let shared = UnleashManager()
    
    @Published public private(set) var lastUpdated: Date = Date()
    private var client: UnleashClient?

    private init() {}

    public func initialize(userId: String, appVersion: String) {
        let unleashClient = UnleashClient(
            unleashUrl: "https://flags.enterprise.internal/proxy",
            clientKey: "mobile:production.ios_key",
            refreshInterval: 15,
            appName: "enterprise-ios-app",
            context: [
                "userId": userId,
                "appVersion": appVersion,
                "platform": "ios"
            ]
        )

        unleashClient.subscribe(name: "ready") { [weak self] in
            Task { @MainActor in self?.lastUpdated = Date() }
        }

        unleashClient.subscribe(name: "update") { [weak self] in
            Task { @MainActor in self?.lastUpdated = Date() }
        }

        unleashClient.start()
        self.client = unleashClient
    }

    public func isEnabled(_ flagName: String, defaultValue: Boolean = false) -> Bool {
        return client?.isEnabled(name: flagName) ?? defaultValue
    }
}
```

