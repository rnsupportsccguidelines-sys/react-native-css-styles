            (ChickenItem(id: " ", unitPriceMinor: 1250, available: true), 1, "request-001", .invalidItem),
            (ChickenItem(id: item.id, unitPriceMinor: 0, available: true), 1, "request-001", .invalidPrice),
            (ChickenItem(id: item.id, unitPriceMinor: Int64.max, available: true), 2, "request-001", .invalidTotal),
            (item, 1, " ", .invalidRequestId)
        ]
        for (selected, quantity, id, expected) in cases {
