### Domain.swift

The repository instance belongs to one account. Observation is deliberately absent from the contract because this feature uses explicit reads and refreshes.

```swift
import Foundation

struct UserDomainModel: Sendable, Equatable, Identifiable {
    let id: String
    let name: String
    let email: String
    let isVIP: Bool
    let cachedAt: Date
}

enum UserProfileError: Error, Sendable, Equatable {
    case invalidUserID
    case invalidConfiguration
    case sessionExpired
    case accessDenied
    case notFound
    case cacheInvalidationFailed
    case invalidResponse
    case invalidPayload
    case httpStatus(Int)
}

/// An instance belongs to one authenticated account.
protocol UserRepository: Sendable {
    func cachedProfile(userID: String) async throws -> UserDomainModel?
    func refreshProfile(userID: String) async throws -> UserDomainModel
}

struct GetUserProfileUseCase: Sendable {
    let repository: any UserRepository

    // Example API contract: 1–128 ASCII letters, digits, underscores or hyphens.
    // Replace this rule if the real API uses a different identifier format.
    func normalizedID(_ rawID: String) throws -> String {
        let id = rawID.trimmingCharacters(in: .whitespacesAndNewlines)
        let allowed = CharacterSet(charactersIn:
            "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-"
        )
        guard !id.isEmpty, id.utf8.count <= 128,
              id.unicodeScalars.allSatisfy({ allowed.contains($0) }) else {
            throw UserProfileError.invalidUserID
        }
        return id
    }

    func cachedProfile(userID: String) async throws -> UserDomainModel? {
        try await repository.cachedProfile(userID: normalizedID(userID))
    }

    func refreshProfile(userID: String) async throws -> UserDomainModel {
        try await repository.refreshProfile(userID: normalizedID(userID))
    }
}
```

<Aside type="tip" title="Hint · validate before side effects">
Normalize and validate identifiers before cache or network operations. The ASCII identifier rule is an explicit example API contract, not a universal restriction on user identifiers. Change it together with the endpoint builder and tests if your API uses another format.
</Aside>

