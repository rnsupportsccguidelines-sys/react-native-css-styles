import XCTest

@MainActor
private struct LoginPage {
    let app: XCUIApplication
    func signIn(username: String, password: String) {
        let user = app.textFields["login_username_input"]
        let secret = app.secureTextFields["login_password_input"]
        let submit = app.buttons["login_submit_button"]
        XCTAssertTrue(user.waitForExistence(timeout: 10), "Username field missing")
        user.tap()
        user.typeText(username)
        XCTAssertTrue(secret.waitForExistence(timeout: 10), "Password field missing")
        secret.tap()
        secret.typeText(password)
        XCTAssertTrue(submit.waitForExistence(timeout: 10), "Sign-in button missing")
        XCTAssertTrue(submit.isEnabled, "Sign-in button disabled")
        submit.tap()
    }
}

@MainActor
final class LoginBalanceUITests: XCTestCase {
    func testValidUserReachesInteractiveBalance() throws {
        continueAfterFailure = false
        let environment = ProcessInfo.processInfo.environment
        let username = try XCTUnwrap(environment["TEST_USERNAME"])
        let password = try XCTUnwrap(environment["TEST_PASSWORD"])
        XCTAssertFalse(username.isEmpty, "Test username missing")
        XCTAssertFalse(password.isEmpty, "Test password missing")
        let app = XCUIApplication()
        app.launch()
        defer { app.terminate() }
        LoginPage(app: app).signIn(username: username, password: password)
        let balance = app.descendants(matching: .any)["dashboard_account_balance_view"]
        let balanceVisible = NSPredicate(format: "exists == true AND hittable == true")
        let balanceReady = XCTNSPredicateExpectation(predicate: balanceVisible, object: balance)
        XCTAssertEqual(XCTWaiter.wait(for: [balanceReady], timeout: 10), .completed,
                       "Balance element did not become accessible on screen")
        let refresh = app.buttons["dashboard_refresh_button"]
        let ready = NSPredicate(format: "exists == true AND enabled == true AND hittable == true")
        let expectation = XCTNSPredicateExpectation(predicate: ready, object: refresh)
        XCTAssertEqual(XCTWaiter.wait(for: [expectation], timeout: 10), .completed,
                       "Dashboard control did not become usable")
    }
}
```

The test-runner process must receive protected inputs through the approved local/cloud test configuration. Bitrise environment variables do not automatically appear in a remote iOS runner. Confirm the adapter; do not bake credentials into the IPA. `waitForExistence` alone checks existence; the balance/control predicates add accessibility/hit-testing readiness. For a scrollable or grouped layout, use the actual screen's approved visibility/scroll behavior rather than weakening the assertion. See [Apple predicate expectations](https://developer.apple.com/documentation/xctest/xctnspredicateexpectation) for condition-based readiness. Fluent Swift helpers return `self`.

