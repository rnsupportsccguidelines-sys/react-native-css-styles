### `OrderFeature.swift` — domain, repository, API port, and fake composition

```swift
import Foundation

// Domain — example-owned models, not an enterprise HTTP schema.
struct OrderRequest: Sendable {
    let accountID: String
    let requestID: String
    let itemID: String
    let quantity: Int
}
enum OrderResult: Sendable, Equatable {
    case confirmed(orderID: String)
    case invalid
    case unknown
}
protocol OrderRepository: Sendable {
    func place(_ request: OrderRequest) async throws -> OrderResult
}
struct PlaceChickenOrder: Sendable {
    let repository: any OrderRepository

    func callAsFunction(_ request: OrderRequest) async throws -> OrderResult {
        try Task.checkCancellation()
        let ids = [request.accountID, request.requestID, request.itemID]
        guard ids.allSatisfy({ !$0.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty }),
              (1...20).contains(request.quantity) else { return .invalid }
        return try await repository.place(request)
    }
}

// Data — implement this port using the approved transport adapter.
struct OrderResponse: Sendable { let orderID: String }
protocol OrderAPI: Sendable {
    func submit(_ request: OrderRequest) async throws -> OrderResponse
}

// Repository implementation — one call, no retry or local fallback.
struct RemoteOrderRepository: OrderRepository {
    let api: any OrderAPI

    func place(_ request: OrderRequest) async throws -> OrderResult {
        do {
            let response = try await api.submit(request)
            guard !response.orderID.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty
            else { return .unknown }
            return .confirmed(orderID: response.orderID)
        } catch is CancellationError {
            // Preserve structured cancellation. The caller must reconcile an
            // already-dispatched write; cancellation does not prove failure.
            throw CancellationError()
        } catch {
            return .unknown
        }
    }
}

// Application composition — synthetic test/demo only. No network call.
struct DemoOrderAPI: OrderAPI {
    func submit(_ request: OrderRequest) async throws -> OrderResponse {
        OrderResponse(orderID: "order-001")
    }
}
func makeDemoPlaceOrder() -> PlaceChickenOrder {
    PlaceChickenOrder(repository: RemoteOrderRepository(api: DemoOrderAPI()))
}
```

In a controlled async test/task, call `try await makeDemoPlaceOrder()(OrderRequest(accountID: "demo-account", requestID: "demo-request", itemID: "chicken-grilled", quantity: 2))`. Expected result: `.confirmed(orderID: "order-001")`.

An appropriately isolated ViewModel owns UI-facing mutation and active request/session identity. Do not start a new task for every repeated tap. Preserve cancellation while recording any unresolved dispatched order for the application's approved recovery process.

