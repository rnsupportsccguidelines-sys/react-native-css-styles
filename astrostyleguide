Using **Room SQLite** for relational data persistence and **WorkManager** with network constraints for guaranteed background syncing:

#### 1. Outbox Entity & DAO (`com.enterprise.mobile.data.local.OutboxDao.kt`)
```kotlin
package com.enterprise.mobile.data.local

import androidx.room.*
import kotlinx.coroutines.flow.Flow

@Entity(tableName = "outbox_mutations")
data class OutboxEntity(
    @PrimaryKey val id: String, // Idempotency UUID
    val endpoint: String,
    val payloadJson: String,
    val createdAt: Long = System.currentTimeMillis(),
    val retryCount: Int = 0,
    val status: String = "PENDING"
)

@Dao
interface OutboxDao {
    @Insert(onConflict = OnConflictStrategy.REPLACE)
    suspend fun insert(mutation: OutboxEntity)

    @Query("SELECT * FROM outbox_mutations WHERE status = 'PENDING' ORDER BY createdAt ASC")
    suspend fun getPendingMutations(): List<OutboxEntity>

    @Query("UPDATE outbox_mutations SET status = 'SYNCED' WHERE id = :id")
    suspend fun markSynced(id: String)

    @Query("DELETE FROM outbox_mutations WHERE status = 'SYNCED'")
    suspend fun pruneSynced()

    @Query("SELECT COUNT(*) FROM outbox_mutations WHERE status = 'PENDING'")
    fun observePendingCount(): Flow<Int>
}
```

#### 2. Background Sync Worker (`OutboxSyncWorker.kt`)
```kotlin
package com.enterprise.mobile.data.sync

import android.content.Context
import androidx.work.*
import com.enterprise.mobile.data.local.OutboxDao
import okhttp3.MediaType.Companion.toMediaType
import okhttp3.OkHttpClient
import okhttp3.Request
import okhttp3.RequestBody.Companion.toRequestBody

class OutboxSyncWorker(
    appContext: Context,
    workerParams: WorkerParameters,
    private val outboxDao: OutboxDao,
    private val httpClient: OkHttpClient
) : CoroutineWorker(appContext, workerParams) {

    override suspend fun doWork(): Result {
        val pending = outboxDao.getPendingMutations()
        if (pending.isEmpty()) return Result.success()

        val jsonMedia = "application/json; charset=utf-8".toMediaType()

        for (mutation in pending) {
            val request = Request.Builder()
                .url(mutation.endpoint)
                .header("X-Idempotency-Key", mutation.id)
                .post(mutation.payloadJson.toRequestBody(jsonMedia))
                .build()

            try {
                httpClient.newCall(request).execute().use { response ->
                    if (response.isSuccessful) {
                        outboxDao.markSynced(mutation.id)
                    } else if (response.code in 400..499) {
                        // Drop unrecoverable 4xx errors
                        outboxDao.markSynced(mutation.id)
                    } else {
                        return Result.retry()
                    }
                }
            } catch (e: Exception) {
                return Result.retry()
            }
        }

        outboxDao.pruneSynced()
        return Result.success()
    }

    companion object {
        fun schedule(context: Context) {
            val constraints = Constraints.Builder()
                .setRequiredNetworkType(NetworkType.CONNECTED)
                .build()

            val syncRequest = OneTimeWorkRequestBuilder<OutboxSyncWorker>()
                .setConstraints(constraints)
                .setBackoffCriteria(BackoffPolicy.EXPONENTIAL, 15, java.util.concurrent.TimeUnit.SECONDS)
                .build()

            WorkManager.getInstance(context).enqueueUniqueWork(
                "OutboxSyncWork",
                ExistingWorkPolicy.KEEP,
                syncRequest
            )
        }
    }
}
```
