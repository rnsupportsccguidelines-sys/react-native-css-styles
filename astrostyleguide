---
import type { MarkdownInstance } from 'astro';

type FAQ = MarkdownInstance<{
  title?: string;
  order?: number;
}>;

// Replace this glob with the relative path to your Markdown FAQ files.
const modules = import.meta.glob<FAQ>('./faqcontent/*.md', { eager: true });

const faqs = Object.entries(modules)
  .map(([path, module]) => ({
    Content: module.Content,
    title: module.frontmatter.title?.trim()
      || path.split('/').pop()!.replace(/\.md$/, ''),
    order: Number.isFinite(module.frontmatter.order)
      ? module.frontmatter.order!
      : Number.MAX_SAFE_INTEGER,
    path,
  }))
  .sort((a, b) => a.order - b.order || a.path.localeCompare(b.path));
---

{faqs.map(({ Content, title }) => (
  <details>
    <summary>{title}</summary>
    <Content />
  </details>
))}



