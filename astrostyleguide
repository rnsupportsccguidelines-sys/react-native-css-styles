        <td>Normalized binary filename (e.g., <code>my-mobile-app.apk</code>) used in cloud storage.</td>
      </tr>
      <tr>
        <td><code>$CREATION_STATUS</code></td>
        <td><code>App Create</code></td>
        <td>Conditional steps</td>
        <td>Status output (<code>created</code>, <code>already_exists</code>, or <code>failed</code>).</td>
      </tr>
      <tr>
        <td><code>$SAUCE_TEST_EXIT_CODE</code></td>
        <td><code>Upload and Test</code></td>
        <td>Build summary</td>
        <td>Exit code (<code>0</code> for pass, non-zero for test assertion failures).</td>
      </tr>
    </tbody>
  </table>
</div>

