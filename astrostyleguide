import type { IUserRepository } from '../../domain/repository/UserRepository';
import type { UserDomainModel } from '../../domain/model/UserDomainModel';
import type { IUserApiService } from '../remote/userApiService';
import type { IUserStorage } from '../local/userStorage';
import { UserMappers } from '../mapper/userMappers';

export class UserRepositoryImpl implements IUserRepository {
  constructor(
    private readonly apiService: IUserApiService,
    private readonly storage: IUserStorage
  ) {}

  async fetchUserProfile(userId: string): Promise<UserDomainModel> {
    try {
      // 1. Fetch fresh payload from Remote REST API
      const dto = await this.apiService.getUserById(userId);
      const domainModel = UserMappers.toDomain(dto);

      // 2. Persist into fast local MMKV storage
      this.storage.saveUser(domainModel);

      return domainModel;
    } catch (networkError) {
      // 3. Fallback to cached MMKV record on network failure
      const cached = this.storage.getUser(userId);
      if (cached) {
        return cached;
      }
      throw networkError;
    }
  }

  async getCachedUserProfile(userId: string): Promise<UserDomainModel | null> {
    return this.storage.getUser(userId);
  }

  async clearUserProfile(userId: string): Promise<void> {
    this.storage.removeUser(userId);
  }
}
