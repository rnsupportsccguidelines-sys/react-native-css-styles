import Foundation
import Observation

/// Modern Swift 5.9+ @Observable ViewModel isolated to the Main Actor.
/// Eliminates @Published and ObservableObject boilerplate.
@Observable
@MainActor
public final class UserProfileViewModel {
    public private(set) var uiState: UserProfileUIState = .idle
    private let getUserProfileUseCase: GetUserProfileUseCase
    private var activeTask: Task<Void, Never>?

    public init(getUserProfileUseCase: GetUserProfileUseCase) {
        self.getUserProfileUseCase = getUserProfileUseCase
    }

    public func send(_ intent: UserProfileUIIntent) {
        switch intent {
        case .refreshProfile(let userId):
            fetchProfile(userId: userId)
        }
    }

    private func fetchProfile(userId: String) {
        activeTask?.cancel()

        activeTask = Task { [weak self] in
            guard let self else { return }
            self.uiState = .loading

            do {
                let domainUser = try await self.getUserProfileUseCase.execute(userId: userId)
                guard !Task.isCancelled else { return }
                self.uiState = .success(domainUser)
            } catch {
                guard !Task.isCancelled else { return }
                self.uiState = .error(error.localizedDescription)
            }
        }
    }

    deinit {
        activeTask?.cancel()
    }
}
```

