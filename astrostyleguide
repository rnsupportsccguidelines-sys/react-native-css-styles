```

### Implementing Circuit Breaker & Offline Fallback

The following TypeScript snippet demonstrates how client apps query remote endpoints with an automatic local storage fallback:

```typescript
import { CircuitBreaker } from '@enterprise/resilience-sdk';
import AsyncStorage from '@react-native-async-storage/async-storage';

interface UserProfile {
  id: string;
  name: string;
  email: string;
}

// 1. Configure the Circuit Breaker with thresholds
const profileBreaker = new CircuitBreaker({
  failureThreshold: 3,        // Trip after 3 consecutive network failures
  resetTimeoutMs: 30000,      // Wait 30s before probing server again
  requestTimeoutMs: 5000,     // Timeout individual request after 5s
});

export async function getUserProfile(userId: string): Promise<UserProfile> {
  const cacheKey = `@cache:user:${userId}`;

  try {
    // 2. Execute network request inside Circuit Breaker
    return await profileBreaker.execute(async () => {
      const response = await fetch(`https://api.enterprise.internal/v1/users/${userId}`);
      if (!response.ok) throw new Error(`HTTP Error: ${response.status}`);
      
      const data: UserProfile = await response.json();
      // Cache fresh data locally for offline scenarios
      await AsyncStorage.setItem(cacheKey, JSON.stringify(data));
      return data;
    });
  } catch (err) {
    // 3. Gracefully serve stale cache when offline or circuit is open
    const cachedData = await AsyncStorage.getItem(cacheKey);
    if (cachedData) {
      return JSON.parse(cachedData) as UserProfile;
    }
    throw new Error('Offline and no cached data available for this user.');
  }
}
```

