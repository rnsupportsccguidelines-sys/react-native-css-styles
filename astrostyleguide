### Test Redux Toolkit with a real store

Keep credentials and bearer tokens outside Redux actions/state. The earlier sign-in unit test covers the authentication boundary. This separate example tests balance loading **after** the application session owner has selected an authorized account. The injected reader performs the real session authorization in production; an account ID is not authorization.

**File: `src/features/balance/balanceStore.ts`.** This is a self-contained teaching module. Merge the slice into the existing application store in production; do not create a second app-wide store.

```typescript
import { configureStore, createAsyncThunk, createSlice, type PayloadAction } from '@reduxjs/toolkit';
import type { AccountBalance } from './signInAndLoadBalance';

export interface BalanceReader {
  load(accountId: string, signal: AbortSignal): Promise<AccountBalance>;
}
type BalanceState = {
  accountId: string;
  status: 'idle' | 'loading' | 'ready' | 'failed';
  requestId: string | null;
  value: AccountBalance | null;
};
const initialState: BalanceState = {
  accountId: '', status: 'idle', requestId: null, value: null,
};
export const loadBalance = createAsyncThunk<
  AccountBalance, string, { state: { balance: BalanceState }; extra: BalanceReader }
>('balance/load', (accountId, api) => api.extra.load(accountId, api.signal), {
  condition: (accountId, api) => api.getState().balance.accountId === accountId,
});
const slice = createSlice({
  name: 'balance', initialState,
  reducers: {
    accountChanged: (_state, action: PayloadAction<string>): BalanceState => ({
      accountId: action.payload, status: 'idle', requestId: null, value: null,
    }),
  },
  extraReducers: builder => {
    builder.addCase(loadBalance.pending, (state, action) => {
      state.requestId = action.meta.requestId;
      state.status = 'loading';
      state.value = null;
    });
    builder.addCase(loadBalance.fulfilled, (state, action) => {
      if (state.accountId !== action.meta.arg || state.requestId !== action.meta.requestId) return;
      state.value = action.payload;
      state.status = 'ready';
      state.requestId = null;
    });
    builder.addCase(loadBalance.rejected, (state, action) => {
      if (state.accountId !== action.meta.arg || state.requestId !== action.meta.requestId) return;
      state.status = action.meta.aborted ? 'idle' : 'failed';
      state.value = null;
      state.requestId = null;
    });
  },
});
export const { accountChanged } = slice.actions;
export const balanceReducer = slice.reducer;
export function makeBalanceStore(reader: BalanceReader) {
  return configureStore({
    reducer: { balance: balanceReducer },
    middleware: getDefault => getDefault({ thunk: { extraArgument: reader } }),
  });
}
export type BalanceStore = ReturnType<typeof makeBalanceStore>;
export type BalanceRootState = ReturnType<BalanceStore['getState']>;
```

Production reader failures must already be sanitized: Redux Toolkit rejected actions can carry error metadata even when the reducer does not retain it. Do not put raw backend bodies, tokens, or credentials in thrown messages or Redux logging.

The request ID rejects older completions even if the account changes away and back to the same ID. On logout, the real session owner must dispatch `accountChanged('')`, cancel owned work, and apply the app's cleanup rules. The state guard prevents stale publication; it does not replace transport authorization, cache isolation, or credential cleanup.

